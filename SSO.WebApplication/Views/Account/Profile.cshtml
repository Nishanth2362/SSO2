                    </div>
                    <div class="prg-pw-panel-foot">
                        <button type="button" class="prg-btn prg-btn-ghost" id="btnCancelReset">Cancel</button>
                        <button type="submit" form="changePasswordForm" class="prg-btn prg-btn-primary">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                            Change Password
                        </button>
                    </div>
                </div>
                <!-- /pw panel -->

            </div>
        </div>
        <!-- /cardSecurity -->

    </div>
    <!-- /prg-grid -->

</div>
<!-- /prg-page -->


<!-- ═════════════════════════════════════════════
     SCRIPTS — 100% original logic preserved
═════════════════════════════════════════════ -->
<script nonce="@Context.Items["CSPNonce"]?.ToString()">
document.addEventListener("DOMContentLoaded", function () {

    /* ── 1. Edit Profile toggle ── */
    const btnEditProfile     = document.getElementById("btnEditProfile");
    const btnEditProfileCard = document.getElementById("btnEditProfileCard");
    const btnCancelEdit      = document.getElementById("btnCancelEdit");
    const personalReadonly   = document.getElementById("personalReadonly");
    const profileEditFormContainer = document.getElementById("profileEditFormContainer");

    function openEditForm() {
        personalReadonly.style.display = "none";
        profileEditFormContainer.classList.add("open");
        if (btnEditProfile)     btnEditProfile.style.display = "none";
        if (btnEditProfileCard) btnEditProfileCard.style.display = "none";
    }
    function closeEditForm() {
        profileEditFormContainer.classList.remove("open");
        personalReadonly.style.display = "";
        if (btnEditProfile)     btnEditProfile.style.display = "";
        if (btnEditProfileCard) btnEditProfileCard.style.display = "";
    }

    if (btnEditProfile)     btnEditProfile.addEventListener("click",     openEditForm);
    if (btnEditProfileCard) btnEditProfileCard.addEventListener("click", openEditForm);
    if (btnCancelEdit)      btnCancelEdit.addEventListener("click",      closeEditForm);

    /* ── 2. Email change verification flow ── */
    const inputEmail        = document.getElementById("inputEmail");
    const btnVerifyEmail    = document.getElementById("btnVerifyEmail");
    const updateProfileForm = document.getElementById("updateProfileForm");
    const originalEmail     = '@Model.Email';

    function sendVerificationForEmail(email) {
        if (!email) return;
        const token = $('input[name="__RequestVerificationToken"]').first().val();

        Swal.fire({
            title: 'Sending verification link...',
            allowOutsideClick: false,
            customClass: { popup: 'prg-swal' },
            didOpen: () => { Swal.showLoading(); }
        });

        $.post('/Account/SendEmailChangeVerification', {
            newEmail: email,
            __RequestVerificationToken: token
        }).done(function (res) {
            if (res.succeeded) {
                let pollInterval;
                Swal.fire({
                    title: 'Check Your Inbox',
                    html: `<div style="margin-top:12px;">We sent a verification link to <strong style="color:#818cf8;">${email}</strong>.<br><br>Click the link in your email to confirm.<br><br><div style="display:flex;align-items:center;justify-content:center;gap:10px;margin-top:12px;"><div class="modern-spinner" style="width:28px;height:28px;"></div><span style="font-size:.83rem;color:var(--text-muted);">Waiting for confirmation…</span></div></div>`,
                    showCancelButton: true, cancelButtonText: 'Cancel',
                    showConfirmButton: false,
                    customClass: { popup: 'prg-swal' },
                    allowOutsideClick: false,
                    didOpen: () => {
                        pollInterval = setInterval(() => {
                            $.get('/Account/CheckEmailChangeStatus', { newEmail: email }, function (statusRes) {
                                if (statusRes.verified) {
                                    clearInterval(pollInterval);
                                    Swal.fire({ icon: 'success', title: 'Email Verified!', text: 'Your email has been verified and updated.', customClass: { popup: 'prg-swal' } })
                                        .then(() => window.location.reload());
                                }
                            });
                        }, 3000);
                    },
                    willClose: () => { if (pollInterval) clearInterval(pollInterval); }
                });
            } else {
                Swal.fire({ icon: 'error', title: 'Failed', text: res.message || 'Failed to send verification email.', customClass: { popup: 'prg-swal' } });
            }
        }).fail(() => {
            Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred while sending the verification email.', customClass: { popup: 'prg-swal' } });
        });
    }

    if (inputEmail && btnVerifyEmail) {
        inputEmail.addEventListener("input", function () {
            btnVerifyEmail.style.display =
                (this.value.trim().toLowerCase() !== originalEmail.toLowerCase()) ? "inline-flex" : "none";
        });
        btnVerifyEmail.addEventListener("click", () => sendVerificationForEmail(inputEmail.value.trim()));
    }

    const btnVerifyBanner  = document.getElementById("btnVerifyBanner");
    const btnVerifyReadonly = document.getElementById("btnVerifyReadonly");
    if (btnVerifyBanner)   btnVerifyBanner.addEventListener("click",  () => sendVerificationForEmail(originalEmail));
    if (btnVerifyReadonly) btnVerifyReadonly.addEventListener("click", () => sendVerificationForEmail(originalEmail));

    if (updateProfileForm && inputEmail) {
        updateProfileForm.addEventListener("submit", function (e) {
            if (inputEmail.value.trim().toLowerCase() !== originalEmail.toLowerCase()) {
                e.preventDefault();
                Swal.fire({ icon: 'warning', title: 'Verify First', text: 'Please verify your new email using the "Verify" button before saving.', customClass: { popup: 'prg-swal' } });
            }
        });
    }

    /* ── 3. Reset Password form toggle ── */
    const btnTriggerReset         = document.getElementById("btnTriggerResetPassword");
    const btnCancelReset          = document.getElementById("btnCancelReset");
    const securityOptionsGrid     = document.getElementById("securityOptionsGrid");
    const resetPasswordFormContainer = document.getElementById("resetPasswordFormContainer");

    if (btnTriggerReset)  btnTriggerReset.addEventListener("click", function () {
        securityOptionsGrid.style.display = "none";
        resetPasswordFormContainer.classList.add("open");
    });
    if (btnCancelReset) btnCancelReset.addEventListener("click", function () {
        resetPasswordFormContainer.classList.remove("open");
        securityOptionsGrid.style.display = "";
    });

    /* ── 4. Password visibility toggle ── */
    window.togglePasswordVisibility = function (fieldId, btn) {
        const input = document.getElementById(fieldId);
        if (!input) return;
        if (input.type === "password") {
            input.type = "text";
            btn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`;
        } else {
            input.type = "password";
            btn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/></svg>`;
        }
    };

    /* ── 5. Password strength meter ── */
    window.checkPasswordStrength = function (val) {
        let score = 0;
        if (val.length >= 8) score++;
        if (/[A-Z]/.test(val)) score++;
        if (/[a-z]/.test(val)) score++;
        if (/[0-9]/.test(val)) score++;
        if (/[^A-Za-z0-9]/.test(val)) score++;

        const bar   = document.getElementById("strengthBar");
        const label = document.getElementById("strengthLabel");
        if (!bar || !label) return;

        if (!val) { bar.style.width = "0%"; bar.style.backgroundColor = "transparent"; label.textContent = ""; return; }

        bar.style.width = ((score / 5) * 100) + "%";
        const levels = [
            null,
            { color: "#ef4444", text: "Very Weak" },
            { color: "#f97316", text: "Weak" },
            { color: "#eab308", text: "Fair" },
            { color: "#22c55e", text: "Good" },
            { color: "#10b981", text: "Strong ✓" }
        ];
        const lvl = levels[score] || levels[1];
        bar.style.backgroundColor = lvl.color;
        label.textContent = lvl.text;
        label.style.color = lvl.color;
    };

    /* ── 6. Forgot password ── */
    window.handleForgotPassword = function () {
        const email = '@Model.Email';
        const token = $('input[name="__RequestVerificationToken"]').first().val();
        Swal.fire({ title: 'Sending recovery link…', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
        $.post('/Login/ForgotPassword', { Email: email, __RequestVerificationToken: token }).always(function () {
            Swal.fire({ icon: 'success', title: 'Recovery Link Sent', text: 'A password reset link has been sent to: ' + email, customClass: { popup: 'prg-swal' } });
        });
    };

    /* ── 7. Mobile App WebView Bridge ── */
    if (window.ReactNativeWebView) {
        $(document).on('click', '#btnBackToApp, .prg-btn-back-hero', function () {
            try {
                window.ReactNativeWebView.postMessage(JSON.stringify({
                    type: 'RETURN_TO_APP',
                    target: '@backUrl'
                }));
            } catch (_) {}
        });
    }

});
</script>

@{
    var profileErrors = ViewData.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .Distinct()
        .ToList();
}
@if (profileErrors.Any())
{
    <script nonce="@Context.Items["CSPNonce"]?.ToString()">
        (function() {
            const errors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(profileErrors));
            if (errors && errors.length > 0) {
                const msg = errors.join("<br/>");
                if (window.showToast) {
                    window.showToast('error', 'Profile Update Error', msg, 5000);
                } else if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'error', title: 'Profile Update Error', html: msg, customClass: { popup: 'prg-swal' } });
                }
            }
        })();
    </script>
}

@if (TempData["SuccessMessage"] != null)
{
    <script nonce="@Context.Items["CSPNonce"]?.ToString()">
        if (window.showToast) {
            window.showToast('success', 'Success', '@System.Web.HttpUtility.JavaScriptStringEncode(TempData["SuccessMessage"]?.ToString())', 3000);
        } else if (typeof Swal !== 'undefined') {
            Swal.fire({ icon: 'success', title: 'Success', text: '@TempData["SuccessMessage"]', timer: 3000, showConfirmButton: false, customClass: { popup: 'prg-swal' } });
        }
    </script>
}

@if (TempData["ErrorMessage"] != null)
{
    <script nonce="@Context.Items["CSPNonce"]?.ToString()">
        if (window.showToast) {
            window.showToast('error', 'Action Failed', '@System.Web.HttpUtility.JavaScriptStringEncode(TempData["ErrorMessage"]?.ToString())', 5000);
        } else if (typeof Swal !== 'undefined') {
            Swal.fire({ icon: 'error', title: 'Action Failed', text: '@System.Web.HttpUtility.JavaScriptStringEncode(TempData["ErrorMessage"]?.ToString())', customClass: { popup: 'prg-swal' } });
        }
    </script>
}
