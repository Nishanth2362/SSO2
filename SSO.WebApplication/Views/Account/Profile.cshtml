@using SSO.Domain.Entities
@model ApplicationUser
@{
    ViewData["Title"] = "My Profile";
}

<div class="panel">
    <div class="panel-header" style="border-bottom: 1px solid var(--border-color); padding-bottom: 24px; margin-bottom: 32px;">
        <div style="display: flex; align-items: center; gap: 24px;">
            <div style="width: 80px; height: 80px; background: rgba(var(--brand-primary-rgb), 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 700; color: var(--brand-primary); box-shadow: 0 0 0 4px rgba(var(--brand-primary-rgb), 0.05);">
                @(string.Join("", (Model.Name ?? "U").Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0]).Take(2)).ToUpper())
            </div>
            <div>
                <h1 style="margin: 0; font-size: 1.5rem; font-weight: 700;">@Model.Name </h1>
                <p style="margin: 4px 0 0; color: var(--text-muted);">@Model.Email • Account Administrator</p>
                <div style="margin-top: 12px;">
                    <span class="badge badge-success">Active Session</span>
                    <span class="badge badge-neutral" style="margin-left: 8px;">Master Tenant Admin</span>
                </div>
            </div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 40px;">
        <!-- General Information -->
        <div>
            <h3 style="margin: 0 0 24px; font-size: 1.125rem;">Account Details</h3>
            
            <div class="panel" style="margin: 0; padding: 24px; border-color: var(--border-color);">
                <form asp-action="UpdateProfile" asp-controller="Account" method="post" class="modal-form">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label class="form-label" style="display: flex; align-items: center; gap: 8px;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                             Full Name
                        </label>
                        <input type="text" asp-for="Name" class="form-input" placeholder="Your Name" required />
                    </div>

                    <div class="form-group" style="margin-top: 16px;">
                        <label class="form-label" style="display: flex; align-items: center; gap: 8px;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                            Work Email
                        </label>
                        <input type="email" asp-for="Email" class="form-input" placeholder="Email Address" required />
                    </div>

                    <div class="form-group" style="margin-top: 16px;">
                        <label class="form-label" style="display: flex; align-items: center; gap: 8px;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                            Contact Phone
                        </label>
                        <input type="text" asp-for="PhoneNumber" class="form-input" placeholder="Phone" />
                    </div>

                    <div class="form-group" style="margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end;">
                        <button type="submit" class="btn btn-primary" style="padding: 10px 24px;">
                            Update Information
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Security & Actions -->
        <div>
            <h3 style="margin: 0 0 24px; font-size: 1.125rem;">Security</h3>
            
            <div class="panel" style="margin: 0; padding: 24px; border-color: rgba(var(--brand-primary-rgb), 0.2); background: rgba(var(--brand-primary-rgb), 0.02);">
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
                    <div style="color: var(--brand-primary);">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </div>
                    <span style="font-weight: 600; font-size: 1.125rem;">Change Password</span>
                </div>
                
                <form asp-action="ChangePassword" asp-controller="Account" method="post" class="modal-form">
                    @Html.AntiForgeryToken()
                    
                    <div class="form-group">
                        <label class="form-label">Current Password</label>
                        <input type="password" name="currentPassword" class="form-input" placeholder="••••••••" required />
                    </div>
                    <div class="form-group" style="margin-top: 16px;">
                        <label class="form-label">New Password</label>
                        <input type="password" name="newPassword" class="form-input" placeholder="••••••••" required />
                    </div>
                    <div class="form-group" style="margin-top: 16px;">
                        <label class="form-label">Confirm New Password</label>
                        <input type="password" name="confirmPassword" class="form-input" placeholder="••••••••" required />
                    </div>
                    
                    <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 24px; justify-content: center;">
                        Update Password
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Updated',
            text: '@TempData["SuccessMessage"]',
            timer: 3000,
            showConfirmButton: false
        });
    </script>
}

@if (TempData["ErrorMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Action Failed',
            text: '@System.Web.HttpUtility.JavaScriptStringEncode(TempData["ErrorMessage"]?.ToString())'
        });
    </script>
}
