@using SSO.Application.Responses.Billing

@{
    ViewData["Title"] = "Invoices";
    var canViewPayments = (await AuthorizationService.AuthorizeAsync(User, Permissions.Payments.View)).Succeeded;
    var canExportInvoice = (await AuthorizationService.AuthorizeAsync(User, Permissions.Invoices.Export)).Succeeded || (await AuthorizationService.AuthorizeAsync(User, Permissions.Invoices.View)).Succeeded;
    var canPrintInvoice = (await AuthorizationService.AuthorizeAsync(User, Permissions.Invoices.View)).Succeeded;
    var canRecordPayment = (await AuthorizationService.AuthorizeAsync(User, Permissions.Payments.Create)).Succeeded;
}

<style>
    /* Full-page background for seamless integration (Premium Sky Blue Theme based on #2563EB) */
    body {
        background: linear-gradient(150deg,
                        rgba(37, 99, 235, 0.12) 0%,
                        rgba(59, 130, 246, 0.06) 22%,
                        rgba(147, 197, 253, 0.08) 55%,
                        rgba(219, 234, 254, 0.5) 78%,
                        rgba(255, 255, 255, 0.95) 100%) !important;
        background-attachment: fixed !important;
        background-repeat: no-repeat !important;
        background-size: cover !important;
    }

    html[data-theme="dark"] body {
        background: linear-gradient(150deg,
                        rgba(37, 99, 235, 0.20) 0%,
                        rgba(59, 130, 246, 0.08) 22%,
                        rgba(15, 23, 42, 0.6) 78%,
                        rgba(9, 12, 20, 0.95) 100%) !important;
        background-attachment: fixed !important;
        background-repeat: no-repeat !important;
        background-size: cover !important;
    }

    .page-wrapper, .content-wrapper, .container-xl, main, #content, .page-body {
        background: transparent !important;
    }

    /* ═══════════════════════════════════════════════════════════
       HERO BANNER — Seamless Background with Scattered Billing Illustrations
       ═══════════════════════════════════════════════════════════ */
    .inv-page-card {
        background: transparent;
        border: none;
        border-radius: 0;
        box-shadow: none;
        overflow: visible;
        margin-bottom: 20px;
    }

    html[data-theme="dark"] .inv-page-card {
        background: transparent;
    }

    .inv-hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
        background: transparent;
        border: none;
        border-radius: 0;
        padding: 24px 4px;
        margin-bottom: 0;
        overflow: hidden;
    }

    html[data-theme="dark"] .inv-hero {
        background: transparent;
    }

    .inv-hero::before {
        content: "";
        position: absolute;
        right: -60px;
        top: -60px;
        width: 280px;
        height: 280px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(37, 99, 235, 0.14) 0%, rgba(37, 99, 235, 0) 70%);
        pointer-events: none;
    }

    .inv-hero::after {
        display: none !important;
    }

    /* Scattered Background Pattern (8-12% opacity outline SVGs in #2563EB) */
    .inv-hero-bg-pattern {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
        z-index: 0;
    }

    .hero-bg-icon {
        position: absolute;
        stroke: #2563eb;
        stroke-width: 1.5;
        fill: none;
        opacity: 0.10;
        transition: opacity 0.3s ease;
    }

    html[data-theme="dark"] .hero-bg-icon {
        stroke: #60a5fa;
        opacity: 0.12;
    }

    .hero-bg-icon.icon-invoice-1 { top: 8%; left: 1%; width: 32px; height: 32px; transform: rotate(-12deg); }
    .hero-bg-icon.icon-rupee-1   { top: 14%; left: 36%; width: 26px; height: 26px; transform: rotate(10deg); }
    .hero-bg-icon.icon-card-1    { bottom: 10%; left: 18%; width: 30px; height: 30px; transform: rotate(-8deg); }
    .hero-bg-icon.icon-receipt-1 { top: 58%; left: 3%; width: 28px; height: 28px; transform: rotate(6deg); }
    .hero-bg-icon.icon-chart-1   { top: 10%; left: 22%; width: 28px; height: 28px; transform: rotate(-10deg); }
    .hero-bg-icon.icon-wallet-1  { top: 62%; left: 44%; width: 26px; height: 26px; transform: rotate(-14deg); }
    .hero-bg-icon.icon-coins-1   { top: 12%; right: 44%; width: 28px; height: 28px; transform: rotate(18deg); }
    .hero-bg-icon.icon-wave-1    { bottom: 8%; right: 36%; width: 32px; height: 32px; transform: rotate(-10deg); }
    .hero-bg-icon.icon-leaf-1    { top: 10%; right: 26%; width: 26px; height: 26px; transform: rotate(8deg); }

    .inv-hero-left {
        position: relative;
        display: flex;
        align-items: center;
        gap: 18px;
        z-index: 1;
        flex: 1 1 320px;
        min-width: 260px;
    }

    .inv-hero-icon {
        width: 54px;
        height: 54px;
        flex-shrink: 0;
        border-radius: 16px;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.32);
    }

    .inv-hero-title {
        font-size: 1.85rem !important;
        font-weight: 800 !important;
        color: var(--text-main);
        letter-spacing: -0.02em;
        margin: 0 0 4px;
    }

    .inv-hero-subtitle {
        font-size: 0.86rem;
        color: var(--text-muted);
        margin: 0 0 8px;
        max-width: 420px;
        line-height: 1.45;
    }

    .inv-hero-underline {
        width: 36px;
        height: 4px;
        border-radius: 4px;
        background: linear-gradient(90deg, #2563eb, #60a5fa);
    }

    /* Hero Illustration in Center-Right matching reference */
    .inv-hero-illustration {
        position: relative;
        z-index: 1;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 250px;
        height: 125px;
        pointer-events: none;
    }

    /* Bottom Flowing Waves */
    .inv-hero-wave-container {
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 50px;
        pointer-events: none;
        overflow: hidden;
        z-index: 0;
    }

    .inv-hero-wave-svg {
        width: 100%;
        height: 100%;
    }

    @@media (max-width: 1100px) {
        .inv-hero-illustration {
            display: none;
        }
    }

    /* ═══════════════════════════════════════════════════════════
       COMPACT KPI CARDS (Matching Tenants & Subscriptions pages)
       ═══════════════════════════════════════════════════════════ */
    .sub-kpi-container {
        position: relative;
        display: flex;
        gap: 14px;
        align-items: stretch;
        z-index: 1;
        flex-wrap: wrap;
        margin-left: 0;
        margin-right: 0;
    }

    .sub-kpi-card {
        cursor: pointer;
        user-select: none;
        width: 178px;
        flex-shrink: 0;
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 14px;
        padding: 10px 14px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(0,0,0,0.03), 0 6px 16px -8px rgba(15,23,42,0.08);
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

    .sub-kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(0,0,0,0.05), 0 10px 24px -8px rgba(15,23,42,0.14);
    }

    .sub-kpi-card.active {
        border-color: #2563eb !important;
        box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.18), var(--shadow-sm) !important;
    }

    .sub-kpi-card .tabler-stat-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
    }

    .sub-kpi-card .tabler-stat-title {
        font-size: 0.66rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #64748b;
        line-height: 1.3;
    }

    html[data-theme="dark"] .sub-kpi-card .tabler-stat-title {
        color: #94a3b8;
    }

    .sub-kpi-card .tabler-stat-value {
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--text-main);
        line-height: 1;
    }

    .tabler-stat-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s ease;
    }

    .sub-kpi-card:hover .tabler-stat-icon {
        transform: scale(1.08);
    }

    .tabler-stat-icon.total-icon {
        background: rgba(37, 99, 235, 0.12) !important;
        color: #2563eb !important;
    }

    .tabler-stat-icon.monthly-icon {
        background: rgba(16, 185, 129, 0.14) !important;
        color: #10b981 !important;
    }

    .tabler-stat-icon.yearly-icon {
        background: rgba(245, 158, 11, 0.14) !important;
        color: #f59e0b !important;
    }

    .kpi-mini-visual {
        position: absolute;
        right: 10px;
        bottom: 6px;
        opacity: 0.7;
        pointer-events: none;
    }

    @@media (max-width: 1024px) {
        .inv-hero {
            padding: 20px;
        }

        .sub-kpi-container {
            width: 100%;
        }

        .sub-kpi-card {
            flex: 1 1 150px;
        }
    }

    @@media (max-width: 768px) {
        .sub-kpi-container {
            flex-direction: column;
            align-items: stretch;
        }

        .sub-kpi-card {
            width: 100% !important;
        }
    }

    /* Hide legacy header and breadcrumbs */
    .page-header, .breadcrumbs {
        display: none !important;
    }

/* ═══════════════════════════════════════════════
   INVOICE SPLIT-VIEW LAYOUT
═══════════════════════════════════════════════ */

/* Outer wrapper fills the content area */
.invoice-workspace {
    display: flex;
    flex-direction: column;
    height: calc(100vh - var(--header-height) - 86px);
    min-height: 0;
}

/* ─── Split container ─── */
.invoice-split {
    display: flex;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
}

/* ─── Left list pane ─── */
.inv-list-pane {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    width: 100%;          /* default: full width when detail closed */
    min-width: 260px;
    max-width: 100%;
    overflow: hidden;
    transition: width 0.32s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
}

.invoice-split.detail-open .inv-list-pane {
    width: var(--list-pane-width, 32%);
    max-width: 55%;
    border-right: 1px solid var(--border-subtle);
}

/* ─── Drag handle (resizer) ─── */
.inv-resizer {
    display: none;           /* hidden until detail is open */
    flex-shrink: 0;
    width: 5px;
    cursor: col-resize;
    background: transparent;
    position: relative;
    z-index: 10;
    transition: background 0.2s;
}

.inv-resizer::after {
    content: '';
    position: absolute;
    inset: 0 1px;
    background: var(--border-subtle);
    transition: background 0.2s, width 0.2s;
    border-radius: 2px;
}

.inv-resizer:hover::after,
.inv-resizer.dragging::after {
    background: var(--brand-primary);
    inset: 0 0px;
}

.invoice-split.detail-open .inv-resizer {
    display: block;
}

/* ─── Right detail pane ─── */
.inv-detail-pane {
    display: none;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateX(14px);
    transition: opacity 0.28s ease, transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
}

.invoice-split.detail-open .inv-detail-pane {
    display: flex;
    opacity: 1;
    transform: translateX(0);
}

/* ─── List pane internals ─── */
.inv-list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 12px;
    border-bottom: 1px solid var(--border-subtle);
    flex-shrink: 0;
    gap: 8px;
    min-height: 0;
}

.inv-list-search {
    position: relative;
    flex: 1;
    min-width: 0;
}

.inv-list-search svg {
    position: absolute;
    left: 8px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
}

.inv-list-search input {
    width: 100%;
    padding: 5px 8px 5px 28px;
    font-size: 0.76rem;
    background: var(--bg-base);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--text-main);
    outline: none;
    font-family: inherit;
    transition: border-color 0.2s;
}

.inv-list-search input:focus {
    border-color: var(--brand-primary);
}

.inv-list-search input::placeholder {
    color: var(--text-muted);
}

/* ─── Invoice list (replaces DataTable in split mode) ─── */
.inv-list-body {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
}

/* Custom scrollbar */
.inv-list-body::-webkit-scrollbar,
.inv-detail-body::-webkit-scrollbar { width: 4px; }
.inv-list-body::-webkit-scrollbar-track,
.inv-detail-body::-webkit-scrollbar-track { background: transparent; }
.inv-list-body::-webkit-scrollbar-thumb,
.inv-detail-body::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 2px; }

/* When detail is open, the DataTable is replaced by a compact card list */
.inv-card-list { display: none; flex-direction: column; }
.invoice-split.detail-open .inv-card-list { display: flex; }
.invoice-split.detail-open .inv-dt-wrapper {
    flex: none !important;
    height: auto !important;
    overflow: visible !important;
}
.invoice-split.detail-open .inv-dt-wrapper .table-responsive,
.invoice-split.detail-open .inv-dt-wrapper .if-table-footer-wrap {
    display: none !important;
}

.inv-dt-wrapper {
    flex: 1;
    overflow: auto;
}

.inv-list-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border-subtle);
    cursor: pointer;
    transition: background 0.15s;
    position: relative;
}

.inv-list-card:last-child { border-bottom: none; }

.inv-list-card:hover { background: var(--bg-surface-hover); }

.inv-list-card.active {
    background: var(--brand-bg-subtle);
    border-left: 3px solid var(--brand-primary);
    padding-left: 9px;
}

.inv-list-card.active::after {
    content: '';
    position: absolute;
    right: -1px;
    top: 50%;
    transform: translateY(-50%);
    border: 6px solid transparent;
    border-right-color: var(--bg-base);
}

.inv-card-left {
    flex: 1;
    min-width: 0;
}

.inv-card-num {
    font-family: 'Fira Code', ui-monospace, monospace;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--brand-primary);
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.inv-card-tenant {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--text-main);
    display: block;
    margin-top: 1px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.inv-card-date {
    font-size: 0.64rem;
    color: var(--text-muted);
    display: block;
    margin-top: 1px;
}

.inv-card-right {
    text-align: right;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
}

.inv-card-amount {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--text-main);
}

/* DataTable invoice number badge */
.inv-number-badge {
    font-family: 'Fira Code', ui-monospace, monospace;
    font-weight: 600;
    font-size: 0.72rem;
    color: var(--brand-primary);
    background: var(--brand-bg-subtle);
    border: 1px solid rgba(59,130,246,0.2);
    padding: 1px 6px;
    border-radius: 4px;
    letter-spacing: 0.03em;
    white-space: nowrap;
}

/* Selected row in full table */
#invoiceTable tbody tr.selected-row td { background: var(--brand-bg-subtle) !important; }
#invoiceTable tbody tr { cursor: pointer; }

/* ─── Detail pane internals ─── */
.inv-detail-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    border-bottom: 1px solid var(--border-subtle);
    flex-shrink: 0;
    gap: 10px;
    background: var(--bg-surface);
}

.inv-detail-title-group {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
}

.inv-detail-inv-num {
    font-family: 'Fira Code', ui-monospace, monospace;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--brand-primary);
    letter-spacing: 0.02em;
    white-space: nowrap;
}

.inv-detail-subtitle {
    font-size: 0.68rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.inv-detail-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
}

.inv-close-btn {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.18s;
    flex-shrink: 0;
}

.inv-close-btn:hover {
    background: var(--bg-surface-hover);
    color: var(--status-error);
    border-color: var(--status-error);
}

.inv-detail-body {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
}

/* ─── Detail sections ─── */
.detail-section {
    padding: 10px 12px;
    border-bottom: 1px solid var(--border-subtle);
}

.detail-section:last-child { border-bottom: none; }

.detail-section-label {
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 5px;
}

.detail-section-label svg { opacity: 0.6; }

/* Info key-value grid */
.detail-kv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 12px;
}

.detail-kv-item { display: flex; flex-direction: column; gap: 2px; }

.detail-kv-key {
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
}

.detail-kv-val {
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--text-main);
}

.detail-kv-val.accent {
    color: var(--brand-primary);
    font-weight: 700;
    font-family: 'Fira Code', ui-monospace, monospace;
}

/* ─── Amount strip ─── */
.detail-amount-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-base);
}

.detail-amount-cell {
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: center;
}

.detail-amount-cell + .detail-amount-cell { border-left: 1px solid var(--border-subtle); }
.detail-amount-key { font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }
.detail-amount-val { font-size: 0.8rem; font-weight: 700; color: var(--text-main); }
.detail-amount-val.total { color: var(--brand-primary); font-size: 0.88rem; }

/* ─── Transaction table ─── */
.txn-table { width: 100%; border-collapse: collapse; font-size: 0.72rem; }
.txn-table thead th {
    padding: 5px 8px;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
    background: var(--bg-base);
    border-bottom: 1px solid var(--border-subtle);
    white-space: nowrap;
}
.txn-table tbody td {
    padding: 6px 8px;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-main);
    vertical-align: middle;
}
.txn-table tbody tr:last-child td { border-bottom: none; }
.txn-table tbody tr:hover td { background: var(--bg-surface-hover); }

/* ─── Empty / loading states ─── */
.detail-empty, .detail-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 40px 20px;
    color: var(--text-muted);
    font-size: 0.78rem;
    text-align: center;
    min-height: 160px;
}

/* Skeleton */
.skel {
    background: linear-gradient(90deg, var(--bg-surface-hover) 25%, var(--border-subtle) 50%, var(--bg-surface-hover) 75%);
    background-size: 200% 100%;
    animation: skel-shimmer 1.3s infinite;
    border-radius: var(--radius-sm);
}

/* Spinner */
.spinner-ring {
    width: 26px; height: 26px;
    border: 3px solid var(--border-strong);
    border-top-color: var(--brand-primary);
    border-radius: 50%;
    animation: spin 0.75s linear infinite;
}

@@keyframes skel-shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
@@keyframes spin { to { transform: rotate(360deg); } }

/* ─── List pane footer (pagination + count) ─── */
.inv-list-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 12px;
    border-top: 1px solid var(--border-subtle);
    flex-shrink: 0;
    font-size: 0.7rem;
    color: var(--text-muted);
    gap: 8px;
}

/* ═══════════════════════════════════════════════
   MOBILE DRAWER  (≤ 768px)
═══════════════════════════════════════════════ */
.inv-drawer-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.45);
    z-index: 300;
    opacity: 0;
    transition: opacity 0.25s ease;
}

.inv-drawer-backdrop.visible { opacity: 1; }

.inv-drawer {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 88vh;
    background: var(--bg-surface);
    border-radius: 14px 14px 0 0;
    z-index: 301;
    display: flex;
    flex-direction: column;
    transform: translateY(100%);
    transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
}

.inv-drawer.open { transform: translateY(0); }

.inv-drawer-handle {
    width: 36px; height: 4px;
    border-radius: 2px;
    background: var(--border-strong);
    margin: 10px auto 0;
    flex-shrink: 0;
}

.inv-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px 8px;
    border-bottom: 1px solid var(--border-subtle);
    flex-shrink: 0;
    gap: 10px;
}

.inv-drawer-title-group { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.inv-drawer-num { font-family: 'Fira Code', ui-monospace, monospace; font-size: 0.88rem; font-weight: 700; color: var(--brand-primary); }
.inv-drawer-sub { font-size: 0.7rem; color: var(--text-muted); }
.inv-drawer-actions { display: flex; align-items: center; gap: 6px; }

.inv-drawer-body { flex: 1; overflow-y: auto; }

@@media (min-width: 769px) {
    .inv-drawer-backdrop,
    .inv-drawer { display: none !important; }
}

@@media (max-width: 768px) {
    .invoice-split.detail-open .inv-list-pane { width: 100% !important; max-width: 100% !important; border-right: none; }
    .invoice-split.detail-open .inv-resizer  { display: none; }
    .invoice-split.detail-open .inv-detail-pane { display: none; }
    .inv-drawer-backdrop { display: block; }
}

/* ─── Adjust DataTable to fill list pane ─── */
.inv-dt-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}
.inv-dt-wrapper .dataTables_wrapper {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    height: 100%;
}
.inv-dt-wrapper .table-responsive {
    flex: 1;
    overflow-y: auto;
    min-height: 0;
}
.inv-dt-wrapper .modern-table-footer {
    margin-top: auto !important;
}
.inv-dt-wrapper .pagination {
    padding: 6px 10px;
    border-top: 1px solid var(--border-subtle);
}

/* Column Width Controls */
#invoiceTable th:nth-child(1), #invoiceTable td:nth-child(1) { width: 32px !important; min-width: 32px; text-align: center; } /* Checkbox */
#invoiceTable th:nth-child(2), #invoiceTable td:nth-child(2) { width: 14% !important; min-width: 95px; } /* Invoice # */
#invoiceTable th:nth-child(3), #invoiceTable td:nth-child(3) { width: 36% !important; min-width: 180px; } /* Tenant & Plan */
#invoiceTable th:nth-child(4), #invoiceTable td:nth-child(4) { width: 12% !important; min-width: 80px; }  /* Amount */
#invoiceTable th:nth-child(5), #invoiceTable td:nth-child(5) { width: 12% !important; min-width: 80px; }  /* Date */
#invoiceTable th:nth-child(6), #invoiceTable td:nth-child(6) { width: 12% !important; min-width: 80px; }  /* Status */
#invoiceTable th:nth-child(7), #invoiceTable td:nth-child(7) { width: 14% !important; min-width: 85px; text-align: right; } /* Actions */

/* Vertically align elements inside cells */
#invoiceTable tbody td .custom-checkbox {
    vertical-align: middle;
    margin: 0;
}

/* Action buttons alignment and padding */
.inv-actions-wrapper {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 4px;
}
.inv-actions-wrapper .action-btn {
    padding: 4px !important;
    border-radius: var(--radius-md) !important;
}

/* Search & filter height adjustments */
.inv-list-header {
    padding: 6px 12px;
}
.inv-list-search input {
    height: 28px !important;
    padding: 0 8px 0 28px !important;
    font-size: 0.72rem !important;
}
#invStatusFilter {
    height: 28px !important;
    padding: 0 24px 0 8px !important;
    font-size: 0.72rem !important;
    border-radius: var(--radius-md) !important;
    border: 1px solid var(--border-subtle) !important;
    background-color: var(--bg-base) !important;
    color: var(--text-main) !important;
    min-height: 28px !important;
}

