                            <div class="smart-export-menu glass-dropdown">
                                <button type="button" class="dropdown-item smart-import-option" onclick="window.openImportModal('Invoices')">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                    Import
                                </button>
                                <button type="button" class="dropdown-item smart-export-option" onclick="window.smartExport('invoiceTable', '/Billing/ExportInvoices')">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                    Export
                                </button>
                            </div>
                        </div>
                    }
                    @if (canViewPayments)
                    {
                        <a href="/Billing/Payments" class="btn btn-primary btn-toolbar">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                <line x1="1" y1="10" x2="23" y2="10"></line>
                            </svg>
                            All Payments
                        </a>
                    }
                </div>
                <div class="table-filters-data" style="display:none;">
                    <div class="filter-group-item">
                        <label>Invoice Status</label>
                        <select name="Status" class="form-select">
                            <option value="">All Statuses</option>
                            <option value="0">Pending</option>
                            <option value="1">Paid</option>
                            <option value="2">Overdue</option>
                            <option value="3">Cancelled</option>
                        </select>
                    </div>
                </div>
                <table id="invoiceTable" class="data-table table-hoverable manual-init" style="width: 100%;">
                    <thead>
                        <tr>
                            <th class="text-center" style="width:40px;"><input type="checkbox" class="master-select-cb" data-table="invoiceTable"></th>
                            <th class="text-center">Invoice #</th>
                            <th class="text-left">Tenant</th>
                            <th class="text-right">Amount</th>
                            <th class="text-center">Date</th>
                            <th class="text-center">Status</th>
                            <th class="text-left">Subscription</th>
                            <th class="text-center">Due Date</th>
                            <th class="text-center">Currency</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <!-- Compact card list (when detail is OPEN) -->
            <div class="inv-card-list inv-list-body" id="invCardList">
                <!-- Populated by JS -->
            </div>

            <!-- List footer -->
            <div class="inv-list-footer" id="invListFooter" style="display:none;">
                <span id="invCountLabel">— invoices</span>
                <div style="display:flex; gap:4px;">
                    <button class="btn btn-secondary" id="invPrevPage" style="padding:2px 7px; font-size:0.7rem;">‹</button>
                    <button class="btn btn-secondary" id="invNextPage" style="padding:2px 7px; font-size:0.7rem;">›</button>
                </div>
            </div>
        </div>

        <!-- ══════════ RESIZER HANDLE ══════════ -->
        <div class="inv-resizer" id="invResizer" title="Drag to resize"></div>

        <!-- ══════════ RIGHT: DETAIL PANE ══════════ -->
        <div class="inv-detail-pane" id="invDetailPane">

            <div class="inv-detail-header">
                <div class="inv-detail-title-group">
                    <span class="inv-detail-inv-num" id="detailNum">—</span>
                    <span class="inv-detail-subtitle" id="detailSub">Select an invoice from the list</span>
                </div>
                <div class="inv-detail-actions">
                    @if (canPrintInvoice)
                    {
                        <button class="btn btn-secondary" id="detailPrintBtn" style="font-size:0.73rem; padding:4px 10px;">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                                <rect x="6" y="14" width="12" height="8"></rect>
                            </svg>
                            Print
                        </button>
                    }
                    @if (canRecordPayment)
                    {
                        <button class="btn btn-primary" id="detailPayBtn" style="font-size:0.73rem; padding:4px 10px;">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                <line x1="1" y1="10" x2="23" y2="10"></line>
                            </svg>
                            Pay
                        </button>
                    }
                    <button class="inv-close-btn" id="detailCloseBtn" title="Close">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="inv-detail-body" id="detailBody">
                <div class="detail-empty">
                    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" style="opacity:0.2;">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                    <span>Click an invoice row to view details</span>
                </div>
            </div>
        </div>

    </div><!-- /.invoice-split -->
</div><!-- /.invoice-workspace -->

<!-- ══════════ MOBILE DRAWER ══════════ -->
<div class="inv-drawer-backdrop" id="drawerBackdrop"></div>
<div class="inv-drawer" id="invDrawer">
    <div class="inv-drawer-handle"></div>
    <div class="inv-drawer-header">
        <div class="inv-drawer-title-group">
            <span class="inv-drawer-num" id="drawerNum">—</span>
            <span class="inv-drawer-sub" id="drawerSub"></span>
        </div>
        <div class="inv-drawer-actions">
            @if (canPrintInvoice)
            {
                <button class="btn btn-secondary" id="drawerPrintBtn" style="font-size:0.73rem; padding:4px 10px;">Print</button>
            }
            @if (canRecordPayment)
            {
                <button class="btn btn-primary"   id="drawerPayBtn"   style="font-size:0.73rem; padding:4px 10px;">Pay</button>
            }
            <button class="inv-close-btn" id="drawerCloseBtn">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    </div>
    <div class="inv-drawer-body" id="drawerBody"></div>
</div>

<script type="text/javascript">
$(function () {
    const canPrintInvoice = @canPrintInvoice.ToString().ToLower();
    const canRecordPayment = @canRecordPayment.ToString().ToLower();

    // ── DOM refs ────────────────────────────────────────────────
    const $split      = $('#invoiceSplit');
    const $listPane   = $('#invListPane');
    const $resizer    = $('#invResizer');
    const $detailPane = $('#invDetailPane');
    const $detailBody = $('#detailBody');
    const $detailNum  = $('#detailNum');
    const $detailSub  = $('#detailSub');
    const $cardList   = $('#invCardList');
    const $listFooter = $('#invListFooter');
    const $countLabel = $('#invCountLabel');
    const $panel      = $('#invoiceTable').closest('.panel');

    // Drawer
    const $backdrop   = $('#drawerBackdrop');
    const $drawer     = $('#invDrawer');
    const $drawerNum  = $('#drawerNum');
    const $drawerSub  = $('#drawerSub');
    const $drawerBody = $('#drawerBody');

    let currentId = null;
    let allRows   = [];           // cache for card list
    let cardPage  = 0;
    const cardPageSize = 30;
    let isMobile  = () => window.innerWidth <= 768;

    // ── DataTable ───────────────────────────────────────────────
    if ($.fn.dataTable.isDataTable('#invoiceTable')) {
        $('#invoiceTable').DataTable().destroy();
    }
    const dt = $('#invoiceTable').DataTable({
        processing : true,
        serverSide : true,
        ajax: {
            url : '/Billing/GetInvoices',
            type: 'POST'
        },
        responsive: false,
        dom: '<"table-toolbar datatables-injected"<"table-filters">f><"table-responsive"t><"if-table-footer-wrap"<"footer-right"<"if-pill-pagination-mount">>>',
drawCallback: function () {
    const api = this.api();
    window.renderPillPagination(api, '.if-pill-pagination-mount', 'invoices');

    // Keep KPI highlight synchronized in drawCallback
    const activeFilters = $panel.data('active-filters') || {};
    $('.sub-kpi-card').removeClass('active');
    if (activeFilters.Status === '1') {
        $('#kpiPaid').addClass('active');
    } else if (activeFilters.Status === '0,2') {
        $('#kpiUnpaid').addClass('active');
    } else {
        $('#kpiTotal').addClass('active');
    }
},
columns: [
            {
                data: null, orderable: false, searchable: false,
                className: 'text-center align-middle',
                render: function (data, type, row) {
                    return '<input type="checkbox" class="row-select-cb" data-row-id="' + (row.id || row.Id || '') + '">';
                }
            },
            {
                data: 'invoiceNumber',
                className: 'text-center align-middle',
                render: d => `<span class="inv-number-badge">${d}</span>`
            },
            {
                data: 'tenantName',
                className: 'text-left align-middle',
                render: (d, t, row) => `<div class="cell-text" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: inline-flex; align-items: center; gap: 6px;"><strong>${d}</strong><span style="color: var(--text-muted); font-size: 0.72rem; font-weight: normal;">(${row.subscriptionName})</span></div>`
            },
            {
                data: 'totalAmount',
                className: 'text-right align-middle',
                render: (d, t, row) => {
                    const sym = getCurrencySymbol(row.currency);
                    return `<span style="font-weight:600;color:var(--brand-primary);">${sym}${d.toFixed(2)}</span>`;
                }
            },
            {
                data: 'invoiceDate',
                className: 'text-center align-middle',
                render: d => {
                    const date = new Date(d);
                    const day = String(date.getDate()).padStart(2, '0');
                    const month = String(date.getMonth() + 1).padStart(2, '0');
                    const year = date.getFullYear();
                    const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                    const monthName = months[date.getMonth()];
                    return `<span class="inv-number-badge">${day} ${monthName} ${year}</span>`;
                }
            },
            {
                data: 'status',
                className: 'text-center align-middle',
                render: d => {
                    let cls = 'badge-neutral';
                    if (d === 'Paid') { cls = 'badge-success'; }
                    else if (d === 'Pending') { cls = 'badge-warning'; }
                    else if (d === 'Overdue') { cls = 'badge-error'; }
                    return `<span class="badge ${cls}">${d}</span>`;
                }
            },
            { data: 'subscriptionName', visible: false, className: 'text-left align-middle', render: d => d || '—' },
            { 
                data: 'dueDate', 
                visible: false, 
                className: 'text-center align-middle',
                render: d => { 
                    if(!d) return '—'; 
                    const date = new Date(d); 
                    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); 
                } 
            },
            { data: 'currency', visible: false, className: 'text-center align-middle', render: d => d || 'INR' },
            {
                data: null, orderable: false,
                className: 'text-center align-middle',
                render: function(d, t, row) {
                    let html = `<div class="inv-actions-wrapper" style="display: flex; justify-content: center; align-items: center; gap: 6px;">
                        <button class="action-btn action-btn-view" data-type="invoice" data-id="${row.id}" title="Details">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path></svg>
                        </button>`;
                    if (canPrintInvoice) {
                        html += `<button class="action-btn" title="Print" onclick="event.stopPropagation();window.open('/Billing/PrintInvoice?id=${row.id}','_blank')">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                        </button>`;
                    }
                    if (canRecordPayment) {
                        html += `<button class="action-btn" title="Record Payment" onclick="event.stopPropagation();openRecordPayment('${row.id}')">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                        </button>`;
                    }
                    html += `</div>`;
                    return html;
                }
            }
        ]
    });

    window.invoiceDt = dt;

    // Listen to xhr event to calculate and cache invoice counts
    $('#invoiceTable').on('xhr.dt', function (e, settings, json, xhr) {
        if (json && json.data) {
            const activeFilters = $panel.data('active-filters') || {};
            const currentStatus = activeFilters.Status;
            
            // Only count when Status filter is not active to get true totals
            if (typeof currentStatus === 'undefined' || currentStatus === '') {
                let paid = 0;
                let unpaid = 0;
                json.data.forEach(function (row) {
                    if (row.status === 'Paid') {
                        paid++;
                    } else if (row.status === 'Pending' || row.status === 'Overdue') {
                        unpaid++;
                    }
                });
                $panel.data('total-paid', paid);
                $panel.data('total-unpaid', unpaid);
                $panel.data('total-invoices', json.data.length);
            }
            
            // Update text elements safely
            $('#paidCount').text($panel.data('total-paid') || 0);
            $('#unpaidCount').text($panel.data('total-unpaid') || 0);
            $('#totalCount').text($panel.data('total-invoices') || 0);
        }
    });

    /* ── KPI Cards Click Routing ── */
    $('.sub-kpi-card').on('click', function () {
        const val = $(this).attr('data-value'); // "all", "1" or "0,2"
        const activeFilters = $panel.data('active-filters') || {};
        
        if (val === 'all') {
            delete activeFilters.Status;
        } else {
            if (activeFilters.Status === val) {
                delete activeFilters.Status;
            } else {
                activeFilters.Status = val;
            }
        }
        
        $panel.data('active-filters', activeFilters);
        const hasFilters = Object.keys(activeFilters).length > 0;
        $panel.find('.filter-trigger-btn').toggleClass('active', hasFilters);
        
        // Sync to select input inside filters repo
        const $repoFilter = $panel.find('.table-filters-repo [name="Status"], .table-filters-repo .filter-Status');
        if ($repoFilter.length) {
            const valArray = activeFilters.Status ? activeFilters.Status.split(',') : [];
            $repoFilter.val(valArray).trigger('change');
        }
        
        dt.draw();
    });

    // Sync KPI highlights if filter changes from filter drawer select
    $(document).on('change', '.table-filters-repo [name="Status"], .table-filters-repo .filter-Status', function () {
        const val = $(this).val(); // Could be array or string
        const activeFilters = $panel.data('active-filters') || {};
        
        // Extract selected Statuses
        let selectedVal = '';
        if (Array.isArray(val)) {
            if (val.includes('0') && val.includes('2')) {
                selectedVal = '0,2';
            } else if (val.length === 1) {
                selectedVal = val[0];
            }
        } else if (typeof val === 'string') {
            selectedVal = val;
        }
        
        $('.sub-kpi-card').removeClass('active');
        if (selectedVal === '1') {
            $('#kpiPaid').addClass('active');
        } else if (selectedVal === '0,2' || selectedVal === '0' || selectedVal === '2') {
            $('#kpiUnpaid').addClass('active');
        } else {
            $('#kpiTotal').addClass('active');
        }
    });

    // Cache all rows after each draw for the card list
    dt.on('draw', function () {
        allRows = dt.rows({ search: 'applied' }).data().toArray();
        if ($split.hasClass('detail-open')) {
            renderCardList(allRows);
        }
    });

    // ── Search / filter debounce ────────────────────────────────
    $panel.on('keyup input', '.search-input', function () {
        if ($split.hasClass('detail-open')) {
            cardPage = 0;
            renderCardList(allRows);
        }
    });

    // ── Row click (full table mode) ─────────────────────────────
    $('#invoiceTable tbody').on('click', 'tr', function (e) {
        if ($(e.target).is('input')) return;
        const row = dt.row(this).data();
        if (!row) return;
        openDetail(row.id, row, this);
    });

    // View button in full table
    $('#invoiceTable tbody').on('click', '.action-btn-view', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const id  = $(this).data('id');
        const row = dt.rows().data().toArray().find(r => r.id === id);
        if (row && typeof window.showDetailsDrawer === 'function') {
            window.showDetailsDrawer('invoice', row);
        }
    });

    // ── Card list click ─────────────────────────────────────────
    $cardList.on('click', '.inv-list-card', function () {
        const id  = $(this).data('id');
        const row = allRows.find(r => r.id === id);
        openDetail(id, row, null);
    });

    // ── Pagination (card list) ──────────────────────────────────
    $('#invPrevPage').on('click', function () {
        if (cardPage > 0) { cardPage--; renderCardList(allRows); }
    });
    $('#invNextPage').on('click', function () {
        if ((cardPage + 1) * cardPageSize < allRows.length) { cardPage++; renderCardList(allRows); }
    });

    // ── Close / keyboard ────────────────────────────────────────
    $('#detailCloseBtn, #drawerCloseBtn').on('click', closeDetail);
    $backdrop.on('click', closeDetail);
    $(document).on('keydown', e => { if (e.key === 'Escape' && currentId) closeDetail(); });

    // ── Header action buttons (detail pane) ────────────────────
    $('#detailPrintBtn').on('click', () => { if (currentId) window.open('/Billing/PrintInvoice?id=' + currentId, '_blank'); });
    $('#detailPayBtn').on('click',   () => { if (currentId) openRecordPayment(currentId); });
    $('#drawerPrintBtn').on('click', () => { if (currentId) window.open('/Billing/PrintInvoice?id=' + currentId, '_blank'); });
    $('#drawerPayBtn').on('click',   () => { if (currentId) openRecordPayment(currentId); });

    // ── Core: openDetail ────────────────────────────────────────
    function openDetail(id, rowData, trEl) {
        const isNewId = (id !== currentId);
        currentId = id;

        // Highlight in full table
        if (trEl) {
            $('#invoiceTable tbody tr').removeClass('selected-row');
            $(trEl).addClass('selected-row');
        }

        if (isMobile()) {
            openDrawer(id, rowData, isNewId);
        } else {
            openSplit(id, rowData, isNewId);
        }
    }

    function openSplit(id, rowData, isNewId) {
        if (!$split.hasClass('detail-open')) {
            $split.addClass('detail-open');

            // Restore saved width
            const savedW = localStorage.getItem('inv-list-width');
            if (savedW) $split[0].style.setProperty('--list-pane-width', savedW);

            // Cache & render card list from DataTable data
            allRows = dt.rows({ search: 'applied' }).data().toArray();
            renderCardList(allRows);
            $listFooter.show();
        }

        // Highlight card
        $cardList.find('.inv-list-card').removeClass('active');
        $cardList.find(`[data-id="${id}"]`).addClass('active');

        if (isNewId) {
            updateDetailHeader(rowData, false);
            showSkeleton($detailBody);
            loadDetail(id);
        }
    }

    function closeDetail() {
        $split.removeClass('detail-open');
        currentId = null;
        $('#invoiceTable tbody tr').removeClass('selected-row');
        $detailNum.text('—');
        $detailSub.text('Select an invoice from the list');
        $detailBody.html(emptyDetailHtml());
        $listFooter.hide();

        // Close drawer on mobile
        closeDrawer();
    }

    // ── Mobile drawer ───────────────────────────────────────────
    function openDrawer(id, rowData, isNewId) {
        $backdrop.addClass('visible').show();
        $drawer.addClass('open');

        if (rowData) {
            $drawerNum.text('#' + rowData.invoiceNumber);
            $drawerSub.text(rowData.tenantName + ' · ' + rowData.subscriptionName);
        }

        if (isNewId) {
            showSkeleton($drawerBody);
            loadDetail(id, true);
        }
    }

    function closeDrawer() {
        $drawer.removeClass('open');
        setTimeout(() => $backdrop.removeClass('visible').hide(), 280);
    }

    // ── Card list rendering ─────────────────────────────────────
    function renderCardList(rows) {
        const filtered = filterRows(rows);
        const start    = cardPage * cardPageSize;
        const page     = filtered.slice(start, start + cardPageSize);

        $countLabel.text(`${filtered.length} invoice${filtered.length !== 1 ? 's' : ''}`);

        if (filtered.length === 0) {
            $cardList.html('<div class="detail-empty" style="padding:30px 16px;"><span>No invoices found</span></div>');
            return;
        }

        let html = '';
        page.forEach(row => {
            const sym  = getCurrencySymbol(row.currency);
            const date = new Date(row.invoiceDate).toLocaleDateString();
            let stsCls = 'badge-neutral';
            if (row.status === 'Paid')    stsCls = 'badge-success';
            else if (row.status === 'Pending') stsCls = 'badge-warning';
            else if (row.status === 'Overdue') stsCls = 'badge-error';

            const isActive = (row.id === currentId) ? 'active' : '';
            html += `
            <div class="inv-list-card ${isActive}" data-id="${row.id}">
                <div class="inv-card-left">
                    <span class="inv-card-num">${row.invoiceNumber}</span>
                    <span class="inv-card-tenant">${row.tenantName}</span>
                    <span class="inv-card-date">${date}</span>
                </div>
                <div class="inv-card-right">
                    <span class="inv-card-amount">${sym}${row.totalAmount.toFixed(2)}</span>
                    <span class="badge ${stsCls}" style="font-size:0.6rem;">${row.status}</span>
                </div>
            </div>`;
        });
        $cardList.html(html);

        // Toggle page buttons
        $('#invPrevPage').prop('disabled', cardPage === 0);
        $('#invNextPage').prop('disabled', (cardPage + 1) * cardPageSize >= filtered.length);
    }

    function filterRows(rows) {
        const q = ($panel.find('.search-input').val() || '').toLowerCase();
        const activeFilters = $panel.data('active-filters') || {};
        const statusVal = activeFilters.Status;
        const sts = statusVal ? statusVal.split(',') : [];
        return rows.filter(r => {
            const matchQ = !q || r.invoiceNumber.toLowerCase().includes(q) || r.tenantName.toLowerCase().includes(q);
            const matchS = !sts || sts.length === 0 || sts.includes(getStatusNum(r.status).toString());
            return matchQ && matchS;
        });
    }

    function getStatusNum(s) {
        if (s === 'Pending') return 0;
        if (s === 'Paid')    return 1;
        if (s === 'Overdue') return 2;
        return 3;
    }

    // ── Detail content ──────────────────────────────────────────
    function updateDetailHeader(rowData, forDrawer) {
        if (!rowData) return;
        const prefix = '#' + rowData.invoiceNumber;
        const sub    = rowData.tenantName + ' · ' + rowData.subscriptionName + ' Plan';
        if (forDrawer) {
            $drawerNum.text(prefix);
            $drawerSub.text(sub);
        } else {
            $detailNum.text(prefix);
            $detailSub.text(sub);
        }
    }

    function loadDetail(id, isDrawer) {
        const $target = isDrawer ? $drawerBody : $detailBody;
        $.get('/Billing/GetInvoiceDetails', { id })
            .done(inv => {
                if (isDrawer) {
                    $drawerNum.text('#' + inv.invoiceNumber);
                    $drawerSub.text(inv.tenantName + ' · ' + inv.subscriptionName);
                } else {
                    $detailNum.text('#' + inv.invoiceNumber);
                    $detailSub.text(inv.tenantName + ' · ' + inv.subscriptionName + ' Plan');
                }

                const sym      = getCurrencySymbol(inv.currency);
                const issueDate = new Date(inv.invoiceDate).toLocaleDateString();
                const dueDate   = new Date(inv.dueDate).toLocaleDateString();
                let stsCls = 'badge-neutral';
                if (inv.status === 'Paid')    stsCls = 'badge-success';
                else if (inv.status === 'Pending') stsCls = 'badge-warning';
                else if (inv.status === 'Overdue') stsCls = 'badge-error';

                const html = `
                <!-- Invoice Details -->
                <div class="detail-section">
                    <div class="detail-section-label">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                        </svg>
                        Invoice Details
                    </div>
                    <div class="detail-kv-grid">
                        <div class="detail-kv-item">
                            <span class="detail-kv-key">Invoice Number</span>
                            <span class="detail-kv-val accent">${inv.invoiceNumber}</span>
                        </div>
                        <div class="detail-kv-item">
                            <span class="detail-kv-key">Status</span>
                            <span><span class="badge ${stsCls}">${inv.status}</span></span>
                        </div>
                        <div class="detail-kv-item">
                            <span class="detail-kv-key">Issue Date</span>
                            <span class="detail-kv-val">${issueDate}</span>
                        </div>
                        <div class="detail-kv-item">
                            <span class="detail-kv-key">Due Date</span>
                            <span class="detail-kv-val">${dueDate}</span>
                        </div>
                        <div class="detail-kv-item">
                            <span class="detail-kv-key">Tenant</span>
                            <span class="detail-kv-val">${inv.tenantName}</span>
                        </div>
                        <div class="detail-kv-item">
                            <span class="detail-kv-key">Plan</span>
                            <span class="detail-kv-val">${inv.subscriptionName}</span>
                        </div>
                        ${inv.billingAddress ? `
                        <div class="detail-kv-item" style="grid-column:1/-1;">
                            <span class="detail-kv-key">Billing Address</span>
                            <span class="detail-kv-val">${inv.billingAddress}</span>
                        </div>` : ''}
                        ${inv.tenantEmail ? `
                        <div class="detail-kv-item">
                            <span class="detail-kv-key">Email</span>
                            <span class="detail-kv-val">${inv.tenantEmail}</span>
                        </div>` : ''}
                        ${inv.tenantPhone ? `
                        <div class="detail-kv-item">
                            <span class="detail-kv-key">Phone</span>
                            <span class="detail-kv-val">${inv.tenantPhone}</span>
                        </div>` : ''}
                    </div>
                </div>

                <!-- Amount Breakdown -->
                <div class="detail-section">
                    <div class="detail-section-label">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M6 3h12M6 8h12M6 13h4a4 4 0 0 0 0-8M9 13l6 6"></path>
                        </svg>
                        Amount Breakdown
                    </div>
                    <div class="detail-amount-strip">
                        <div class="detail-amount-cell">
                            <span class="detail-amount-key">Subtotal</span>
                            <span class="detail-amount-val">${sym}${(inv.amount || 0).toFixed(2)}</span>
                        </div>
                        <div class="detail-amount-cell">
                            <span class="detail-amount-key">Tax (10%)</span>
                            <span class="detail-amount-val">${sym}${(inv.taxAmount || 0).toFixed(2)}</span>
                        </div>
                        <div class="detail-amount-cell">
                            <span class="detail-amount-key">Total Due</span>
                            <span class="detail-amount-val total">${sym}${(inv.totalAmount || 0).toFixed(2)}</span>
                        </div>
                    </div>
                </div>

                <!-- Transaction History -->
                <div class="detail-section">
                    <div class="detail-section-label">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                        </svg>
                        Transaction History
                    </div>
                    <div id="txnContent_${id}">
                        <div class="detail-loading">
                            <div class="spinner-ring"></div>
                            <span>Loading payments…</span>
                        </div>
                    </div>
                </div>`;

                $target.html(html);
                loadTransactions(id, sym);
            })
            .fail(() => {
                $target.html('<div class="detail-empty"><span style="color:var(--status-error);">Failed to load invoice.</span></div>');
            });
    }

    function loadTransactions(id, sym) {
        $.ajax({
            url : '/Billing/GetPayments',
            type: 'POST',
            data: {
                InvoiceId          : id,
                draw               : 1,
                start              : 0,
                length             : 50,
                'search[value]'    : '',
                'search[regex]'    : false,
                'order[0][column]' : 0,
                'order[0][dir]'    : 'desc'
            }
        }).done(function (res) {
            const $c  = $(`#txnContent_${id}`);
            const rows = res.data || [];
            if (!rows.length) {
                $c.html(`<div class="detail-empty" style="min-height:80px;">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" style="opacity:0.25;">
                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line>
                    </svg>
                    <span>No payments recorded yet</span>
                </div>`);
                return;
            }
            let t = `<table class="txn-table"><thead><tr>
                <th>Transaction ID</th><th>Date</th><th>Method</th><th>Amount</th><th>Status</th>
            </tr></thead><tbody>`;
            rows.forEach(p => {
                let sc = 'badge-neutral';
                if (p.status === 'Completed' || p.status === 'Paid') sc = 'badge-success';
                else if (p.status === 'Pending') sc = 'badge-warning';
                else if (p.status === 'Failed')  sc = 'badge-error';
                t += `<tr>
                    <td><span style="font-family:monospace;font-size:0.7rem;color:var(--text-muted);">${p.transactionId || '—'}</span></td>
                    <td style="white-space:nowrap;">${new Date(p.paymentDate).toLocaleDateString()}</td>
                    <td>${p.method || '—'}</td>
                    <td style="font-weight:600;color:var(--brand-primary);">${sym}${(p.amount||0).toFixed(2)}</td>
                    <td><span class="badge ${sc}">${p.status}</span></td>
                </tr>`;
            });
            t += '</tbody></table>';
            $c.html(t);
        }).fail(() => {
            $(`#txnContent_${id}`).html('<div class="detail-empty" style="min-height:60px;"><span>Could not load transactions.</span></div>');
        });
    }

    // ── Skeleton ────────────────────────────────────────────────
    function showSkeleton($el) {
        $el.html(`<div style="padding:16px;display:flex;flex-direction:column;gap:10px;">
            <div class="skel" style="height:13px;width:55%;"></div>
            <div class="skel" style="height:11px;width:38%;"></div>
            <div style="height:8px;"></div>
            <div class="skel" style="height:54px;border-radius:6px;"></div>
            <div class="skel" style="height:11px;width:65%;"></div>
            <div class="skel" style="height:11px;width:48%;"></div>
            <div style="height:8px;"></div>
            <div class="skel" style="height:110px;border-radius:6px;"></div>
        </div>`);
    }

    function emptyDetailHtml() {
        return `<div class="detail-empty">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" style="opacity:0.2;">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
            <span>Click an invoice row to view details</span>
        </div>`;
    }

    function getCurrencySymbol(code) {
        if (code === 'INR') return '₹';
        if (code === 'USD') return '$';
        if (code === 'EUR') return '€';
        if (code === 'GBP') return '£';
        return code ? code + ' ' : '₹';
    }

    // ════════════════════════════════════════════════════════
    //  DRAGGABLE RESIZER
    // ════════════════════════════════════════════════════════
    (function initResizer() {
        const resizer  = document.getElementById('invResizer');
        const listPane = document.getElementById('invListPane');
        const splitEl  = document.getElementById('invoiceSplit');
        let isDragging = false;
        let startX, startW;

        resizer.addEventListener('mousedown', function (e) {
            e.preventDefault();
            isDragging = true;
            startX = e.clientX;
            startW = listPane.getBoundingClientRect().width;
            resizer.classList.add('dragging');
            document.body.style.cursor = 'col-resize';
            document.body.style.userSelect = 'none';
        });

        document.addEventListener('mousemove', function (e) {
            if (!isDragging) return;
            const totalW = splitEl.getBoundingClientRect().width;
            const delta  = e.clientX - startX;
            let newW     = startW + delta;
            // clamp: 220px – 55%
            newW = Math.max(220, Math.min(newW, totalW * 0.55));
            const pct = ((newW / totalW) * 100).toFixed(2) + '%';
            splitEl.style.setProperty('--list-pane-width', pct);
        });

        document.addEventListener('mouseup', function () {
            if (!isDragging) return;
            isDragging = false;
            resizer.classList.remove('dragging');
            document.body.style.cursor = '';
            document.body.style.userSelect = '';
            // Persist
            const w = getComputedStyle(splitEl).getPropertyValue('--list-pane-width').trim();
            if (w) localStorage.setItem('inv-list-width', w);
        });

        // Touch support
        resizer.addEventListener('touchstart', function (e) {
            e.preventDefault();
            isDragging = true;
            startX = e.touches[0].clientX;
            startW = listPane.getBoundingClientRect().width;
        }, { passive: false });

        document.addEventListener('touchmove', function (e) {
            if (!isDragging) return;
            const totalW = splitEl.getBoundingClientRect().width;
            const delta  = e.touches[0].clientX - startX;
            let newW     = startW + delta;
            newW = Math.max(220, Math.min(newW, totalW * 0.55));
            const pct = ((newW / totalW) * 100).toFixed(2) + '%';
            splitEl.style.setProperty('--list-pane-width', pct);
        });

        document.addEventListener('touchend', function () { isDragging = false; });
    })();

    // Responsive: recalculate on window resize
    window.addEventListener('resize', function () {
        if (!isMobile() && $split.hasClass('detail-open')) {
            $cardList.show();
        }
    });

    // Initialize row selection for smart export
    window.initRowSelection('invoiceTable', 'id');
});

function openRecordPayment(invoiceId) {
    window.openModal({
        title   : 'Record Payment',
        subtitle: 'Process a payment for this invoice',
        icon    : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>',
        url     : '/Billing/RecordPayment?invoiceId=' + invoiceId
    });
}
</script>
