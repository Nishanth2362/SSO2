@using SSO.Application.Responses.Billing

@{
    ViewData["Title"] = "Invoices";
}

<div class="breadcrumbs">
    <span>Auxinz Identity</span>
    <a href="#">Multi-Tenancy</a>
    <span class="current">Billing & Invoices</span>
</div>

<div class="page-header">
    <div>
        <h1>Subscription Invoices</h1>
        <p style="color: var(--text-muted); margin-top: 4px;">
            Track tenant billing cycles, outstanding payments, and financial history.
        </p>
    </div>
    <div style="display: flex; gap: 12px;">
        <a href="/Billing/Payments" class="btn btn-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                <line x1="1" y1="10" x2="23" y2="10"></line>
            </svg>
            All Payments
        </a>
        <a href="/Billing/ExportInvoices" class="btn btn-secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Export Excel
        </a>
    </div>
</div>

<div class="panel">
    <div class="table-toolbar">
        <div class="table-filters">
            <div style="position: relative;">
                <svg style="position: absolute; left: 10px; top: 10px; color: var(--text-muted);"
                     width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" class="form-input" placeholder="Search Invoice # or Tenant..."
                       style="padding-left: 32px; width: 250px;">
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table id="invoiceTable" class="data-table table-hoverable manual-init">
            <thead>
                <tr>
                    <th style="width: 48px;"><input type="checkbox" class="custom-checkbox"></th>
                    <th>Invoice #</th>
                    <th>Tenant</th>
                    <th>Amount</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        const $panel = $('#invoiceTable').closest('.panel');
        const $customSearch = $panel.find('.table-toolbar .form-input');

        const dt = $('#invoiceTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '/Billing/GetInvoices',
                type: 'POST',
                data: function (d) {
                    if ($customSearch.length > 0) {
                        d.customSearchValue = $customSearch.val();
                    }
                }
            },
            responsive: true,
            dom: '<"table-toolbar datatables-injected"<"table-filters"l>f>t<"pagination"ip>',
            columns: [
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function () { return '<input type="checkbox" class="custom-checkbox">'; }
                },
                {
                    data: 'invoiceNumber',
                    render: function (data) {
                        return `<span style="font-family: monospace; font-weight: 600;">${data}</span>`;
                    }
                },
                {
                    data: 'tenantName',
                    render: function (data, type, row) {
                        return `<div class="cell-text"><h5>${data}</h5><p>${row.subscriptionName}</p></div>`;
                    }
                },
                {
                    data: 'totalAmount',
                    render: function (data, type, row) {
                        const symbol = getCurrencySymbol(row.currency);
                        return `<span style="font-weight: 600; color: var(--brand-primary);">${symbol}${data.toFixed(2)}</span>`;
                    }
                },
                {
                    data: 'invoiceDate',
                    render: function (data) {
                        return new Date(data).toLocaleDateString();
                    }
                },
                {
                    data: 'status',
                    render: function (data) {
                        let badgeClass = 'badge-neutral';
                        if (data === 'Paid') badgeClass = 'badge-success';
                        else if (data === 'Pending') badgeClass = 'badge-warning';
                        else if (data === 'Overdue') badgeClass = 'badge-error';
                        return `<span class="badge ${badgeClass}">${data}</span>`;
                    }
                },
                {
                    data: null,
                    orderable: false,
                    render: function (data, type, row) {
                        return `<div style="text-align: right; display: flex; gap: 4px; justify-content: flex-end;">
                                    <button class="action-btn" title="Print Invoice" onclick="window.open('/Billing/PrintInvoice?id=${row.id}', '_blank')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg></button>
                                    <button class="action-btn" title="Record Payment" onclick="openRecordPayment('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg></button>
                                    <button class="action-btn" title="View Payments" onclick="window.location.href='/Billing/Payments?InvoiceId=${row.id}'"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg></button>
                                </div>`;
                    }
                }
            ]
        });

        function getCurrencySymbol(code) {
            if (code === 'INR') return '₹';
            if (code === 'USD') return '$';
            if (code === 'EUR') return '€';
            if (code === 'GBP') return '£';
            return code ? code + ' ' : '₹';
        }

        // Store reference for reload after payment
        window.invoiceDt = dt;

        if ($customSearch.length > 0) {
            let searchTimeout;
            $customSearch.on('keyup', function () {
                clearTimeout(searchTimeout);
                const val = this.value;
                searchTimeout = setTimeout(() => {
                    dt.search(val).draw();
                }, 400);
            });
        }
    });

    function openRecordPayment(invoiceId) {
        window.openModal({
            title: 'Record Payment',
            subtitle: 'Process a payment for this invoice',
            icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>',
            url: '/Billing/RecordPayment?invoiceId=' + invoiceId
        });
    }
</script>
