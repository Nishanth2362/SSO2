@using SSO.Application.Responses.Billing

@{
    ViewData["Title"] = "Payments";
    var invoiceId = ViewBag.InvoiceId as Guid?;
}

<div class="breadcrumbs">
    <span>Auxinz Identity</span>
    <a href="/Billing/Invoices">Billing</a>
    <span class="current">Payments</span>
</div>

<div class="page-header">
    <div>
        <h1>Transaction History</h1>
        <p style="color: var(--text-muted); margin-top: 4px;">
            Process subscription payments and manage transaction records.
        </p>
    </div>
    <div style="display: flex; gap: 12px;">
        <a href="/Billing/ExportPayments" class="btn btn-secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Export Excel
        </a>
        <a href="/Billing/Invoices" class="btn btn-ghost">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Back to Invoices
        </a>
    </div>
</div>

<div class="panel">
    <div class="table-toolbar">
        <div class="table-filters">
            <div style="position: relative;">
                <svg style="position: absolute; left: 10px; top: 10px; color: var(--text-muted);"
                     width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" class="form-input" placeholder="Search Transaction ID or Tenant..."
                       style="padding-left: 32px; width: 280px;">
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table id="paymentTable" class="data-table table-hoverable manual-init">
            <thead>
                <tr>
                    <th style="width: 48px;"><input type="checkbox" class="custom-checkbox"></th>
                    <th>Transaction ID</th>
                    <th>Invoice</th>
                    <th>Tenant</th>
                    <th>Amount</th>
                    <th>Method</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        const invoiceId = '@(invoiceId?.ToString() ?? "")';
        const $panel = $('#paymentTable').closest('.panel');
        const $customSearch = $panel.find('.table-toolbar .form-input');

        const dt = $('#paymentTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '/Billing/GetPayments' + (invoiceId ? '?InvoiceId=' + invoiceId : ''),
                type: 'POST',
                data: function (d) {
                    if ($customSearch.length > 0) {
                        d.customSearchValue = $customSearch.val();
                    }
                }
            },
            responsive: true,
            dom: '<"table-toolbar datatables-injected"<"table-filters"l>f>t<"pagination"ip>',
            order: [[6, 'desc']],
            columns: [
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function () { return '<input type="checkbox" class="custom-checkbox">'; }
                },
                {
                    data: 'transactionId',
                    render: function (data) {
                        return `<span style="font-family: monospace; font-weight: 600; font-size: 13px;">${data}</span>`;
                    }
                },
                {
                    data: 'invoiceNumber',
                    render: function (data, type, row) {
                        return `<a href="/Billing/PrintInvoice?id=${row.invoiceId}" style="color: var(--brand-primary); text-decoration: none; font-weight: 500;">${data}</a>`;
                    }
                },
                {
                    data: 'tenantName',
                    render: function (data) {
                        return `<span style="font-weight: 500;">${data}</span>`;
                    }
                },
                {
                    data: 'amount',
                    render: function (data) {
                        return `<span style="font-weight: 600; color: var(--brand-primary);">$${data.toFixed(2)}</span>`;
                    }
                },
                {
                    data: 'method',
                    render: function (data) {
                        const icons = {
                            'CreditCard': '💳',
                            'PayPal': '🌐',
                            'BankTransfer': '🏦',
                            'Cash': '💵',
                            'Check': '🧾',
                            'Other': '📋'
                        };
                        const icon = icons[data] || '💳';
                        return `<span>${icon} ${data}</span>`;
                    }
                },
                {
                    data: 'paymentDate',
                    render: function (data) {
                        return new Date(data).toLocaleDateString();
                    }
                },
                {
                    data: 'status',
                    render: function (data) {
                        let badgeClass = 'badge-neutral';
                        if (data === 'Completed') badgeClass = 'badge-success';
                        else if (data === 'Pending') badgeClass = 'badge-warning';
                        else if (data === 'Failed') badgeClass = 'badge-error';
                        else if (data === 'Refunded') badgeClass = 'badge-neutral';
                        return `<span class="badge ${badgeClass}">${data}</span>`;
                    }
                }
            ]
        });

        if ($customSearch.length > 0) {
            let searchTimeout;
            $customSearch.on('keyup', function () {
                clearTimeout(searchTimeout);
                const val = this.value;
                searchTimeout = setTimeout(() => {
                    dt.search(val).draw();
                }, 400);
            });
        }
    });
</script>
