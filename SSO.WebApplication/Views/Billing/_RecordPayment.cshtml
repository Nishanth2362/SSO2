@using SSO.Application.Features.Payments.Commands.AddEdit
@using SSO.Domain.Entities
@model RecordPaymentCommand

<form id="recordPaymentForm">
    <input type="hidden" name="InvoiceId" value="@Model.InvoiceId" />

    <div style="display: flex; flex-direction: column; gap: 20px; padding: 4px 0;">

        <!-- Amount -->
        <div class="form-group">
            <label class="form-label">Payment Amount</label>
            <div style="position: relative;">
                <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-weight: 600;">
                    @(Model.Currency == "INR" ? "₹" : Model.Currency == "USD" ? "$" : Model.Currency == "EUR" ? "€" : "£")
                </span>
                <input type="number" step="0.01" name="Amount" value="@Model.Amount.ToString("F2")"
                       class="form-input" style="padding-left: 28px;" required
                       id="paymentAmount" />
            </div>
        </div>

        <!-- Payment Method -->
        <div class="form-group">
            <label class="form-label">Payment Method</label>
            <select name="Method" class="form-select" id="paymentMethod" onchange="toggleOfflineFields(this.value)">
                <optgroup label="Online">
                    <option value="0">💳 Credit / Debit Card</option>
                    <option value="1">🌐 PayPal</option>
                    <option value="2">🏦 Bank Transfer</option>
                </optgroup>
                <optgroup label="Offline">
                    <option value="3">💵 Cash</option>
                    <option value="4">🧾 Cheque</option>
                    <option value="5">📋 Other</option>
                </optgroup>
            </select>
        </div>

        <!-- Reference / Transaction ID -->
        <div class="form-group">
            <label class="form-label" id="refLabel">Transaction Reference</label>
            <input type="text" name="TransactionId" class="form-input" id="transactionId"
                   placeholder="e.g. TXN-123456 / Cheque #9001" />
            <p class="form-hint" id="refHint" style="margin-top: 6px; font-size: 12px; color: var(--text-muted);">
                Optional for offline payments. Auto-generated if left blank.
            </p>
        </div>

        <!-- Offline-specific: Received By -->
        <div class="form-group" id="receivedByGroup" style="display: none;">
            <label class="form-label">Received By</label>
            <input type="text" name="ReceivedBy" class="form-input"
                   placeholder="Name of person who collected the payment" />
        </div>

        <!-- Payment Date -->
        <div class="form-group">
            <label class="form-label">Payment Date</label>
            <input type="date" name="PaymentDate" class="form-input"
                   value="@DateTime.Now.ToString("yyyy-MM-dd")" required id="paymentDate" />
        </div>

        <!-- Offline info callout -->
        <div id="offlineNote" style="display: none; background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.25); border-radius: 8px; padding: 14px 16px;">
            <div style="display: flex; gap: 10px; align-items: flex-start;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" style="flex-shrink:0; margin-top:1px;">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                <div style="font-size: 13px; color: var(--text-muted); line-height: 1.6;">
                    <strong style="color: #f59e0b;">Offline Payment</strong><br>
                    Ensure you have collected physical proof (receipt, cheque, deposit slip) before recording this payment. 
                    The invoice will be <strong>marked as Paid</strong> immediately.
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 8px;">
            <button type="button" class="btn btn-ghost" onclick="window.closeModal && window.closeModal()">Cancel</button>
            <button type="submit" class="btn btn-primary" id="paymentSubmitBtn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 11 12 14 22 4"></polyline>
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                </svg>
                Record Payment
            </button>
        </div>
    </div>
</form>

<script>
    function toggleOfflineFields(value) {
        // 3 = Cash, 4 = Check, 5 = Other
        const isOffline = ['3', '4', '5'].includes(String(value));
        document.getElementById('offlineNote').style.display = isOffline ? 'block' : 'none';
        document.getElementById('receivedByGroup').style.display = isOffline ? 'block' : 'none';
        document.getElementById('refLabel').textContent = isOffline ? 'Cheque # / Receipt #' : 'Transaction Reference';
        document.getElementById('refHint').textContent = isOffline
            ? 'Enter cheque number or physical receipt reference.'
            : 'Optional for online payments. Auto-generated if left blank.';
    }

    document.getElementById('recordPaymentForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        if (!window.validateAjaxForm(this)) {
            return;
        }

        const btn = document.getElementById('paymentSubmitBtn');
        btn.disabled = true;
        btn.innerHTML = '<span>Processing...</span>';

        const form = e.target;
        const data = {
            invoiceId: form.InvoiceId.value,
            amount: parseFloat(form.Amount.value),
            method: parseInt(form.Method.value),
            transactionId: form.TransactionId.value,
            paymentDate: form.PaymentDate.value,
        };

        try {
            const response = await fetch('/Billing/RecordPayment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' },
                body: JSON.stringify(data)
            });
            const result = await response.json();

            if (result.succeeded) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ title: 'Payment Recorded!', text: result.messages?.[0] || 'Invoice marked as paid.', icon: 'success', confirmButtonText: 'Done' })
                        .then(() => { window.closeModal && window.closeModal(); window.invoiceDt && window.invoiceDt.ajax.reload(); });
                } else {
                    alert('Payment recorded successfully!');
                    window.closeModal && window.closeModal();
                    window.invoiceDt && window.invoiceDt.ajax.reload();
                }
            } else {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ title: 'Error', text: result.messages?.[0] || 'Failed to record payment.', icon: 'error' });
                } else {
                    alert('Error: ' + (result.messages?.[0] || 'Failed.'));
                }
                btn.disabled = false;
                btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg> Record Payment';
            }
        } catch (err) {
            window.showRequestError({
                title: 'Unable to Record Payment',
                fallbackMessage: 'We could not record this payment right now. Please try again.'
            });
            btn.disabled = false;
            btn.innerHTML = 'Record Payment';
        }
    });

    // Trigger on load to set initial state
    toggleOfflineFields(document.getElementById('paymentMethod').value);
</script>
