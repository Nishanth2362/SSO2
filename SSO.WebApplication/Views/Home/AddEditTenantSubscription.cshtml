@using SSO.Application.Responses.Features
@model SSO.Application.Features.TenentSubscriptions.Commands.AddEdit.AddEditTenantSubscriptionCommand
@{
    Layout = null;
    var subscriptions = ViewBag.Subscriptions as List<SubscriptionResponse>;
}

<style>
    .provision-modal-content {
        padding: 8px 4px;
    }
    .input-with-icon {
        position: relative;
        display: flex;
        align-items: center;
    }
    .input-with-icon svg {
        position: absolute;
        left: 12px;
        color: var(--text-muted);
        pointer-events: none;
    }
    .input-with-icon .form-input, 
    .input-with-icon .form-select {
        padding-left: 38px;
    }
    .date-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 24px;
    }
    .plan-info-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 24px;
        display: flex;
        align-items: flex-start;
        gap: 16px;
        transition: all 0.2s ease;
    }
    .plan-info-card:focus-within {
        border-color: var(--brand-primary);
        background: rgba(var(--brand-primary-rgb), 0.05);
    }
    .status-toggle-wrapper {
        background: rgba(255,255,255,0.02);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 16px;
        margin-top: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .form-section-title {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        margin-bottom: 12px;
        display: block;
    }

    @@media (max-width: 576px) {
        .date-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="provision-modal-content">
    <form id="addEditTenantSubscriptionForm" class="modal-form">
        <input type="hidden" id="Id" asp-for="Id" />
        <input type="hidden" id="TenantId" asp-for="TenantId" />

        <span class="form-section-title">ENTITLEMENT TIER</span>
        <div class="plan-info-card">
            <div style="padding: 10px; background: rgba(var(--brand-primary-rgb), 0.1); border-radius: 10px; color: var(--brand-primary);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
                </svg>
            </div>
            <div style="flex: 1;">
                <label class="form-label" style="margin-bottom: 8px;">Select Subscription Plan</label>
                <div class="input-with-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <select id="SubscriptionId" asp-for="SubscriptionId" class="form-select" required>
                        <option value="">Choose a plan...</option>
                        @if (subscriptions != null)
                        {
                            foreach (var sub in subscriptions)
                            {
                                <option value="@sub.Id">@sub.Name</option>
                            }
                        }
                    </select>
                </div>
                <p class="form-hint" style="margin-top: 8px; margin-bottom: 0;">This defines the features and limits unlocked for the tenant.</p>
            </div>
        </div>

        <span class="form-section-title">VALIDITY PERIOD</span>
        <div class="date-grid">
            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">Activation Date</label>
                <div class="input-with-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <input type="date" id="StartDateUtc" asp-for="StartDateUtc" class="form-input" required />
                </div>
            </div>
            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">Expiration Date</label>
                <div class="input-with-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                    <input type="date" id="EndDateUtc" asp-for="EndDateUtc" class="form-input" required />
                </div>
            </div>
        </div>

        <div class="status-toggle-wrapper">
            <div>
                <label class="form-label" style="margin-bottom: 4px; display: block;">Set as Primary Plan</label>
                <span class="form-hint">Automatically deactivates any existing active plans for this tenant.</span>
            </div>
            <div class="custom-checkbox-wrapper">
                <input type="checkbox" asp-for="IsActive" class="custom-checkbox" id="IsActiveProvision" />
            </div>
        </div>

        <div class="modal-actions" style="margin-top: 32px; display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid var(--border-color); padding-top: 24px;">
            <button type="button" class="btn btn-secondary" onclick="window.closeModal()">Dismiss</button>
            <button id="AddTenantSubs" type="submit" class="btn btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                Confirm Provisioning
            </button>
        </div>
    </form>
</div>

<script>
    $(document).ready(function() {
        // Set default dates if new
        if (!$('#Id').val() || $('#Id').val() === '00000000-0000-0000-0000-000000000000') {
            const today = new Date().toISOString().split('T')[0];
            const nextYear = new Date();
            nextYear.setFullYear(nextYear.getFullYear() + 1);
            const nextYearStr = nextYear.toISOString().split('T')[0];
            
            if (!$('#StartDateUtc').val()) $('#StartDateUtc').val(today);
            if (!$('#EndDateUtc').val()) $('#EndDateUtc').val(nextYearStr);
        }

        $('#addEditTenantSubscriptionForm').off('submit').on('submit', function (e) {
            e.preventDefault();
            if (!window.validateAjaxForm(this)) {
                return;
            }

            const $btn = $('#AddTenantSubs');
            const originalHtml = $btn.html();
            
            // Validation
            const start = new Date($('#StartDateUtc').val());
            const end = new Date($('#EndDateUtc').val());
            
            if (end <= start) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Invalid Dates',
                    text: 'Expiration date must be after the activation date.'
                });
                return;
            }

            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...');
            
            const formData = $(this).serialize();
            $.post('/Home/AddEditTenantSubscription', formData, function(result) {
                if (result.succeeded) {
                    if (window.onModalSuccess) {
                        window.onModalSuccess(result);
                    }
                    window.closeModal();
                    Swal.fire({
                        icon: 'success',
                        title: 'Provisioned!',
                        text: 'Subscription plan updated successfully.',
                        timer: 2000,
                        showConfirmButton: false
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Provisioning Failed',
                        text: window.getPrimaryResultMessage(result, 'Check your inputs and try again.')
                    });
                    $btn.prop('disabled', false).html(originalHtml);
                }
            }).fail(function(xhr) {
                window.showRequestError({
                    title: 'Unable to Update Subscription',
                    xhr: xhr,
                    fallbackMessage: 'We could not process the subscription update right now. Please try again.'
                });
                $btn.prop('disabled', false).html(originalHtml);
            });
        });
    });
</script>

