
@{
    ViewData["Title"] = "Clients";
    var canCreateClient = (await AuthorizationService.AuthorizeAsync(User, Permissions.Client.Create)).Succeeded;
    var canExportClient = (await AuthorizationService.AuthorizeAsync(User, Permissions.Client.Export)).Succeeded || (await AuthorizationService.AuthorizeAsync(User, Permissions.Client.View)).Succeeded;
    var canEditClient = (await AuthorizationService.AuthorizeAsync(User, Permissions.Client.Edit)).Succeeded;
    var canDeleteClient = (await AuthorizationService.AuthorizeAsync(User, Permissions.Client.Delete)).Succeeded;
    var canImportScopes = (await AuthorizationService.AuthorizeAsync(User, Permissions.Scope.Import)).Succeeded;
}

<style>
