    .hero-bg-icon.icon-code-1     { top: 10%; left: 22%; width: 28px; height: 28px; transform: rotate(-10deg); }
    .hero-bg-icon.icon-box-1      { top: 62%; left: 44%; width: 26px; height: 26px; transform: rotate(-14deg); }
    .hero-bg-icon.icon-server-1   { top: 12%; right: 44%; width: 28px; height: 28px; transform: rotate(18deg); }
