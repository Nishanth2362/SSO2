<script type="text/javascript">


    $(function () {
        const $panel = $('#clientTable').closest('.panel');
        const $customSearch = $panel.find('.table-toolbar .form-input[placeholder*="Filter"], .table-toolbar .form-input[placeholder*="Search"]');
        const $customFilters = $panel.find('.table-toolbar .form-select');
        const canEditClient = @canEditClient.ToString().ToLower();
        const canDeleteClient = @canDeleteClient.ToString().ToLower();
        const canImportScopes = @canImportScopes.ToString().ToLower();

        window.setClientTypeFilter = function (val) {
            $('.client-type-btn').removeClass('active btn-secondary').addClass('btn-outline-secondary');
            $(`.client-type-btn[data-type="${val}"]`).removeClass('btn-outline-secondary').addClass('active btn-secondary');
            const activeFilters = $panel.data('active-filters') || {};
            if (!val) {
                delete activeFilters['AppClientType'];
            } else {
                activeFilters['AppClientType'] = val;
            }
            $panel.data('active-filters', activeFilters);
            const $select = $panel.find('.table-filters-repo .filter-AppClientType');
            if ($select.length) {
                $select.val(val);
            }
            if (dt) dt.ajax.reload();
        };

        const dt = $('#clientTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '/Home/GetClients',
                type: 'POST',
                data: function (d) {
                    const activeFilters = $panel.data('active-filters') || {};
                    if (activeFilters['AppClientType']) {
                        d.filter_AppClientType = activeFilters['AppClientType'];
                    } else {
                        const $typeFilter = $panel.find('.table-filters-repo [name="filter-AppClientType"], .table-filters-repo .filter-AppClientType');
                        if ($typeFilter.length && $typeFilter.val()) {
                            const val = $typeFilter.val();
                            d.filter_AppClientType = Array.isArray(val) ? val.join(',') : val;
                        }
                    }
                    if (activeFilters['IsActive']) {
                        d.filter_IsActive = activeFilters['IsActive'];
                    } else {
                        const $statusFilter = $panel.find('.table-filters-repo [name="filter-IsActive"], .table-filters-repo .filter-IsActive');
                        if ($statusFilter.length && $statusFilter.val()) {
                            const val = $statusFilter.val();
                            d.filter_IsActive = Array.isArray(val) ? val.join(',') : val;
                        }
                    }
                    if ($customSearch.length > 0 && $customSearch.val()) {
                        d.customSearchValue = $customSearch.val();
                        d.search = d.search || {};
                        d.search.value = $customSearch.val();
                    }
                }
            },
            language: {
                search: "",
                searchPlaceholder: "Search records..."
            },
            responsive: false,
            dom: '<"table-toolbar datatables-injected"<"table-filters">f>t<"if-table-footer-wrap"<"footer-right"<"if-pill-pagination-mount">>>',
            drawCallback: function(settings) {
                const api = this.api();
                const rows = api.rows({ page: 'current' }).data();
                const json = api.ajax.json();

                // Sync KPI highlights and counts
                const activeFilters = $panel.data('active-filters') || {};
                $('.sub-kpi-card').removeClass('active');
                if (activeFilters.IsActive === 'true') {
                    $('#kpiActiveClients').addClass('active');
                } else if (activeFilters.IsActive === 'false') {
                    $('#kpiInactiveClients').addClass('active');
                } else {
                    $('#kpiTotalClients').addClass('active');
                }

                if (json) {
                    const total = json.recordsTotal || rows.length;
                    
                    // Self-correcting count logic
                    if (typeof activeFilters.IsActive === 'undefined' || activeFilters.IsActive === '') {
                        let activeCount = 0;
                        rows.each(function(r) {
                            if (r.isActive || r.IsActive) activeCount++;
                        });
                        
                        if (rows.length === total) {
                            $panel.data('total-clients-kpi', total);
                            $panel.data('active-clients-kpi', activeCount);
                            $panel.data('inactive-clients-kpi', total - activeCount);
                        } else {
                            const ratio = rows.length > 0 ? (activeCount / rows.length) : 0;
                            const approxActive = Math.round(ratio * total) || 0;
                            $panel.data('total-clients-kpi', total);
                            $panel.data('active-clients-kpi', approxActive);
                            $panel.data('inactive-clients-kpi', total - approxActive);
                        }
                    } else if (activeFilters.IsActive === 'true') {
                        $panel.data('active-clients-kpi', json.recordsFiltered);
                    } else if (activeFilters.IsActive === 'false') {
                        $panel.data('inactive-clients-kpi', json.recordsFiltered);
                    }

                    const totalVal = $panel.data('total-clients-kpi') || total || 0;
                    const activeVal = $panel.data('active-clients-kpi') || 0;
                    const inactiveVal = $panel.data('inactive-clients-kpi') || 0;

                    $('#totalClientsCount, #totalClientsCountKpi').text(totalVal);
                    $('#activeClientsCount, #activeClientsCountKpi').text(activeVal);
                    $('#inactiveClientsCountKpi').text(inactiveVal);
                }

                // Render standardized pill pagination
                window.renderPillPagination(api, '.if-pill-pagination-mount', 'applications');

                // Render grid view with current page data
                renderClientGridView(rows.toArray());

                // Sync footer when grid is active
                var _sCView = localStorage.getItem('view-mode-clientTable') || 'list';
                if (_sCView === 'grid') {
                    var $cF = $panel.find('.if-table-footer-wrap');
                    if ($cF.length) $panel.append($cF);
                }
            },
            columns: [
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: 'text-center align-middle',
                    render: function (data, type, row) {
                        return '<input type="checkbox" class="row-select-cb" data-row-id="' + (row.id || '') + '">';
                    }
                },
                {
                    data: 'name',
                    className: 'text-left align-middle',
                    render: function (data, type, row) {
                        return ` <div class="cell-flex">
                                    <div class="cell-avatar primary">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                            stroke-linejoin="round">
                                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                        </svg>
                                    </div>
                                    <div class="cell-text">
                                         <h5>${data || 'Unknown Tenant'}</h5>
                                        <p>${row.clientId || 'No Code'}</p>
                                    </div>
                                </div>`;
                    }
                },
                {
                    data: 'clientType',
                    className: 'text-center align-middle',
                    render: function (data, type, row) {
                        return `<span class="badge badge-neutral">${row.appClientType} / ${data || 'Standard'} </span>`;
                    }
                },
                {
                    data: 'scopes',
                    orderable: false,
                    className: 'text-left align-middle',
                    render: function (data) {
                        return `<div class="cell-text"><h5 style="color: var(--brand-primary);">${data}</h5></div>`;
                    }
                },
                {
                    data: 'isActive',
                    className: 'text-center align-middle',
                    render: function (data) {
                        return data ? '<span class="badge badge-success">Active</span>' : '<span class="badge badge-error">Disabled</span>';
                    }
                },
                { data: 'clientId', visible: false, className: 'text-left align-middle', render: function(d){ return d || '—'; } },
                { data: 'clientType', visible: false, className: 'text-center align-middle', render: function(d){ return d || 'Confidential'; } },
                { data: 'audience', visible: false, className: 'text-left align-middle', render: function(d){ return d || '—'; } },
                { 
                    data: 'require2FA', 
                    visible: false, 
                    className: 'text-center align-middle',
                    render: function(d){ 
                        return d 
                            ? '<span class="badge badge-warning">Required</span>' 
                            : '<span class="badge badge-neutral">Off</span>'; 
                    } 
                },
                { data: 'allowedLoginMethod', visible: false, className: 'text-center align-middle', render: function(d){ return d || 'CredentialsOnly'; } },
                { 
                    data: 'allowPublicRegistration', 
                    visible: false, 
                    className: 'text-center align-middle',
                    render: function(d){ 
                        return d 
                            ? '<span class="badge badge-success">Allowed</span>' 
                            : '<span class="badge badge-neutral">Off</span>'; 
                    } 
                },
                { data: 'defaultRoleName', visible: false, className: 'text-left align-middle', render: function(d){ return d || 'End User'; } },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: 'text-center align-middle',
                    render: function (data, type, row) {
                        let html = `<div style="display: flex; align-items: center; justify-content: center; gap: 8px;">
                                    <button class="action-btn action-btn-view" title="View Details" data-type="client" data-id="${row.id}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path></svg></button>`;
                        if (canImportScopes) {
                            html += `<button class="action-btn action-btn-import" title="Import Scopes/Permissions" onclick="openImportScopesModal('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg></button>`;
                        }
                        if (canEditClient) {
                            html += `<button class="action-btn action-btn-edit" title="Edit Client" onclick="editClient('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></button>`;
                        }
                        if (canDeleteClient) {
                            html += `<button class="action-btn action-btn-delete" title="Delete Client" onclick="deleteClient('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>`;
                        }
                        html += `</div>`;
                        return html;
                    }
                }
            ]
        });

        if ($customSearch.length > 0) {
            let searchTimeout;
            $customSearch.on('keyup', function () {
                clearTimeout(searchTimeout);
                const val = this.value;
                searchTimeout = setTimeout(() => {
                    dt.search(val).draw();
                }, 400);
            });
        }

        if ($customFilters.length > 0) {
            $customFilters.on('change', function () {
                dt.ajax.reload();
            });
        }

        $('#openCreateClientModal').on('click', function() {
            openClientModal();
        });

        // Initialize row selection for smart export
        window.initRowSelection('clientTable', 'id');

        /* ── KPI Cards Click Routing ── */
        $('.sub-kpi-card').on('click', function () {
            const id = $(this).attr('id');
            const activeFilters = $panel.data('active-filters') || {};
            
            if (id === 'kpiTotalClients') {
                delete activeFilters.IsActive;
            } else if (id === 'kpiActiveClients') {
                if (activeFilters.IsActive === 'true') {
                    delete activeFilters.IsActive;
                } else {
                    activeFilters.IsActive = 'true';
                }
            } else if (id === 'kpiInactiveClients') {
                if (activeFilters.IsActive === 'false') {
                    delete activeFilters.IsActive;
                } else {
                    activeFilters.IsActive = 'false';
                }
            }
            
            $panel.data('active-filters', activeFilters);
            const hasFilters = Object.keys(activeFilters).length > 0;
            $panel.find('.filter-trigger-btn').toggleClass('active', hasFilters);
            
            // Sync values to select inputs in hidden repo
            const $isActiveFilter = $panel.find('.table-filters-repo [name="filter-IsActive"], .table-filters-repo .filter-IsActive');
            if ($isActiveFilter.length) {
                $isActiveFilter.val(activeFilters.IsActive ? [activeFilters.IsActive] : []).trigger('change');
            }
            
            dt.draw();
        });

        // Sync KPI highlights if filter changes from filter drawer select
        $(document).on('change', '.table-filters-repo [name="filter-IsActive"], .table-filters-repo .filter-IsActive', function () {
            const activeFilters = $panel.data('active-filters') || {};
            $('.sub-kpi-card').removeClass('active');
            if (activeFilters.IsActive === 'true') {
                $('#kpiActiveClients').addClass('active');
            } else if (activeFilters.IsActive === 'false') {
                $('#kpiInactiveClients').addClass('active');
            } else {
                $('#kpiTotalClients').addClass('active');
            }
        });

    /* ═══════════════════════════════════════════════════════════
       CLIENT GRID VIEW
       ═══════════════════════════════════════════════════════════ */
    var _cAvatarPalette = ['#6366f1','#3b82f6','#8b5cf6','#10b981','#f59e0b','#ef4444','#06b6d4','#ec4899'];

    function _cEsc(s) { return $('<div>').text(s || '').html(); }

    function renderClientGridView(dataArray) {
        var $c = $('#clientGridViewWrapper');
        $c.empty();
        if (!dataArray || dataArray.length === 0) {
            $c.html('<div style="grid-column:1/-1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:64px 20px;color:var(--text-muted);text-align:center;background:var(--bg-surface);border:1px dashed var(--border-strong);border-radius:var(--radius-lg);margin:16px;">' +
                '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom:12px;opacity:0.7;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>' +
                '<h5 style="margin:0 0 4px;font-weight:600;color:var(--text-main);">No Applications Found</h5>' +
                '<p style="margin:0;font-size:0.75rem;">Try adjusting your search terms or filters.</p></div>');
            return;
        }
        var sel       = (window.getSelectionSet ? window.getSelectionSet('clientTable') : new Set());
        var colType   = dt.column(2).visible();
        var colScopes = dt.column(3).visible();
        var colStatus = dt.column(4).visible();

        /* Application-themed avatar palette: deep, vivid colors */
        var _cAvatarPaletteLocal = ['#4f46e5','#0d9488','#7c3aed','#0891b2','#b45309','#b91c1c','#0369a1','#0f766e'];

        $.each(dataArray, function (idx, row) {
            var color    = _cAvatarPaletteLocal[idx % _cAvatarPaletteLocal.length];
            var isSel    = sel.has(String(row.id));
            var inactive = !row.isActive;

            /* Type badge with color per type */
            var clientTypeFull = (row.appClientType || row.clientType || '').toLowerCase();
            var typeBgClr = '';
            if      (/web/.test(clientTypeFull))     typeBgClr = 'background:rgba(59,130,246,0.10);color:#1d4ed8;border:1px solid rgba(59,130,246,0.22);';
            else if (/spa/.test(clientTypeFull))     typeBgClr = 'background:rgba(139,92,246,0.10);color:#6d28d9;border:1px solid rgba(139,92,246,0.22);';
            else if (/machine/.test(clientTypeFull)) typeBgClr = 'background:rgba(245,158,11,0.10);color:#b45309;border:1px solid rgba(245,158,11,0.22);';
            else                                     typeBgClr = 'background:rgba(100,116,139,0.10);color:#475569;border:1px solid rgba(100,116,139,0.2);';

            var typeBadge = colType
                ? '<span style="display:inline-flex;align-items:center;gap:4px;font-size:0.71rem;font-weight:700;padding:3px 9px;border-radius:999px;' + typeBgClr + '">' +
                  _cEsc((row.appClientType || '') + (row.clientType ? ' / ' + row.clientType : '')) + '</span>'
                : '';

            var scopeArr  = (row.scopes || '').toString().split(/[,\s]+/).filter(Boolean);
            var scopeText = scopeArr.slice(0, 4).join(', ') + (scopeArr.length > 4 ? '…' : '');
            var scopeField = colScopes
                ? '<div class="client-card-field"><span class="clf-label">Permissions</span><span class="clf-value" title="' + _cEsc(row.scopes) + '">' + _cEsc(scopeText || '—') + '</span></div>'
                : '';

            var statusBadge = colStatus
                ? (row.isActive
                    ? '<span class="ccard-s-active"><span class="ccard-sdot" style="background:#10b981;"></span>Active</span>'
                    : '<span class="ccard-s-inactive"><span class="ccard-sdot" style="background:#94a3b8;"></span>Disabled</span>')
                : '';

            var actions = '<button class="btn-ccard-view action-btn-view" data-type="client" data-id="' + row.id + '" title="View Details">' +
                '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path></svg>View</button>';
            if (canImportScopes) {
                actions += '<button class="btn-ccard-action" title="Import Scopes" onclick="openImportScopesModal(\'' + row.id + '\')">' +
                    '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg></button>';
            }
            if (canEditClient) {
                actions += '<button class="btn-ccard-action" title="Edit Client" onclick="editClient(\'' + row.id + '\')">' +
                    '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></button>';
            }
            if (canDeleteClient) {
                actions += '<button class="btn-ccard-action cdanger" title="Delete Client" onclick="deleteClient(\'' + row.id + '\')">' +
                    '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>';
            }

            var card = '<div class="client-grid-card' + (inactive ? ' cinactive' : '') + (isSel ? ' cselected' : '') + '" data-id="' + row.id + '">' +
                '<div class="client-card-header">' +
                '<input type="checkbox" class="client-card-checkbox" data-id="' + row.id + '"' + (isSel ? ' checked' : '') + '>' +
                statusBadge +
                '</div>' +
                '<div class="client-card-app-section">' +
                '<div class="client-card-avatar" style="background:' + color + ';">' +
                '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.9)" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>' +
                '</div>' +
                '<div class="client-card-name-group">' +
                '<h4 class="client-card-name" title="' + _cEsc(row.name) + '">' + _cEsc(row.name || 'Unknown App') + '</h4>' +
                '<div class="client-card-id">' + _cEsc(row.clientId || '—') + '</div>' +
                '</div></div>' +
                (typeBadge ? '<div class="ccard-divider"></div><div style="padding:6px 16px;">' + typeBadge + '</div>' : '') +
                (scopeField ? '<div class="ccard-divider"></div><div class="client-card-fields">' + scopeField + '</div>' : '') +
                '<div class="ccard-divider"></div>' +
                '<div class="client-card-actions">' + actions + '</div>' +
                '</div>';
            $c.append(card);
        });
    }

    /* Card checkbox → table row sync */
    $('#clientGridViewWrapper').on('change', '.client-card-checkbox', function () {
        var id = $(this).data('id'), chk = this.checked;
        if (window.toggleSelection) window.toggleSelection('clientTable', id, chk);
        $(this).closest('.client-grid-card').toggleClass('cselected', chk);
        var $rc = $('#clientTable').find('input.row-select-cb[data-row-id="' + id + '"]');
        if ($rc.length) { $rc.prop('checked', chk); $rc.closest('tr').toggleClass('selected-row', chk); }
        var s = window.getSelectionSet ? window.getSelectionSet('clientTable') : new Set();
        var vis = $('#clientTable').find('input.row-select-cb').map(function () { return String($(this).data('row-id')); }).get();
        var $m = $('.master-select-cb[data-table="clientTable"]');
        $m.prop('checked', vis.length > 0 && vis.every(function (i) { return s.has(i); }));
        var cc = vis.filter(function (i) { return s.has(i); }).length;
        $m.prop('indeterminate', cc > 0 && cc < vis.length);
    });

    /* Global selection → card sync */
    $(document).on('selection:changed', function (e, data) {
        if (data && data.tableId === 'clientTable') {
            $('.client-card-checkbox').each(function () {
                var id = $(this).data('id'), chk = data.ids && data.ids.includes(String(id));
                $(this).prop('checked', chk);
                $(this).closest('.client-grid-card').toggleClass('cselected', chk);
            });
        }
    });

    /* applyViewMode override for clientTable */
    var _origCVM = window.applyViewMode;
    window.applyViewMode = function (targetTableId, mode) {
        if (targetTableId === 'clientTable') {
            var $grid = $('#clientGridViewWrapper');
            var $tbl  = $('#clientTableViewWrapper');
            var $foot = $panel.find('.if-table-footer-wrap');
            var $btns = $panel.find('.view-toggle-btn[data-target="clientTable"]');
            if (mode === 'grid') {
                $tbl.removeClass('active'); $grid.addClass('active');
                if ($foot.length) $panel.append($foot);
                $btns.removeClass('active');
                $panel.find('.view-toggle-btn[data-target="clientTable"][data-view="grid"]').addClass('active');
                localStorage.setItem('view-mode-clientTable', 'grid');
            } else {
                $grid.removeClass('active'); $tbl.addClass('active');
                var $dtw = $('#clientTable_wrapper');
                if ($foot.length && $dtw.length) $dtw.append($foot);
                $btns.removeClass('active');
                $panel.find('.view-toggle-btn[data-target="clientTable"][data-view="list"]').addClass('active');
                localStorage.setItem('view-mode-clientTable', 'list');
            }
        } else if (typeof _origCVM === 'function') {
            _origCVM(targetTableId, mode);
        }
    };

    /* View toggle click → animate wrappers */
    $(document).on('click', '.view-toggle-btn[data-target="clientTable"]', function () {
        var mode = $(this).data('view');
        window.applyViewMode('clientTable', mode);
        if (mode === 'grid') {
            $('#clientTableViewWrapper').removeClass('active');
            setTimeout(function () { $('#clientGridViewWrapper').addClass('active'); }, 50);
        } else {
            $('#clientGridViewWrapper').removeClass('active');
            setTimeout(function () { $('#clientTableViewWrapper').addClass('active'); }, 50);
        }
    });

    /* Init from localStorage – no flicker */
    (function initClientView() {
        var saved = localStorage.getItem('view-mode-clientTable') || 'list';
        window.applyViewMode('clientTable', saved);
        if (saved === 'grid') {
            $('#clientTableViewWrapper').removeClass('active');
            $('#clientGridViewWrapper').addClass('active');
        } else {
            $('#clientGridViewWrapper').removeClass('active');
            $('#clientTableViewWrapper').addClass('active');
        }
    })();

    });



    window.openImportScopesModal = function(clientId) {
        openModal({
            title: 'Import Application Scopes',
            subtitle: 'Upload an Excel file to import scopes and permissions for this client.',
            icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>',
            url: '/Home/ImportScopes?clientId=' + clientId,
            onSuccess: function() {
                $('#clientTable').DataTable().ajax.reload();
            }
        });
    }

    window.openClientModal = function(id = '') {
        const isEdit = id !== '';
        openModal({
            title: isEdit ? 'Update Application' : 'Register New Client',
            subtitle: isEdit ? 'Modify client configuration and allowed grants.' : 'Connect a new application to your SSO ecosystem.',
            icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>',
            url: '/Home/CreateClient?Id=' + id,
            onSuccess: function() {
                $('#clientTable').DataTable().ajax.reload();
            }
        });
    }

    window.editClient = function(id) {
        window.openClientModal(id);
    }

    window.deleteClient = function(id) {
        openModal({
            title: 'Delete Application',
            subtitle: 'This will permanently remove the OIDC client config.',
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-error">
                    <path d="M19 6H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2z"></path>
                    <path d="M17 6V4a2 2 0 0 0-2-2H9a2 2 0 0 0-2 2v2"></path>
                  </svg>`,
            url: '/Home/DeleteClient?Id=' + id,
            onSuccess: function(result) {
                $('#clientTable').DataTable().ajax.reload();
            }
        });
    }
</script>

