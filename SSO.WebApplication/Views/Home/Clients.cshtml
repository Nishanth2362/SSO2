    .ccard-s-inactive { background: rgba(100,116,139,0.1); color:#475569; font-size:0.71rem; font-weight:600; padding:3px 9px; border-radius:999px; display:inline-flex; align-items:center; gap:5px; border:1px solid rgba(100,116,139,0.18); white-space:nowrap; }
    html[data-theme="dark"] .ccard-s-inactive { background:rgba(100,116,139,0.15); color:#94a3b8; border-color:rgba(100,116,139,0.2); }
    .ccard-sdot { width:6px; height:6px; border-radius:50%; display:inline-block; flex-shrink:0; }

    .client-card-app-section { display: flex; align-items: center; gap: 12px; padding: 12px 16px; }
    .client-card-name-group { display: flex; flex-direction: column; min-width: 0; }
    .client-card-name { font-size: 0.92rem; font-weight: 700; color: #064e3b; margin: 0; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    html[data-theme="dark"] .client-card-name { color: #d1fae5; }
    .client-card-id { font-size: 0.68rem; color: #64748b; font-family: 'SFMono-Regular','Consolas',monospace; margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    html[data-theme="dark"] .client-card-id { color: #94a3b8; }

    .ccard-divider { height: 1px; background: linear-gradient(90deg, #d4eddf, #c6e8d4 50%, transparent); margin: 0 16px; }
    html[data-theme="dark"] .ccard-divider { background: linear-gradient(90deg, #1a3028, #1e3028 50%, transparent); }

    .client-card-fields { display: flex; flex-direction: column; gap: 8px; padding: 10px 16px; flex: 1; }
    .client-card-field  { display: flex; align-items: flex-start; gap: 8px; }
    .clf-label { font-size: 0.63rem; font-weight: 700; color: #64748b; letter-spacing: 0.07em; text-transform: uppercase; min-width: 72px; flex-shrink: 0; padding-top: 1px; }
    html[data-theme="dark"] .clf-label { color: #64748b; }
    .clf-value { font-size: 0.76rem; color: #0f3827; font-weight: 500; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.4; }
    html[data-theme="dark"] .clf-value { color: #a7f3d0; }

    /* Action Buttons */
    .client-card-actions { display: flex; gap: 6px; padding: 10px 16px 14px; margin-top: auto; }
    .btn-ccard-view {
        flex: 1; display: inline-flex; align-items: center; justify-content: center;
        gap: 5px; font-size: 0.79rem; font-weight: 600; height: 34px; padding: 0 10px;
        border-radius: 9px; border: 1.5px solid #d4eddf; background: rgba(236, 253, 245, 0.9);
        color: #065f46; cursor: pointer; transition: all 0.2s ease; white-space: nowrap;
    }
    html[data-theme="dark"] .btn-ccard-view { border-color: #1e3028; background: rgba(15, 35, 28, 0.9); color: #6ee7b7; }
    .btn-ccard-view:hover { background: #10b981; border-color: #10b981; color: #fff; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3); }
    html[data-theme="dark"] .btn-ccard-view:hover { background: #059669; border-color: #059669; color: #fff; }
    .btn-ccard-action {
        width: 34px; height: 34px; border-radius: 9px; border: 1.5px solid #d4eddf;
        background: rgba(236, 253, 245, 0.9); color: #065f46; display: inline-flex; align-items: center;
        justify-content: center; cursor: pointer; transition: all 0.2s ease; padding: 0; flex-shrink: 0;
    }
    html[data-theme="dark"] .btn-ccard-action { border-color: #1e3028; background: rgba(15, 35, 28, 0.9); color: #6ee7b7; }
    .btn-ccard-action:hover { background: var(--bg-surface-hover); border-color: #10b981; color: #047857; transform: scale(1.05); }
    html[data-theme="dark"] .btn-ccard-action:hover { background: #1e3028; border-color: #059669; color: #a7f3d0; }
    .btn-ccard-action.cdanger { color: #ef4444; border-color: rgba(239,68,68,0.2); }
    html[data-theme="dark"] .btn-ccard-action.cdanger { color: #f87171; border-color: rgba(239,68,68,0.2); }
    .btn-ccard-action.cdanger:hover { background: #fef2f2; border-color: #fca5a5; color: #dc2626; transform: scale(1.05); }
    html[data-theme="dark"] .btn-ccard-action.cdanger:hover { background: rgba(239,68,68,0.12); border-color: rgba(239,68,68,0.4); color: #f87171; }

</style>


