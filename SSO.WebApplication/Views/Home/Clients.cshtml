
@{
    ViewData["Title"] = "Clients";
}


<div class="breadcrumbs">
    <span>Auxinz Identity</span>
    <a href="#">OpenIddict</a>
    <span class="current">Applications</span>
</div>

<div class="page-header">
    <div>
        <h1>Applications & Clients</h1>
        <p style="color: var(--text-muted); margin-top: 4px;">
            Manage OIDC clients, configure callbacks,
            secrets, and allowed grants.
        </p>
    </div>
    <div style="display: flex; gap: 12px;">
        <button class="btn btn-primary" id="openCreateClientModal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Create Application
        </button>
        <a href="/Home/ExportClients" class="btn btn-secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Export Excel
        </a>
    </div>
</div>
<!-- Applications View -->
<div style="margin-top:24px;"></div>

<div class="panel">
    <div class="table-toolbar">
        <div class="table-filters">
            <div style="position: relative;">
                <svg style="position: absolute; left: 10px; top: 10px; color: var(--text-muted);"
                     width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" class="form-input" placeholder="Filter Application Name..."
                       style="padding-left: 32px; width: 250px;">
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table id="clientTable" class="data-table table-hoverable manual-init">
            <thead>
                <tr>
                    <th style="width: 48px;"><input type="checkbox" class="custom-checkbox"></th>
                    <th class="sorted">
                        Client Application
                        <svg class="sort-icon" width="12" height="12" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <path d="M12 5v14M5 12l7-7 7 7" />
                        </svg>
                    </th>
                    <th>Type</th>
                    <th>Permissions / Flow</th>
                    <th>
                        Resource Usage
                        <svg class="sort-icon" width="12" height="12" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <path d="M11 5h10M11 9h7M11 13h4M3 17l4 4 4-4M7 21V3" />
                        </svg>
                    </th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>


<script type="text/javascript">
    $(function () {
        // Keep the custom UI toolbar/filter references and connect them to this specific table instances
        const $panel = $('#clientTable').closest('.panel');

        const $customSearch = $panel.find('.table-toolbar .form-input[placeholder*="Filter"], .table-toolbar .form-input[placeholder*="Search"]');
        const $customFilters = $panel.find('.table-toolbar .form-select');

        // The `.data-table.manual-init` class applied to #clientTable ensures that `ui.js` doesn't double-initialize it,
        // but `$.fn.dataTable.defaults` in `ui.js` ensures it naturally inherits the beautiful dark enterprise theme!
        const dt = $('#clientTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '/Home/GetClients',
                type: 'POST',
                data: function (d) {
                    // Forward custom filters to the server automatically
                    $customFilters.each(function (index, el) {
                        d['custom_filter_' + index] = $(el).val();
                    });

                    // Pass along custom search if present
                    if ($customSearch.length > 0) {
                        d.customSearchValue = $customSearch.val();
                    }
                },
                error: function (xhr, error, thrown) {
                    console.warn("Tenant AJAX failed. Waiting for real ASP.NET Core endpoint to be wired up.");
                }
            },
            language: {
                search: "",
                searchPlaceholder: "Search records...",
                lengthMenu: ""
            },
            responsive: true,
            dom: '<"table-toolbar datatables-injected"<"table-filters"l>f>t<"pagination"ip>',
            initComplete: function () {
                $('.dataTables_filter input').addClass('form-input');
                $('.dataTables_length select').addClass('form-select');
            },
            // Map the 5 specific data properties you provided into the 7 visual columns of the UI design
            columns: [
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function () { return '<input type="checkbox" class="custom-checkbox">'; }
                },
                {
                    data: 'name',
                    render: function (data, type, row) {

                        return ` <div class="cell-flex">
                                            <div class="cell-avatar primary">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                    stroke-linejoin="round">
                                                    <path
                                                        d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z">
                                                    </path>
                                                </svg>
                                            </div>
                                            <div class="cell-text">
                                                 <h5>${data || 'Unknown Tenant'}</h5>
                                                <p>${row.clientId || 'No Code'}</p>
                                            </div>
                                        </div>`;
                    }
                },
                {
                    data: 'clientType',
                    render: function (data, type, row) {
                        return `<span class="badge badge-neutral">${row.appClientType} / ${data || 'Standard'} </span>`;
                    }
                },
                {
                    data: 'scopes', // We bind data mapping array so things don't break, and just mock UI values temporarily
                    orderable: false,
                    render: function (data) {
                        return `<div class="cell-text"><h5 style="color: var(--brand-primary);">${data}</h5></div>`;
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    render: function (data) {
                        return `<div title="Usage">
                                    <div class="progress-track">
                                        <div class="progress-fill" style="width: 50%;"></div>
                                    </div>
                                    <span style="font-family: monospace; font-size: 0.75rem; color: var(--text-muted);">50%</span>
                                </div>`;
                    }
                },
                {
                    data: 'isActive',
                    render: function (data) {
                        // Maps user's 'isActive' boolean/property into the UI pills
                        return data ? '<span class="badge badge-success">Active</span>' : '<span class="badge badge-error">Disabled</span>';
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function (data, type, row) {
                        return `<div style="text-align: right;">
                                    <button class="action-btn" title="Import Scopes/Permissions" onclick="openImportScopesModal('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg></button>
                                    <button class="action-btn" title="Edit Client" onclick="editClient('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></button>
                                    <button class="action-btn text-error" title="Delete Client" onclick="deleteClient('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>
                                </div>`;
                    }
                }
            ]
        });

        // Wire up the exact custom search filtering that we previously built
        if ($customSearch.length > 0) {
            let searchTimeout;
            $customSearch.on('keyup', function () {
                clearTimeout(searchTimeout);
                const val = this.value;
                searchTimeout = setTimeout(() => {
                    dt.search(val).draw();
                }, 400);
            });
        }

        if ($customFilters.length > 0) {
            $customFilters.on('change', function () {
                dt.ajax.reload(); // Tell the ASP.NET MVC backend to fetch data again
            });
        }

        $('#openCreateClientModal').on('click', function() {
            openClientModal();
        });
    });

    window.openImportScopesModal = function(clientId) {
        openModal({
            title: 'Import Application Scopes',
            subtitle: 'Upload an Excel file to import scopes and permissions for this client.',
            icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>',
            url: '/Home/ImportScopes?clientId=' + clientId,
            onSuccess: function() {
                $('#clientTable').DataTable().ajax.reload();
            }
        });
    }

    window.openClientModal = function(id = '') {
        const isEdit = id !== '';
        openModal({
            title: isEdit ? 'Update Application' : 'Register New Client',
            subtitle: isEdit ? 'Modify client configuration and allowed grants.' : 'Connect a new application to your SSO ecosystem.',
            icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>',
            url: '/Home/CreateClient?Id=' + id,
            onSuccess: function() {
                $('#clientTable').DataTable().ajax.reload();
            }
        });
    }

    window.editClient = function(id) {
        window.openClientModal(id);
    }

    window.deleteClient = function(id) {
        openModal({
            title: 'Delete Application',
            subtitle: 'This will permanently remove the OIDC client config.',
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-error">
                    <path d="M19 6H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2z"></path>
                    <path d="M17 6V4a2 2 0 0 0-2-2H9a2 2 0 0 0-2 2v2"></path>
                  </svg>`,
            url: '/Home/DeleteClient?Id=' + id,
            onSuccess: function(result) {
                $('#clientTable').DataTable().ajax.reload();
            }
        });
    }
</script>

