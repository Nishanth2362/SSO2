@using System.Text.Json
@using SSO.Application.Responses.Features
@using SSO.Domain.Enums
@model SSO.Application.Requests.Features.ClientRequest

@{
    Layout = null;
    bool isEdit = Model.Id.HasValue && Model.Id.Value != Guid.Empty;
}

<!-- Premium Client Creation Modal -->
<form id="createClientForm" class="luxe-form">
    <input type="hidden" id="editClientId" value="@Model.Id" />
    <div class="modal-body luxe-scroll">
        
        <!-- Tab Navigation (Optional, or just Sections) -->
        <div class="form-sections-nav">
            <span class="section-title active">Registration Details</span>
        </div>

        <!-- Section: Basic Identity -->
        <div class="form-section">
            <div class="form-section-header">
                <i class="section-icon bi bi-person-badge"></i>
                <span>Application Identity</span>
            </div>
            
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="modal-field">
                        <label class="modal-label" asp-for="ClientName">Display Name <span class="required-star">*</span></label>
                        <input id="clientName" asp-for="ClientName" type="text" class="modal-input" 
                               placeholder="e.g. My Customer Portal" required autocomplete="off">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="modal-field">
                        <label class="modal-label" asp-for="ClientId">Client ID <span class="required-star">*</span></label>
                        <input id="clientId" asp-for="ClientId" type="text" class="modal-input" 
                               placeholder="e.g. customer_portal_app" required autocomplete="off" readonly="@isEdit">
                    </div>
                </div>
            </div>

            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <div class="modal-field">
                        <label class="modal-label" asp-for="ClientType">Application Type <span class="required-star">*</span></label>
                        <select id="clientType" asp-for="ClientType" class="modal-select" required>
                            @if (isEdit)
                            {
                                <option value="" disabled>Select application type...</option>
                            }
                            else
                            {
                                <option value="" disabled selected>Select application type...</option>
                            }
                            @foreach (var type in Enum.GetValues<ClientType>())
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="modal-field mt-3" id="clientSecretGroup" style="display:none;">
                <label class="modal-label" asp-for="ClientSecret">Client Secret</label>
                <div class="input-with-action">
                    <input id="clientSecret" asp-for="ClientSecret" type="password" class="modal-input" 
                           placeholder="Leave empty for auto-generation">
                    <button type="button" class="field-action-btn" id="toggleSecret" title="Toggle Visibility">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Section: Endpoints -->
        <div class="form-section mt-4">
            <div class="form-section-header">
                <i class="section-icon bi bi-link-45deg"></i>
                <span>Redirect Configuration</span>
            </div>
            
            <div class="modal-field">
                <label class="modal-label">Callback URLs (Comma separated)</label>
                <textarea id="redirectUris" class="modal-input" rows="2" 
                          placeholder="https://app.com/callback">@(Model.RedirectUris != null ? string.Join(", ", Model.RedirectUris) : "")</textarea>
            </div>

            <div class="modal-field mt-3">
                <label class="mini-label">Post-Logout URLs (Comma separated)</label>
                <textarea id="postLogoutRedirectUris" class="modal-input" rows="2" 
                          placeholder="https://app.com/logout">@(Model.PostLogoutRedirectUris != null ? string.Join(", ", Model.PostLogoutRedirectUris) : "")</textarea>
            </div>
        </div>

        <!-- Section: Scopes & Granular Permissions -->
        <div class="form-section mt-4">
            <div class="form-section-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <i class="section-icon bi bi-shield-lock"></i>
                    <span>Scopes & Granular Permissions</span>
                </div>
                <button type="button" class="btn btn-outline-primary btn-sm" id="addScopeBtn">
                    <i class="bi bi-plus-lg"></i> Add Scope
                </button>
            </div>
            
            <div id="scopesContainer" class="scopes-dynamic-list mt-3">
                <!-- Initial Scope Row -->
                <div class="scope-row-card">
                    <div class="scope-header">
                        <div class="modal-field flex-grow-1">
                            <label class="mini-label">Scope Name</label>
                            <input type="text" class="modal-input scope-name" placeholder="e.g. Identity" value="openid">
                        </div>
                    </div>
                    
                    <div class="permissions-sub-section mt-3">
                        <label class="mini-label d-flex justify-content-between">
                            Permissions (Code & Description)
                            <button type="button" class="btn-add-perm add-permission-btn">
                                <i class="bi bi-plus"></i> Add Permission
                            </button>
                        </label>
                        <div class="permissions-list">
                            <!-- Permission Rows will go here -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div><!-- /modal-body -->

    <div class="modal-footer">
        <button type="button" class="btn-luxe btn-secondary" id="cancelCreateClient">Cancel</button>
        <button type="submit" class="btn-luxe btn-primary" id="submitCreateClient">
            <i class="bi bi-check-circle me-1"></i> @(isEdit ? "Update Application" : "Register Client")
        </button>
    </div>
</form>

<style>
    .luxe-form .modal-body { max-height: 70vh; overflow-y: auto; padding-right: 15px; }
    .luxe-form .form-section { background: rgba(255,255,255,0.02); padding: 20px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); }
    .luxe-form .form-section-header { font-size: 0.9rem; font-weight: 600; color: #a0a0a0; margin-bottom: 20px; display: flex; align-items: center; gap: 8px; text-transform: uppercase; }
    .luxe-form .section-icon { color: var(--primary-color, #3b82f6); font-size: 1.1rem; }
    .luxe-form .input-with-action { position: relative; }
    .luxe-form .field-action-btn { position: absolute; right: 8px; top: 10px; background: transparent; border: none; color: #666; cursor: pointer; padding: 4px 8px; }
    
    .luxe-form .scope-row-card { background: rgba(0,0,0,0.15); padding: 20px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.08); position: relative; margin-bottom: 20px; }
    .luxe-form .mini-label { font-size: 0.75rem; color: #888; margin-bottom: 6px; display: block; font-weight: 600; }
    .luxe-form .btn-add-perm { background: transparent; border: 1px dashed #3b82f6; color: #3b82f6; font-size: 0.7rem; padding: 2px 8px; border-radius: 4px; }
    .luxe-form .btn-add-perm:hover { background: rgba(59, 130, 246, 0.1); }
    
    .luxe-form .perm-row { display: grid; grid-template-columns: 1fr 1fr 40px; gap: 10px; margin-bottom: 8px; align-items: center; }
    .luxe-form .remove-scope-btn { position: absolute; right: 10px; top: 10px; border: none; background: transparent; color: #ff4d4d; opacity: 0.6; cursor: pointer; transition: 0.2s; }
    .luxe-form .remove-scope-btn:hover { opacity: 1; transform: scale(1.1); }
    .luxe-form .remove-perm-btn { background: transparent; border: none; color: #ff4d4d; opacity: 0.6; cursor: pointer; transition: 0.2s; }
    .luxe-form .remove-perm-btn:hover { opacity: 1; transform: scale(1.1); }
</style>

<script>
    $(function() {
        const isEditMode = @(isEdit.ToString().ToLower());
        const initialModel = @Html.Raw(JsonSerializer.Serialize(Model));

        // Toggle Client Secret visibility
        $('#toggleSecret').on('click', function() {
            const input = $('#clientSecret');
            const type = input.attr('type') === 'password' ? 'text' : 'password';
            input.attr('type', type);
            $(this).find('i').toggleClass('bi-eye bi-eye-slash');
        });

        // Show/Hide Secret field based on Client Type
        $('#clientType').on('change', function() {
            const type = $(this).val();
            // Web and Machine require client secrets
            if (type === 'Web' || type === 'Machine') {
                $('#clientSecretGroup').slideDown(200);
            } else {
                $('#clientSecretGroup').slideUp(200);
                $('#clientSecret').val('');
            }
        });

        // Trigger change to show secret field if editing and type requires it
        if (isEditMode) {
            $('#clientType').trigger('change');
            
            // Clear the initial scopes container and populate from model
            $('#scopesContainer').empty();
            if (initialModel.Scopes && initialModel.Scopes.length > 0) {
                initialModel.Scopes.forEach(s => {
                    addScopeRow(s);
                });
            } else {
                // If no scopes, maybe add one default or leave empty
            }
        }

        // Function to create a Permission Row
        function createPermissionRow(code = '', desc = '') {
            return `
                <div class="perm-row">
                    <input type="text" class="modal-input perm-code" placeholder="Code" value="${code}">
                    <input type="text" class="modal-input perm-desc" placeholder="Description" value="${desc}">
                    <button type="button" class="remove-perm-btn"><i class="bi bi-x-circle"></i></button>
                </div>`;
        }

        function addScopeRow(scopeData = null) {
            const name = scopeData ? scopeData.Name : (scopeData === null ? 'openid' : '');
            const rowId = 'scope_' + Math.random().toString(36).substr(2, 9);
            const row = `
                <div class="scope-row-card animate__animated animate__fadeIn" id="${rowId}">
                    <button type="button" class="remove-scope-btn" title="Remove Scope"><i class="bi bi-trash"></i></button>
                    <div class="scope-header">
                        <div class="modal-field flex-grow-1">
                            <label class="mini-label">Scope Name</label>
                            <input type="text" class="modal-input scope-name" placeholder="e.g. Products" value="${name}">
                        </div>
                    </div>
                    <div class="permissions-sub-section mt-3">
                        <label class="mini-label d-flex justify-content-between">
                            Permissions (Code & Description)
                            <button type="button" class="btn-add-perm add-permission-btn">
                                <i class="bi bi-plus"></i> Add Permission
                            </button>
                        </label>
                        <div class="permissions-list"></div>
                    </div>
                </div>`;
            
            const $row = $(row);
            $('#scopesContainer').append($row);

            if (scopeData && scopeData.Permissions) {
                scopeData.Permissions.forEach(p => {
                    $row.find('.permissions-list').append(createPermissionRow(p.Code, p.Description));
                });
            }
        }

        // Add Scope Row
        $('#addScopeBtn').on('click', function() {
            addScopeRow('');
        });

        // Add Permission Row within a Scope
        $(document).off('click', '.add-permission-btn').on('click', '.add-permission-btn', function() {
            $(this).closest('.permissions-sub-section').find('.permissions-list').append(createPermissionRow());
        });

        // Remove Scope Row
        $(document).on('click', '.remove-scope-btn', function() { $(this).closest('.scope-row-card').remove(); });
        // Remove Permission Row
        $(document).on('click', '.remove-perm-btn', function() { $(this).closest('.perm-row').remove(); });

        // Form Submission - Maps to ClientRequest object structure
        $('#createClientForm').off('submit').on('submit', function(e) {
            e.preventDefault();
            if (!window.validateAjaxForm(this)) {
                return;
            }
            const $btn = $('#submitCreateClient');
            const originalHtml = $btn.html();
            $btn.prop('disabled', true);
            
            const scopes = [];
            
            $('.scope-row-card').each(function() {
                const scopeName = $(this).find('.scope-name').val()?.trim();
                if (!scopeName) return;

                const permissions = [];
                $(this).find('.perm-row').each(function() {
                    const code = $(this).find('.perm-code').val()?.trim();
                    const desc = $(this).find('.perm-desc').val()?.trim();
                    if (code) {
                        permissions.push({ Code: code, Description: desc || code });
                    }
                });

                scopes.push({
                    Name: scopeName,
                    DisplayName: scopeName, // Default display name to name
                    Permissions: permissions
                });
            });

            // Prepare the ClientRequest object
            const formData = {
                Id: $('#editClientId').val() || null,
                ClientId: $('#clientId').val(),
                ClientName: $('#clientName').val(),
                ClientType: $('#clientType').val(), 
                ClientSecret: $('#clientSecret').val(),
                RedirectUris: $('#redirectUris').val().split(',').map(s => s.trim()).filter(s => s !== ''),
                PostLogoutRedirectUris: $('#postLogoutRedirectUris').val().split(',').map(s => s.trim()).filter(s => s !== ''),
                Scopes: scopes
            };

            $.ajax({
                url: '/Home/CreateClient',
                type: 'POST',
                data: JSON.stringify(formData),
                contentType: 'application/json',
                success: function(res) {
                    if (res.succeeded) {
                        if (typeof closeModal === 'function') closeModal();
                        if (window.onModalSuccess) window.onModalSuccess();
                        Swal.fire({
                            icon: 'success',
                            title: isEditMode ? 'Updated!' : 'Registered!',
                            text: window.getPrimaryResultMessage(res, isEditMode ? 'Application updated successfully.' : 'Application registered successfully.'),
                            showConfirmButton: false,
                            timer: 1500
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: window.getPrimaryResultMessage(res, isEditMode ? 'Update failed' : 'Registration failed')
                        });
                        $btn.prop('disabled', false).html(originalHtml);
                    }
                },
                error: function(xhr) {
                    window.showRequestError({
                        title: isEditMode ? 'Unable to Update Application' : 'Unable to Register Application',
                        xhr: xhr,
                        fallbackMessage: isEditMode ? 'We could not update the application right now. Please try again.' : 'We could not register the application right now. Please try again.'
                    });
                    $btn.prop('disabled', false).html(originalHtml);
                }
            });
        });

        $('#cancelCreateClient').on('click', function() {
            if (typeof closeModal === 'function') closeModal();
        });
    });
</script>
