                    </div>

                    <div class="et-field-group">
                        <textarea asp-for="Body" id="etBody" class="et-textarea-editor"
                                  placeholder="Paste your HTML email template here. Use tokens like {{UserName}}, {{CallbackUrl}}, {{AppName}}..."
                                  required></textarea>
                    </div>

                    <div class="et-tokens-row" style="margin-top: 4px;">
                        <span class="et-tokens-label">Available Tokens:</span>
                        <span class="et-token-badge" onclick="insertToken('{{UserName}}')">{{UserName}}</span>
                        <span class="et-token-badge" onclick="insertToken('{{Email}}')">{{Email}}</span>
                        <span class="et-token-badge" onclick="insertToken('{{AppName}}')">{{AppName}}</span>
                        <span class="et-token-badge" onclick="insertToken('{{TenantName}}')">{{TenantName}}</span>
                        <span class="et-token-badge" onclick="insertToken('{{CallbackUrl}}')">{{CallbackUrl}}</span>
                        <span class="et-token-badge" onclick="insertToken('{{LogoUrl}}')">{{LogoUrl}}</span>
