    <!-- REMARKS FIELD (Edit mode only) -->
    @await Html.PartialAsync("_EditRemarksPartial", isEdit)

    <!-- Modal Footer -->
    <div class="modal-footer">
        <button type="submit" class="btn btn-primary" id="etSubmitBtn">
            @(isEdit ? "Update Template" : "Save Template")
        </button>
    </div>
</form>

<script>
    function etOpenPreview() {
        var html = document.getElementById('etBody').value.trim();
        if (!html) {
            Swal.fire({ icon: 'info', title: 'Nothing to Preview', text: 'Add some HTML content to the body first.', timer: 2000, showConfirmButton: false });
            return;
        }
        var blob = new Blob([html], { type: 'text/html' });
        var url  = URL.createObjectURL(blob);
        var win  = window.open(url, '_blank', 'width=860,height=640,toolbar=0,menubar=0');
        if (!win) {
            Swal.fire({ icon: 'warning', title: 'Popup Blocked', text: 'Allow popups for this site to use the preview feature.' });
        }
        setTimeout(function () { URL.revokeObjectURL(url); }, 8000);
    }

    function insertToken(token) {
        const bodyElem = document.getElementById('etBody');
        const subjectElem = document.getElementById('etSubject');
        const activeElem = document.activeElement;

        if (activeElem === subjectElem) {
            const start = subjectElem.selectionStart || subjectElem.value.length;
            const end = subjectElem.selectionEnd || subjectElem.value.length;
            subjectElem.value = subjectElem.value.substring(0, start) + token + subjectElem.value.substring(end);
            subjectElem.focus();
            subjectElem.setSelectionRange(start + token.length, start + token.length);
        } else {
            const start = bodyElem.selectionStart || bodyElem.value.length;
            const end = bodyElem.selectionEnd || bodyElem.value.length;
            bodyElem.value = bodyElem.value.substring(0, start) + token + bodyElem.value.substring(end);
            bodyElem.focus();
            bodyElem.setSelectionRange(start + token.length, start + token.length);
        }
    }

    function updateSummarySidebar() {
        // Update Template Type
        const typeVal = $('#etTemplateType').val();
        const typeText = typeVal === '1' || typeVal === 'PlainText' ? 'Plain Text' : 'HTML';
        $('#summaryTemplateType').text(typeText);

        // Update Trigger Event
        const triggerText = $('#etTriggerEvent option:selected').text() || 'Registration';
        $('#summaryTriggerEvent').text(triggerText);

        // Update Active Status
        const isActive = $('#etIsActive').is(':checked');
        const $statusBadge = $('#summaryStatusBadge');
        if (isActive) {
            $statusBadge.text('Active').removeClass('inactive').addClass('active');
        } else {
            $statusBadge.text('Inactive').removeClass('active').addClass('inactive');
        }
    }

    $(function() {
        // Initialize live update listeners
        $('#etTemplateType, #etTriggerEvent').on('change', updateSummarySidebar);
        $('#etIsActive').on('change', updateSummarySidebar);
        updateSummarySidebar();

        const wizard = window.initWizardForm('#etForm', {
            onFinished: function() {
                var form = document.getElementById('etForm');
                const $btn = $('.wizard-btn-save');
                const originalHtml = $btn.html();

                // Validate remarks before submission (edit mode only)
                if (typeof validateRemarks === 'function' && !validateRemarks()) return;

                $btn.prop('disabled', true).html('<svg class="et-spin" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px; display: inline-block; vertical-align: middle;"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Saving…');

                $.ajax({
                    url: '/Home/CreateEmailTemplate',
                    type: 'POST',
                    data: new FormData(form),
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        if (res.succeeded) {
                            window.closeModal();
                            if (typeof window.onModalSuccess === 'function') {
                                window.onModalSuccess();
                            }
                            Swal.fire({
                                icon: 'success',
                                title: 'Saved',
                                text: res.messages?.[0] || 'Email template saved successfully.',
                                showConfirmButton: false,
                                timer: 1500
                            });
                        } else {
                            $btn.prop('disabled', false).html(originalHtml);
                            Swal.fire({
                                icon: 'error',
                                title: 'Unable to Save',
                                text: window.getPrimaryResultMessage ? window.getPrimaryResultMessage(res, 'Could not save the template.') : 'Error saving template.'
                            });
                        }
                    },
                    error: function (xhr) {
                        $btn.prop('disabled', false).html(originalHtml);
                        if (window.showRequestError) {
                            window.showRequestError({
                                title: 'Unable to Save',
                                xhr: xhr,
                                fallbackMessage: 'Could not save the email template.'
                            });
                        }
                    }
                });
            }
        });
    });
</script>
