                            </svg>
                        </div>

                        <!-- Stats Card -->
                        <div class="et-summary-stats-card">
                            <!-- Template Type Stat -->
                            <div class="et-summary-stat-row">
                                <div class="et-summary-stat-left">
                                    <div class="et-summary-stat-icon">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="16 18 22 12 16 6"/>
                                            <polyline points="8 6 2 12 8 18"/>
                                        </svg>
                                    </div>
                                    <span class="et-summary-stat-label">Template Type</span>
                                </div>
                                <span id="summaryTemplateType" class="et-summary-stat-value">HTML</span>
                            </div>

                            <!-- Trigger Event Stat -->
                            <div class="et-summary-stat-row">
                                <div class="et-summary-stat-left">
                                    <div class="et-summary-stat-icon">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                                        </svg>
                                    </div>
                                    <span class="et-summary-stat-label">Trigger Event</span>
                                </div>
                                <span id="summaryTriggerEvent" class="et-summary-stat-value">Registration</span>
                            </div>

                            <!-- Status Stat -->
                            <div class="et-summary-stat-row">
                                <div class="et-summary-stat-left">
                                    <div class="et-summary-stat-icon">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"/>
                                            <circle cx="12" cy="12" r="3"/>
                                        </svg>
                                    </div>
                                    <span class="et-summary-stat-label">Status</span>
                                </div>
                                <span id="summaryStatusBadge" class="et-status-pill active">Active</span>
