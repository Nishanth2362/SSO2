                                    </linearGradient>
                                    <linearGradient id="smPlaneGrad" x1="0" y1="0" x2="1" y2="1">
                                        <stop offset="0%" stop-color="#a855f7"/>
                                        <stop offset="100%" stop-color="#7c3aed"/>
                                    </linearGradient>
                                    <filter id="smSoftShadow" x="-20%" y="-20%" width="140%" height="140%">
                                        <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#7c3aed" flood-opacity="0.2"/>
