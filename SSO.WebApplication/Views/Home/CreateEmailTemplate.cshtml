                                    <path d="M 125 112 C 90 105, 70 88, 80 70 C 95 85, 110 100, 125 112 Z" fill="#e9d5ff"/>

                                    <path d="M 195 105 C 225 85, 240 65, 228 48 C 215 70, 205 90, 195 105 Z" fill="#d8b4fe"/>
                                    <path d="M 195 112 C 230 105, 250 88, 240 70 C 225 85, 210 100, 195 112 Z" fill="#e9d5ff"/>
                                </g>

