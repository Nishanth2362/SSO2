                                <path d="M 110 85 L 160 120 L 210 85 L 210 135 C 210 140.5 205.5 145 200 145 L 120 145 C 114.5 145 110 140.5 110 135 Z" fill="url(#smEnvBody)" filter="url(#smSoftShadow)"/>

                                <!-- Floating Green Checkmark Badge (Right Side) -->
                                <g transform="translate(215, 60)" filter="url(#smSoftShadow)">
                                    <circle cx="14" cy="14" r="14" fill="#10b981"/>
                                    <path d="M9 14l3.5 3.5 7-7" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </g>

