                                    <path d="M 34 0 L 16 28 L 12 18 Z" fill="#6d28d9" opacity="0.25"/>
                                </g>

                                <!-- Envelope Back -->
                                <rect x="110" y="75" width="100" height="70" rx="10" fill="url(#smEnvBack)" filter="url(#smSoftShadow)"/>

                                <!-- Letter Document -->
