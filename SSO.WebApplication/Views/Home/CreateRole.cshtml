@using SSO.Application.Responses.Features
@{
    Layout = null;
    var tenants = ViewBag.Tenants as List<TenantResponse> ?? new List<TenantResponse>();
}
@model SSO.Application.Features.Roles.Commands.AddEdit.AddEditRolesCommand

<form id="createRoleForm" novalidate>
    <input type="hidden" asp-for="Id" />
    <div class="modal-body">

        <!-- Section: Role Info -->
        <div class="modal-section-label">General Information</div>
        <div class="modal-form-grid">
            <div class="modal-field">
                <label class="modal-label" for="roleName">
                    Role Name <span class="required-star">*</span>
                </label>
                <input id="roleNameField" asp-for="Name" type="text" class="modal-input"
                       placeholder="e.g. Administrator" required autocomplete="off">
            </div>

            <div class="modal-field">
                <label class="modal-label" for="roleDescription">
                    Description
                </label>
                <input id="roleDescriptionField" asp-for="Description" type="text" class="modal-input"
                       placeholder="e.g. Full system access" autocomplete="off">
            </div>
            
            <div class="modal-field">
                <label class="modal-label" for="roleTenant">
                    Tenant Organization <span class="required-star">*</span>
                </label>
                <select id="roleTenantField" asp-for="TenantId" class="modal-select" required>
                    <option value="" selected>Select tenant...</option>
                    @foreach (var tenant in tenants)
                    {
                        <option value="@tenant.Id">@tenant.Name</option>
                    }
                </select>
            </div>
        </div>

        <!-- Section: Settings -->
        <div class="modal-section-label">Settings</div>
        <div class="modal-form-grid">
            <div class="modal-field">
                <label class="modal-toggle-row" for="roleIsSystem">
                    <div>
                        <div class="modal-label" style="margin-bottom:2px;">System Role</div>
                        <span class="field-hint" style="margin-top:0;">System roles cannot be deleted.</span>
                    </div>
                    <div class="toggle-switch">
                        <input type="checkbox" id="roleIsSystem" asp-for="IsSystemRole">
                        <span class="toggle-track">
                            <span class="toggle-thumb"></span>
                        </span>
                    </div>
                </label>
            </div>
        </div>

    </div><!-- /modal-body -->
    <!-- Modal Footer -->
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="window.closeModal()">Cancel</button>
        <button type="submit" class="btn btn-primary" id="submitRoleForm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            @(Model.Id == null || Model.Id == Guid.Empty ? "Create Role" : "Update Role")
        </button>
    </div>
</form>

<script>
    $('#createRoleForm').off('submit').on('submit', function(e) {
        e.preventDefault();
        if (!window.validateAjaxForm(this)) {
            return;
        }

        const $btn = $('#submitRoleForm');
        $btn.prop('disabled', true).html('Processing...');

        const formData = $(this).serialize();

        $.post('/Home/CreateRole', formData, function(result) {
            if (result.succeeded) {
                window.closeModal();
                if ($('#roleTable').length) {
                    $('#roleTable').DataTable().ajax.reload(null, false);
                }
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error Saving Role',
                    text: window.getPrimaryResultMessage(result, 'Unknown error')
                });
                $btn.prop('disabled', false).html('@(Model.Id == null || Model.Id == Guid.Empty ? "Create Role" : "Update Role")');
            }
        }).fail(function(xhr) {
            window.showRequestError({
                title: 'Unable to Save Role',
                xhr: xhr,
                fallbackMessage: 'We could not save the role right now. Please try again.'
            });
            $btn.prop('disabled', false).html('@(Model.Id == null || Model.Id == Guid.Empty ? "Create Role" : "Update Role")');
        });
    });
</script>
