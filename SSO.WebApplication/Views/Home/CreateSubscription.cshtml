        </div>

        <!-- REMARKS FIELD (Edit mode only) -->
        @await Html.PartialAsync("_EditRemarksPartial", Model.Id != null && Model.Id != Guid.Empty)

    </div>
</form>

<script>
    $(function() {
        // Dynamic Progressive Interactive Stepper Handler
        function updateStepperProgress(targetStep) {
            // Step 1 is always active
            $('#stepNum1').removeClass('inactive').addClass('active');
            $('#stepLabel1').removeClass('inactive').addClass('active');

            // Line 1 -> Step 2
            if (targetStep >= 2) {
                $('#stepperLine1').addClass('active');
                $('#stepNum2').removeClass('inactive').addClass('active');
                $('#stepLabel2').removeClass('inactive').addClass('active');
            } else {
                $('#stepperLine1').removeClass('active');
                $('#stepNum2').removeClass('active').addClass('inactive');
                $('#stepLabel2').removeClass('active').addClass('inactive');
            }

            // Line 2 -> Step 3
            if (targetStep >= 3) {
                $('#stepperLine2').addClass('active');
                $('#stepNum3').removeClass('inactive').addClass('active');
                $('#stepLabel3').removeClass('inactive').addClass('active');
            } else {
                $('#stepperLine2').removeClass('active');
                $('#stepNum3').removeClass('active').addClass('inactive');
                $('#stepLabel3').removeClass('active').addClass('inactive');
            }
        }

        // Stepper Progress triggers based on form input focus/interaction
        $('#subName, #description, #billingCycle').on('focus input change', function() {
            updateStepperProgress(1);
        });

        $('#subMaxUsers, #subMaxApps, #price, #currency').on('focus input change', function() {
            updateStepperProgress(2);
        });

        $('#subSeparateDb').on('focus change', function() {
            updateStepperProgress(3);
        });

        // Clickable stepper indicators
        $('#stepIndicator1').on('click', function() { updateStepperProgress(1); $('#subName').focus(); });
        $('#stepIndicator2').on('click', function() { updateStepperProgress(2); $('#subMaxUsers').focus(); });
        $('#stepIndicator3').on('click', function() { updateStepperProgress(3); $('#subSeparateDb').focus(); });

        // Dynamic Live Summary Updater
        function updateSummary() {
            const name = $('#subName').val() || '-';
            const cycleText = $('#billingCycle option:selected').text() || $('#billingCycle').val() || '-';
            const curr = $('#currency').val() || 'INR';
            const price = $('#price').val();
            const symbol = curr === 'INR' ? '₹' : curr === 'USD' ? '$' : curr === 'EUR' ? '€' : '£';
            const priceText = price ? (symbol + ' ' + parseFloat(price).toLocaleString()) : '-';
            const maxUsers = $('#subMaxUsers').val() || '-';
            const maxApps = $('#subMaxApps').val() || '-';
            const isSeparateDb = $('#subSeparateDb').is(':checked');

            $('#summaryPlanName').text(name);
            $('#summaryBillingCycle').text(cycleText);
            $('#summaryPrice').text(priceText);
            $('#summaryMaxUsers').text(maxUsers);
            $('#summaryMaxApps').text(maxApps);
            $('#summaryIsolation').text(isSeparateDb ? 'Isolated DB' : 'Shared DB');
        }

        // Initialize Summary & Stepper state
        updateSummary();
        updateStepperProgress(1);

        // Update Summary on input/change
        $('#createSubscriptionForm').find('input, select, textarea').on('input change', function() {
            $(this).removeClass('ct-invalid');
            updateSummary();
        });

        const wizard = window.initWizardForm('#createSubscriptionForm', {
            onStepChanging: function(currentIndex, newIndex) {
                return true;
            },
            onFinished: function() {
                const $btn = $('#submitSubscriptionForm');
                const originalHtml = $btn.html();

                // Validate remarks before submission (edit mode only)
                if (typeof validateRemarks === 'function' && !validateRemarks()) return;

                $btn.prop('disabled', true).html('Processing...');

                const formData = $('#createSubscriptionForm').serialize();

                $.post('/Home/CreateSubscription', formData, function(result) {
                    if (result.succeeded) {
                        window.closeModal();
                        if (window.appToast) {
                            window.appToast.show('success', 'Plan Saved', result.messages ? result.messages[0] : 'Subscription plan has been saved successfully.');
                        }
                        if (window.onModalSuccess) {
                            window.onModalSuccess();
                        } else if ($('#subscriptionTable').length) {
                            $('#subscriptionTable').DataTable().ajax.reload();
                        } else {
                            location.reload();
                        }
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error Saving Subscription',
                            text: window.getPrimaryResultMessage ? window.getPrimaryResultMessage(result, 'Unknown error') : (result.messages ? result.messages.join('\n') : 'Unknown error')
                        });
                        resetBtn();
                    }
                }).fail(function(xhr) {
                    if (window.showRequestError) {
                        window.showRequestError({
                            title: 'Unable to Save Plan',
                            xhr: xhr,
                            fallbackMessage: 'We could not save the subscription plan right now. Please try again.'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Unable to Save Plan',
                            text: 'We could not save the subscription plan right now. Please try again.'
                        });
                    }
                    resetBtn();
                });

                function resetBtn() {
                    $btn.prop('disabled', false).html(originalHtml);
                }
            }
        });
    });
</script>
