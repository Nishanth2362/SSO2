@{
    Layout = null;
}
@model SSO.Application.Features.Subscriptions.Commands.AddEdit.AddEditSubscriptionCommand

<form id="createSubscriptionForm" novalidate>
    <input type="hidden" asp-for="Id" />
    <div class="modal-body">

        <!-- Section: Basic Details -->
        <div class="modal-section-label">Plan Details</div>
        <div class="modal-form-grid">
            <div class="modal-field">
                <label class="modal-label" for="subName">
                    Plan Name <span class="required-star">*</span>
                </label>
                <input id="subName" asp-for="Name" type="text" class="modal-input"
                       placeholder="e.g. Enterprise Tier" required autocomplete="off">
                <span class="field-hint">The display name for this subscription plan.</span>
            </div>
            <div class="modal-field">
                <label class="modal-label" for="description">
                    Description <span class="required-star">*</span>
                </label>
                <input id="description" asp-for="Description" type="text" class="modal-input"
                       placeholder="e.g. Enterprise Tier Desp" required autocomplete="off">
                <span class="field-hint">The Description for this subscription plan.</span>
            </div>
        </div>

        <!-- Section: Billing -->
        <div class="modal-section-label">Billing & Pricing</div>
        <div class="modal-form-grid">
            <div class="modal-field">
                <label class="modal-label" for="billingCycle">
                    Billing Cycle <span class="required-star">*</span>
                </label>
                <select id="billingCycle" asp-for="BillingCycle" class="modal-input" required>
                    <option value="1">Monthly</option>
                    <option value="2">Yearly</option>
                </select>
                <span class="field-hint">Subscription interval.</span>
            </div>
            <div class="modal-field">
                <label class="modal-label" for="price">
                    Price <span class="required-star">*</span>
                </label>
                <div style="display: flex; gap: 8px;">
                    <select id="currency" asp-for="Currency" class="modal-input" style="width: 100px;" required>
                        <option value="INR">INR (₹)</option>
                        <option value="USD">USD ($)</option>
                        <option value="EUR">EUR (€)</option>
                        <option value="GBP">GBP (£)</option>
                    </select>
                    <input id="price" asp-for="Price" type="number" step="0.01" class="modal-input"
                           placeholder="e.g. 99.00" required style="flex: 1;">
                </div>
                <span class="field-hint">The cost and currency per billing cycle.</span>
            </div>
        </div>
       

        <!-- Section: Quotas -->
        <div class="modal-section-label">Feature Quotas</div>
        <div class="modal-form-grid">
            <div class="modal-field">
                <label class="modal-label" for="subMaxUsers">
                    Max Users <span class="required-star">*</span>
                </label>
                <input id="subMaxUsers" asp-for="MaxUsers" type="number" class="modal-input"
                       placeholder="e.g. 50" required>
                <span class="field-hint">Maximum number of user accounts allowed.</span>
            </div>
            <div class="modal-field">
                <label class="modal-label" for="subMaxApps">
                    Max Applications <span class="required-star">*</span>
                </label>
                <input id="subMaxApps" asp-for="MaxApps" type="number" class="modal-input"
                       placeholder="e.g. 10" required>
                <span class="field-hint">Maximum number of client applications.</span>
            </div>
        </div>

        <!-- Section: Advanced -->
        <div class="modal-section-label">Isolation Strategy</div>
        <div class="modal-field">
            <label class="modal-toggle-row" for="subSeparateDb">
                <div>
                    <div class="modal-label" style="margin-bottom:2px;">Allow Separate Database</div>
                    <span class="field-hint" style="margin-top:0;">
                        Enable isolated database infrastructure for tenants on this plan.
                    </span>
                </div>
                <div class="toggle-switch">
                    <input type="checkbox" id="subSeparateDb" asp-for="AllowSeparateDb">
                    <span class="toggle-track">
                        <span class="toggle-thumb"></span>
                    </span>
                </div>
            </label>
        </div>

    </div><!-- /modal-body -->
    <!-- Modal Footer -->
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="window.closeModal()">Cancel</button>
        <button type="submit" class="btn btn-primary" id="submitSubscriptionForm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            @(Model.Id == Guid.Empty ? "Create Plan" : "Update Plan")
        </button>
    </div>
</form>

<script>
    $('#createSubscriptionForm').off('submit').on('submit', function(e) {
        e.preventDefault();
        if (!window.validateAjaxForm(this)) {
            return;
        }

        const $btn = $('#submitSubscriptionForm');
        $btn.prop('disabled', true).html('Processing...');

        const formData = $(this).serialize();

        $.post('/Home/CreateSubscription', formData, function(result) {
            if (result.succeeded) {
                window.closeModal();
                if($('#subscriptionTable').length) {
                    $('#subscriptionTable').DataTable().ajax.reload();
                } else {
                    location.reload();
                }
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error Saving Subscription',
                    text: window.getPrimaryResultMessage(result, 'Unknown error')
                });
                $btn.prop('disabled', false).html('@(Model.Id == Guid.Empty ? "Create Plan" : "Update Plan")');
            }
        }).fail(function(xhr) {
            window.showRequestError({
                title: 'Unable to Save Plan',
                xhr: xhr,
                fallbackMessage: 'We could not save the subscription plan right now. Please try again.'
            });
            $btn.prop('disabled', false).html('@(Model.Id == Guid.Empty ? "Create Plan" : "Update Plan")');
        });
    });
</script>
