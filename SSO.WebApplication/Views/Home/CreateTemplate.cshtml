    <!-- REMARKS FIELD (Edit mode only) -->
    @await Html.PartialAsync("_EditRemarksPartial", isEdit)

    <!-- Modal Footer -->
    <div class="modal-footer">
        <button type="submit" class="btn btn-primary" id="submitTemplateForm">
            @(Model.Id == Guid.Empty ? "Create Template" : "Update Template")
        </button>
    </div>
</form>

<script>
    function updateDocTemplateSummary() {
        const typeVal = $('#Type').val();
        const types = ['Excel (.xlsx)', 'Word (.docx)', 'PowerPoint (.pptx)'];
        const typeText = types[typeVal] || 'Excel (.xlsx)';
        $('#summaryDocType, .summaryDocType').text(typeText);

        const versionVal = ($('#Version').val() || '').trim();
        $('#summaryVersion, .summaryVersion').text(versionVal || '1.0.0');
    }

    $(function() {
        // Live updates for summary sidebar
        $('#Type').on('change', updateDocTemplateSummary);
        $('#Version').on('input change', updateDocTemplateSummary);
        updateDocTemplateSummary();

        // File input selection listener
        $('#TemplateFile').on('change', function() {
            const file = this.files[0];
            const $status = $('#fileSelectionStatus');
            if (file) {
                $status.html('<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="color: #10b981;"><polyline points="20 6 9 17 4 12"/></svg> ' + file.name).addClass('selected');
            } else {
                $status.text('No file chosen').removeClass('selected');
            }
        });

        // Drag and drop handlers for dropzone
        const dropzone = document.getElementById('ctDropzone');
        if (dropzone) {
            ['dragenter', 'dragover'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => { e.preventDefault(); e.stopPropagation(); dropzone.classList.add('dragover'); }, false);
            });
            ['dragleave', 'drop'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => { e.preventDefault(); e.stopPropagation(); dropzone.classList.remove('dragover'); }, false);
            });
        }

        const wizard = window.initWizardForm('#createTemplateForm', {
            onFinished: function() {
                var form = document.getElementById('createTemplateForm');
                
                var fileInput = document.getElementById('TemplateFile');
                var file = fileInput.files[0];
                var allowedExtensions = ['.xlsx', '.docx', '.pptx'];
                var maxBytes = 15 * 1024 * 1024;

                if (file) {
                    var normalizedName = file.name.toLowerCase();
                    var hasValidExtension = allowedExtensions.some(function (ext) {
                        return normalizedName.endsWith(ext);
                    });

                    if (!hasValidExtension) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Invalid File',
                            text: 'Please upload an Excel, Word, or PowerPoint template file.'
                        });
                        return false;
                    }

                    if (file.size > maxBytes) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'File Too Large',
                            text: 'Template files must be 15 MB or smaller.'
                        });
                        return false;
                    }
                }

                const $btn = $('.wizard-btn-save');
                const originalHtml = $btn.html();

                // Validate remarks before submission (edit mode only)
                if (typeof validateRemarks === 'function' && !validateRemarks()) return;

                $btn.prop('disabled', true).html('<svg class="et-spin" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px; display: inline-block; vertical-align: middle;"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Saving…');

                var formData = new FormData(form);

                $.ajax({
                    url: '/Home/CreateTemplate',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.succeeded) {
                            window.closeModal();
                            if (window.onModalSuccess) {
                                window.onModalSuccess();
                            } else if ($('#templateTable').length) {
                                $('#templateTable').DataTable().ajax.reload();
                            } else {
                                location.reload();
                            }
                            Swal.fire({
                                icon: 'success',
                                title: 'Saved',
                                text: response.messages?.[0] || 'Template saved successfully.',
                                showConfirmButton: false,
                                timer: 1500
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Unable to Save Template',
                                text: window.getPrimaryResultMessage ? window.getPrimaryResultMessage(response, 'We could not save the template right now.') : 'Could not save template.'
                            });
                            $btn.prop('disabled', false).html(originalHtml);
                        }
                    },
                    error: function (xhr) {
                        window.showRequestError({
                            title: 'Unable to Save Template',
                            xhr: xhr,
                            fallbackMessage: 'We could not save the template right now. Please check the file and try again.'
                        });
                        $btn.prop('disabled', false).html(originalHtml);
                    }
                });
            }
        });
    });
</script>
