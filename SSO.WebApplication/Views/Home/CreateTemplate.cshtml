@model SSO.Application.Features.Templates.Commands.AddEdit.AddEditTemplateCommand
@{
    Layout = null;
}
<div class="modal-body p-4">
    <form id="createTemplateForm" onsubmit="return submitTemplateForm(event)">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Content" id="hiddenContentPath" />
        <div class="form-group mb-3">
            <label class="form-label text-sm fw-medium text-muted">Template Name</label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Monthly Invoice" required maxlength="100" />
        </div>

        <div class="form-group mb-3">
            <label class="form-label text-sm fw-medium text-muted">Logical Key</label>
            <input asp-for="Key" class="form-control" placeholder="e.g. INVOICE_V1" required maxlength="50" style="text-transform: uppercase;" />
            <small class="text-muted">Used by developers or backend to map data.</small>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label text-sm fw-medium text-muted">Document Type</label>
                <select asp-for="Type" class="form-select" required>
                    <option value="0">Excel (.xlsx)</option>
                    <option value="1">Word (.docx)</option>
                    <option value="2">PowerPoint (.pptx)</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label text-sm fw-medium text-muted">Version</label>
                <input asp-for="Version" class="form-control" required maxlength="10" />
            </div>
        </div>

        <div class="form-group mb-4">
            <label class="form-label text-sm fw-medium text-muted">Upload Template File</label>
            <input type="file" id="TemplateFile" name="TemplateFile" class="form-control" accept=".xlsx,.docx,.pptx" @(Model.Id == Guid.Empty ? "required" : "") />
            @if(Model.Id != Guid.Empty && !string.IsNullOrEmpty(Model.Content))
            {
                <small class="text-brand">Current file: @System.IO.Path.GetFileName(Model.Content)</small>
            }
            else
            {
                <small class="text-muted">Supported formats: Excel, Word, PPT.</small>
            }
        </div>

        <div class="modal-footer px-0 pb-0" style="border-top: 1px solid var(--border-color); padding-top: 16px!important; margin-top: 16px;">
            <button type="button" class="btn btn-secondary" onclick="closeModal()">Cancel</button>
            <button type="submit" class="btn btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                    <polyline points="17 21 17 13 7 13 7 21"></polyline>
                    <polyline points="7 3 7 8 15 8"></polyline>
                </svg>
                Save Template
            </button>
        </div>
    </form>
</div>

<script>
    function submitTemplateForm(e) {
        e.preventDefault();
        var form = document.getElementById('createTemplateForm');
        if (!window.validateAjaxForm(form)) {
            return false;
        }

        var fileInput = document.getElementById('TemplateFile');
        var file = fileInput.files[0];
        var allowedExtensions = ['.xlsx', '.docx', '.pptx'];
        var maxBytes = 15 * 1024 * 1024;

        if (file) {
            var normalizedName = file.name.toLowerCase();
            var hasValidExtension = allowedExtensions.some(function (ext) {
                return normalizedName.endsWith(ext);
            });

            if (!hasValidExtension) {
                alert('Please upload an Excel, Word, or PowerPoint template file.');
                return false;
            }

            if (file.size > maxBytes) {
                alert('Template files must be 15 MB or smaller.');
                return false;
            }
        }

        var formData = new FormData(form);

        $.ajax({
            url: '/Home/CreateTemplate',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                if (response.succeeded) {
                    closeModal();
                    $('#templateTable').DataTable().ajax.reload();
                    Swal.fire({
                        icon: 'success',
                        title: 'Saved',
                        text: response.messages[0] || 'Template saved successfully.',
                        showConfirmButton: false,
                        timer: 1500
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Unable to Save Template',
                        text: window.getPrimaryResultMessage(response, 'We could not save the template right now.')
                    });
                }
            },
            error: function (xhr) {
                window.showRequestError({
                    title: 'Unable to Save Template',
                    xhr: xhr,
                    fallbackMessage: 'We could not save the template right now. Please check the file and try again.'
                });
            }
        });
        return false;
    }
</script>
