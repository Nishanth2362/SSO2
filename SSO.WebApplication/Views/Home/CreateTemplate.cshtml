@model SSO.Application.Features.Templates.Commands.AddEdit.AddEditTemplateCommand
@{
    Layout = null;
    var isEdit = Model.Id != Guid.Empty;
}

<style>
    /* Scope: appModal when #createTemplateForm is loaded */
    #appModal:has(#createTemplateForm) .modal-dialog {
        max-width: 940px !important;
        width: 92vw !important;
        border-radius: 24px !important;
        background: #ffffff !important;
        overflow: hidden !important;
        box-shadow: 0 25px 60px rgba(15, 23, 42, 0.16) !important;
        border: 1px solid #e2e8f0 !important;
        display: flex !important;
        flex-direction: column !important;
        margin: auto !important;
    }

    #appModal:has(#createTemplateForm) #modalContent {
        display: flex !important;
        flex-direction: column !important;
        padding: 0 !important;
        overflow: hidden !important;
    }

    /* Header styling with subtle teal wave background */
    #appModal:has(#createTemplateForm) .modal-header {
        position: relative !important;
        padding: 24px 32px 18px 32px !important;
        border-bottom: none !important;
        background: linear-gradient(135deg, rgba(204, 251, 241, 0.6) 0%, rgba(240, 253, 250, 0.3) 50%, #ffffff 100%) !important;
        overflow: hidden !important;
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
    }

    #appModal:has(#createTemplateForm) .modal-header::after {
        content: '';
        position: absolute;
        top: -10px;
        right: -10px;
        width: 340px;
        height: 140px;
        background: radial-gradient(circle at 85% 20%, rgba(20, 184, 166, 0.2) 0%, rgba(13, 148, 136, 0.08) 45%, transparent 75%);
        pointer-events: none;
        z-index: 0;
    }

    #appModal:has(#createTemplateForm) #modalIcon {
        display: flex !important;
        align-items: center;
        justify-content: center;
        width: 48px !important;
        height: 48px !important;
        border-radius: 14px !important;
        background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%) !important;
        box-shadow: 0 8px 20px rgba(19, 178, 161, 0.28) !important;
        color: #ffffff !important;
        flex-shrink: 0;
    }

    #appModal:has(#createTemplateForm) .modal-title {
        font-size: 1.45rem !important;
        font-weight: 700 !important;
        color: #0f172a !important;
        margin: 0 !important;
        letter-spacing: -0.02em !important;
    }

    #appModal:has(#createTemplateForm) .modal-subtitle {
        font-size: 0.88rem !important;
        color: #64748b !important;
        margin-top: 3px !important;
        margin-bottom: 0 !important;
    }

    #appModal:has(#createTemplateForm) .modal-close-btn {
        position: relative;
        z-index: 1;
        width: 34px !important;
        height: 34px !important;
        border-radius: 50% !important;
        background: #ffffff !important;
        border: 1px solid #e2e8f0 !important;
        color: #64748b !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04) !important;
        transition: all 0.2s ease !important;
        cursor: pointer;
    }

    #appModal:has(#createTemplateForm) .modal-close-btn:hover {
        background: #f8fafc !important;
        color: #0f172a !important;
        border-color: #cbd5e1 !important;
    }

    /* Stepper Styling */
    #createTemplateForm .wizard-steps-header {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px 32px 20px 32px;
        background: #ffffff;
        gap: 0;
        border-bottom: 1px solid #f1f5f9;
        margin-bottom: 16px;
    }

    #createTemplateForm .wizard-step-indicator {
        display: flex;
        align-items: center;
        gap: 10px;
        position: relative;
    }

    #createTemplateForm .wizard-step-indicator:not(:last-child)::after {
        content: '';
        height: 3px;
        width: 140px;
        background: #e2e8f0;
        margin: 0 16px;
        border-radius: 2px;
        transition: background 0.3s ease;
    }

    #createTemplateForm .wizard-step-indicator.active:not(:last-child)::after,
    #createTemplateForm .wizard-step-indicator.completed:not(:last-child)::after {
        background: linear-gradient(to right, #14b8a6 0%, #2dd4bf 100%);
    }

    #createTemplateForm .step-number {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #ffffff;
        border: 2px solid #cbd5e1;
        color: #64748b;
        font-size: 0.85rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.25s ease;
    }

    #createTemplateForm .wizard-step-indicator.active .step-number {
        background: #13B2A1;
        border-color: #13B2A1;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(19, 178, 161, 0.3);
    }

    #createTemplateForm .wizard-step-indicator.completed .step-number {
        background: #10b981;
        border-color: #10b981;
        color: #ffffff;
    }

    #createTemplateForm .step-label {
        font-size: 0.88rem;
        font-weight: 600;
        color: #64748b;
        transition: color 0.25s ease;
    }

    #createTemplateForm .wizard-step-indicator.active .step-label {
        color: #13B2A1;
        font-weight: 700;
    }

    #createTemplateForm .wizard-step-indicator.completed .step-label {
        color: #0f172a;
    }

    /* Main Form Layout (Two-Column) */
    .ct-step-layout {
        display: grid;
        grid-template-columns: 1.35fr 1fr;
        gap: 24px;
        padding: 4px 32px 24px 32px;
    }

    /* Left Column (Main Form Panel) */
    .ct-form-main {
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        border-radius: 18px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .ct-section-header {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 2px;
    }

    .ct-section-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #ccfbf1;
        color: #13B2A1;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .ct-section-title {
        font-size: 0.8rem;
        font-weight: 800;
        color: #13B2A1;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .ct-section-subtitle {
        font-size: 0.78rem;
        color: #64748b;
        margin-top: 1px;
    }

    /* Field Group & Inputs */
    .ct-field-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .ct-field-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .ct-required-star {
        color: #ef4444;
        font-weight: 700;
    }

    .ct-input-wrapper {
        position: relative;
        width: 100%;
        display: flex;
        align-items: center;
    }

    .ct-input-icon {
        position: absolute;
        left: 14px;
        color: #64748b;
        pointer-events: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ct-input {
        width: 100%;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 10px 14px 10px 42px;
        font-size: 0.88rem;
        color: #1e293b;
        transition: all 0.2s ease;
        outline: none;
    }

    .ct-input:focus {
        border-color: #14b8a6;
        box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.12);
    }

    .ct-input::placeholder {
        color: #94a3b8;
    }

    .ct-field-hint {
        font-size: 0.75rem;
        color: #64748b;
        margin-top: 2px;
    }

    /* Select Inputs with Icons */
    .ct-select-wrapper {
        position: relative;
        width: 100%;
        display: flex;
        align-items: center;
    }

    .ct-select {
        width: 100%;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 10px 36px 10px 42px;
        font-size: 0.88rem;
        color: #1e293b;
        appearance: none;
        -webkit-appearance: none;
        outline: none;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .ct-select:focus {
        border-color: #14b8a6;
        box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.12);
    }

    .ct-select-chevron {
        position: absolute;
        right: 12px;
        pointer-events: none;
        color: #64748b;
    }

    /* Step 2 File Upload Drop Zone */
    .ct-dropzone {
        background: #ffffff;
        border: 2px dashed #cbd5e1;
        border-radius: 14px;
        padding: 32px 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.25s ease;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .ct-dropzone:hover, .ct-dropzone.dragover {
        border-color: #13B2A1;
        background: #f0fdfa;
    }

    .ct-dropzone-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: #e6fffa;
        color: #13B2A1;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
    }

    .ct-dropzone-title {
        font-size: 0.92rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 4px;
    }

    .ct-dropzone-subtitle {
        font-size: 0.78rem;
        color: #64748b;
        margin-bottom: 12px;
    }

    .ct-file-input {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
        width: 100%;
        height: 100%;
    }

    .ct-file-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #f1f5f9;
        color: #64748b;
        border-radius: 20px;
        padding: 4px 14px;
        font-size: 0.78rem;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .ct-file-status.selected {
        background: #dcfce7;
        color: #15803d;
    }

    /* Right Column (Template Overview Sidebar) */
    .ct-summary-sidebar {
        background: #f8fafc;
        border: 1px solid #ccfbf1;
        border-radius: 18px;
        padding: 22px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 18px;
    }

    .ct-summary-header {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding-bottom: 12px;
        border-bottom: 1px dashed #cbd5e1;
    }

    .ct-summary-header-icon {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: #ccfbf1;
        color: #13B2A1;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .ct-summary-header-title {
        font-size: 0.78rem;
        font-weight: 800;
        color: #13B2A1;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .ct-summary-header-subtitle {
        font-size: 0.75rem;
        color: #64748b;
        margin-top: 1px;
    }

    /* Summary Illustration Box */
    .ct-summary-illustration {
        position: relative;
        width: 100%;
        height: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 4px 0;
    }

    .ct-summary-illustration-blob {
        position: absolute;
        width: 220px;
        height: 110px;
        background: radial-gradient(circle at 50% 50%, rgba(204, 251, 241, 0.9) 0%, rgba(224, 253, 249, 0.4) 60%, rgba(255, 255, 255, 0) 100%);
        border-radius: 50%;
        filter: blur(18px);
        z-index: 0;
    }

    .ct-summary-illustration-svg {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    /* Summary Stats Card */
    .ct-summary-stats-card {
        background: #ffffff;
        border: 1px solid #f1f5f9;
        border-radius: 14px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }

    .ct-summary-stat-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .ct-summary-stat-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .ct-summary-stat-icon {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: #e6fffa;
        color: #13B2A1;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .ct-summary-stat-label {
        font-size: 0.82rem;
        font-weight: 600;
        color: #1e293b;
    }

    .ct-summary-stat-value {
        font-size: 0.82rem;
        font-weight: 700;
        color: #0f172a;
    }

    /* Modal Footer Buttons */
    #appModal:has(#createTemplateForm) .modal-footer {
        padding: 16px 32px 24px 32px !important;
        border-top: 1px solid #f1f5f9 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        background: #ffffff !important;
    }

    #appModal:has(#createTemplateForm) .wizard-btn-back,
    #appModal:has(#createTemplateForm) .wizard-btn-prev {
        background: #ffffff !important;
        border: 1px solid #e2e8f0 !important;
        color: #1e293b !important;
        border-radius: 10px !important;
        padding: 10px 24px !important;
        font-size: 0.88rem !important;
        font-weight: 600 !important;
        box-shadow: 0 2px 6px rgba(0,0,0,0.02) !important;
        cursor: pointer;
        transition: all 0.2s ease !important;
    }

    #appModal:has(#createTemplateForm) .wizard-btn-back:hover,
    #appModal:has(#createTemplateForm) .wizard-btn-prev:hover {
        background: #f8fafc !important;
        border-color: #cbd5e1 !important;
    }

    #appModal:has(#createTemplateForm) .wizard-btn-next,
    #appModal:has(#createTemplateForm) .wizard-btn-save {
        background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%) !important;
        border: none !important;
        color: #ffffff !important;
        border-radius: 10px !important;
        padding: 10px 24px !important;
        font-size: 0.88rem !important;
        font-weight: 600 !important;
        box-shadow: 0 4px 14px rgba(19, 178, 161, 0.35) !important;
        cursor: pointer;
        transition: all 0.2s ease !important;
    }

    #appModal:has(#createTemplateForm) .wizard-btn-next:hover,
    #appModal:has(#createTemplateForm) .wizard-btn-save:hover {
        background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%) !important;
        box-shadow: 0 6px 18px rgba(19, 178, 161, 0.45) !important;
        transform: translateY(-1px);
    }
</style>

<form id="createTemplateForm" class="wizard-container" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Content" id="hiddenContentPath" />

    <div class="modal-body" style="padding: 0;">

        <!-- Step 1: General Info -->
        <div class="wizard-step" data-title="General Info">
            <div class="ct-step-layout">
                <!-- LEFT COLUMN: Main Form Panel -->
                <div class="ct-form-main">
                    
                    <!-- Section Header -->
                    <div class="ct-section-header">
                        <div class="ct-section-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                                <line x1="16" y1="13" x2="8" y2="13"/>
                                <line x1="16" y1="17" x2="8" y2="17"/>
                            </svg>
                        </div>
                        <div>
                            <div class="ct-section-title">GENERAL DETAILS</div>
                            <div class="ct-section-subtitle">Provide basic information for your document template.</div>
                        </div>
                    </div>

                    <!-- Template Name -->
                    <div class="ct-field-group">
                        <label class="ct-field-label" for="Name">
                            Template Name <span class="ct-required-star">*</span>
                        </label>
                        <div class="ct-input-wrapper">
                            <span class="ct-input-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                </svg>
                            </span>
                            <input asp-for="Name" class="ct-input" placeholder="e.g. Monthly Invoice" required maxlength="100" autocomplete="off" />
                        </div>
                    </div>

                    <!-- Logical Key -->
                    <div class="ct-field-group">
                        <label class="ct-field-label" for="Key">
                            Logical Key <span class="ct-required-star">*</span>
                        </label>
                        <div class="ct-input-wrapper">
                            <span class="ct-input-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                                </svg>
                            </span>
                            <input asp-for="Key" class="ct-input" placeholder="e.g. INVOICE_V1" required maxlength="50" style="text-transform: uppercase;" autocomplete="off" />
                        </div>
                        <div class="ct-field-hint">Used by developers or backend to map data.</div>
                    </div>

                    <!-- Side-by-Side Grid: Document Type & Version -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <!-- Document Type -->
                        <div class="ct-field-group">
                            <label class="ct-field-label" for="Type">
                                Document Type <span class="ct-required-star">*</span>
                            </label>
                            <div class="ct-select-wrapper">
                                <span class="ct-input-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                        <line x1="3" y1="9" x2="21" y2="9"/>
                                        <line x1="9" y1="21" x2="9" y2="9"/>
                                    </svg>
                                </span>
                                <select asp-for="Type" id="Type" class="ct-select" required>
                                    <option value="0">Excel (.xlsx)</option>
                                    <option value="1">Word (.docx)</option>
                                    <option value="2">PowerPoint (.pptx)</option>
                                </select>
                                <svg class="ct-select-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </div>
                        </div>

                        <!-- Version -->
                        <div class="ct-field-group">
                            <label class="ct-field-label" for="Version">
                                Version <span class="ct-required-star">*</span>
                            </label>
                            <div class="ct-input-wrapper">
                                <span class="ct-input-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                                        <line x1="7" y1="7" x2="7.01" y2="7"/>
                                    </svg>
                                </span>
                                <input asp-for="Version" id="Version" class="ct-input" required maxlength="10" placeholder="e.g. 1.0.0" autocomplete="off" />
                            </div>
                        </div>
                    </div>

                </div><!-- /ct-form-main -->

                <!-- RIGHT COLUMN: Template Overview Sidebar -->
                <div class="ct-summary-sidebar">
                    <div>
                        <!-- Header -->
                        <div class="ct-summary-header">
                            <div class="ct-summary-header-icon">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                </svg>
                            </div>
                            <div>
                                <div class="ct-summary-header-title">TEMPLATE OVERVIEW</div>
                                <div class="ct-summary-header-subtitle">This template will be available for all users in the organization.</div>
                            </div>
                        </div>

                        <!-- Illustration Box -->
                        <div class="ct-summary-illustration">
                            <div class="ct-summary-illustration-blob"></div>
                            <svg class="ct-summary-illustration-svg" viewBox="0 0 300 150" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <defs>
                                    <linearGradient id="ctDocGrad" x1="0" y1="0" x2="1" y2="1">
                                        <stop offset="0%" stop-color="#14b8a6"/>
                                        <stop offset="100%" stop-color="#0d9488"/>
                                    </linearGradient>
                                    <filter id="ctSoftShadow" x="-20%" y="-20%" width="140%" height="140%">
                                        <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#0d9488" flood-opacity="0.2"/>
                                    </filter>
                                </defs>

                                <!-- Leaf / Sparkle Backdrop -->
                                <g opacity="0.6">
                                    <path d="M 115 95 C 85 75, 70 55, 82 38 C 95 60, 105 80, 115 95 Z" fill="#99f6e4"/>
                                    <path d="M 185 95 C 215 75, 230 55, 218 38 C 205 60, 195 80, 185 95 Z" fill="#99f6e4"/>
                                </g>

                                <!-- Document Card Graphic -->
                                <g transform="translate(110, 25)" filter="url(#ctSoftShadow)">
                                    <rect x="0" y="0" width="80" height="100" rx="10" fill="#ffffff"/>
                                    <path d="M 58 0 L 80 22 L 58 22 Z" fill="#cbd5e1"/>
                                    <rect x="14" y="24" width="52" height="6" rx="3" fill="url(#ctDocGrad)"/>
                                    <rect x="14" y="38" width="52" height="4" rx="2" fill="#cbd5e1"/>
                                    <rect x="14" y="48" width="40" height="4" rx="2" fill="#e2e8f0"/>
                                    <rect x="14" y="58" width="46" height="4" rx="2" fill="#e2e8f0"/>
                                    <rect x="14" y="68" width="32" height="4" rx="2" fill="#e2e8f0"/>
                                </g>

                                <!-- Floating Green Checkmark Badge -->
                                <g transform="translate(205, 55)" filter="url(#ctSoftShadow)">
