            </div><!-- /ct-summary-section -->

        </div>
    </div><!-- /modal-body -->

    <!-- REMARKS FIELD (Edit mode only) -->
    @await Html.PartialAsync("_EditRemarksPartial", Model.Id != Guid.Empty)

    <!-- FOOTER BUTTONS -->
    <div class="modal-footer wizard-footer">
        <!-- Buttons injected dynamically by initWizardForm with matching styling -->
        <button type="submit" class="btn btn-primary" id="submitCreateTenant" style="display:none;">
            @(Model.Id == Guid.Empty ? "Create Tenant" : "Update Tenant")
        </button>
    </div>
</form>

<script>
    function selectDbMode(mode) {
        $('#tenantDbMode').val(mode).trigger('change');
        if (mode === '@SSO.Domain.Enums.TenantDatabaseMode.Separate' || mode === 'Separate') {
            $('#cardDbSeparate').addClass('active');
            $('#cardDbShared').removeClass('active');
        } else {
            $('#cardDbShared').addClass('active');
            $('#cardDbSeparate').removeClass('active');
        }
        syncSummary();
    }

    function syncSummary() {
        const orgName = $('#tenantName').val() || 'Planurix SSO';
        const code = $('#tenantCode').val() || 'planurix_sso';
        const dbMode = $('#tenantDbMode').val();
        const isActive = $('#tenantIsActive').is(':checked');
        const clientsVal = $('#tenantClientIds').val();
        const appsCount = Array.isArray(clientsVal) ? clientsVal.length : 0;

        $('#summaryOrgName').text(orgName);
        $('#summaryTenantCode').text(code);

        if (dbMode === '@SSO.Domain.Enums.TenantDatabaseMode.Separate' || dbMode === 'Separate') {
            $('#summaryDatabase').html('<span class="summary-badge badge-purple">Isolated Database</span>');
        } else if (dbMode === '@SSO.Domain.Enums.TenantDatabaseMode.Shared' || dbMode === 'Shared') {
            $('#summaryDatabase').html('<span class="summary-badge badge-blue">Shared Database</span>');
        } else {
            $('#summaryDatabase').text('Not selected');
        }

        if (isActive) {
            $('#summaryStatus').attr('class', 'summary-badge badge-green').text('Active');
        } else {
            $('#summaryStatus').attr('class', 'summary-badge badge-gray').text('Inactive');
        }

        $('#summaryApps').text(appsCount > 0 ? appsCount + ' Selected' : '0');
    }

    $(function() {
        // Add ct-modal-open class to appModal for large modal sizing
        $('#appModal').addClass('ct-modal-open');

        // Override Header Title & Subtitle text to match reference
        $('#modalTitle').text('@(Model.Id == Guid.Empty ? "Create New Tenant" : "Update Organization")');
        $('#modalSubtitle').text('Set up a new organization in less than 2 minutes');

        /* -- DB Mode sync -- */
        const sharedDatabaseMode = '@SSO.Domain.Enums.TenantDatabaseMode.Shared';
        const $tenantDbMode      = $('#tenantDbMode');
        const $dbProviderGroup   = $('#dbProviderGroup');
        const $dbNameGroup       = $('#dbNameGroup');
        const $tenantDbProvider  = $('#tenantDatabaseProvider');
        const $tenantDbName      = $('#tenantDatabaseName');

        function syncDbMode() {
            const isShared = $tenantDbMode.val() === sharedDatabaseMode;
            $dbProviderGroup.toggle(!isShared);
            $dbNameGroup.toggle(!isShared);
            $tenantDbProvider.prop('required', !isShared);
            $tenantDbName.prop('required', !isShared);
            if (isShared) { $tenantDbProvider.val(''); $tenantDbName.val(''); }
        }
        $tenantDbMode.off('change.dbmode').on('change.dbmode', function() {
            syncDbMode();
            syncSummary();
        });
        syncDbMode();

        /* -- Client Application Toggles Sync -- */
        $('.client-app-toggle').off('change.apptoggle').on('change.apptoggle', function () {
            const clientId = $(this).data('client-id');
            const isChecked = $(this).is(':checked');
            $(`#tenantClientIds option[value="${clientId}"]`).prop('selected', isChecked);
            $('#tenantClientIds').trigger('change');
            syncSummary();
        });

        /* -- Client Application Live Search Filter -- */
        $('#clientAppSearchInput').off('input.appsearch keyup.appsearch').on('input.appsearch keyup.appsearch', function () {
            const query = $(this).val().toLowerCase().trim();
            let visibleCount = 0;

            $('.ct-app-card').each(function () {
                const text = ($(this).attr('data-search-text') || $(this).text()).toLowerCase();
                if (!query || text.indexOf(query) !== -1) {
                    $(this).removeClass('is-hidden').attr('style', 'display: flex !important;');
                    visibleCount++;
                } else {
                    $(this).addClass('is-hidden').attr('style', 'display: none !important;');
                }
            });

            if (visibleCount === 0 && query.length > 0) {
                if ($('#noMatchingAppsMsg').length === 0) {
                    $('.ct-app-search-box').after(`
                        <div id="noMatchingAppsMsg" style="font-size: 0.82rem; font-weight: 600; color: #ef4444; margin: -6px 0 12px 2px; display: flex; align-items: center; gap: 6px;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                            No applications found matching your search.
                        </div>`);
                }
            } else {
                $('#noMatchingAppsMsg').remove();
            }
        });

        /* -- Live sync summary -- */
        $('#tenantName, #tenantCode, #tenantIsActive, #tenantClientIds').on('input change', syncSummary);
        syncSummary();

        /* ── Helper: truncate filename ── */
        function truncateFilename(name, maxLength = 20) {
            if (!name || name.length <= maxLength) return name;
            return name.substring(0, maxLength) + '...';
        }

        /* ── Helper: bind upload ── */
        function bindUpload(opts) {
            $('#' + opts.inputId).on('change', function () {
                const file = this.files[0];
                if (!file) return;
                const displayName = truncateFilename(file.name, 20);
                $('#' + opts.fileNameId).text(displayName).attr('title', file.name);
                const reader = new FileReader();
                reader.onload = function (e) {
                    $('#' + opts.previewImgId).attr('src', e.target.result);
                };
                reader.readAsDataURL(file);
                $('#' + opts.fileBlockId).show();
            });

            $('#' + opts.removeBtnId).on('click', function () {
                $('#' + opts.inputId).val('');
                $('#' + opts.previewImgId).attr('src', '');
                $('#' + opts.fileNameId).text('');
                $('#' + opts.fileBlockId).hide();
            });
        }

        bindUpload({ inputId: 'tenantLogo', fileBlockId: 'logoFileBlock', previewImgId: 'logoPreview', fileNameId: 'logoFileName', removeBtnId: 'btnRemoveLogo' });
        bindUpload({ inputId: 'tenantFavicon', fileBlockId: 'faviconFileBlock', previewImgId: 'faviconPreview', fileNameId: 'faviconFileName', removeBtnId: 'btnRemoveFavicon' });

        /* -- Validation helpers -- */
        function markValid($el, errId)   { $el.removeClass('ct-invalid'); $('#' + errId).hide(); }
        function markInvalid($el, errId) { $el.addClass('ct-invalid');    $('#' + errId).show(); }

        $('#tenantName').on('input', function () {
            this.value.trim() ? markValid($(this), 'errName') : markInvalid($(this), 'errName');
        });
        $('#tenantCode').on('input', function () {
            /^[a-z0-9_]+$/.test(this.value.trim()) ? markValid($(this), 'errCode') : markInvalid($(this), 'errCode');
        });

        // Initialize 5-Step Wizard Form (Step 1 = Next; Step 2-4 = Prev+Next; Step 5 = Prev + Create Tenant)
        const wizard = window.initWizardForm('#createTenantForm', {
            showCancelButton: false,
            onStepChanging: function(currentIndex, newIndex) {
                if (newIndex > currentIndex) {
                    if (currentIndex === 0) {
                        let valid = true;
                        const $name = $('#tenantName');
                        if (!$name.val().trim()) { markInvalid($name, 'errName'); valid = false; }
                        
                        const $code = $('#tenantCode');
                        if (!/^[a-z0-9_]+$/.test($code.val().trim())) { markInvalid($code, 'errCode'); valid = false; }
                        return valid;
                    }
                    if (currentIndex === 1) {
                        let valid = true;
                        const isShared = $tenantDbMode.val() === sharedDatabaseMode;
                        if (!isShared) {
                            if (!$tenantDbProvider.val()) { $tenantDbProvider.addClass('ct-invalid'); valid = false; }
                            if (!$tenantDbName.val().trim()) { $tenantDbName.addClass('ct-invalid'); valid = false; }
                        }
                        return valid;
                    }
                }
                return true;
            },
            onFinished: function() {
                const $btn = $('.wizard-btn-save, #submitCreateTenant');
                $btn.prop('disabled', true).html('Processing...');

                $.ajax({
                    url: '/Home/CreateTenant',
                    type: 'POST',
                    data: new FormData(document.getElementById('createTenantForm')),
                    processData: false,
                    contentType: false,
                    success: function (result) {
                        if (result.succeeded) {
                            window.closeModal();
                            if (window.appToast) {
                                window.appToast.show('success', 'Tenant Saved', result.messages ? result.messages[0] : 'Tenant has been saved successfully.');
                            }
                            if (window.onModalSuccess) {
                                window.onModalSuccess();
                            } else if ($('#tenantTable').length) {
                                $('#tenantTable').DataTable().ajax.reload();
                            } else {
                                location.reload();
                            }
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error Saving Tenant',
                                text: window.getPrimaryResultMessage
                                    ? window.getPrimaryResultMessage(result, 'Unknown error')
                                    : (result.messages?.[0] || 'Unknown error')
                            });
                            resetBtn();
                        }
                    },
                    error: function (xhr) {
                        window.showRequestError({
                            title: 'Unable to Save Tenant',
                            xhr: xhr,
                            fallbackMessage: 'We could not save the tenant right now. Please try again.'
                        });
                        resetBtn();
                    }
                });

                function resetBtn() {
                    $btn.prop('disabled', false).html('@(Model.Id == Guid.Empty ? "Create Tenant" : "Update Tenant")');
                }
            }
        });
    });
</script>
