@{
    Layout = null;
    var clients = ViewBag.Clients as List<SSO.Domain.Entities.ApplicationClient> ?? new List<SSO.Domain.Entities.ApplicationClient>();
}
@model SSO.Application.Features.Tenants.Commands.AddEdit.AddEditTenentCommand

@using SSO.Common.Constants.Application

<!-- Modal Body -->
<form id="createTenantForm" novalidate>
    <input type="hidden" asp-for="Id" />
    @Html.AntiForgeryToken()
    <div class="modal-body">

        <!-- Section: Identity -->
        <div class="modal-section-label">Tenant Identity</div>
        <div class="modal-form-grid">
            <div class="modal-field">
                <label class="modal-label" for="tenantName">
                    Organization Name <span class="required-star">*</span>
                </label>
                <input id="tenantName" asp-for="Name" type="text" class="modal-input"
                       placeholder="e.g. Acme Corporation" required autocomplete="off">
                <span class="field-hint">The display name for this tenant organization.</span>
            </div>
            <div class="modal-field">
                <label class="modal-label" for="tenantCode">
                    Tenant Code <span class="required-star">*</span>
                </label>
                <input id="tenantCode" asp-for="Code" type="text" class="modal-input"
                       placeholder="e.g. acme_corp" required autocomplete="off" pattern="^[a-z0-9_]+$">
                <span class="field-hint">Unique slug used internally. Lowercase, no spaces.</span>
            </div>
        </div>

        <!-- Section: Database -->
        <div class="modal-section-label">Database Configuration</div>
        <div class="modal-form-grid">
            <div class="modal-field">
                <label class="modal-label" for="tenantDbMode">
                    Database Mode <span class="required-star">*</span>
                </label>
                <select id="tenantDbMode" asp-for="DatabaseMode" class="modal-select" required>
                    <option value="" disabled selected>Select database mode…</option>
                    <option value="@SSO.Domain.Enums.TenantDatabaseMode.Shared">Shared DB (Row-Level Security)</option>
                    <option value="@SSO.Domain.Enums.TenantDatabaseMode.Separate">Isolated DB (Dedicated Schema)</option>
                </select>
                <span class="field-hint">Determines data isolation strategy for this tenant. Separate DB requires a subscription that allows it.</span>
            </div>
            <div class="modal-field" id="dbConnectionStringGroup" style="@(Model.DatabaseMode == SSO.Domain.Enums.TenantDatabaseMode.Shared ? "display:none;" : "")">
                <label class="modal-label" for="tenantDatabaseProvider">Database Provider <span class="required-star">*</span></label>
                <select id="tenantDatabaseProvider" asp-for="DatabaseProvider" class="modal-select">
                    <option value="">Select provider...</option>
                    <option value="@ApplicationConstants.DBProvider.SqlServer">SQL Server</option>
                    <option value="@ApplicationConstants.DBProvider.Mysql">MySQL</option>
                    <option value="@ApplicationConstants.DBProvider.PostgreSql">PostgreSQL</option>
                    <option value="@ApplicationConstants.DBProvider.Oracle">Oracle</option>
                </select>
                <span class="field-hint">Choose the dedicated database engine for this tenant.</span>
            </div>
            <div class="modal-field" id="dbNameGroup" style="@(Model.DatabaseMode == SSO.Domain.Enums.TenantDatabaseMode.Shared ? "display:none;" : "")">
                <label class="modal-label" for="tenantDatabaseName">Database Name <span class="required-star">*</span></label>
                <input id="tenantDatabaseName" asp-for="DatabaseName" type="text" class="modal-input"
                       placeholder="e.g. acme_identity" autocomplete="off" maxlength="128">
                <span class="field-hint">Store only the database name. Connection secrets stay outside tenant records.</span>
            </div>
        </div>

        <!-- Section: Contact Details -->
        <div class="modal-section-label">Contact Details</div>
        <div class="modal-form-grid">
            <div class="modal-field">
                <label class="modal-label" for="tenantEmail">Email Address</label>
                <input id="tenantEmail" asp-for="Email" type="email" class="modal-input" placeholder="e.g. contact@acme.com">
            </div>
            <div class="modal-field">
                <label class="modal-label" for="tenantPhone">Phone Number</label>
                <input id="tenantPhone" asp-for="Phone" type="text" class="modal-input" placeholder="e.g. +1 555-0123">
            </div>
            <div class="modal-field">
                <label class="modal-label" for="tenantWebsite">Website</label>
                <input id="tenantWebsite" asp-for="Website" type="url" class="modal-input" placeholder="e.g. https://acme.com">
            </div>
             <div class="modal-field">
                <label class="modal-label" for="tenantAddress">Billing Address</label>
                <input id="tenantAddress" asp-for="BillingAddress" type="text" class="modal-input" placeholder="e.g. 123 Street, City, Country">
            </div>
            <div class="modal-field">
                <label class="modal-label" for="tenantGracePeriod">Grace Period (Days)</label>
                <input id="tenantGracePeriod" asp-for="GracePeriodDays" type="number" class="modal-input" placeholder="7" min="0">
                <span class="field-hint">Days allowed before SSO is blocked for unpaid invoices.</span>
            </div>
            <div class="modal-field">
                <label class="modal-label" for="tenantCurrency">Preferred Currency <span class="required-star">*</span></label>
                <select id="tenantCurrency" asp-for="Currency" class="modal-select" required>
                    <option value="INR">INR (₹) - Rupee</option>
                    <option value="USD">USD ($) - US Dollar</option>
                    <option value="EUR">EUR (€) - Euro</option>
                    <option value="GBP">GBP (£) - British Pound</option>
                </select>
                <span class="field-hint">The currency used for this organization's invoices.</span>
            </div>
        </div>

        <!-- Section: Branding -->
        <div class="modal-section-label">Branding Assets</div>
        <div class="modal-form-grid">
            <div class="modal-field">
                <label class="modal-label" for="tenantLogo">Organization Logo</label>
                <input id="tenantLogo" name="LogoFile" type="file" class="modal-input" accept="image/*">
                <span class="field-hint">Used for login page and dashboards.</span>
                @if(!string.IsNullOrEmpty(Model.LogoUrl)) {
                    <div style="margin-top: 8px;"><img src="/@Model.LogoUrl" height="30" style="border-radius:4px;" /></div>
                    <input type="hidden" asp-for="LogoUrl" />
                }
            </div>
            <div class="modal-field">
                <label class="modal-label" for="tenantFavicon">Organization Favicon</label>
                <input id="tenantFavicon" name="FaviconFile" type="file" class="modal-input" accept="image/x-icon,image/png,image/gif">
                <span class="field-hint">Logo used in browser tabs.</span>
                @if(!string.IsNullOrEmpty(Model.FaviconUrl)) {
                    <div style="margin-top: 8px;"><img src="/@Model.FaviconUrl" height="30" style="border-radius:4px;" /></div>
                    <input type="hidden" asp-for="FaviconUrl" />
                }
            </div>
        </div>

        <!-- Section: Client Applications -->
        <div class="modal-section-label">Client Applications</div>
        <div class="modal-form-grid" style="display: block;">
            <div class="modal-field">
                <label class="modal-label" for="tenantClientIds">Mapped Clients</label>
                <select id="tenantClientIds" name="ClientIds" asp-for="ClientIds" class="modal-select" multiple="multiple" style="width: 100%; height: 120px;">
                    @foreach (var client in clients)
                    {
                        <option value="@client.Id">@client.DisplayName (@client.ClientId)</option>
                    }
                </select>
                <span class="field-hint">Hold Ctrl (Windows) or Cmd (Mac) to select multiple client applications that belong to this tenant.</span>
            </div>
        </div>

        <!-- Section: Status -->
        <div class="modal-section-label">Activation</div>
        <div class="modal-field">
            <label class="modal-toggle-row" for="tenantIsActive">
                <div>
                    <div class="modal-label" style="margin-bottom:2px;">Activate Immediately</div>
                    <span class="field-hint" style="margin-top:0;">
                        If disabled, the tenant will be created
                        in an inactive state.
                    </span>
                </div>
                <div class="toggle-switch">
                    <input type="checkbox" id="tenantIsActive" asp-for="IsActive">
                    <span class="toggle-track">
                        <span class="toggle-thumb"></span>
                    </span>
                </div>
            </label>
        </div>
        <div class="modal-field">
            <label class="modal-toggle-row" for="tenantAllowPublicRegistration">
                <div>
                    <div class="modal-label" style="margin-bottom:2px;">Allow Public Registration</div>
                    <span class="field-hint" style="margin-top:0;">
                        When enabled, users can create their own accounts for this tenant from the registration page.
                    </span>
                </div>
                <div class="toggle-switch">
                    <input type="checkbox" id="tenantAllowPublicRegistration" asp-for="AllowPublicRegistration">
                    <span class="toggle-track">
                        <span class="toggle-thumb"></span>
                    </span>
                </div>
            </label>
        </div>

    </div><!-- /modal-body -->
    <!-- Modal Footer -->
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="window.closeModal()">Cancel</button>
        <button type="submit" class="btn btn-primary" id="submitCreateTenant">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            @(Model.Id == Guid.Empty ? "Create Tenant" : "Update Tenant")
        </button>
    </div>
</form>

<script>
    const sharedDatabaseMode = '@SSO.Domain.Enums.TenantDatabaseMode.Shared';
    const $tenantDbMode = $('#tenantDbMode');
    const $dbConnectionStringGroup = $('#dbConnectionStringGroup');
    const $dbNameGroup = $('#dbNameGroup');
    const $tenantDatabaseProvider = $('#tenantDatabaseProvider');
    const $tenantDatabaseName = $('#tenantDatabaseName');

    function syncTenantDatabaseMode() {
        const isSharedMode = $tenantDbMode.val() === sharedDatabaseMode;
        $dbConnectionStringGroup.toggle(!isSharedMode);
        $dbNameGroup.toggle(!isSharedMode);
        $tenantDatabaseProvider.prop('required', !isSharedMode);
        $tenantDatabaseName.prop('required', !isSharedMode);

        if (isSharedMode) {
            $tenantDatabaseProvider.val('');
            $tenantDatabaseName.val('');
        }
    }

    $tenantDbMode.off('change').on('change', syncTenantDatabaseMode);
    syncTenantDatabaseMode();

    $('#createTenantForm').off('submit').on('submit', function(e) {
        e.preventDefault();
        if (!window.validateAjaxForm(this)) {
            return;
        }

        const $btn = $('#submitCreateTenant');
        $btn.prop('disabled', true).html('Processing...');

        const formData = new FormData(this);

        $.ajax({
            url: '/Home/CreateTenant',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(result) {
                if (result.succeeded) {
                    window.closeModal();
                    if($('#tenantTable').length) {
                        $('#tenantTable').DataTable().ajax.reload();
                    } else {
                        location.reload();
                    }
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error Saving Tenant',
                        text: window.getPrimaryResultMessage(result, 'Unknown error')
                    });
                    $btn.prop('disabled', false).html('@(Model.Id == Guid.Empty ? "Create Tenant" : "Update Tenant")');
                }
            },
            error: function(xhr) {
                window.showRequestError({
                    title: 'Unable to Save Tenant',
                    xhr: xhr,
                    fallbackMessage: 'We could not save the tenant right now. Please try again.'
                });
                $btn.prop('disabled', false).html('@(Model.Id == Guid.Empty ? "Create Tenant" : "Update Tenant")');
            }
        });
    });
</script>
