@using SSO.Application.Responses.Features
@{
    Layout = null;
    var tenants = ViewBag.Tenants as List<TenantResponse> ?? new List<TenantResponse>();
    var clients = ViewBag.Clients as List<SSO.Domain.Entities.ApplicationClient> ?? new List<SSO.Domain.Entities.ApplicationClient>();
}
@model SSO.Application.Features.Users.Commands.AddEdit.AddEditUserCommand

<form id="createUserForm" novalidate>
    <input type="hidden" asp-for="Id" />
    <div class="modal-body">

        <!-- Section: Personal Info -->
        <div class="modal-section-label">User Information</div>
        <div class="modal-form-grid">
            <div class="modal-field">
                <label class="modal-label" for="userName">
                    Full Name <span class="required-star">*</span>
                </label>
                <input id="userNameField" asp-for="Name" type="text" class="modal-input"
                       placeholder="e.g. John Doe" required autocomplete="off">
            </div>
            <div class="modal-field">
                <label class="modal-label" for="userEmail">
                    Email Address <span class="required-star">*</span>
                </label>
                <input id="userEmailField" asp-for="Email" type="email" class="modal-input"
                       placeholder="e.g. john@example.com" required autocomplete="off">
            </div>
        </div>

        <div class="modal-form-grid">
            <div class="modal-field">
                <label class="modal-label" for="userUsername">
                    Username <span class="required-star">*</span>
                </label>
                <input id="userUsernameField" asp-for="UserName" type="text" class="modal-input"
                       placeholder="e.g. johndoe" required autocomplete="off">
            </div>
            <div class="modal-field">
                <label class="modal-label" for="userPhone">
                    Phone Number
                </label>
                <input id="userPhoneField" asp-for="PhoneNumber" type="text" class="modal-input"
                       placeholder="e.g. +1234567890" autocomplete="off">
            </div>
        </div>

        @if (Model.Id == null || Model.Id == Guid.Empty)
        {
            <div class="modal-form-grid">
                <div class="modal-field">
                    <label class="modal-label" for="userPassword">
                        Password <span class="required-star">*</span>
                    </label>
                    <input id="userPasswordField" asp-for="Password" type="password" class="modal-input"
                           required autocomplete="new-password">
                </div>
            </div>
        }

        <!-- Section: Assignment -->
        <div class="modal-section-label">Organization & Access</div>
        <div class="modal-form-grid">
            <div class="modal-field">
                <label class="modal-label" for="userTenant">
                    Tenant Organization <span class="required-star">*</span>
                </label>
                <select id="userTenantField" asp-for="TenantId" class="modal-select" required>
                    <option value="" selected>Select tenant...</option>
                    @foreach (var tenant in tenants)
                    {
                        <option value="@tenant.Id">@tenant.Name</option>
                    }
                </select>
            </div>
            <div class="modal-field">
                <label class="modal-label">Role Assignment</label>
                <div id="rolesListContainer" class="checkbox-list-container" style="max-height: 120px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 10px; background: rgba(0,0,0,0.15);">
                    @{
                        var availableRoles = ViewBag.Roles as List<RoleResponse> ?? new List<RoleResponse>();
                    }
                    @foreach (var role in availableRoles)
                    {
                        <div class="form-check" style="margin-bottom: 6px;">
                            <input class="form-check-input" type="checkbox" name="RoleNames" value="@role.Name" id="role_@role.Id" @(Model.RoleNames != null && Model.RoleNames.Contains(role.Name) ? "checked" : "")>
                            <label class="form-check-label" for="role_@role.Id" style="color: #ccc; font-size: 0.85rem; cursor: pointer;">
                                @role.Name
                            </label>
                        </div>
                    }
                    @if (!availableRoles.Any())
                    {
                        <span class="text-muted" style="font-size:0.75rem;">(Select tenant to see roles)</span>
                    }
                </div>
            </div>
        </div>

        <div class="modal-form-grid">
            <div class="modal-field" style="grid-column: span 2;">
                <label class="modal-label">Application Consents</label>
                <div class="checkbox-list-container" style="max-height: 120px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 10px; background: rgba(0,0,0,0.15);">
                    @foreach (var client in clients)
                    {
                        <div class="form-check" style="margin-bottom: 6px;">
                            <input class="form-check-input" type="checkbox" name="ClientIds" value="@client.Id" id="client_@client.Id" @(Model.ClientIds != null && Model.ClientIds.Contains(client.Id) ? "checked" : "")>
                            <label class="form-check-label" for="client_@client.Id" style="color: #ccc; font-size: 0.85rem; cursor: pointer;">
                                @client.DisplayName (@client.ClientId)
                            </label>
                        </div>
                    }
                </div>
                <span class="field-hint" style="margin-top:4px;">Check all apps this user can access.</span>
            </div>
        </div>

        <!-- Section: Status -->
        <div class="modal-section-label">Account Settings</div>
        <div class="modal-form-grid">
            <div class="modal-field">
                <label class="modal-toggle-row" for="userIsActive">
                    <div>
                        <div class="modal-label" style="margin-bottom:2px;">Activate Account</div>
                        <span class="field-hint" style="margin-top:0;">Allow user to log in immediately.</span>
                    </div>
                    <div class="toggle-switch">
                        <input type="checkbox" id="userIsActive" asp-for="ActivateUser">
                        <span class="toggle-track">
                            <span class="toggle-thumb"></span>
                        </span>
                    </div>
                </label>
            </div>
            <div class="modal-field">
                <label class="modal-toggle-row" for="userConfirmEmail">
                    <div>
                        <div class="modal-label" style="margin-bottom:2px;">Auto-Confirm Email</div>
                        <span class="field-hint" style="margin-top:0;">Skip email verification process.</span>
                    </div>
                    <div class="toggle-switch">
                        <input type="checkbox" id="userConfirmEmail" asp-for="AutoConfirmEmail">
                        <span class="toggle-track">
                            <span class="toggle-thumb"></span>
                        </span>
                    </div>
                </label>
            </div>
        </div>

    </div><!-- /modal-body -->
    <!-- Modal Footer -->
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="window.closeModal()">Cancel</button>
        <button type="submit" class="btn btn-primary" id="submitUserForm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            @(Model.Id == null || Model.Id == Guid.Empty ? "Create User" : "Update User")
        </button>
    </div>
</form>

<script>
    $('#userTenantField').on('change', function() {
        const tenantId = $(this).val();
        const $container = $('#rolesListContainer');
        
        if (!tenantId) {
            $container.html('<span class="text-muted" style="font-size:0.75rem;">(Select tenant to see roles)</span>');
            return;
        }

        $container.html('<span class="text-muted" style="font-size:0.75rem;">Loading roles...</span>');

        $.get('/Home/GetRolesByTenant', { tenantId: tenantId }, function(result) {
            if (result.succeeded && result.data) {
                let html = '';
                result.data.forEach(role => {
                    html += `
                        <div class="form-check" style="margin-bottom: 6px;">
                            <input class="form-check-input" type="checkbox" name="RoleNames" value="${role.name}" id="role_${role.id}">
                            <label class="form-check-label" for="role_${role.id}" style="color: #ccc; font-size: 0.85rem; cursor: pointer;">
                                ${role.name}
                            </label>
                        </div>`;
                });
                if (!result.data.length) {
                    html = '<span class="text-muted" style="font-size:0.75rem;">No roles found for this tenant.</span>';
                }
                $container.html(html);
            } else {
                $container.html('<span class="text-error" style="font-size:0.75rem;">Error loading roles.</span>');
            }
        });
    });

    $('#createUserForm').off('submit').on('submit', function(e) {
        e.preventDefault();
        if (!window.validateAjaxForm(this)) {
            return;
        }

        const $btn = $('#submitUserForm');
        $btn.prop('disabled', true).html('Processing...');

        const formData = $(this).serialize();

        $.post('/Home/CreateUser', formData, function(result) {
            if (result.succeeded) {
                window.closeModal();
                if(window.dt) {
                    window.dt.ajax.reload();
                } else {
                    location.reload();
                }
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error Saving User',
                    text: window.getPrimaryResultMessage(result, 'Unknown error')
                });
                $btn.prop('disabled', false).html('@(Model.Id == null || Model.Id == Guid.Empty ? "Create User" : "Update User")');
            }
        }).fail(function(xhr) {
            window.showRequestError({
                title: 'Unable to Save User',
                xhr: xhr,
                fallbackMessage: 'We could not save the user right now. Please try again.'
            });
            $btn.prop('disabled', false).html('@(Model.Id == null || Model.Id == Guid.Empty ? "Create User" : "Update User")');
        });
    });
</script>
