@model Guid
@{
    Layout = null;
}

<div class="modal-body">
    <div style="text-align: center; padding: 20px;">
        <div style="color: var(--status-error); margin-bottom: 20px;">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
        </div>
        <h3 style="margin-bottom: 12px;">Delete Application?</h3>
        <p style="color: var(--text-muted); line-height: 1.5;">
            You are about to permanently remove this OIDC client and all associated configurations. 
            This action <strong>cannot be undone</strong>.
        </p>
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" onclick="window.closeModal()">Keep Application</button>
    <button type="button" class="btn btn-error" id="confirmDeleteClient">
        Confirm Removal
    </button>
</div>

<script>
    $('#confirmDeleteClient').off('click').on('click', function() {
        const $btn = $(this);
        $btn.prop('disabled', true).html('Deleting...');

        $.post('/Home/DeleteClient', { Id: '@Model' }, function(result) {
            if (result.succeeded) {
                window.closeModal();
                if (window.onModalSuccess) {
                    window.onModalSuccess(result);
                }
                Swal.fire({
                    icon: 'success',
                    title: 'Deleted!',
                    text: 'The application has been permanently removed.',
                    showConfirmButton: false,
                    timer: 1500
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: window.getPrimaryResultMessage(result, 'Could not delete application.')
                });
                $btn.prop('disabled', false).html('Confirm Removal');
            }
        }).fail(function(xhr) {
            window.showRequestError({
                title: 'Unable to Delete Application',
                xhr: xhr,
                fallbackMessage: 'We could not delete the application right now. Please try again.'
            });
            $btn.prop('disabled', false).html('Confirm Removal');
        });
    });
</script>
