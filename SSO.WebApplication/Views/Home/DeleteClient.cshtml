@model Guid
@{
    Layout = null;
}

<div class="modal-body" style="padding: 20px;">
    <p style="color: var(--text-muted); font-size: 0.85rem; margin: 0 0 16px; line-height: 1.5;">
        This cannot be undone. Type <strong style="color: var(--text-main); font-weight: 700;">DELETE</strong> to confirm.
    </p>
    <div style="margin-bottom: 8px;">
        <input type="text" class="form-input delete-confirm-input" placeholder="Type DELETE to confirm" autocomplete="off" style="width: 100%; height: 40px; padding: 0 12px; font-size: 0.88rem; border-radius: var(--radius-md, 8px); border: 1px solid var(--border-subtle); background: var(--bg-base); color: var(--text-main);" />
    </div>
</div>

<div class="modal-footer" style="display: flex; justify-content: flex-end; gap: 10px; padding: 14px 20px; border-top: 1px solid var(--border-subtle);">
    <button type="button" class="btn btn-secondary" onclick="window.closeModal()">Cancel</button>
    <button type="button" class="btn btn-error btn-delete-confirm" id="confirmDeleteClient" disabled style="opacity: 0.5; cursor: not-allowed;">
        Delete forever
    </button>
</div>

<script>
    $('.delete-confirm-input').off('input keyup paste change').on('input keyup paste change', function() {
        const val = $(this).val().trim();
        const $btn = $('#confirmDeleteClient');
        if (val === 'DELETE') {
            $btn.prop('disabled', false).css({ opacity: '1', cursor: 'pointer' });
        } else {
            $btn.prop('disabled', true).css({ opacity: '0.5', cursor: 'not-allowed' });
        }
    });

    $('#confirmDeleteClient').off('click').on('click', function() {
        const $input = $(this).closest('.modal-footer').siblings('.modal-body').find('.delete-confirm-input');
        if ($input.length && $input.val().trim() !== 'DELETE') return;

        const $btn = $(this);
        $btn.prop('disabled', true).html('Deleting...');

        $.post('/Home/DeleteClient', { Id: '@Model' }, function(result) {
            if (result.succeeded) {
                window.closeModal();
                if (window.appToast) {
                    window.appToast.show('delete', 'Application Deleted', result.messages ? result.messages[0] : 'Application has been deleted successfully.');
                }
                if (window.onModalSuccess) {
                    window.onModalSuccess(result);
                }
            } else {
                if (window.appToast) {
                    window.appToast.show('error', 'Delete Failed', result.messages ? result.messages[0] : 'Failed to delete application.');
                }
                $btn.prop('disabled', false).html('Delete forever');
            }
        }).fail(function(xhr) {
            window.showRequestError({
                title: 'Unable to Delete Application',
                xhr: xhr,
                fallbackMessage: 'We could not delete the application right now. Please try again.'
            });
            $btn.prop('disabled', false).html('Delete forever');
        });
    });
</script>
