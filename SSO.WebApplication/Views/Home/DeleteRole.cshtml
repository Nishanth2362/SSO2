@{
    Layout = null;
}
@model SSO.Application.Features.Roles.Commands.Delete.DeleteRoleCommand

<form id="deleteRoleForm">
    <input type="hidden" asp-for="Id" />
    <div class="modal-body">
        <div style="text-align: center; padding: 20px 0;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-error" style="margin-bottom: 16px;">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <h3 style="margin-bottom: 8px;">Are you sure?</h3>
            <p style="color: var(--text-muted); font-size: 0.95rem;">
                This action cannot be undone. This will permanently delete the selected role across the system.
            </p>
        </div>
    </div>
    <div class="modal-footer" style="justify-content: center; border-top: none; padding-top: 0;">
        <button type="button" class="btn btn-secondary" onclick="window.closeModal()">Cancel</button>
        <button type="submit" class="btn text-error" id="submitDeleteRole" style="background: rgba(239, 68, 68, 0.1);">
            Yes, Delete Role
        </button>
    </div>
</form>

<script>
    $('#deleteRoleForm').on('submit', function (e) {
        e.preventDefault();
        const $btn = $('#submitDeleteRole');
        $btn.prop('disabled', true).html('Deleting...');

        $.post('/Home/DeleteRole', $(this).serialize(), function (result) {
            if (result.succeeded) {
                window.closeModal();
                if ($('#roleTable').length) {
                    $('#roleTable').DataTable().ajax.reload(null, false);
                } else {
                    location.reload();
                }
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error Deleting Role',
                    text: window.getPrimaryResultMessage(result, 'Unknown error')
                });
                $btn.prop('disabled', false).html('Yes, Delete Role');
            }
        }).fail(function(xhr) {
            window.showRequestError({
                title: 'Unable to Delete Role',
                xhr: xhr,
                fallbackMessage: 'We could not delete the role right now. Please try again.'
            });
            $btn.prop('disabled', false).html('Yes, Delete Role');
        });
    });
</script>
