@{
    Layout = null;
}
@model SSO.Application.Features.Subscriptions.Commands.Delete.DeleteSubscriptionCommand

<form id="deleteSubscriptionForm">
    <input type="hidden" asp-for="Id" />
    <div class="modal-body">
        <div class="modal-section-label">Are you absolutely sure?</div>
        <p style="color: var(--text-muted); margin-top: 8px;">
            This action will permanently delete the <strong>Subscription Plan</strong>. Active tenants using this plan may lose access to critical features or quotas.
        </p>
    </div><!-- /modal-body -->
    <!-- Modal Footer -->
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="window.closeModal()">Cancel</button>
        <button type="submit" class="btn btn-error" id="confirmDeleteSubscription">
            Delete Plan
        </button>
    </div>
</form>

<script>
    $('#deleteSubscriptionForm').off('submit').on('submit', function(e) {
        e.preventDefault();
        const $btn = $('#confirmDeleteSubscription');
        $btn.prop('disabled', true).html('Processing...');

        const formData = $(this).serialize();

        $.post('/Home/DeleteSubscription', formData, function(result) {
            if (result.succeeded) {
                window.closeModal();
                if($('#subscriptionTable').length) {
                    $('#subscriptionTable').DataTable().ajax.reload();
                } else {
                    location.reload();
                }
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error Deleting Plan',
                    text: window.getPrimaryResultMessage(result, 'Unknown error')
                });
                $btn.prop('disabled', false).html('Delete Plan');
            }
        }).fail(function(xhr) {
            window.showRequestError({
                title: 'Unable to Delete Plan',
                xhr: xhr,
                fallbackMessage: 'We could not delete the subscription plan right now. Please try again.'
            });
            $btn.prop('disabled', false).html('Delete Plan');
        });
    });
</script>
