@{
    Layout = null;
}
@model SSO.Application.Features.Tenants.Commands.Delete.DeleteTenantCommand

<form id="deleteTenantForm">
    <input type="hidden" asp-for="Id" />
    <div class="modal-body">
        <div class="modal-section-label">Are you absolutely sure?</div>
        <p style="color: var(--text-muted); margin-top: 8px;">
            This action is <strong>IRREVERSIBLE</strong>. This will permanently delete the organization tenant, all associated users, applications, and configurations.
        </p>
    </div><!-- /modal-body -->
    <!-- Modal Footer -->
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="window.closeModal()">Cancel</button>
        <button type="submit" class="btn btn-error" id="confirmDeleteTenant">
            Destroy Tenant Organization
        </button>
    </div>
</form>

<script>
    $('#deleteTenantForm').off('submit').on('submit', function(e) {
        e.preventDefault();
        const $btn = $('#confirmDeleteTenant');
        $btn.prop('disabled', true).html('Processing...');

        const formData = $(this).serialize();

        $.post('/Home/DeleteTenant', formData, function(result) {
            if (result.succeeded) {
                window.closeModal();
                if(window.dt) {
                    window.dt.ajax.reload();
                } else if($('#tenantTable').length) {
                    $('#tenantTable').DataTable().ajax.reload();
                } else {
                    location.reload();
                }
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error Deleting Tenant',
                    text: window.getPrimaryResultMessage(result, 'Unknown error')
                });
                $btn.prop('disabled', false).html('Destroy Tenant Organization');
            }
        }).fail(function(xhr) {
            window.showRequestError({
                title: 'Unable to Delete Tenant',
                xhr: xhr,
                fallbackMessage: 'We could not delete this tenant right now. Please try again.'
            });
            $btn.prop('disabled', false).html('Destroy Tenant Organization');
        });
    });
</script>
