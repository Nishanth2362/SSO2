@{
    Layout = null;
}
@model SSO.Application.Features.Users.Commands.Delete.DeleteUserCommand

<form id="deleteUserForm">
    <input type="hidden" asp-for="Id" />
    <div class="modal-body">
        <div class="modal-section-label">Are you absolutely sure?</div>
        <p style="color: var(--text-muted); margin-top: 8px;">
            This action cannot be undone. This will permanently delete the user account and remove their access from all assigned resources.
        </p>
    </div><!-- /modal-body -->
    <!-- Modal Footer -->
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="window.closeModal()">Cancel</button>
        <button type="submit" class="btn btn-error" id="confirmDeleteUser">
            Delete User Account
        </button>
    </div>
</form>

<script>
    $('#deleteUserForm').off('submit').on('submit', function(e) {
        e.preventDefault();
        const $btn = $('#confirmDeleteUser');
        $btn.prop('disabled', true).html('Deleting...');

        const formData = $(this).serialize();

        $.post('/Home/DeleteUser', formData, function(result) {
            if (result.succeeded) {
                window.closeModal();
                if(window.dt) {
                    window.dt.ajax.reload();
                } else {
                    location.reload();
                }
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error Deleting User',
                    text: window.getPrimaryResultMessage(result, 'Unknown error')
                });
                $btn.prop('disabled', false).html('Delete User Account');
            }
        }).fail(function(xhr) {
            window.showRequestError({
                title: 'Unable to Delete User',
                xhr: xhr,
                fallbackMessage: 'We could not delete the user right now. Please try again.'
            });
            $btn.prop('disabled', false).html('Delete User Account');
        });
    });
</script>
