@model SSO.Application.Responses.Features.DashboardResponse
@{
    ViewData["Title"] = "Home Page";
}

<div class="breadcrumbs">
    <span>Auxinz Identity</span>
    <a href="#">Metrics</a>
    <span class="current">Dashboard</span>
</div>

<div class="page-header">
    <div class="dashboard-hero">
        <h1>Identity Server Overview</h1>
        <p class="dashboard-subtitle">
            System health, authentication activity,
            and OpenIddict metrics.
        </p>
    </div>
</div>

<!-- Stats Grid -->
<div class="grid-stats">
    <div class="stat-box">
        <div class="stat-header">
            <span>Server Users</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
            </svg>
        </div>
        <div class="stat-value">@Model.TotalUsers</div>
        <div class="stat-trend up">
            Across All Tenants
        </div>
    </div>

    <div class="stat-box">
        <div class="stat-header">
            <span>Registered Tenants</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                 <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            </svg>
        </div>
        <div class="stat-value">@Model.TotalTenants</div>
        <div class="stat-trend up">
            Isolated Environments
        </div>
    </div>

    <div class="stat-box">
        <div class="stat-header">
            <span>OIDC Applications</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="3" y1="9" x2="21" y2="9"></line>
                <line x1="9" y1="21" x2="9" y2="9"></line>
            </svg>
        </div>
        <div class="stat-value">@Model.TotalClients</div>
        <div class="stat-trend up">
            Active RP Clients
        </div>
    </div>

    <div class="stat-box stat-box-accent">
        <div class="stat-header">
            <span>Active Subscriptions</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
            </svg>
        </div>
        <div class="stat-value">@Model.ActiveSubscriptions</div>
        <div class="stat-trend stat-trend-accent">
             Licensed Tenants
        </div>
    </div>
</div>

<div class="dashboard-layout">
    <!-- Activity Table -->
    <div class="panel">
        <div class="panel-header">
            <div>
                <h3 class="panel-title">System Registration Activity</h3>
            </div>
            <a href="#" class="panel-link">View All Logs</a>
        </div>
        <div class="table-responsive">
            <table class="data-table dashboard-table">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>User Principal</th>
                        <th>Workflow</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentActivities != null)
                    {
                        foreach (var act in Model.RecentActivities)
                        {
                            <tr>
                                <td class="dashboard-time">@act.Timestamp</td>
                                <td class="dashboard-principal">@act.Email</td>
                                <td>
                                    <span class="workflow-chip">@act.GrantType</span>
                                </td>
                                <td><span class="badge badge-success">@act.Status</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- OpenIddict Server Status -->
    <div class="panel">
        <div class="panel-header">
            <h3 class="panel-title">Server Configuration</h3>
            <span class="badge badge-success">Healthy</span>
        </div>
        <div class="panel-body">
            <div class="config-list">
                <div class="config-row">
                    <span class="config-label">Issuer URI</span>
                    <span class="config-value config-value-code">@Model.IssuerUri</span>
                </div>
                <div class="config-row">
                    <span class="config-label">Signing Certificate</span>
                    <span class="config-value config-value-code config-value-inline">
                        <span class="badge badge-success badge-compact">Valid</span> @Model.CertificateType
                    </span>
                </div>
                <div class="config-row">
                    <span class="config-label">Encryption</span>
                    <span class="config-value config-value-code">@Model.EncryptionAlgorithm</span>
                </div>
                <div class="config-row config-row-last">
                    <span class="config-label">Database Provider</span>
                    <span class="config-value config-value-code">@Model.DatabaseProvider</span>
                </div>
            </div>

            <div class="config-note">
                <p class="config-note-text">
                    Configuration is locked via appsettings.json
                </p>
            </div>
        </div>
    </div>
</div>
