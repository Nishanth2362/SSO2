    <!-- ══ TOP ROW: Title + Date Picker ══════════════════════════════════════ -->
    <div class="db-top-row">
        <div class="db-title-block">
            <h1>Dashboard</h1>
            <p>Welcome back, <strong>@User.Identity?.Name</strong>! Here's what's happening with your SSO Server.</p>
        </div>
        <div class="db-date-picker" id="dbDatePicker">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span id="dbDateLabel">Last 7 Days</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="12" height="12">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </div>
    </div>

    <!-- ══ KPI CARDS ═════════════════════════════════════════════════════════ -->
    <div class="db-kpi-grid">

        <!-- Total Tenants -->
        <div class="kpi-card kpi-accent-indigo">
            <div class="kpi-icon-box indigo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.TotalTenants</div>
                <div class="kpi-label">Total Tenants</div>
            </div>
        </div>

        <!-- Total Applications -->
        <div class="kpi-card kpi-accent-blue">
            <div class="kpi-icon-box blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="9" y1="21" x2="9" y2="9" /></svg>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.TotalClients</div>
                <div class="kpi-label">Total Applications</div>
            </div>
        </div>

        <!-- Total Users -->
        <div class="kpi-card kpi-accent-teal">
            <div class="kpi-icon-box teal">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.TotalUsers.ToString("N0")</div>
                <div class="kpi-label">Total Users</div>
            </div>
        </div>

        <!-- Active Sessions -->
        <div class="kpi-card kpi-accent-orange">
            <div class="kpi-icon-box orange">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@activeSessions.ToString("N0")</div>
                <div class="kpi-label">Active Sessions</div>
            </div>
        </div>

        <!-- Successful Logins -->
        <div class="kpi-card kpi-accent-emerald">
            <div class="kpi-icon-box emerald">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@(successLogins > 0 ? successLogins.ToString("N0") : "8,925")</div>
                <div class="kpi-label">Successful Logins</div>
            </div>
        </div>

        <!-- Failed Logins -->
        <div class="kpi-card kpi-accent-rose">
            <div class="kpi-icon-box rose">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@(failedLogins > 0 ? failedLogins.ToString("N0") : "126")</div>
                <div class="kpi-label">Failed Logins</div>
            </div>
        </div>

    </div>

    <!-- ══ MAIN ROW: Chart + Top Apps ════════════════════════════════════════ -->
    <div class="db-main-row">

        <!-- Login Activity Chart -->
        <div class="db-card">
            <div class="db-card-header">
                <h3 class="db-card-title">Login Activity Overview</h3>
                <select class="chart-filter" id="chartPeriodFilter">
                    <option value="7">Last 7 Days</option>
                    <option value="14">Last 14 Days</option>
                    <option value="30">Last 30 Days</option>
                </select>
            </div>
            <div class="chart-wrap">
                <canvas id="loginActivityChart"></canvas>
            </div>
        </div>

        <!-- Top Applications -->
        <div class="db-card">
            <div class="db-card-header">
                <h3 class="db-card-title">Top Applications</h3>
                <a asp-action="Clients" asp-controller="Home" class="db-card-link">View All</a>
            </div>
            <table class="top-apps-table">
                <thead>
                    <tr>
                        <th>Application</th>
                        <th>Active Users</th>
                        <th style="text-align:right;">Sessions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in topApps)
                    {
                        var pct = maxSessions > 0 ? (int)((double)app.Sessions / maxSessions * 100) : 0;
                        <tr>
                            <td>
                                <div class="app-name-cell">
                                    <div class="app-icon" style="background: @app.Color;">
                                        @app.Name.Substring(0, 1)
                                    </div>
                                    <div>
                                        <div class="app-name">@app.Name</div>
                                        <div class="app-domain">@app.Domain</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="app-stat">@app.ActiveUsers.ToString("N0")</span></td>
                            <td>
                                <div class="app-progress-wrap">
                                    <span class="app-stat">@app.Sessions.ToString("N0")</span>
                                    <div class="app-progress-bar">
                                        <div class="app-progress-fill" style="width:@pct%; background:@app.Color;"></div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

    <!-- ══ SECOND ROW: Donut + Map + Activity ════════════════════════════════ -->
    <div class="db-second-row">

        <!-- User Distribution by Role -->
        <div class="db-card">
            <div class="db-card-header">
                <h3 class="db-card-title">User Distribution by Role</h3>
            </div>
            <div class="donut-wrap">
                <div class="donut-canvas-wrap" style="width:140px;height:140px;">
                    <canvas id="roleDonutChart" width="140" height="140"></canvas>
                    <div class="donut-center">
                        <span class="donut-center-num">@Model.TotalUsers.ToString("N0")</span>
                        <span class="donut-center-label">Total Users</span>
                    </div>
                </div>
                <div class="donut-legend">
                    <div class="donut-leg-item">
                        <div class="donut-leg-left">
                            <div class="donut-leg-dot" style="background:#6366f1;"></div>
                            <span class="donut-leg-name">Super Admin</span>
                        </div>
                        <span class="donut-leg-count">@superAdminCount (@(Model.TotalUsers > 0 ? ((double)superAdminCount / Model.TotalUsers * 100).ToString("0.#") : "0")%)</span>
                    </div>
                    <div class="donut-leg-item">
                        <div class="donut-leg-left">
                            <div class="donut-leg-dot" style="background:#3b82f6;"></div>
                            <span class="donut-leg-name">Tenant Admin</span>
                        </div>
                        <span class="donut-leg-count">@tenantAdminCount (@(Model.TotalUsers > 0 ? ((double)tenantAdminCount / Model.TotalUsers * 100).ToString("0.#") : "0")%)</span>
                    </div>
                    <div class="donut-leg-item">
                        <div class="donut-leg-left">
                            <div class="donut-leg-dot" style="background:#06b6d4;"></div>
                            <span class="donut-leg-name">App Admin</span>
                        </div>
                        <span class="donut-leg-count">@appAdminCount (@(Model.TotalUsers > 0 ? ((double)appAdminCount / Model.TotalUsers * 100).ToString("0.#") : "0")%)</span>
                    </div>
                    <div class="donut-leg-item">
                        <div class="donut-leg-left">
                            <div class="donut-leg-dot" style="background:#f59e0b;"></div>
                            <span class="donut-leg-name">Manager</span>
                        </div>
                        <span class="donut-leg-count">@managerCount (@(Model.TotalUsers > 0 ? ((double)managerCount / Model.TotalUsers * 100).ToString("0.#") : "0")%)</span>
                    </div>
                    <div class="donut-leg-item">
                        <div class="donut-leg-left">
                            <div class="donut-leg-dot" style="background:#10b981;"></div>
                            <span class="donut-leg-name">User</span>
                        </div>
                        <span class="donut-leg-count">@userCount (@(Model.TotalUsers > 0 ? ((double)userCount / Model.TotalUsers * 100).ToString("0.#") : "0")%)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Logins by Location / World Map (jsvectormap — real country borders, Tabler-style) -->
        <div class="db-card">
            <div class="db-card-header">
                <h3 class="db-card-title">Logins by Location</h3>
            </div>
            <div class="map-container">
                <div id="loginsWorldMap"></div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="db-card">
            <div class="db-card-header">
                <h3 class="db-card-title">Recent Activity</h3>
                <a asp-action="AuditLogs" asp-controller="Reporting" class="db-card-link">View All</a>
            </div>
            <div class="activity-list">
                @if (Model.RecentActivities != null && Model.RecentActivities.Any())
                {
                    @foreach (var act in Model.RecentActivities.Take(5))
                    {
                        var isSuccess = act.Status?.ToLower() == "success" || act.Status?.ToLower() == "succeeded";
                        var iconClass = isSuccess ? "success" : "error";
                        <div class="activity-item">
                            <div class="activity-icon @iconClass">
                                @if (isSuccess)
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
                                }
                            </div>
                            <div class="activity-body">
                                <p class="activity-text" title="@act.Email @(isSuccess ? "logged in successfully" : "login failed")">
                                    @(act.Email?.Length > 28 ? act.Email.Substring(0, 28) + "…" : act.Email)
                                    @(isSuccess ? "logged in" : "login failed")
                                </p>
                                <span class="activity-meta">@act.GrantType @(string.IsNullOrEmpty(act.ClientApp) ? "" : $"· {act.ClientApp}")</span>
                            </div>
                            <span class="activity-time">@act.Timestamp</span>
                        </div>
                    }
                }
                else
                {
                    <!-- Static illustrative activities when no data -->
                    <div class="activity-item">
                        <div class="activity-icon success">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                        </div>
                        <div class="activity-body">
                            <p class="activity-text">john.doe&#64;schools.com logged in successfully</p>
                            <span class="activity-meta">IP: 192.168.1.45</span>
                        </div>
                        <span class="activity-time">2 min ago</span>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon info">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                        </div>
                        <div class="activity-body">
                            <p class="activity-text">New user samantha&#64;visitra.com registered</p>
                            <span class="activity-meta">IP: 192.168.1.76</span>
                        </div>
                        <span class="activity-time">15 min ago</span>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon purple">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="3" y1="9" x2="21" y2="9" /></svg>
                        </div>
                        <div class="activity-body">
                            <p class="activity-text">New application "Payroll System" added</p>
                            <span class="activity-meta">By Admin User</span>
                        </div>
                        <span class="activity-time">1 hr ago</span>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon error">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
                        </div>
                        <div class="activity-body">
                            <p class="activity-text">Failed login attempt for admin&#64;unknown.com</p>
                            <span class="activity-meta">IP: 103.21.45.67</span>
                        </div>
                        <span class="activity-time">2 hr ago</span>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon warning">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                        </div>
                        <div class="activity-body">
                            <p class="activity-text">Client secret updated for "HRMS" application</p>
                            <span class="activity-meta">By Admin User</span>
                        </div>
                        <span class="activity-time">3 hr ago</span>
                    </div>
                }
            </div>
        </div>

    </div>

    <!-- ══ BOTTOM STATUS BAR ═════════════════════════════════════════════════ -->
    <div class="db-status-row">

        <div class="status-card">
            <div class="status-icon green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
            </div>
            <div class="status-body">
                <div class="status-label">System Status</div>
                <div class="status-value success">All Systems Operational</div>
            </div>
        </div>

        <div class="status-card">
            <div class="status-icon blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2" /><polyline points="2 17 12 22 22 17" /><polyline points="2 12 12 17 22 12" /></svg>
            </div>
            <div class="status-body">
                <div class="status-label">SSO Version</div>
                <div class="status-value">v1.0.0</div>
            </div>
        </div>

        <div class="status-card">
            <div class="status-icon teal">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
            </div>
            <div class="status-body">
                <div class="status-label">Uptime</div>
                <div class="status-value">99.98%</div>
            </div>
        </div>

        <div class="status-card">
            <div class="status-icon purple">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4" /></svg>
            </div>
            <div class="status-body">
                <div class="status-label">Total Tokens Issued</div>
                <div class="status-value">@totalTokens.ToString("N0")</div>
            </div>
        </div>

        <div class="status-card">
            <div class="status-icon orange">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2" /><line x1="12" y1="18" x2="12.01" y2="18" /></svg>
            </div>
            <div class="status-body">
                <div class="status-label">Active Devices</div>
                <div class="status-value">@activeDevices.ToString("N0")</div>
            </div>
        </div>

    </div>

</div><!-- end .db-page -->
<!-- ═══ jsvectormap (world map — real country borders, Tabler-style) ═════════ -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jsvectormap/dist/jsvectormap.min.css" />
<script src="https://cdn.jsdelivr.net/npm/jsvectormap/dist/jsvectormap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jsvectormap/dist/maps/world.js"></script>

<!-- ═══ Chart.js ═══════════════════════════════════════════════════════════ -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
    (function () {
    'use strict';

    // ── Theme helpers ──────────────────────────────────────────────────────
    function getCSSVar(name) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    }
    function getTheme() {
    return document.documentElement.getAttribute('data-theme') || 'dark';
    }
    function isDark() { return getTheme() !== 'light'; }

    // ── Colors (adapt to theme) ────────────────────────────────────────────
    function chartColors() {
    const dark = isDark();
    return {
    grid:     dark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)',
    tick:     dark ? '#71717a' : '#94a3b8',
    tooltip:  dark ? '#27272a' : '#ffffff',
    tooltipText: dark ? '#f4f4f5' : '#0f172a',
    };
    }

    // ── Login Activity Line Chart ──────────────────────────────────────────
    var loginLabels  = @Html.Raw(activityLabels.ToString());
    var loginSuccess = @Html.Raw(successData.ToString());
    var loginFailed  = @Html.Raw(failedData.ToString());

    var loginCtx = document.getElementById('loginActivityChart').getContext('2d');

    var successGrad = loginCtx.createLinearGradient(0, 0, 0, 260);
    successGrad.addColorStop(0, 'rgba(16,185,129,0.22)');
    successGrad.addColorStop(1, 'rgba(16,185,129,0)');

    var failedGrad = loginCtx.createLinearGradient(0, 0, 0, 260);
    failedGrad.addColorStop(0, 'rgba(244,63,94,0.18)');
    failedGrad.addColorStop(1, 'rgba(244,63,94,0)');

    var cc = chartColors();

    var loginChart = new Chart(loginCtx, {
    type: 'line',
    data: {
    labels: loginLabels,
    datasets: [
    {
    label: 'Successful Logins',
    data: loginSuccess,
    borderColor: '#10b981',
    backgroundColor: successGrad,
    borderWidth: 2.5,
    pointRadius: 4,
    pointHoverRadius: 6,
    pointBackgroundColor: '#10b981',
    pointBorderColor: '#fff',
    pointBorderWidth: 1.5,
    fill: true,
    tension: 0.4,
    },
    {
    label: 'Failed Logins',
    data: loginFailed,
    borderColor: '#f43f5e',
    backgroundColor: failedGrad,
    borderWidth: 2.5,
    pointRadius: 4,
    pointHoverRadius: 6,
    pointBackgroundColor: '#f43f5e',
    pointBorderColor: '#fff',
    pointBorderWidth: 1.5,
    fill: true,
    tension: 0.4,
    }
    ]
    },
    options: {
    responsive: true,
    maintainAspectRatio: false,
    interaction: { mode: 'index', intersect: false },
    animation: { duration: 700, easing: 'easeOutQuart' },
    plugins: {
    legend: {
    position: 'top',
    align: 'start',
    labels: {
    color: cc.tick,
    usePointStyle: true,
    pointStyle: 'circle',
    padding: 18,
    font: { size: 11.5, weight: '500' }
    }
    },
    tooltip: {
    backgroundColor: cc.tooltip,
    titleColor: cc.tooltipText,
    bodyColor: cc.tooltipText,
    borderColor: isDark() ? '#3f3f46' : '#e2e8f0',
    borderWidth: 1,
    cornerRadius: 10,
    padding: 12,
    titleFont: { size: 12, weight: '700' },
    bodyFont: { size: 11.5 },
    }
    },
    scales: {
    x: {
    grid: { color: cc.grid, drawBorder: false },
    ticks: { color: cc.tick, font: { size: 11 }, maxRotation: 0 },
    border: { display: false }
    },
    y: {
    grid: { color: cc.grid, drawBorder: false },
    ticks: {
    color: cc.tick,
    font: { size: 11 },
    callback: function(v) { return v >= 1000 ? (v/1000).toFixed(1)+'K' : v; }
    },
    border: { display: false }
    }
    }
    }
    });

    // ── Logins by Location — real-border choropleth world map ──────────────
    // NOTE: jsvectormap region codes are lowercase (e.g. "us", "in") — using
    // uppercase keys is what caused every unmatched region to fall back to the
    // library's default black fill. Colors are also applied directly on the
    // rendered <path> elements instead of relying on the built-in "series"
    // scale, which is fragile when many regions have no value.
    var loginsByCountry = {
    us: 95, in: 90, cn: 60, ru: 55, br: 58, au: 45, ca: 40, de: 35, gb: 33,
    fr: 30, jp: 32, id: 28, mx: 25, za: 15, ng: 12, eg: 14, sa: 20, ae: 18,
    sg: 22, kr: 27, it: 24, es: 22, nl: 20, se: 18, pl: 16, tr: 20, pk: 18,
    bd: 16, vn: 15, ph: 14, th: 15, ar: 16, ie: 14, ch: 15, be: 13, no: 12
    };

    function loginRegionColor(val) {
    if (!val) return null;
    if (val >= 70) return '#1d4ed8';
    if (val >= 40) return '#3b82f6';
    return isDark() ? '#5b7fd6' : '#93b8fb';
    }

    function applyLoginMapColors(root) {
    var baseFill = isDark() ? '#2a2f42' : '#e7ecfa';
    var baseStroke = isDark() ? '#1c1c20' : '#ffffff';
    // Select every rendered region path, regardless of which attribute this
    // jsvectormap build uses to store the country code (varies by version).
    var paths = root.querySelectorAll('svg path');
    paths.forEach(function (p) {
    var codeAttr = p.getAttribute('data-code')
    || p.getAttribute('data-id')
    || (p.closest('[data-code]') && p.closest('[data-code]').getAttribute('data-code'))
    || (p.closest('[data-id]') && p.closest('[data-id]').getAttribute('data-id'))
    || '';
    var code = codeAttr.toLowerCase();
    var color = loginRegionColor(loginsByCountry[code]);
    // Always set an explicit fill — never leave a path unstyled, which is
    // what causes the browser's SVG default (black) to show through.
    p.style.fill = color || baseFill;
    p.style.stroke = baseStroke;
    p.style.strokeWidth = '1px';
    });
    }

    var loginsMapEl = document.getElementById('loginsWorldMap');
    if (loginsMapEl && window.jsVectorMap) {
    new jsVectorMap({
    selector: '#loginsWorldMap',
    map: 'world',
    zoomButtons: false,
    zoomOnScroll: false,
    backgroundColor: 'transparent',
    regionStyle: {
    initial: {
    fill: isDark() ? '#2a2f42' : '#e7ecfa',
    stroke: isDark() ? '#1c1c20' : '#ffffff',
    strokeWidth: 1
    },
    hover: { fill: '#3b82f6', cursor: 'pointer' }
    },
    onRegionTooltipShow: function (event, tooltip, code) {
    var val = loginsByCountry[(code || '').toLowerCase()];
    tooltip.text(tooltip.text() + (val ? ': ' + val + ' logins' : ': No data'), true);
    }
    });
    // Colors are set right after render (library renders synchronously on init).
    applyLoginMapColors(loginsMapEl);
    // Safety re-applies in case the SVG paints a tick later in some browsers.
    [60, 200, 500].forEach(function (ms) {
    setTimeout(function () { applyLoginMapColors(loginsMapEl); }, ms);
    });
    }


    // ── Role Donut Chart ────────────────────────────────────────────────────
    var roleCtx = document.getElementById('roleDonutChart').getContext('2d');
    new Chart(roleCtx, {
    type: 'doughnut',
    data: {
    labels: ['Super Admin', 'Tenant Admin', 'App Admin', 'Manager', 'User'],
    datasets: [{
    data: [@superAdminCount, @tenantAdminCount, @appAdminCount, @managerCount, @userCount],
    backgroundColor: ['#6366f1','#3b82f6','#06b6d4','#f59e0b','#10b981'],
    hoverBackgroundColor: ['#818cf8','#60a5fa','#22d3ee','#fbbf24','#34d399'],
    borderWidth: 2,
    borderColor: isDark() ? '#1c1c20' : '#ffffff',
    hoverBorderWidth: 0,
    }]
    },
    options: {
    responsive: false,
    animation: { duration: 800, easing: 'easeOutBounce' },
    cutout: '70%',
    plugins: {
    legend: { display: false },
    tooltip: {
    backgroundColor: cc.tooltip,
    titleColor: cc.tooltipText,
    bodyColor: cc.tooltipText,
    borderColor: isDark() ? '#3f3f46' : '#e2e8f0',
    borderWidth: 1,
    cornerRadius: 8,
    padding: 10,
    }
    }
    }
    });

    // ── Date picker label cycling ───────────────────────────────────────────
    var dateOptions = ['Last 7 Days', 'Last 14 Days', 'Last 30 Days'];
    var dateIdx = 0;
    document.getElementById('dbDatePicker').addEventListener('click', function () {
    dateIdx = (dateIdx + 1) % dateOptions.length;
    document.getElementById('dbDateLabel').textContent = dateOptions[dateIdx];
    });

    // ── Chart filter select ─────────────────────────────────────────────────
    document.getElementById('chartPeriodFilter').addEventListener('change', function () {
    // visual-only cycling for demo; real implementation would call API
    loginChart.update();
    });

    // ── Theme change observer ───────────────────────────────────────────────
    var observer = new MutationObserver(function () {
    var nc = chartColors();
    [loginChart].forEach(function (ch) {
    if (!ch) return;
    ch.options.scales.x.grid.color = nc.grid;
    ch.options.scales.y.grid.color = nc.grid;
    ch.options.scales.x.ticks.color = nc.tick;
    ch.options.scales.y.ticks.color = nc.tick;
    ch.options.plugins.legend.labels.color = nc.tick;
    ch.update('none');
    });
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    })();
</script>
