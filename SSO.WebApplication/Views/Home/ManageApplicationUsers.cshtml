@using SSO.Application.Responses.Features

@{
    ViewData["Title"] = $"{ViewBag.ApplicationDisplayName} - Users";
    var canCreateUser = (await AuthorizationService.AuthorizeAsync(User, Permissions.Users.Create)).Succeeded;
    var canExportUser = (await AuthorizationService.AuthorizeAsync(User, Permissions.Users.Export)).Succeeded || (await AuthorizationService.AuthorizeAsync(User, Permissions.Users.View)).Succeeded;
    var canEditUser = (await AuthorizationService.AuthorizeAsync(User, Permissions.Users.Edit)).Succeeded;
    var canDeleteUser = (await AuthorizationService.AuthorizeAsync(User, Permissions.Users.Delete)).Succeeded;
    var canSendResetLink = (await AuthorizationService.AuthorizeAsync(User, Permissions.Users.SendResetLink)).Succeeded;
    var canResetPassword = (await AuthorizationService.AuthorizeAsync(User, Permissions.Users.ResetPassword)).Succeeded;
}

<style>
    /* Full-page background for seamless integration (Purple/Blue Theme matching Tenant Access Control page) */
    body {
        background: linear-gradient(150deg,
                        rgba(124, 92, 252, 0.10) 0%,
                        rgba(124, 92, 252, 0.05) 22%,
                        rgba(24, 167, 223, 0.06) 55%,
                        rgba(236, 253, 245, 0.5) 78%,
                        rgba(255, 255, 255, 0.95) 100%) !important;
        background-attachment: fixed !important;
        background-repeat: no-repeat !important;
        background-size: cover !important;
    }

    html[data-theme="dark"] body {
        background: linear-gradient(150deg,
                        rgba(124, 92, 252, 0.18) 0%,
                        rgba(124, 92, 252, 0.08) 22%,
                        rgba(24, 167, 223, 0.09) 55%,
                        rgba(15, 23, 42, 0.6) 78%,
                        rgba(9, 12, 20, 0.95) 100%) !important;
        background-attachment: fixed !important;
        background-repeat: no-repeat !important;
        background-size: cover !important;
    }

    .page-wrapper, .content-wrapper, .container-xl, main, #content, .page-body {
        background: transparent !important;
    }

    /* ═══════════════════════════════════════════════════════════
       UNIFIED HERO BANNER — Matching Tenant Access Control
       ═══════════════════════════════════════════════════════════ */
    .inv-page-card {
        background: transparent;
        border: none;
        border-radius: 0;
        box-shadow: none;
        overflow: visible;
        margin-bottom: 8px;
    }

    .inv-hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
        background: transparent;
        border: none;
        border-radius: 0;
        padding: 14px 4px 6px;
        margin-bottom: 0;
        overflow: hidden;
    }

    html[data-theme="dark"] .inv-hero {
        background: transparent;
    }

    .inv-hero::before {
        content: "";
        position: absolute;
        right: -60px;
        top: -60px;
        width: 280px;
        height: 280px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(124, 92, 252, 0.14) 0%, rgba(124, 92, 252, 0) 70%);
        pointer-events: none;
    }

    .inv-hero-bg-pattern {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
        z-index: 0;
    }

    .hero-bg-icon {
        position: absolute;
        stroke: #7c5cfc;
        stroke-width: 1.5;
        fill: none;
        opacity: 0.10;
        transition: opacity 0.3s ease;
    }

    html[data-theme="dark"] .hero-bg-icon {
        stroke: #a78bfa;
        opacity: 0.12;
    }

    .hero-bg-icon.icon-invoice-1 { top: 8%; left: 1%; width: 32px; height: 32px; transform: rotate(-12deg); }
    .hero-bg-icon.icon-rupee-1   { top: 14%; left: 36%; width: 26px; height: 26px; transform: rotate(10deg); }
    .hero-bg-icon.icon-card-1    { bottom: 10%; left: 18%; width: 30px; height: 30px; transform: rotate(-8deg); }
    .hero-bg-icon.icon-receipt-1 { top: 58%; left: 3%; width: 28px; height: 28px; transform: rotate(6deg); }

    .inv-hero-left {
        position: relative;
        display: flex;
        align-items: center;
        gap: 18px;
        z-index: 1;
        flex: 1 1 320px;
        min-width: 260px;
    }

    .inv-hero-icon {
        width: 54px;
        height: 54px;
        flex-shrink: 0;
        border-radius: 16px;
        background: linear-gradient(135deg, #8b6cfd, #6a3df5);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        box-shadow: 0 8px 20px rgba(124, 92, 252, 0.35);
        overflow: hidden;
    }

    .inv-hero-title {
        font-size: 1.85rem !important;
        font-weight: 800 !important;
        color: var(--text-main);
        letter-spacing: -0.02em;
        margin: 0 0 2px;
    }

    .inv-hero-subtitle {
        font-size: 0.86rem;
        color: var(--text-muted);
        margin: 0 0 6px;
    }

    .inv-hero-underline {
        width: 36px;
        height: 4px;
        border-radius: 4px;
        background: linear-gradient(90deg, #7c5cfc, #a78bfa);
    }

    .inv-hero-illustration {
        position: relative;
        z-index: 1;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 240px;
        pointer-events: none;
    }

    /* COMPACT KPI CARDS */
    .sub-kpi-container {
        position: relative;
        display: flex;
        gap: 14px;
        align-items: stretch;
        z-index: 1;
        flex-wrap: wrap;
    }

    .sub-kpi-card {
        cursor: pointer;
        user-select: none;
        width: 178px;
        flex-shrink: 0;
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 14px;
        padding: 10px 14px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(0,0,0,0.03), 0 6px 16px -8px rgba(15,23,42,0.08);
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

    .sub-kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(0,0,0,0.05), 0 10px 24px -8px rgba(15,23,42,0.14);
    }

    .sub-kpi-card.active {
        border-color: #7c5cfc !important;
        box-shadow: 0 0 0 2px rgba(124, 92, 252, 0.18), var(--shadow-sm) !important;
    }

    .sub-kpi-card .tabler-stat-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
    }

    .sub-kpi-card .tabler-stat-title {
        font-size: 0.66rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #64748b;
        line-height: 1.3;
    }

    html[data-theme="dark"] .sub-kpi-card .tabler-stat-title {
        color: #94a3b8;
    }

    .sub-kpi-card .tabler-stat-value {
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--text-main);
        line-height: 1;
    }

    .tabler-stat-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s ease;
    }

    .sub-kpi-card:hover .tabler-stat-icon {
        transform: scale(1.08);
    }

    .tabler-stat-icon.total-icon {
        background: rgba(124, 92, 252, 0.14);
        color: #7c5cfc !important;
    }

    .tabler-stat-icon.active-icon {
        background: rgba(16, 185, 129, 0.14);
        color: #10b981 !important;
    }

    .tabler-stat-icon.inactive-icon {
        background: rgba(245, 158, 11, 0.14);
        color: #f59e0b !important;
    }

    .kpi-mini-visual {
        position: absolute;
        right: 10px;
        bottom: 6px;
        opacity: 0.7;
        pointer-events: none;
    }

    /* Toolbar Buttons */
    .btn-cyan-primary {
        background: linear-gradient(135deg, #8b6cfd 0%, #6a3df5 100%) !important;
        border: none !important;
        color: #ffffff !important;
        font-weight: 700 !important;
        height: 38px !important;
        padding: 0 18px !important;
        border-radius: 10px !important;
        font-size: 0.84rem !important;
        box-shadow: 0 4px 14px rgba(124, 92, 252, 0.35) !important;
        transition: all 0.25s ease !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        cursor: pointer !important;
    }

    .btn-cyan-primary:hover {
        transform: translateY(-1px) !important;
        box-shadow: 0 6px 18px rgba(124, 92, 252, 0.45) !important;
        color: #ffffff !important;
    }

    /* Filter Buttons in Toolbar */
    .mau-filter-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 14px;
        border: 1px solid #E5E7EB;
        border-radius: 10px;
        font-size: 0.78rem;
        font-weight: 600;
        color: #64748B;
        background: #ffffff;
        cursor: pointer;
        transition: all 0.2s ease;
        height: 38px;
    }

    html[data-theme="dark"] .mau-filter-btn {
        background: #11141f;
        border-color: #262d42;
        color: #94A3B8;
    }

    .mau-filter-btn:hover {
        border-color: #7c5cfc;
        color: #7c5cfc;
    }

    .mau-filter-btn.active {
        border-color: #7c5cfc;
        color: #7c5cfc;
        background: rgba(124, 92, 252, 0.08);
    }

    /* Action Buttons (Plain Outline Icons - Matching Main Users Module) */
    .action-btn {
        width: 30px !important;
        height: 30px !important;
        border-radius: 50% !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        border: 1px solid transparent !important;
        background: transparent !important;
        cursor: pointer !important;
        transition: all 0.15s ease !important;
        padding: 0 !important;
        margin: 0 2px !important;
    }

    .action-btn svg { width: 14px !important; height: 14px !important; flex-shrink: 0 !important; }
    .action-btn-view { background: rgba(59, 130, 246, 0.1) !important; color: #3b82f6 !important; border-color: rgba(59, 130, 246, 0.2) !important; }
    .action-btn-view:hover { background: rgba(59, 130, 246, 0.22) !important; color: #2563eb !important; border-color: rgba(59, 130, 246, 0.35) !important; transform: scale(1.05) !important; }
    .action-btn-notify { background: rgba(59, 130, 246, 0.08) !important; color: #3b82f6 !important; border-color: rgba(59, 130, 246, 0.15) !important; }
    .action-btn-notify:hover { background: rgba(59, 130, 246, 0.18) !important; color: #2563eb !important; transform: scale(1.05) !important; }
    .action-btn-edit  { background: rgba(245, 158, 11, 0.1) !important; color: #f59e0b !important; border-color: rgba(245, 158, 11, 0.2) !important; }
    .action-btn-edit:hover { background: rgba(245, 158, 11, 0.22) !important; color: #d97706 !important; border-color: rgba(245, 158, 11, 0.35) !important; transform: scale(1.05) !important; }
    .action-btn-delete, .action-btn.text-error { background: rgba(239, 68, 68, 0.1) !important; color: #ef4444 !important; border-color: rgba(239, 68, 68, 0.2) !important; }
    .action-btn-delete:hover, .action-btn.text-error:hover { background: rgba(239, 68, 68, 0.22) !important; color: #dc2626 !important; border-color: rgba(239, 68, 68, 0.35) !important; transform: scale(1.05) !important; }
</style>

<div class="breadcrumbs">
    <span>Auxinz SSO Server</span>
    <a href="/Home/TenantUsers">Tenant Access Control</a>
    @if (ViewBag.TenantName != null && ViewBag.TenantId != null)
    {
        <a href="/Home/ManageTenant?tenantId=@ViewBag.TenantId">@ViewBag.TenantName</a>
    }
    <span class="current">@ViewBag.ApplicationDisplayName - Users</span>
</div>

<!-- ═══════════════════════════════════════════════════════════
   HERO HEADER
   ═══════════════════════════════════════════════════════════ -->
<div class="inv-page-card">
    <div class="inv-hero">
        <!-- Background Pattern -->
        <div class="inv-hero-bg-pattern">
            <svg class="hero-bg-icon icon-invoice-1" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <svg class="hero-bg-icon icon-rupee-1" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            <svg class="hero-bg-icon icon-card-1" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <svg class="hero-bg-icon icon-receipt-1" viewBox="0 0 24 24"><circle cx="7.5" cy="15.5" r="5.5"></circle><path d="m21 2-9.6 9.6"></path><path d="m15.5 7.5 3 3"></path></svg>
        </div>

        <!-- Left Title Group -->
        <div class="inv-hero-left">
            <div class="inv-hero-icon">
                @if (!string.IsNullOrEmpty((string)ViewBag.ApplicationLogoUrl))
                {
                    <img src="@ViewBag.ApplicationLogoUrl" alt="@ViewBag.ApplicationDisplayName" style="width: 100%; height: 100%; object-fit: cover;" />
                }
                else
                {
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    </svg>
                }
            </div>
            <div>
                <h1 class="inv-hero-title">@ViewBag.ApplicationDisplayName</h1>
                <p class="inv-hero-subtitle">Users assigned to this application @(ViewBag.TenantName != null ? $"within {ViewBag.TenantName}" : "").</p>
                <div class="inv-hero-underline"></div>
            </div>
        </div>

        <!-- Center Illustration -->
        <div class="inv-hero-illustration">
            <svg width="180" height="110" viewBox="0 0 200 135" fill="none">
                <radialGradient id="app_hero_glow" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(100 68) scale(75 55)">
                    <stop stop-color="#ddd6fe" stop-opacity="0.5" />
                    <stop offset="1" stop-color="#7c5cfc" stop-opacity="0" />
                </radialGradient>
                <circle cx="100" cy="68" r="65" fill="url(#app_hero_glow)" />
                <g transform="translate(62, 10)">
                    <rect x="0" y="0" width="76" height="96" rx="12" fill="#ffffff" fill-opacity="0.9" stroke="#ddd6fe" stroke-width="1" />
                    <circle cx="38" cy="26" r="14" fill="#7c5cfc" />
                    <path d="M38 21a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 2.5c-3.8 0-7.5 1.9-7.5 3.8v1.7h15v-1.7c0-1.9-3.7-3.8-7.5-3.8z" fill="#ffffff" />
                    <rect x="20" y="47" width="36" height="4.5" rx="2.25" fill="#7c5cfc" />
                    <rect x="25" y="55" width="26" height="3" rx="1.5" fill="#94a3b8" opacity="0.55" />
                    <rect x="12" y="70" width="26" height="11" rx="5.5" fill="#7c5cfc" />
                    <circle cx="31" cy="75.5" r="3.8" fill="#ffffff" />
                </g>
            </svg>
        </div>

        <!-- Right KPI Cards -->
        <div class="sub-kpi-container">
            <div class="tabler-card tabler-stat-card sub-kpi-card active" id="kpiTotalUsers" data-filter="">
                <div class="tabler-card-body">
                    <div class="tabler-stat-header">
                        <div class="tabler-stat-icon total-icon">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </div>
                        <span class="tabler-stat-title">Total<br />Users</span>
                    </div>
                    <div class="tabler-stat-main">
                        <div class="tabler-stat-value" id="mauStatTotal">—</div>
                    </div>
                    <svg class="kpi-mini-visual" width="52" height="30" viewBox="0 0 52 30" fill="none">
                        <path d="M2,24 L10,16 L18,20 L28,8 L36,14 L48,4" fill="none" stroke="#7c5cfc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.6" />
                        <path d="M2,24 L10,16 L18,20 L28,8 L36,14 L48,4 L48,30 L2,30 Z" fill="#7c5cfc" opacity="0.12" />
                    </svg>
                </div>
            </div>

            <div class="tabler-card tabler-stat-card sub-kpi-card" id="kpiActiveUsers" data-filter="true">
                <div class="tabler-card-body">
                    <div class="tabler-stat-header">
                        <div class="tabler-stat-icon active-icon">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </div>
                        <span class="tabler-stat-title">Active<br />Users</span>
                    </div>
                    <div class="tabler-stat-main">
                        <div class="tabler-stat-value" id="mauStatActive">—</div>
                    </div>
                    <svg class="kpi-mini-visual" width="52" height="30" viewBox="0 0 52 30" fill="none">
                        <path d="M2,26 L12,14 L22,18 L32,10 L42,15 L50,6 L50,30 L2,30 Z" fill="#10b981" opacity="0.14" />
                        <polyline points="2,26 12,14 22,18 32,10 42,15 50,6" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.7" />
                    </svg>
                </div>
            </div>

            <div class="tabler-card tabler-stat-card sub-kpi-card" id="kpiInactiveUsers" data-filter="false">
                <div class="tabler-card-body">
                    <div class="tabler-stat-header">
                        <div class="tabler-stat-icon inactive-icon">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </div>
                        <span class="tabler-stat-title">Inactive<br />Users</span>
                    </div>
                    <div class="tabler-stat-main">
                        <div class="tabler-stat-value" id="mauStatInactive">—</div>
                    </div>
                    <svg class="kpi-mini-visual" width="42" height="30" viewBox="0 0 42 30" fill="none">
                        <rect x="4" y="16" width="8" height="14" rx="1.5" fill="#f59e0b" opacity="0.2" />
                        <rect x="17" y="8" width="8" height="22" rx="1.5" fill="#f59e0b" opacity="0.3" />
                        <rect x="30" y="12" width="8" height="18" rx="1.5" fill="#f59e0b" opacity="0.2" />
                    </svg>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════
   DATATABLE PANEL
   ═══════════════════════════════════════════════════════════ -->
<div class="panel">
    <!-- Toolbar Section -->
    <div class="table-toolbar" style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; width: 100%;">
        <!-- Search + Filters (left) -->
        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap; flex: 1; min-width: 0;">
            <div style="position: relative;">
                <svg style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #64748B;"
                     width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" class="form-input" placeholder="Search application users..."
                       style="padding-left: 36px; width: 260px; height: 38px; border-radius: 10px;" id="mauSearchInput">
            </div>

            <div class="mau-filter-group" style="display: flex; gap: 6px;">
                <button class="mau-filter-btn active" id="mauBtnAll" onclick="setStatusFilter('')">All</button>
                <button class="mau-filter-btn" id="mauBtnActive" onclick="setStatusFilter('true')">
                    <span class="tu-status-dot" style="background:#22C55E;display:inline-block;width:5px;height:5px;border-radius:50%;"></span> Active
                </button>
                <button class="mau-filter-btn" id="mauBtnInactive" onclick="setStatusFilter('false')">
                    <span class="tu-status-dot" style="background:#94A3B8;display:inline-block;width:5px;height:5px;border-radius:50%;"></span> Inactive
                </button>
            </div>
        </div>

        <!-- Right: Export button & New User button -->
        <div style="display: flex; gap: 10px; align-items: center; flex-shrink: 0;">
            @if (canExportUser)
            {
                <div class="smart-export-dropdown-wrapper">
                    <button type="button" class="btn btn-secondary smart-export-dropdown-btn smart-export-btn btn-toolbar" id="exportMauUsersBtn" title="More Options">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="1.5"></circle>
                            <circle cx="12" cy="5" r="1.5"></circle>
                            <circle cx="12" cy="19" r="1.5"></circle>
                        </svg>
                    </button>
                    <span class="smart-export-badge" id="mauSelectionBadge"></span>
                    <div class="smart-export-menu glass-dropdown">
                        <button type="button" class="dropdown-item smart-import-option" onclick="window.openImportModal('Application Users')">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                            Import
                        </button>
                        <button type="button" class="dropdown-item smart-export-option" onclick="window.smartExport('mauTable','/Home/ExportUsers')">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                            Export
                        </button>
                    </div>
                </div>
            }
            @if (canCreateUser)
            {
                <button class="btn-cyan-primary" id="openCreateUserBtn" type="button" onclick="openUserModal()">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    New User
                </button>
            }
        </div>
    </div>

    <!-- Hidden filter input -->
    <div class="table-filters-data" style="display:none;">
        <select class="form-select filter-IsActive" id="mauStatusFilter">
            <option value="">All Statuses</option>
            <option value="true">Active</option>
            <option value="false">Disabled</option>
        </select>
    </div>

    <!-- Full DataTable View -->
    <div class="table-responsive">
        <table id="mauTable" class="data-table table-hoverable manual-init" style="width:100%;">
            <thead>
                <tr>
                    <th style="width: 48px; min-width: 48px; text-align: center;"><input type="checkbox" class="master-select-cb" data-table="mauTable" /></th>
                    <th class="sorted">USER</th>
                    <th>EMAIL</th>
                    <th>TENANT</th>
                    <th>ROLES</th>
                    <th>CREATED</th>
                    <th>STATUS</th>
                    <th style="text-align: right;">ACTIONS</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    const TENANT_ID = '@ViewBag.TenantId';
    const CLIENT_ID = '@ViewBag.ApplicationId';

    $(function () {
        const canEditUser = @canEditUser.ToString().ToLower();
        const canDeleteUser = @canDeleteUser.ToString().ToLower();
        const canSendResetLink = @canSendResetLink.ToString().ToLower();
        const canResetPassword = @canResetPassword.ToString().ToLower();

        const $search = $('#mauSearchInput');

        const dt = $('#mauTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '/Home/GetApplicationUsers?tenantId=' + TENANT_ID + '&clientId=' + CLIENT_ID,
                type: 'POST',
                data: function (d) {
                    d.customSearchValue = d.search.value;
                    const $panel = $('#mauTable').closest('.panel');
                    const activeFilters = $panel.data('active-filters') || {};
                    if (activeFilters['IsActive'] !== undefined && activeFilters['IsActive'] !== '') {
                        d.filter_IsActive = activeFilters['IsActive'];
                    } else {
                        const val = $('#mauStatusFilter').val();
                        if (val) d.filter_IsActive = val;
                    }
                }
            },
            responsive: false,
            dom: 't<"if-table-footer-wrap"<"footer-right"<"if-pill-pagination-mount">>>',
            drawCallback: function (settings) {
                const api = this.api();
                window.renderPillPagination(api, '.if-pill-pagination-mount', 'users');

                const info = api.page.info();
                const shown = api.rows({ page: 'current' }).count();
                const total = info.recordsTotal;
                const rows = api.rows({ page: 'current' }).data().toArray();

                const activeCount = rows.filter(r => r.isActive).length;
                const inactiveCount = rows.filter(r => !r.isActive).length;

                $('#mauStatTotal').text(total);
                $('#mauStatActive').text(shown > 0 ? Math.round(activeCount / shown * total) : 0);
                $('#mauStatInactive').text(shown > 0 ? Math.round(inactiveCount / shown * total) : 0);
            },
            columns: [
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function (data, type, row) {
                        return '<input type="checkbox" class="row-select-cb" data-row-id="' + (row.id || '') + '">';
                    }
                },
                /* 0 - User with avatar/username */
                {
                    data: 'userName',
                    render: function (data, type, row, meta) {
                        const name = row.firstName || data || 'User';
                        const avatarPalette = [
                            { bg: 'rgba(124, 92, 252, 0.14)', fg: '#7c5cfc' },
                            { bg: 'rgba(245, 158, 11, 0.14)', fg: '#f59e0b' },
                            { bg: 'rgba(24, 167, 223, 0.14)', fg: '#18a7df' },
                            { bg: 'rgba(236, 72, 153, 0.14)', fg: '#ec4899' },
                            { bg: 'rgba(16, 185, 129, 0.14)', fg: '#10b981' },
                            { bg: 'rgba(99, 102, 241, 0.14)', fg: '#6366f1' }
                        ];
                        const tint = avatarPalette[(meta && typeof meta.row === 'number' ? meta.row : 0) % avatarPalette.length];
                        return `<div class="cell-flex">
                                    <div class="cell-avatar" style="background: ${tint.bg}; color: ${tint.fg}; font-weight: 700; overflow: hidden; display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%;">
                                        ${name.charAt(0).toUpperCase()}
                                    </div>
                                    <div class="cell-text">
                                        <h5 style="font-size: 0.82rem; font-weight: 700; margin: 0;">${name}</h5>
                                        <p style="font-size: 0.72rem; color: var(--text-muted); margin: 0;">@@${data || ''}</p>
                                    </div>
                                </div>`;
                    }
                },
                /* 1 - Email */
                {
                    data: 'email',
                    render: function(data) {
                        return `<span style="font-size: 0.82rem; color: var(--text-main);">${data || '—'}</span>`;
                    }
                },
                /* 2 - Tenant */
                {
                    data: 'tenantName',
                    render: function (data) {
                        const name = data || '@ViewBag.TenantName' || 'Global';
                        let hash = 0;
                        for (let i = 0; i < name.length; i++) {
                            hash = name.charCodeAt(i) + ((hash << 5) - hash);
                        }
                        const badgeColors = [
                            { bg: 'rgba(59, 130, 246, 0.1)', fg: '#3b82f6', border: 'rgba(59, 130, 246, 0.2)' },
                            { bg: 'rgba(139, 92, 246, 0.1)', fg: '#8b5cf6', border: 'rgba(139, 92, 246, 0.2)' },
                            { bg: 'rgba(236, 72, 153, 0.1)', fg: '#ec4899', border: 'rgba(236, 72, 153, 0.2)' },
                            { bg: 'rgba(24, 167, 223, 0.1)', fg: '#18a7df', border: 'rgba(24, 167, 223, 0.2)' }
                        ];
                        const color = badgeColors[Math.abs(hash) % badgeColors.length];
                        return `<span class="badge" style="background: ${color.bg}; color: ${color.fg}; border: 1px solid ${color.border}; font-weight: 600;">${name}</span>`;
                    }
                },
                /* 3 - Roles */
                {
                    data: 'roles',
                    render: function (data) {
                        if (!data || data.length === 0) return '<span class="text-muted" style="font-size:0.75rem;">Viewer</span>';
                        return data.map(r => `<span class="badge badge-info" style="margin-right:2px; margin-bottom:2px; display:inline-block;">${r}</span>`).join('');
                    }
                },
                /* 4 - Created */
                {
                    data: 'createdAt',
                    render: function (data) {
                        if (!data) return '—';
                        const date = new Date(data);
                        const dateStr = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                        const timeStr = date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
                        return `<div style="line-height: 1.4;">
                                    <div style="font-weight: 600; color: var(--text-main); font-size: 0.8rem;">${dateStr}</div>
                                    <div style="font-size: 0.72rem; color: var(--text-muted);">${timeStr}</div>
                                </div>`;
                    }
                },
                /* 5 - Status */
                {
                    data: 'isActive',
                    render: function (data) {
                        return data
                            ? `<span class="tu-status tu-status-active" style="padding: 3px 10px; border-radius: 999px; font-size: 0.75rem; font-weight: 700; color: #22C55E; background: rgba(34, 197, 94, 0.1);"><span class="tu-status-dot" style="width: 5px; height: 5px; border-radius: 50%; background: #22C55E; display: inline-block; margin-right: 5px;"></span>Active</span>`
                            : `<span class="tu-status tu-status-inactive" style="padding: 3px 10px; border-radius: 999px; font-size: 0.75rem; font-weight: 700; color: #64748B; background: rgba(100, 116, 139, 0.1);"><span class="tu-status-dot" style="width: 5px; height: 5px; border-radius: 50%; background: #94A3B8; display: inline-block; margin-right: 5px;"></span>Inactive</span>`;
                    }
                },
                /* 6 - Actions: View, Email, Reset Password, Edit, Delete */
                {
                    data: null,
                    orderable: false,
                    render: function (data, type, row) {
                        let html = `<div style="text-align: right; display: flex; justify-content: flex-end; align-items: center; gap: 4px;">`;
                        html += `<button class="action-btn action-btn-view" title="View Details" onclick="viewUserDetails('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path></svg></button>`;
                        if (canEditUser) {
                            if (canSendResetLink) {
                                html += `<button class="action-btn action-btn-notify" title="Send Reset Link" onclick="sendResetLink('${row.email}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg></button>`;
                            }
                            if (canResetPassword) {
                                html += `<button class="action-btn action-btn-notify" title="Change Password" onclick="resetUserPassword('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.778-7.778zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg></button>`;
                            }
                            html += `<button class="action-btn action-btn-edit" title="Edit" onclick="editUser('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></button>`;
                        }
                        if (canDeleteUser) {
                            html += `<button class="action-btn action-btn-delete" title="Delete" onclick="deleteUser('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>`;
                        }
                        html += `</div>`;
                        return html;
                    }
                }
            ]
        });

        /* Search debounce */
        let searchTimer;
        $search.on('keyup', function () {
            clearTimeout(searchTimer);
            const val = this.value;
            searchTimer = setTimeout(() => dt.search(val).draw(), 350);
        });

        /* KPI card clicks */
        $('.sub-kpi-card').on('click', function () {
            const filterVal = $(this).attr('data-filter') || '';
            window.setStatusFilter(filterVal);
        });

        /* Status filter buttons */
        window.setStatusFilter = function (val) {
            $('#mauBtnAll, #mauBtnActive, #mauBtnInactive').removeClass('active');
            $('.sub-kpi-card').removeClass('active');

            if (val === '') {
                $('#mauBtnAll').addClass('active');
                $('#kpiTotalUsers').addClass('active');
            } else if (val === 'true') {
                $('#mauBtnActive').addClass('active');
                $('#kpiActiveUsers').addClass('active');
            } else {
                $('#mauBtnInactive').addClass('active');
                $('#kpiInactiveUsers').addClass('active');
            }

            const $panel = $('#mauTable').closest('.panel');
            const activeFilters = $panel.data('active-filters') || {};
            if (val === '') {
                delete activeFilters['IsActive'];
            } else {
                activeFilters['IsActive'] = val;
            }
            $panel.data('active-filters', activeFilters);

            $('#mauStatusFilter').val(val);
            dt.ajax.reload();
        };

        // Initialize row selection for smart export
        window.initRowSelection('mauTable', 'id');
    });

    /* View User details */
    function viewUserDetails(id) {
        if (typeof window.showDetailsDrawer === 'function') {
            window.showDetailsDrawer('user', id);
        } else {
            openUserModal(id);
        }
    }

    /* Send password reset link */
    function sendResetLink(email) {
        Swal.fire({
            title: 'Send Reset Link',
            text: `Are you sure you want to send a password reset email to ${email}?`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Send Email',
            cancelButtonText: 'Cancel',
            showLoaderOnConfirm: true,
            preConfirm: () => {
                const token = $('input[name="__RequestVerificationToken"]').val();
                return $.post('/Login/ForgotPassword', { 
                    Email: email, 
                    __RequestVerificationToken: token 
                }).catch(error => {
                    Swal.showValidationMessage(`Request failed: ${error.statusText || error}`);
                });
            },
            allowOutsideClick: () => !Swal.isLoading()
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire('Success', 'Password reset link has been dispatched successfully.', 'success');
            }
        });
    }

    /* Change password */
    function resetUserPassword(id) {
        Swal.fire({
            title: 'Change Password',
            text: 'Enter the new password for this user:',
            input: 'password',
            inputAttributes: {
                autocapitalize: 'off',
                autocorrect: 'off',
                placeholder: 'New password (min 8 chars)'
            },
            showCancelButton: true,
            confirmButtonText: 'Change Password',
            cancelButtonText: 'Cancel',
            showLoaderOnConfirm: true,
            preConfirm: (newPassword) => {
                if (!newPassword || newPassword.trim().length < 8) {
                    Swal.showValidationMessage('Password must be at least 8 characters long');
                    return false;
                }
                return $.ajax({
                    url: '/Home/ResetPasswordAdmin',
                    type: 'POST',
                    data: {
                        userId: id,
                        newPassword: newPassword
                    },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    }
                }).then(response => {
                    if (!response.succeeded) {
                        throw new Error(response.messages ? response.messages[0] : 'Failed to change password');
                    }
                    return response;
                }).catch(error => {
                    Swal.showValidationMessage(`Request failed: ${error.message || error}`);
                });
            },
            allowOutsideClick: () => !Swal.isLoading()
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire('Success', 'The user password has been changed successfully.', 'success');
            }
        });
    }

    /* Open User Modal (Create/Edit) */
    function openUserModal(id = '') {
        const isEdit = id !== '';
        window.openModal({
            title: isEdit ? 'Edit User Profile' : 'Create New User',
            subtitle: isEdit ? 'Modify identity and access details.' : 'Register a new identity on the platform.',
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>`,
            url: '/Home/CreateUser?Id=' + id + (TENANT_ID ? '&tenantId=' + TENANT_ID : ''),
            onSuccess: function(result) {
                $('#mauTable').DataTable().ajax.reload();
            }
        });
    }

    function editUser(id) {
        openUserModal(id);
    }

    function deleteUser(id) {
        window.openModal({
            title: 'Delete User',
            subtitle: 'Confirm permanent account removal.',
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-error">
                    <path d="M3 6h18"></path>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  </svg>`,
            url: '/Home/DeleteUser?Id=' + id,
            onSuccess: function() {
                $('#mauTable').DataTable().ajax.reload();
            }
        });
    }
</script>
