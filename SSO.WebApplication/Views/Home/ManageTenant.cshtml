@{
    ViewData["Title"] = "Manage Tenant – " + ViewBag.TenantName;
    var tenantId      = ViewBag.TenantId?.ToString() ?? "";
    var tenantName    = ViewBag.TenantName?.ToString() ?? "Tenant";
    var tenantCode    = ViewBag.TenantCode?.ToString() ?? "";
    var tenantEmail   = ViewBag.TenantEmail?.ToString() ?? "";
    var isActive      = ViewBag.TenantIsActive is bool b && b;

    var canExportUsers = (await AuthorizationService.AuthorizeAsync(User, Permissions.Users.Export)).Succeeded;
    var canCreateUser = (await AuthorizationService.AuthorizeAsync(User, Permissions.Users.Create)).Succeeded;
    var canEditUser = (await AuthorizationService.AuthorizeAsync(User, Permissions.Users.Edit)).Succeeded;
    var canDeleteUser = (await AuthorizationService.AuthorizeAsync(User, Permissions.Users.Delete)).Succeeded;
    var canViewClients = (await AuthorizationService.AuthorizeAsync(User, Permissions.Client.View)).Succeeded;
    var canEditRole = (await AuthorizationService.AuthorizeAsync(User, Permissions.Roles.Edit)).Succeeded;
    var canCreateRole = (await AuthorizationService.AuthorizeAsync(User, Permissions.Roles.Create)).Succeeded;
    var canDeleteRole = (await AuthorizationService.AuthorizeAsync(User, Permissions.Roles.Delete)).Succeeded;
    var canManagePermissions = (await AuthorizationService.AuthorizeAsync(User, Permissions.RoleClaims.View)).Succeeded;
}

