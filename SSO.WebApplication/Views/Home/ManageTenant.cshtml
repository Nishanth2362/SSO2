            </table>
        </div>

        <div id="rolesEmptyState" style="display:none;">
            <div class="mt-empty">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                    <polyline points="2 17 12 22 22 17"></polyline>
                    <polyline points="2 12 12 17 22 12"></polyline>
                </svg>
                <p>No roles found for this tenant.</p>
            </div>
        </div>

        <div id="rolesLoadingState">
            <div class="mt-empty">
                <span class="mt-spinner" style="width:28px;height:28px;border-width:3px;"></span>
                <p>Loading roles…</p>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
(function () {
    var TENANT_ID = '@tenantId';
    const canCreateUser = @canCreateUser.ToString().ToLower();
    const canEditUser = @canEditUser.ToString().ToLower();
    const canDeleteUser = @canDeleteUser.ToString().ToLower();
    const canViewClients = @canViewClients.ToString().ToLower();
    const canEditRole = @canEditRole.ToString().ToLower();
    const canDeleteRole = @canDeleteRole.ToString().ToLower();
    const canManagePermissions = @canManagePermissions.ToString().ToLower();

    /* ── Tab switching ─────────────────────────────── */
    window.switchTab = function (tab) {
        document.querySelectorAll('.mt-tab-panel').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.mt-tab').forEach(t => t.classList.remove('active'));
        document.getElementById('panel' + tab.charAt(0).toUpperCase() + tab.slice(1)).classList.add('active');
        document.getElementById('tabBtn' + tab.charAt(0).toUpperCase() + tab.slice(1)).classList.add('active');

        if (tab === 'roles' && !window._rolesTableInit) {
            window._rolesTableInit = true;
            loadRoles();
        }
    };

    /* ═══════════════════════════════════════════════
       APPLICATIONS TAB
       ═══════════════════════════════════════════════ */
    var allApps = [];
    var appsDt = null;

    function loadApplications() {
        $('#appsLoadingState').show();
        $('#appsEmptyState').hide();
        $('#appsTableContainer').hide();
        $.get('/Home/GetTenantApplications', { tenantId: TENANT_ID })
            .done(function (res) {
                allApps = res.data || [];
                $('#appCountBadge').text(allApps.length);
                if (allApps.length === 0) {
                    $('#appsEmptyState').show();
                } else {
                    $('#appsTableContainer').show();
                    initAppsTable(allApps);
                }
            })
            .fail(function () {
                $('#appsEmptyState').html('<div class="mt-empty"><p>Failed to load applications.</p></div>').show();
            })
            .always(function () { $('#appsLoadingState').hide(); });
    }

    function initAppsTable(apps) {
        if (appsDt) {
            appsDt.clear().rows.add(apps).draw();
            return;
        }

        appsDt = $('#appsTable').DataTable({
            data: apps,
            processing: false,
            serverSide: false,
            responsive: false,
            autoWidth: false,
            pageLength: 10,
            dom: 't<"if-table-footer-wrap"<"footer-right"<"if-pill-pagination-mount if-pill-pagination-mount-apps">>>',
            drawCallback: function () {
                const api = this.api();
                window.renderPillPagination(api, '.if-pill-pagination-mount-apps', 'applications');
            },
            language: {
                emptyTable: "No applications match the filters.",
                info: "Showing _START_ to _END_ of _TOTAL_ applications",
                infoEmpty: "Showing 0 to 0 of 0 applications",
                infoFiltered: "(filtered from _MAX_ total applications)"
            },
            columns: [
                {
                    data: 'displayName',
                    width: '45%',
                    render: function (data, type, row) {
                        const name = data || row.clientId || 'Unknown App';
                        const logoHtml = row.logoUrl
                            ? `<img src="${row.logoUrl}" alt="${name}" style="width: 28px; height: 28px; border-radius: var(--radius-md); object-fit: cover;">`
                            : `<div class="cell-avatar primary" style="width: 28px; height: 28px; font-size: 0.72rem; border-radius: var(--radius-md);"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg></div>`;
                        return `<div class="cell-flex">
                                    ${logoHtml}
                                    <div class="cell-text">
                                        <h5 style="font-size: 0.8rem; font-weight: 600; margin: 0;">${name}</h5>
                                        <p style="font-family: monospace; font-size: 0.72rem; color: var(--text-muted); margin: 2px 0 0 0;">${row.clientId || '—'}</p>
                                    </div>
                                </div>`;
                    }
                },
                {
                    data: 'appType',
                    width: '20%',
                    render: function (data, type, row) {
                        const typeLabel = data || row.clientType || 'App';
                        return `<span class="badge badge-neutral">${typeLabel}</span>`;
                    }
                },
                {
                    data: 'isActive',
                    width: '20%',
                    render: function (data) {
                        return data
                            ? `<span class="badge badge-success">Active</span>`
                            : `<span class="badge badge-error">Inactive</span>`;
                    }
                },
                {
                    data: null,
                    orderable: false,
                    width: '15%',
                    render: function (data, type, row) {
                        if (canViewClients) {
                            return `<div style="text-align:right;display:flex;justify-content:flex-end;gap:4px;">
                                        <a href="/Home/ManageApplicationUsers?applicationId=${row.id}&tenantId=${TENANT_ID}" class="mt-app-manage-btn" style="text-decoration:none;">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right: 4px;">
                                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                                <circle cx="9" cy="7" r="4"></circle>
                                            </svg>
                                            Manage
                                        </a>
                                    </div>`;
                        }
                        return '';
                    }
                }
            ]
        });

        // Add custom search
        let searchTimer;
        $('#appSearchInput').off('keyup').on('keyup', function() {
            clearTimeout(searchTimer);
            const val = this.value;
            searchTimer = setTimeout(function() {
                appsDt.search(val).draw();
            }, 300);
        });

        // Add custom filters
        $('#appTypeFilter').off('change').on('change', function() {
            const val = this.value;
            appsDt.column(1).search(val ? '^' + val + '$' : '', true, false).draw();
        });

        $('#appStatusFilter').off('change').on('change', function() {
            const val = this.value;
            appsDt.column(2).search(val ? '^' + val + '$' : '', true, false).draw();
        });
    }

    /* ═══════════════════════════════════════════════
       ROLES TAB
       ═══════════════════════════════════════════════ */
    window._rolesTableInit = false;
    var allRoles = [];
    var rolesDt = null;

    function loadRoles() {
        $('#rolesLoadingState').show();
        $('#roleLoadingSpinner').show();
        $('#rolesEmptyState').hide();
        $('#rolesTableContainer').hide();
        $.get('/Home/GetRolesByTenant', { tenantId: TENANT_ID })
            .done(function (res) {
                allRoles = res.data || [];
                $('#roleCountBadge').text(allRoles.length);
                if (allRoles.length === 0) {
                    $('#rolesEmptyState').show();
                } else {
                    $('#rolesTableContainer').show();
                    initRolesTable(allRoles);
                }
            })
            .fail(function () {
                window._rolesTableInit = false;
                $('#rolesEmptyState').html('<div class="mt-empty"><p>Failed to load roles.</p></div>').show();
            })
            .always(function () {
                $('#roleLoadingSpinner').hide();
                $('#rolesLoadingState').hide();
            });
    }

    function initRolesTable(roles) {
        if (rolesDt) {
            rolesDt.clear().rows.add(roles).draw();
            return;
        }

        rolesDt = $('#rolesTable').DataTable({
            data: roles,
            processing: false,
            serverSide: false,
            responsive: false,
            autoWidth: false,
            pageLength: 10,
            dom: 't<"if-table-footer-wrap"<"footer-right"<"if-pill-pagination-mount if-pill-pagination-mount-roles">>>',
            drawCallback: function () {
                const api = this.api();
                window.renderPillPagination(api, '.if-pill-pagination-mount-roles', 'roles');
            },
            language: {
                emptyTable: "No roles match the filters.",
                info: "Showing _START_ to _END_ of _TOTAL_ roles",
                infoEmpty: "Showing 0 to 0 of 0 roles",
                infoFiltered: "(filtered from _MAX_ total roles)"
            },
            columns: [
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function (data, type, row) {
                        return '<input type="checkbox" class="row-select-cb" data-row-id="' + (row.id || '') + '">';
                    }
                },
                {
                    data: 'name',
                    render: function (data, type, row) {
                        return `<div class="cell-flex">
                                    <div class="cell-avatar warning">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                            <polyline points="2 17 12 22 22 17"></polyline>
                                            <polyline points="2 12 12 17 22 12"></polyline>
                                        </svg>
                                    </div>
                                    <div class="cell-text">
                                        <h5>${data}</h5>
                                    </div>
                                </div>`;
                    }
                },
                {
                    data: 'description',
                    render: function (data) {
                        return data || '<span class="text-muted">No description</span>';
                    }
                },
                {
                    data: null,
                    orderable: false,
                    render: function (data, type, row) {
                        let html = `<div style="text-align: right; display: flex; justify-content: flex-end; align-items: center; gap: 4px;">`;
                        html += `<button class="action-btn action-btn-view" title="View Details" data-type="role" data-id="${row.id}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path></svg></button>`;
                        if (canManagePermissions) {
                            html += `<button class="action-btn action-btn-shield" title="Manage Permissions" onclick="managePermissions('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg></button>`;
                        }
                        if (canEditRole) {
                            html += `<button class="action-btn action-btn-edit" title="Edit Role" onclick="openRoleModal('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></button>`;
                        }
                        if (canDeleteRole) {
                            html += `<button class="action-btn action-btn-delete" title="Delete Role" onclick="deleteRole('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>`;
                        }
                        html += `</div>`;
                        return html;
                    }
                }
            ]
        });

        // Add custom search
        let searchTimer;
        $('#roleSearchInput').off('keyup').on('keyup', function() {
            clearTimeout(searchTimer);
            const val = this.value;
            searchTimer = setTimeout(function() {
                rolesDt.search(val).draw();
            }, 300);
        });
    }

    window.openRoleModal = function (id = '') {
        const isEdit = id !== '';
        window.openModal({
            title: isEdit ? 'Update Role' : 'Create Security Role',
            subtitle: isEdit ? 'Modify role name and metadata.' : 'Define a new access level for system users.',
            icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>',
            url: '/Home/CreateRole?Id=' + id + (TENANT_ID ? '&tenantId=' + TENANT_ID : ''),
            onSuccess: function () {
                loadRoles();
            }
        });
    };

    window.editRole = function (id) {
        window.openRoleModal(id);
    };

    window.managePermissions = function (id) {
        window.location.href = '/Home/RolePermissions?Id=' + id + (TENANT_ID ? '&tenantId=' + TENANT_ID : '');
    };

    window.deleteRole = function (id) {
        window.openModal({
            title: 'Delete Role',
            subtitle: 'Warning: This may affect users currently assigned to this role.',
            icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-error"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>',
            url: '/Home/DeleteRole?Id=' + id,
            onSuccess: function () {
                loadRoles();
            }
        });
    };



    /* Manage button now navigates directly to /Home/ManageApplicationUsers */

    var avatarPalettes = [
        { bg: '#E8E5FF', text: '#4F46E5' }, // Pastel Purple
        { bg: '#E0F2FE', text: '#0284C7' }, // Pastel Blue
        { bg: '#DCFCE7', text: '#16A34A' }, // Pastel Green
        { bg: '#FFEDD5', text: '#EA580C' }, // Pastel Orange
        { bg: '#FCE7F3', text: '#DB2777' }, // Pastel Pink
        { bg: '#F3E8FF', text: '#9333EA' }, // Pastel Violet
        { bg: '#FEF3C7', text: '#D97706' }, // Pastel Amber
        { bg: '#E8E5FF', text: '#7C5CFC' }  // Pastel Purple
    ];

    var defaultRolesList = ['Owner', 'Administrator', 'Viewer', 'Editor'];

    /* Delegated event listener for clicking anywhere on an assigned user card */
    $(document).off('click.appUserCard').on('click.appUserCard', '.app-user-card', function(e) {
        if ($(e.target).closest('.btn-three-dots, .app-user-dropdown-menu').length) {
            return;
        }
        e.stopPropagation();
        e.preventDefault();

        const userId = $(this).attr('data-user-id');
        const userObj = {
            id: userId,
            firstName: $(this).attr('data-user-name'),
            name: $(this).attr('data-user-name'),
            userName: $(this).attr('data-user-username'),
            email: $(this).attr('data-user-email'),
            role: $(this).attr('data-user-role'),
            isActive: $(this).attr('data-user-active') === 'true',
            createdAt: $(this).attr('data-user-created'),
            tenantName: '@ViewBag.TenantName' || 'Tenant'
        };

        if (typeof window.showDetailsDrawer === 'function') {
            window.showDetailsDrawer('user', userId || userObj);
        } else {
            openAppUserDetailsModal(userObj);
        }
    });

    window.handleEditUserClick = function(e, id) {
        e.stopPropagation();
        e.preventDefault();
        $('.app-user-dropdown-menu').removeClass('show');
        editUser(id);
    };

    window.handleDeleteUserClick = function(e, id) {
        e.stopPropagation();
        e.preventDefault();
        $('.app-user-dropdown-menu').removeClass('show');
        deleteUser(id);
    };

    window.toggleUserDropdown = function(e, id) {
        e.stopPropagation();
        e.preventDefault();
        const target = $('#userDropdown_' + id);
        const wasShown = target.hasClass('show');
        $('.app-user-dropdown-menu').removeClass('show');
        if (!wasShown) {
            target.addClass('show');
        }
    };

    $(document).off('click.appUserMenu').on('click.appUserMenu', function() {
        $('.app-user-dropdown-menu').removeClass('show');
    });

    window.openAppUserDetailsModal = function(user) {
        if (typeof user === 'string') {
            try { user = JSON.parse(user); } catch(e) {}
        }
        const appModal = document.getElementById('appModal');
        if (!appModal) return;

        document.getElementById('modalTitle').innerText = 'User Details';
        document.getElementById('modalSubtitle').innerText = 'Overview of user identity and application access.';
        document.getElementById('modalIcon').innerHTML = `
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #7c5cfc;">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
            </svg>`;

        const isOnline = user.isActive;
        const name = user.firstName || user.name || user.userName || 'User';
        const initial = name.charAt(0).toUpperCase();
        const uname = user.userName || '';
        const email = user.email || '—';
        const role = user.role || user.roleName || 'Viewer';
        const tenant = user.tenantName || '@ViewBag.TenantName' || 'Tenant';
        const app = user.appName || 'Application';
        const createdDate = user.createdAt ? new Date(user.createdAt).toLocaleDateString() : 'N/A';

        const modalHtml = `
            <div style="padding: 24px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px;">
                <div style="position: relative; display: inline-block;">
                    <div style="width: 72px; height: 72px; border-radius: 50%; background: linear-gradient(135deg, rgba(124, 92, 252, 0.2), rgba(124, 92, 252, 0.08)); color: #7c5cfc; font-size: 1.8rem; font-weight: 800; display: flex; align-items: center; justify-content: center; border: 2px solid rgba(124, 92, 252, 0.3);">
                        ${initial}
                    </div>
                    <span style="position: absolute; bottom: 4px; right: 4px; width: 14px; height: 14px; border-radius: 50%; background: ${isOnline ? '#22c55e' : '#ef4444'}; border: 2.5px solid var(--bg-surface);"></span>
                </div>
                
                <div>
                    <h4 style="font-size: 1.1rem; font-weight: 700; color: var(--text-main); margin: 0 0 4px 0;">${name}</h4>
                    <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0;">&#64;${uname}</p>
                </div>

                <div style="width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; background: var(--bg-surface-hover); padding: 14px; border-radius: var(--radius-md); text-align: left; font-size: 0.8rem; border: 1px solid var(--border-subtle);">
                    <div>
                        <span style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; display: block; margin-bottom: 2px;">Email</span>
                        <strong style="color: var(--text-main); word-break: break-all;">${email}</strong>
                    </div>
                    <div>
                        <span style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; display: block; margin-bottom: 2px;">Tenant</span>
                        <strong style="color: var(--text-main);">${tenant}</strong>
                    </div>
                    <div>
                        <span style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; display: block; margin-bottom: 2px;">Role</span>
                        <strong style="color: var(--text-main);">${role}</strong>
                    </div>
                    <div>
                        <span style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; display: block; margin-bottom: 2px;">Applications</span>
                        <strong style="color: var(--text-main);">${app}</strong>
                    </div>
                    <div>
                        <span style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; display: block; margin-bottom: 2px;">Status</span>
                        <span class="badge ${isOnline ? 'badge-success' : 'badge-error'}" style="padding: 2px 8px; font-size: 0.72rem; border-radius: 10px;">${isOnline ? 'Active' : 'Inactive'}</span>
                    </div>
                    <div>
                        <span style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; display: block; margin-bottom: 2px;">Created</span>
                        <strong style="color: var(--text-main);">${createdDate}</strong>
                    </div>
                </div>

                <div style="display: flex; gap: 10px; width: 100%; justify-content: flex-end; margin-top: 8px;">
                    ${canEditUser ? `
                    <button class="btn btn-sm btn-primary" onclick="window.closeModal ? window.closeModal() : document.getElementById('appModal').classList.remove('active'); editUser('${user.id}');" style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; padding: 8px 16px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                        Edit User
                    </button>` : ''}
                    <button class="btn btn-sm btn-secondary" onclick="window.closeModal ? window.closeModal() : document.getElementById('appModal').classList.remove('active');" style="font-size: 0.8rem; padding: 8px 16px;">
                        Close
                    </button>
                </div>
            </div>`;

        document.getElementById('modalContent').innerHTML = modalHtml;
        appModal.classList.add('active');
    };

    function loadAppUsers(clientId, appName) {
        $.post('/Home/GetApplicationUsers?tenantId=' + TENANT_ID + '&clientId=' + clientId, {
            draw   : 1, start: 0, length: 50,
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
        })
        .done(function (res) {
            var users = res.data || [];
            
            // Update the count badge
            $('#appUsersCount_' + clientId).text(users.length);

            if (!users.length) {
                var emptyHtml = `
                    <div class="mt-app-users-empty-container">
                        <div class="mt-app-users-empty-icon">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </div>
                        <h5 class="mt-app-users-empty-title">No users assigned to this application.</h5>
                        <p class="mt-app-users-empty-desc">There are currently no users assigned to ${appName || 'this application'}. Assign users to grant them access.</p>
                        ${canCreateUser ? `
                        <button class="mt-assign-user-btn-ref" onclick="openUserModal()" title="Assign User">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                            Assign User
                        </button>` : ''}
                    </div>`;
                $('#appUsersContent_' + clientId).html(emptyHtml);
                return;
            }

            var cardsHtml = users.map(function (u, index) {
                var name    = u.name || u.firstName || u.userName || 'User';
                var initial = name.charAt(0).toUpperCase();
                var uname   = u.userName || '';
                var email   = u.email || '—';
                var isOnline = u.isActive;
                var role    = u.role || u.roleName || defaultRolesList[index % defaultRolesList.length];
                var palette = avatarPalettes[index % avatarPalettes.length];

                return `
                    <div class="app-user-card" data-user-id="${u.id}" data-user-name="${name}" data-user-username="${uname}" data-user-email="${email}" data-user-role="${role}" data-user-active="${isOnline}" data-user-created="${u.createdAt || ''}" style="cursor: pointer;">
                        <div class="app-user-avatar-wrap">
                            <div class="app-user-avatar" style="background-color: ${palette.bg}; color: ${palette.text};">
                                ${initial}
                            </div>
                            <span class="app-user-status-dot ${isOnline ? 'active' : 'inactive'}"></span>
                        </div>
                        
                        <h5 class="app-user-card-name" title="${name}">${name}</h5>
                        <span class="app-user-card-role" title="${role}">${role}</span>
                        <span class="app-user-card-email" title="${email}">${email}</span>

                        <div style="position: relative; width: 100%; display: flex; justify-content: center;">
                            <button class="btn-three-dots" title="More options" onclick="toggleUserDropdown(event, '${u.id}')">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <circle cx="12" cy="5" r="1.5"></circle>
                                    <circle cx="12" cy="12" r="1.5"></circle>
                                    <circle cx="12" cy="18" r="1.5"></circle>
                                </svg>
                            </button>
                            <div class="app-user-dropdown-menu" id="userDropdown_${u.id}">
                                ${canEditUser ? `
                                <button class="app-user-dropdown-item" onclick="handleEditUserClick(event, '${u.id}')">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    Edit User
                                </button>` : ''}
                                ${canDeleteUser ? `
                                <button class="app-user-dropdown-item text-danger" onclick="handleDeleteUserClick(event, '${u.id}')">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                    Delete User
                                </button>` : ''}
                            </div>
                        </div>
                    </div>`;
            }).join('');

            var gridHtml = `<div class="app-users-grid">${cardsHtml}</div>`;
            $('#appUsersContent_' + clientId).html(gridHtml);
        })
        .fail(function () {
            $('#appUsersContent_' + clientId).html(`
                <div class="mt-app-users-empty-container">
                    <p style="font-size: 0.85rem; color: var(--status-error); margin: 0;">Failed to load assigned users. Please try again.</p>
                </div>`);
        });
    }

    /* ═══════════════════════════════════════════════
       USERS TAB
       ═══════════════════════════════════════════════ */
    window._usersTableInit = false;

    function initUsersTable() {
        window._usersTableInit = true;

        var $search       = $('#userSearchInput');
        var $statusFilter = $('#userStatusFilter');

        var dt = $('#usersTable').DataTable({
            processing : true,
            serverSide : true,
            ajax: {
                url  : '/Home/GetTenantUsersList?tenantId=' + TENANT_ID,
                type : 'POST',
                data : function (d) {
                    d.customSearchValue = d.search.value;
                    var statusVal = $('#userStatusFilter').val();
                    if (statusVal) {
                        d.filter_IsActive = statusVal;
                    }
                }
            },
            dom        : 't<"if-table-footer-wrap"<"footer-right"<"if-pill-pagination-mount if-pill-pagination-mount-users">>>',
            columns    : [
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    width: '40px',
                    render: function (data, type, row) {
                        return '<input type="checkbox" class="row-select-cb" data-row-id="' + (row.id || '') + '">';
                    }
                },
                /* 0 – User */
                {
                    data: 'userName',
                    width: '30%',
                    render: function (data, type, row) {
                        const name = row.firstName || data || '?';
                        const initial = name.charAt(0).toUpperCase();
                        const uname = data || '';
                        let displayUname = uname;
                        if (uname.includes('@@')) {
                            displayUname = uname.split('@@')[0];
                        }
                        return `<div class="cell-flex">
                                    <div class="cell-avatar primary">
                                        ${initial}
                                    </div>
                                    <div class="cell-text" style="overflow: hidden; flex: 1;">
                                        <h5 style="font-size: 0.8rem; font-weight: 600; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${name}">${name}</h5>
                                        <p style="font-size: 0.72rem; color: var(--text-muted); margin: 2px 0 0 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="&#64;${uname}">&#64;${displayUname}</p>
                                    </div>
                                </div>`;
                    }
                },
                /* 1 – Email */
                {
                    data: 'email',
                    width: '25%',
                    render: function (data) {
                        return `<span style="font-size:0.78rem;color:var(--text-muted);">${data || '—'}</span>`;
                    }
                },
                /* 2 – Joined */
                {
                    data: 'createdAt',
                    width: '15%',
                    render: function (data) {
                        if (!data) return '—';
                        return new Date(data).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
                    }
                },
                /* 3 – Status */
                {
                    data: 'isActive',
                    width: '13%',
                    render: function (data) {
                        return data
                            ? `<span class="badge badge-success">Active</span>`
                            : `<span class="badge badge-error">Inactive</span>`;
                    }
                },
                /* 4 – Actions */
                {
                    data: null,
                    orderable: false,
                    width: '13%',
                    render: function (data, type, row) {
                        let html = `<div style="text-align:right;display:flex;justify-content:flex-end;gap:4px;">`;
                        if (canEditUser) {
                            html += `<button class="action-btn" title="Edit User" onclick="editUser('${row.id}')">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    </button>`;
                        }
                        if (canDeleteUser) {
                            html += `<button class="action-btn text-error" title="Delete User" onclick="deleteUser('${row.id}')">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                    </button>`;
                        }
                        html += `</div>`;
                        return html;
                    }
                }
            ],
            drawCallback: function () {
                var api        = this.api();
                var info       = api.page.info();
                var total      = info.recordsTotal;
                var shown      = api.rows({ page: 'current' }).count();
                var rows       = api.rows({ page: 'current' }).data().toArray();

                var activeCount   = rows.filter(r => r.isActive).length;
                var inactiveCount = rows.filter(r => !r.isActive).length;

                $('#userCountBadge').text(total);
                $('#tuStatTotal').text(total);
                $('#tuStatActive').text(shown > 0 ? Math.round(activeCount / shown * total) : 0);
                $('#tuStatInactive').text(shown > 0 ? Math.round(inactiveCount / shown * total) : 0);

                window.renderPillPagination(api, '.if-pill-pagination-mount-users', 'users');
            }
        });

        /* KPI card clicks */
        $('.sub-kpi-card').on('click', function () {
            const filterVal = $(this).attr('data-filter') || '';
            window.setUserStatusFilter(filterVal);
        });

        window.setUserStatusFilter = function (val) {
            $('#userStatusFilter').val(val).trigger('change');
            $('.sub-kpi-card').removeClass('active');
            if (val === '') {
                $('#kpiTotalUsers').addClass('active');
            } else if (val === 'true') {
                $('#kpiActiveUsers').addClass('active');
            } else {
                $('#kpiInactiveUsers').addClass('active');
            }
        };

        /* Search debounce */
        var searchTimer;
        $search.on('keyup', function () {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(function () { dt.ajax.reload(); }, 350);
        });

        /* Status filter */
        $statusFilter.on('change', function () { dt.ajax.reload(); });

        // Initialize row selection for smart export
        window.initRowSelection('usersTable', 'id');
 
        window._usersDt = dt;
    }

    function renderUserPagination(dt, current, totalPages) {
        var $pg = $('#usersPagination').empty();
        if (totalPages <= 1) return;

        $('<button class="mt-page-btn">').html(
            '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>'
        ).prop('disabled', current === 0).on('click', function () { dt.page(current - 1).draw('page'); }).appendTo($pg);

        var start = Math.max(0, current - 2);
        var end   = Math.min(totalPages - 1, current + 2);
        for (var i = start; i <= end; i++) {
            (function (idx) {
                $('<button class="mt-page-btn">').text(idx + 1)
                    .toggleClass('active', idx === current)
                    .on('click', function () { dt.page(idx).draw('page'); })
                    .appendTo($pg);
            })(i);
        }

        $('<button class="mt-page-btn">').html(
            '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>'
        ).prop('disabled', current >= totalPages - 1).on('click', function () { dt.page(current + 1).draw('page'); }).appendTo($pg);
    }

    /* ── Edit / Delete / Create helpers (reuse existing modals) ── */
    window.openUserModal = function (id = '') {
        const isEdit = id !== '';
        const url = isEdit ? '/Home/CreateUser?Id=' + id : '/Home/CreateUser?tenantId=' + TENANT_ID;
        window.openModal({
            title   : isEdit ? 'Edit User Profile' : 'Create New User',
            subtitle: isEdit ? 'Modify identity and access details.' : 'Register a new identity on the platform.',
            icon    : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>',
            url     : url,
            onSuccess: function () {
                if (window._usersDt) window._usersDt.ajax.reload();
            }
        });
    };

    window.editUser = function (id) {
        window.openUserModal(id);
    };

    window.deleteUser = function (id) {
        window.openModal({
            title   : 'Delete User',
            subtitle: 'Confirm permanent account removal.',
            icon    : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-error"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>',
            url     : '/Home/DeleteUser?Id=' + id,
            onSuccess: function () {
                if (window._usersDt) window._usersDt.ajax.reload();
            }
        });
    };

    /* ── Init ─────────────────────────────────────── */
    $(document).ready(function () {
        const urlParams = new URLSearchParams(window.location.search);
        const tabParam = (urlParams.get('tab') || window.location.hash.replace('#', '')).toLowerCase();
        if (tabParam === 'roles') {
            switchTab('roles');
        } else {
            loadApplications();
        }
    });

})();
</script>
