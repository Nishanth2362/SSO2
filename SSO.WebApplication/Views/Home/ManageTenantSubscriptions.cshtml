@using SSO.Application.Responses.Features
@{
    Layout = null;
    var tenantId = ViewBag.TenantId;
}

<div class="modal-body-content">
    <div class="table-toolbar" style="margin-bottom: 16px;">
        <div class="table-filters">
            <button class="btn btn-primary btn-sm" onclick="addNewSubscription('@tenantId')">
                 <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Provision New Plan
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table id="tenantSubscriptionTable" class="data-table table-hoverable">
            <thead>
                <tr>
                    <th>Plan</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<script>
    $(document).ready(function() {
        var tsTable = $('#tenantSubscriptionTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '/Home/GetTenantSubscriptions?TenantId=@tenantId',
                type: 'POST'
            },
            columns: [
                { 
                    data: 'subscriptionName',
                    render: function(data) {
                        return `<span style="font-weight: 600; color: var(--brand-primary);">${data}</span>`;
                    }
                },
                { 
                    data: 'startDateUtc',
                    render: function(data) { return new Date(data).toLocaleDateString(); }
                },
                { 
                    data: 'endDateUtc',
                    render: function(data) { return new Date(data).toLocaleDateString(); }
                },
                {
                    data: 'isActive',
                    render: function(data) {
                        return data ? '<span class="badge badge-success">Active</span>' : '<span class="badge badge-neutral">Inactive</span>';
                    }
                },
                {
                    data: null,
                    orderable: false,
                    render: function(data, type, row) {
                        return `<div style="text-align: right;">
                                    <button class="action-btn" title="Edit" onclick="editTenantSubscription('${row.id}', '@tenantId')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></button>
                                </div>`;
                    }
                }
            ]
        });

        window.addNewSubscription = function(tId) {
            openAddEditSubscription(tId);
        };

        window.editTenantSubscription = function(id, tId) {
            openAddEditSubscription(tId, id);
        };

        function openAddEditSubscription(tId, id = '') {
            // Nested modal? Or replace content?
            // User likely wants a simple flow. 
            // We can use the same modal system to load the next view.
            window.openModal({
                title: id ? 'Modify Subscription' : 'Provision New Subscription',
                subtitle: 'Set license duration and entitlement tier.',
                icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>',
                url: `/Home/AddEditTenantSubscription?TenantId=${tId}&Id=${id}`,
                onSuccess: function() {
                   tsTable.ajax.reload();
                }
            });
        }
    });
</script>
