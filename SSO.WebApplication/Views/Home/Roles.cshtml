@using SSO.Application.Responses.Features

@{
    ViewData["Title"] = "Roles & Permissions";
}

<div class="breadcrumbs">
    <span>Auxinz Identity</span>
    <a href="#">Identity & Access</a>
    <span class="current">Roles</span>
</div>

<div class="page-header">
    <div>
        <h1>Security Roles</h1>
        <p style="color: var(--text-muted); margin-top: 4px;">
            Define user roles and assign granular permissions across tenants.
        </p>
    </div>
    <div style="display: flex; gap: 12px;">
        <button class="btn btn-primary" id="openCreateRoleModal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Create Role
        </button>
        <a href="/Home/ExportRoles" class="btn btn-secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Export Excel
        </a>
    </div>
</div>

<div class="panel">
    <div class="table-toolbar">
        <div class="table-filters">
            <div style="position: relative;">
                <svg style="position: absolute; left: 10px; top: 10px; color: var(--text-muted);"
                     width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" class="form-input" placeholder="Filter by Role Name..."
                       style="padding-left: 32px; width: 250px;">
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table id="roleTable" class="data-table table-hoverable manual-init">
            <thead>
                <tr>
                    <th style="width: 48px;"><input type="checkbox" class="custom-checkbox"></th>
                    <th class="sorted">Role Name</th>
                    <th>Description</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        const $panel = $('#roleTable').closest('.panel');
        const $customSearch = $panel.find('.table-toolbar .form-input');

        const dt = $('#roleTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '/Home/GetRoles',
                type: 'POST',
                data: function (d) {
                    if ($customSearch.length > 0) {
                        d.customSearchValue = $customSearch.val();
                    }
                }
            },
            responsive: true,
            dom: '<"table-toolbar datatables-injected"<"table-filters"l>f>t<"pagination"ip>',
            columns: [
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function () { return '<input type="checkbox" class="custom-checkbox">'; }
                },
                {
                    data: 'name',
                    render: function (data, type, row) {
                        return `<div class="cell-flex">
                                    <div class="cell-avatar warning">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                            <polyline points="2 17 12 22 22 17"></polyline>
                                            <polyline points="2 12 12 17 22 12"></polyline>
                                        </svg>
                                    </div>
                                    <div class="cell-text">
                                        <h5>${data}</h5>
                                    </div>
                                </div>`;
                    }
                },
                { 
                    data: 'description',
                    render: function(data) { return data || '<span class="text-muted">No description</span>'; }
                },
                {
                    data: null,
                    orderable: false,
                    render: function (data, type, row) {
                        return `<div style="text-align: right;">
                                    <button class="action-btn" title="Manage Permissions" onclick="managePermissions('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg></button>
                                    <button class="action-btn" title="Edit Role" onclick="editRole('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></button>
                                    <button class="action-btn text-error" title="Delete Role" onclick="deleteRole('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>
                                </div>`;
                    }
                }
            ]
        });

        if ($customSearch.length > 0) {
            let searchTimeout;
            $customSearch.on('keyup', function () {
                clearTimeout(searchTimeout);
                const val = this.value;
                searchTimeout = setTimeout(() => {
                    dt.search(val).draw();
                }, 400);
            });
        }

        $('#openCreateRoleModal').on('click', function() {
            openRoleModal();
        });
    });

    function openRoleModal(id = '') {
        const isEdit = id !== '';
        window.openModal({
            title: isEdit ? 'Update Role' : 'Create Security Role',
            subtitle: isEdit ? 'Modify role name and metadata.' : 'Define a new access level for system users.',
            icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>',
            url: '/Home/CreateRole?Id=' + id,
            onSuccess: function() {
                $('#roleTable').DataTable().ajax.reload();
            }
        });
    }

    function editRole(id) {
        openRoleModal(id);
    }

    function managePermissions(id) {
        window.location.href = '/Home/RolePermissions?Id=' + id;
    }

    function deleteRole(id) {
        window.openModal({
            title: 'Delete Role',
            subtitle: 'Warning: This may affect users currently assigned to this role.',
            icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-error"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>',
            url: '/Home/DeleteRole?Id=' + id,
            onSuccess: function() {
                $('#roleTable').DataTable().ajax.reload();
            }
        });
    }
</script>
