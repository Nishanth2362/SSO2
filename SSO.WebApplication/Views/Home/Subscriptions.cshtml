@using SSO.Application.Responses.Features

@{
    ViewData["Title"] = "Subscriptions & Plans";
}

<div class="breadcrumbs">
    <span>Auxinz Identity</span>
    <a href="#">Multi-Tenancy</a>
    <span class="current">Subscription Plans</span>
</div>

<div class="page-header">
    <div>
        <h1>Service Plans</h1>
        <p style="color: var(--text-muted); margin-top: 4px;">
            Configure subscription tiers, pricing, and feature quotas.
        </p>
    </div>
    <div style="display: flex; gap: 12px;">
        <button class="btn btn-primary" id="openCreatePlanModal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Create Plan
        </button>
        <a href="/Home/ExportSubscriptions" class="btn btn-secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Export Excel
        </a>
    </div>
</div>

<div class="panel">
    <div class="table-toolbar">
        <div class="table-filters">
            <div style="position: relative;">
                <svg style="position: absolute; left: 10px; top: 10px; color: var(--text-muted);"
                     width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" class="form-input" placeholder="Search plans..."
                       style="padding-left: 32px; width: 250px;">
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table id="subscriptionTable" class="data-table table-hoverable manual-init">
            <thead>
                <tr>
                    <th style="width: 48px;"><input type="checkbox" class="custom-checkbox"></th>
                    <th class="sorted">Plan Name</th>
                    <th>Billing</th>
                    <th>Pricing</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        const $panel = $('#subscriptionTable').closest('.panel');
        const $customSearch = $panel.find('.table-toolbar .form-input');

        const dt = $('#subscriptionTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '/Home/GetSubscriptions',
                type: 'POST',
                data: function (d) {
                    if ($customSearch.length > 0) {
                        d.customSearchValue = $customSearch.val();
                    }
                }
            },
            responsive: true,
            dom: '<"table-toolbar datatables-injected"<"table-filters"l>f>t<"pagination"ip>',
            columns: [
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function () { return '<input type="checkbox" class="custom-checkbox">'; }
                },
                {
                    data: 'name',
                    render: function (data, type, row) {
                        return `<div class="cell-flex">
                                    <div class="cell-avatar success">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect>
                                            <line x1="2" y1="10" x2="22" y2="10"></line>
                                        </svg>
                                    </div>
                                    <div class="cell-text">
                                        <h5>${data}</h5>
                                        <p>${row.description || 'No description'}</p>
                                    </div>
                                </div>`;
                    }
                },
                {
                    data: 'billingCycle',
                    render: function (data) {
                        return data === 2 ? '<span class="badge">Yearly</span>' : '<span class="badge">Monthly</span>';
                    }
                },
                {
                    data: 'price',
                    render: function (data, type, row) {
                        const symbol = getCurrencySymbol(row.currency);
                        return `<span style="font-weight: 600; color: var(--brand-primary);">${symbol}${data.toFixed(2)}</span>`;
                    }
                },
                {
                    data: 'isActive',
                    render: function (data) {
                        return data ? '<span class="badge badge-success">Active</span>' : '<span class="badge badge-neutral">Retired</span>';
                    }
                },
                {
                    data: null,
                    orderable: false,
                    render: function (data, type, row) {
                        return `<div style="text-align: right;">
                                    <button class="action-btn" title="Edit Plan" onclick="editPlan('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></button>
                                    <button class="action-btn text-error" title="Delete Plan" onclick="deletePlan('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>
                                </div>`;
                    }
                }
            ]
        });

        function getCurrencySymbol(code) {
            if (code === 'INR') return '₹';
            if (code === 'USD') return '$';
            if (code === 'EUR') return '€';
            if (code === 'GBP') return '£';
            return code + ' ';
        }

        if ($customSearch.length > 0) {
            let searchTimeout;
            $customSearch.on('keyup', function () {
                clearTimeout(searchTimeout);
                const val = this.value;
                searchTimeout = setTimeout(() => {
                    dt.search(val).draw();
                }, 400);
            });
        }

        $('#openCreatePlanModal').on('click', function() {
            openSubscriptionModal();
        });
    });

    function openSubscriptionModal(id = '') {
        const isEdit = id !== '';
        openModal({
            title: isEdit ? 'Update Service Plan' : 'Create Subscription Tier',
            subtitle: isEdit ? 'Modify plan quotas and features.' : 'Design a new subscription package for tenants.',
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect>
                    <line x1="2" y1="10" x2="22" y2="10"></line>
                  </svg>`,
            url: '/Home/CreateSubscription?Id=' + id,
            onSuccess: function() {
                $('#subscriptionTable').DataTable().ajax.reload();
            }
        });
    }

    function editPlan(id) {
        openSubscriptionModal(id);
    }

    function deletePlan(id) {
        openModal({
            title: 'Retire Plan',
            subtitle: 'Confirm permanent removal of this subscription tier.',
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-error">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  </svg>`,
            url: '/Home/DeleteSubscription?Id=' + id,
            onSuccess: function() {
                $('#subscriptionTable').DataTable().ajax.reload();
            }
        });
    }
</script>
