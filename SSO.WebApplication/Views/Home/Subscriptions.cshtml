<script type="text/javascript">
    $(function () {
        var isYearly = false;
        var currencySymbols = { INR: '₹', USD: '$', EUR: '€', GBP: '£' };

        function sym(code) {
            return currencySymbols[code] || (code + ' ');
        }

        var iconClasses  = ['icon-green', 'icon-purple', 'icon-blue', 'icon-amber'];
        var checkClasses = ['icon-green', 'icon-purple', 'icon-blue', 'icon-amber'];
        const $panel = $('#subscriptionTable').closest('.panel');
        const $customSearch = $('#planSearchInput');
        const canEditPlan = @canEditPlan.ToString().ToLower();
        const canDeletePlan = @canDeletePlan.ToString().ToLower();

        const dt = $('#subscriptionTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '/Home/GetSubscriptions',
                type: 'POST',
                data: function (d) {
                    d.draw = d.draw || 1;
                    d.start = d.start || 0;
                    d.length = d.length || 200;
                    d.customSearchValue = $customSearch.val() || '';
                }
            },
            language: {
                search: "",
                searchPlaceholder: "Search records...",
                lengthMenu: ""
            },
            responsive: false,
            dom: '<"table-toolbar datatables-injected"<"table-filters">f>t<"if-table-footer-wrap"<"footer-right"<"if-pill-pagination-mount">>>',
            drawCallback: function(settings) {
                const api = this.api();
                const rows = api.rows({ page: 'current' }).data();

                // Read isYearly from activeFilters
                const activeFilters = $panel.data('active-filters') || {};
                isYearly = (activeFilters.BillingCycle === '2');
                window.renderPillPagination(api, '.if-pill-pagination-mount', 'plans');

                // Keep KPI highlight synchronized in drawCallback
                $('.sub-kpi-card').removeClass('active');
                if (activeFilters.BillingCycle === '1') {
                    $('#kpiMonthly').addClass('active');
                } else if (activeFilters.BillingCycle === '2') {
                    $('#kpiYearly').addClass('active');
                } else {
                    $('#kpiTotal').addClass('active');
                }

                // Render grid view with current page data
                renderGridView(rows.toArray());

                // Sync footer position based on active view mode
                const savedView = localStorage.getItem('view-mode-subscriptionTable') || 'list';
                if (savedView === 'grid' || savedView === 'dense') {
                    const $footer = $panel.find('.if-table-footer-wrap');
                    if ($footer.length) {
                        $panel.append($footer);
                    }
                }
            },
            columns: [
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: 'text-center align-middle',
                    render: function (data, type, row) {
                        return '<input type="checkbox" class="row-select-cb" data-row-id="' + (row.id || '') + '">';
                    }
                },
                {
                    data: 'name',
                    className: 'text-left align-middle',
                    render: function (data, type, row, meta) {
                        const idx = meta.row;
                        const styles = [
                            { bg: 'bg-purple', icon: '<path d="M2 20h20"></path><path d="M4 20V10l4 4 4-8 4 8 4-4v10"></path>' },
                            { bg: 'bg-green',  icon: '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>' },
                            { bg: 'bg-blue',   icon: '<rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line>' },
                            { bg: 'bg-amber',  icon: '<polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline>' }
                        ];
                        const st = styles[idx % styles.length];
                        const desc = row.description || (data && data.toLowerCase() === 'default' ? 'System default plan' : (row.billingCycle === 2 || row.billingCycle === '2' ? 'Yearly plan' : 'Monthly plan'));
                        return `<div class="sub-plan-cell">
                                    <div class="sub-plan-avatar ${st.bg}">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            ${st.icon}
                                        </svg>
                                    </div>
                                    <div class="sub-plan-meta">
                                        <h5 class="sub-plan-name">${escHtml(data)}</h5>
                                        <span class="sub-plan-desc">${escHtml(desc)}</span>
                                    </div>
                                </div>`;
                    }
                },
                {
                    data: 'billingCycle',
                    className: 'text-center align-middle',
                    render: function (data) {
                        return (data === 2 || data === '2' || data === 'Yearly')
                            ? '<span class="sub-badge-cycle-yearly">Yearly</span>'
                            : '<span class="sub-badge-cycle-monthly">Monthly</span>';
                    }
                },
                {
                    data: 'price',
                    className: 'text-right align-middle',
                    render: function (data, type, row) {
                        const currSym = sym(row.currency);
                        const basePrice = data || 0;
                        const displayPrice = isYearly ? Math.round(basePrice * 0.8) : basePrice;
                        return `<span class="sub-price-val">${currSym}${displayPrice.toFixed(2)}</span> <span class="sub-price-unit">/mo</span>`;
                    }
                },
                {
                    data: 'maxUsers',
                    className: 'text-center align-middle',
                    render: function (data) {
                        const val = data >= 999999 ? 'Unlimited' : data;
                        return `<div class="sub-metric-item" style="display: inline-flex; align-items: center; justify-content: center;">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sub-metric-icon">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                    </svg>
                                    ${val}
                                </div>`;
                    }
                },
                {
                    data: 'maxApps',
                    className: 'text-center align-middle',
                    render: function (data) {
                        return `<div class="sub-metric-item" style="display: inline-flex; align-items: center; justify-content: center;">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sub-metric-icon">
                                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                                    </svg>
                                    ${data || 0}
                                </div>`;
                    }
                },
                {
                    data: 'allowSeparateDb',
                    className: 'text-center align-middle',
                    render: function (data) {
                        return `<span class="sub-badge-isolation">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                                        <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                                        <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                                    </svg>
                                    ${data ? 'Isolated' : 'Shared'}
                                </span>`;
                    }
                },
                {
                    data: 'isActive',
                    className: 'text-center align-middle',
                    render: function (data) {
                        return data
                            ? '<span class="sub-badge-status-active"><span class="sub-status-dot dot-active"></span>Active</span>'
                            : '<span class="sub-badge-status-retired"><span class="sub-status-dot dot-retired"></span>Retired</span>';
                    }
                },
                { data: 'description', visible: false, className: 'text-left align-middle', render: function(d){ return d || '—'; } },
                { data: 'currency', visible: false, className: 'text-center align-middle', render: function(d){ return d || 'USD'; } },
                { 
                    data: 'createdOn', 
                    visible: false, 
                    className: 'text-center align-middle',
                    render: function(d){ 
                        if(!d) return '—'; 
                        return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); 
                    } 
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: 'text-center align-middle',
                    render: function (data, type, row) {
                        let html = `<div class="sub-action-group" style="display: inline-flex; align-items: center; justify-content: center; gap: 8px;">
                                    <button class="action-btn action-btn-view" title="View Details" data-type="subscription" data-id="${row.id}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path></svg></button>`;
                        if (canEditPlan) {
                            html += `<button class="action-btn action-btn-edit" title="Edit Plan" onclick="editPlan('${row.id}')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 1-2 2v14a2 2 0 0 1 2 2h14a2 2 0 0 1 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></button>`;
                        }
                        if (canDeletePlan) {
                            html += `<button class="action-btn action-btn-delete" title="Retire Plan" onclick="deletePlan('${row.id}')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>`;
                        }
                        html += `</div>`;
                        return html;
                    }
                }
            ]
        });

        // Listen to xhr event to calculate and cache plan counts
        $('#subscriptionTable').on('xhr.dt', function (e, settings, json, xhr) {
            if (json && json.data) {
                const activeFilters = $panel.data('active-filters') || {};
                const currentBillingCycle = activeFilters.BillingCycle;

                // Only count when BillingCycle filter is not active to get true totals
                if (typeof currentBillingCycle === 'undefined' || currentBillingCycle === '') {
                    let monthly = 0;
                    let yearly = 0;
                    json.data.forEach(function (row) {
                        if (row.billingCycle === 1 || row.billingCycle === '1' || row.billingCycle === 'Monthly') {
                            monthly++;
                        } else if (row.billingCycle === 2 || row.billingCycle === '2' || row.billingCycle === 'Yearly') {
                            yearly++;
                        }
                    });
                    $panel.data('total-monthly', monthly);
                    $panel.data('total-yearly', yearly);
                    $panel.data('total-plans', monthly + yearly);
                }

                // Update text elements safely
                $('#monthlyCount').text($panel.data('total-monthly') || 0);
                $('#yearlyCount').text($panel.data('total-yearly') || 0);
                $('#totalCount').text($panel.data('total-plans') || 0);
            }
        });

        /* ── KPI Cards Click Routing ── */
        $('.sub-kpi-card').on('click', function () {
            const val = $(this).attr('data-value'); // "all", "1" or "2"
            const activeFilters = $panel.data('active-filters') || {};

            if (val === 'all') {
                delete activeFilters.BillingCycle;
            } else {
                if (activeFilters.BillingCycle === val) {
                    delete activeFilters.BillingCycle;
                } else {
                    activeFilters.BillingCycle = val;
                }
            }

            $panel.data('active-filters', activeFilters);
            const hasFilters = Object.keys(activeFilters).length > 0;
            $panel.find('.filter-trigger-btn').toggleClass('active', hasFilters);

            // Sync to select input inside filters repo
            const $repoFilter = $panel.find('.table-filters-repo .filter-BillingCycle');
            if ($repoFilter.length) {
                $repoFilter.val(activeFilters.BillingCycle ? [activeFilters.BillingCycle] : []).trigger('change');
            }

            dt.draw();
        });

        // Sync KPI highlights if filter changes from filter drawer select
        $(document).on('change', '.table-filters-repo .filter-BillingCycle', function () {
            const val = $(this).val(); // Could be array or string
            const activeFilters = $panel.data('active-filters') || {};

            // Extract selected billing cycle
            let selectedVal = '';
            if (Array.isArray(val) && val.length > 0) {
                selectedVal = val[0];
            } else if (typeof val === 'string') {
                selectedVal = val;
            }

            $('.sub-kpi-card').removeClass('active');
            if (selectedVal === '1') {
                $('#kpiMonthly').addClass('active');
            } else if (selectedVal === '2') {
                $('#kpiYearly').addClass('active');
            } else {
                $('#kpiTotal').addClass('active');
            }
        });

        function escHtml(str) {
            return $('<div>').text(str).html();
        }



        /* ── Search ── */
        var searchTimer;
        $('#planSearchInput').on('keyup', function () {
            clearTimeout(searchTimer);
            var val = this.value;
            searchTimer = setTimeout(function () {
                dt.search(val).draw();
            }, 300);
        });

        /* ── Create plan modal button ── */
        $('#openCreatePlanModal').on('click', function () {
            openSubscriptionModal();
        });

        // Listen for reloading events from modal callbacks
        document.addEventListener('reloadPlans', function() {
            dt.ajax.reload();
        });

        // Initialize row selection for smart export
        window.initRowSelection('subscriptionTable', 'id');

        /* ── Override applyViewMode to integrate with ui.js and support 'dense' mode ── */
        const originalApplyViewMode = window.applyViewMode;
        window.applyViewMode = function(targetTableId, mode) {
            if (targetTableId === 'subscriptionTable' && (mode === 'grid' || mode === 'dense')) {
                const $table = $('#subscriptionTable');
                const $panel = $table.closest('.panel');
                const $grid = $panel.find('.grid-cards-container');
                const $tableResponsive = $table.closest('.table-responsive');
                const $footer = $panel.find('.if-table-footer-wrap');

                $tableResponsive.hide();
                $grid.css('display', 'grid');

                if (mode === 'dense') {
                    $grid.addClass('dense');
                } else {
                    $grid.removeClass('dense');
                }

                // Move footer to the end of panel so it remains visible below Grid View
                if ($footer.length) {
                    $panel.append($footer);
                }

                // Update buttons state
                $panel.find('.view-toggle-btn').removeClass('active');
                $panel.find(`.view-toggle-btn[data-view="${mode}"]`).addClass('active');

                // Save selection
                localStorage.setItem('view-mode-subscriptionTable', mode);
            } else {
                if (mode === 'list' && targetTableId === 'subscriptionTable') {
                    const $table = $('#subscriptionTable');
                    const $panel = $table.closest('.panel');
                    const $grid = $panel.find('.grid-cards-container');
                    const $footer = $panel.find('.if-table-footer-wrap');
                    $grid.hide();

                    // Move footer back into the DataTable wrapper
                    const $dtWrapper = $('#subscriptionTable_wrapper');
                    if ($footer.length && $dtWrapper.length) {
                        $dtWrapper.append($footer);
                    }
                }
                if (typeof originalApplyViewMode === 'function') {
                    originalApplyViewMode(targetTableId, mode);
                }
            }
        };

        /* ── Grid View Rendering ── */
        function renderGridView(dataArray) {
            const $container = $('#gridViewWrapper');
            $container.empty();

            if (!dataArray || dataArray.length === 0) {
                $container.html(`
                    <div style="grid-column: 1 / -1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 64px 20px; color: var(--text-muted); text-align: center; background: var(--bg-surface); border: 1px dashed var(--border-strong); border-radius: var(--radius-lg); margin: 16px 0;">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 12px; opacity: 0.7;">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="9" y1="3" x2="9" y2="21"></line>
                        </svg>
                        <h5 style="margin: 0 0 4px 0; font-weight: 600; color: var(--text-main);">No Subscription Plans Found</h5>
                        <p style="margin: 0; font-size: 0.75rem;">Try adjusting your search terms or filters.</p>
                    </div>
                `);
                return;
            }

            const selectedSet = window.getSelectionSet('subscriptionTable');

            dataArray.forEach(function (row, idx) {
                const iconCls = iconClasses[idx % iconClasses.length];
                const isFeatured = false;

                const currSym = sym(row.currency);
                const basePrice = row.price || 0;
                const displayPrice = isYearly ? Math.round(basePrice * 0.8) : basePrice;
                const suffix = isYearly ? 'mo' : 'mo';

                const displayPriceFormatted = Number(displayPrice).toLocaleString(row.currency === 'INR' ? 'en-IN' : 'en-US', {
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 0
                });

                const isSelected = selectedSet.has(String(row.id));
                const maxUsersVal = row.maxUsers >= 999999 ? 'Unlimited' : row.maxUsers;
                const maxAppsVal = row.maxApps >= 999999 ? 'Unlimited' : (row.maxApps || 0);

                const cardHtml = `
                    <div class="sub-grid-card ${isFeatured ? 'featured' : ''} ${!row.isActive ? 'retired' : ''} ${isSelected ? 'selected' : ''}" data-id="${row.id}">
                        <div class="sub-card-header">
                            <div class="sub-card-badge-left">
                                ${isFeatured ? '<span class="badge-popular-card">+ MOST POPULAR</span>' : ''}
                                <input type="checkbox" class="sub-card-checkbox" data-id="${row.id}" ${isSelected ? 'checked' : ''}>
                            </div>
                            <div class="sub-card-badge-right">
                                ${row.isActive
                                    ? '<span class="badge-active-card"><span class="status-dot dot-active"></span>Active</span>'
                                    : '<span class="badge-retired-card"><span class="status-dot dot-retired"></span>Retired</span>'}
                            </div>
                        </div>

                        <div class="sub-card-title-section">
                            <div class="sub-avatar-card ${iconCls}">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M6 3h12l4 6-10 13L2 9z"></path>
                                    <path d="M11 3 8 9l4 13 4-13-3-6"></path>
                                    <path d="M2 9h20"></path>
                                </svg>
                            </div>
                            <div class="sub-card-title-group">
                                <h4 class="sub-card-name" title="${escHtml(row.name)}">${escHtml(row.name)}</h4>
                                <div class="sub-card-billing-desc" title="${isYearly ? 'Yearly billing - -20% off' : 'Monthly billing'}">${isYearly ? 'Yearly billing - -20% off' : 'Monthly billing'}</div>
                            </div>
                        </div>

                        <div class="sub-card-price-section">
                            <span class="sub-card-price">${currSym}${displayPriceFormatted}</span>
                            <span class="sub-card-price-suffix">/${suffix}</span>
                        </div>

                        <div class="sub-card-quotas">
                            <div class="quota-box" title="${maxUsersVal}">
                                <svg class="quota-box-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                </svg>
                                <div class="quota-box-value">${maxUsersVal}</div>
                                <div class="quota-box-label">USERS</div>
                            </div>
                            <div class="quota-box" title="${maxAppsVal}">
                                <svg class="quota-box-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                                    <line x1="8" y1="21" x2="16" y2="21"></line>
                                    <line x1="12" y1="17" x2="12" y2="21"></line>
                                </svg>
                                <div class="quota-box-value">${maxAppsVal}</div>
                                <div class="quota-box-label">APPS</div>
                            </div>
                            <div class="quota-box" title="${row.allowSeparateDb ? 'Isolated' : 'Shared'}">
                                <svg class="quota-box-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                                    <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                                    <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                                </svg>
                                <div class="quota-box-value">${row.allowSeparateDb ? 'Isolated' : 'Shared'}</div>
                                <div class="quota-box-label">ISOLATION</div>
                            </div>
                        </div>

                        <div class="sub-card-actions">
                            <button class="btn-card-view-details action-btn-view ${isFeatured ? 'featured' : ''}" data-type="subscription" data-id="${row.id}">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px; vertical-align: middle;">
                                    <circle cx="12" cy="12" r="3"></circle>
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                </svg>
                                View details
                            </button>
                            ${canEditPlan ? `
                                <button class="btn-card-action" title="Edit Plan" onclick="editPlan('${row.id}')">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                    </svg>
                                </button>
                            ` : ''}
                            ${canDeletePlan ? `
                                <button class="btn-card-action text-error" title="Retire Plan" onclick="deletePlan('${row.id}')">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    </svg>
                                </button>
                            ` : ''}
                        </div>
                    </div>
                `;
                $container.append(cardHtml);
            });
        }

        /* ── Card Checkbox Handler ── */
        $('#gridViewWrapper').on('change', '.sub-card-checkbox', function (e) {
            const cardId = $(this).data('id');
            const isChecked = this.checked;
            window.toggleSelection('subscriptionTable', cardId, isChecked);
            $(this).closest('.sub-grid-card').toggleClass('selected', isChecked);

            // Sync table checkbox if visible
            const $rowCheckbox = $(`#subscriptionTable input.row-select-cb[data-row-id="${cardId}"]`);
            if ($rowCheckbox.length) {
                $rowCheckbox.prop('checked', isChecked);
                $rowCheckbox.closest('tr').toggleClass('selected-row', isChecked);
            }

            // Sync master select checkbox
            const set = window.getSelectionSet('subscriptionTable');
            const visibleIds = $('#subscriptionTable').find('input.row-select-cb').map(function () { return String($(this).data('row-id')); }).get();
            const allChecked = visibleIds.length > 0 && visibleIds.every(id => set.has(id));
            const $master = $('.master-select-cb[data-table="subscriptionTable"]');
            $master.prop('checked', allChecked);

            const checkedCount = visibleIds.filter(id => set.has(id)).length;
            $master.prop('indeterminate', checkedCount > 0 && checkedCount < visibleIds.length);
        });

        /* ── Sync Selection from Table/Global to Cards ── */
        $(document).on('selection:changed', function (e, data) {
            if (data.tableId === 'subscriptionTable') {
                $('.sub-card-checkbox').each(function () {
                    const cardId = $(this).data('id');
                    const isChecked = data.ids.includes(String(cardId));
                    $(this).prop('checked', isChecked);
                    $(this).closest('.sub-grid-card').toggleClass('selected', isChecked);
                });
            }
        });

        /* ── View Switcher Transitions ── */
        $(document).on('click', '.view-toggle-btn', function (e) {
            const mode = $(this).data('view');
            const target = $(this).data('target');
            if (target === 'subscriptionTable') {
                if (mode === 'grid' || mode === 'dense') {
                    $('#tableViewWrapper').removeClass('active');
                    setTimeout(() => {
                        $('#gridViewWrapper').addClass('active');
                    }, 50);
                } else {
                    $('#gridViewWrapper').removeClass('active');
                    setTimeout(() => {
                        $('#tableViewWrapper').addClass('active');
                    }, 50);
                }
            }
        });

        // Initialize active view state from storage without animation transitions
        function initActiveView() {
            const savedView = localStorage.getItem('view-mode-subscriptionTable') || 'list';
            window.applyViewMode('subscriptionTable', savedView);

            if (savedView === 'grid' || savedView === 'dense') {
                $('#tableViewWrapper').removeClass('active');
                $('#gridViewWrapper').addClass('active');
            } else {
                $('#gridViewWrapper').removeClass('active');
                $('#tableViewWrapper').addClass('active');
            }
        }

        // Run view switcher initialization
        initActiveView();
    });

    /* ── Global modal helpers (referenced by edit/delete buttons) ── */
    function openSubscriptionModal(id) {
        id = id || '';
        var isEdit = id !== '';
        openModal({
            title: isEdit ? 'Update Service Plan' : 'Create Subscription Tier',
            subtitle: isEdit ? 'Modify plan quotas and features.' : 'Design a new subscription package for tenants.',
            icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>',
            url: '/Home/CreateSubscription?Id=' + id,
            onSuccess: function () {
                /* dispatch reload event */
                var event = new Event('reloadPlans');
                document.dispatchEvent(event);
            }
        });
    }

    function editPlan(id) {
        openSubscriptionModal(id);
    }

    function deletePlan(id, name) {
        let planName = name;
        if (!planName && typeof $ !== 'undefined' && $('#subscriptionTable').length) {
            if ($.fn && $.fn.dataTable && typeof $.fn.dataTable.isDataTable === 'function' && $.fn.dataTable.isDataTable('#subscriptionTable')) {
                try {
                    const rowData = $('#subscriptionTable').DataTable().rows().data().toArray().find(r => String(r.id) === String(id));
                    if (rowData && rowData.name) planName = rowData.name;
                } catch (e) { }
            }
        }
        openModal({
            title: 'Delete ' + (planName ? planName : 'Plan') + '?',
            subtitle: 'This cannot be undone. Type DELETE to confirm.',
            icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-error"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>',
            url: '/Home/DeleteSubscription?Id=' + id,
            onSuccess: function () {
                var event = new Event('reloadPlans');
                document.dispatchEvent(event);
                if (typeof $ !== 'undefined' && $('#subscriptionTable').length && $.fn && $.fn.dataTable && $.fn.dataTable.isDataTable('#subscriptionTable')) {
                    $('#subscriptionTable').DataTable().ajax.reload();
                }
            }
        });
    }


</script>
