@using SSO.Application.Responses.Features

@{
    ViewData["Title"] = "Templates";
}

<div class="breadcrumbs">
    <span>Auxinz Identity</span>
    <a href="#">System Settings</a>
    <span class="current">Templates</span>
</div>

<div class="page-header">
    <div>
        <h1>Document Templates</h1>
        <p style="color: var(--text-muted); margin-top: 4px;">
            Manage system templates for invoices, emails, and notifications.
        </p>
    </div>
    <div style="display: flex; gap: 12px;">
        <button class="btn btn-primary" id="openCreateTemplateModal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Create Template
        </button>
        <a href="/Home/ExportTemplates" class="btn btn-secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Export Excel
        </a>
    </div>
</div>

<div class="panel">
    <div class="table-toolbar">
        <div class="table-filters">
            <div style="position: relative;">
                <svg style="position: absolute; left: 10px; top: 10px; color: var(--text-muted);"
                     width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" class="form-input" placeholder="Filter by Name or Key..."
                       style="padding-left: 32px; width: 250px;">
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table id="templateTable" class="data-table table-hoverable manual-init">
            <thead>
                <tr>
                    <th style="width: 48px;"><input type="checkbox" class="custom-checkbox"></th>
                    <th class="sorted">Template Name</th>
                    <th>Logical Key</th>
                    <th>Type</th>
                    <th>Version</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        const $panel = $('#templateTable').closest('.panel');
        const $customSearch = $panel.find('.table-toolbar .form-input');
        const $customFilters = $panel.find('.table-toolbar .form-select');

        const dt = $('#templateTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '/Home/GetTemplates',
                type: 'POST',
                data: function (d) {
                    if ($customSearch.length > 0) {
                        d.customSearchValue = $customSearch.val();
                    }
                }
            },
            responsive: true,
            dom: '<"table-toolbar datatables-injected"<"table-filters"l>f>t<"pagination"ip>',
            columns: [
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function () { return '<input type="checkbox" class="custom-checkbox">'; }
                },
                {
                    data: 'name',
                    render: function (data, type, row) {
                        return `<div class="cell-flex">
                                    <div class="cell-avatar secondary">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                            <polyline points="14 2 14 8 20 8"></polyline>
                                        </svg>
                                    </div>
                                    <div class="cell-text">
                                        <h5>${data}</h5>
                                    </div>
                                </div>`;
                    }
                },
                { data: 'key' },
                { 
                    data: 'type',
                    render: function(data) {
                        const types = ['Email', 'Invoice', 'SMS'];
                        return `<span class="badge badge-neutral">${types[data] || 'Other'}</span>`;
                    }
                },
                { data: 'version' },
                {
                    data: null,
                    orderable: false,
                    render: function (data, type, row) {
                        const types = ['Excel', 'Word', 'PowerPoint'];
                        const docType = types[row.type] || 'Word';
                        return `<div style="text-align: right;">
                                    <button class="action-btn text-brand" title="Export Test Data" onclick="window.location.href='/Home/ExportTestTemplate?key=${row.key}&type=${docType}'"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg></button>
                                    <button class="action-btn" title="Edit Template" onclick="editTemplate('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></button>
                                    <button class="action-btn text-error" title="Delete Template" onclick="deleteTemplate('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>
                                </div>`;
                    }
                }
            ]
        });

        if ($customSearch.length > 0) {
            let searchTimeout;
            $customSearch.on('keyup', function () {
                clearTimeout(searchTimeout);
                const val = this.value;
                searchTimeout = setTimeout(() => {
                    dt.search(val).draw();
                }, 400);
            });
        }

        $('#openCreateTemplateModal').on('click', function() {
            openTemplateModal();
        });
    });

    function openTemplateModal(id = '') {
        const isEdit = id !== '';
        window.openModal({
            title: isEdit ? 'Update Template' : 'Create Document Template',
            subtitle: isEdit ? 'Modify template content and versioning.' : 'Define a new system template for organization-wide use.',
            icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>',
            url: '/Home/CreateTemplate?Id=' + id,
            onSuccess: function() {
                $('#templateTable').DataTable().ajax.reload();
            }
        });
    }

    function editTemplate(id) {
        openTemplateModal(id);
    }

    function deleteTemplate(id) {
        window.openModal({
            title: 'Delete Template',
            subtitle: 'This will permanently remove this template version.',
            icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-error"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>',
            url: '/Home/DeleteTemplate?Id=' + id,
            onSuccess: function() {
                $('#templateTable').DataTable().ajax.reload();
            }
        });
    }
</script>
