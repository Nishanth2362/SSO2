@using SSO.Application.Responses.Features

@{
    ViewData["Title"] = "Tenant Access Control";
    var canExportTenantUsers = (await AuthorizationService.AuthorizeAsync(User, Permissions.Tenant.Export)).Succeeded;
    var canManageTenant = (await AuthorizationService.AuthorizeAsync(User, Permissions.Tenant.Edit)).Succeeded;
}

<style>
    /* Full-page background for seamless integration (Purple/Blue Theme matching Tenants page) */
    body {
        background: linear-gradient(150deg,
                        rgba(124, 92, 252, 0.10) 0%,
                        rgba(124, 92, 252, 0.05) 22%,
                        rgba(24, 167, 223, 0.06) 55%,
                        rgba(236, 253, 245, 0.5) 78%,
                        rgba(255, 255, 255, 0.95) 100%) !important;
        background-attachment: fixed !important;
        background-repeat: no-repeat !important;
        background-size: cover !important;
    }

    html[data-theme="dark"] body {
        background: linear-gradient(150deg,
                        rgba(124, 92, 252, 0.18) 0%,
                        rgba(124, 92, 252, 0.08) 22%,
                        rgba(24, 167, 223, 0.09) 55%,
                        rgba(15, 23, 42, 0.6) 78%,
                        rgba(9, 12, 20, 0.95) 100%) !important;
        background-attachment: fixed !important;
        background-repeat: no-repeat !important;
        background-size: cover !important;
    }

    .page-wrapper, .content-wrapper, .container-xl, main, #content, .page-body {
        background: transparent !important;
    }

    /* ═══════════════════════════════════════════════════════════
       TENANT ACCESS CONTROL TABLE ALIGNMENT FIX
       ═══════════════════════════════════════════════════════════ */
    #tuTable {
        width: 100% !important;
        table-layout: fixed !important;
    }
    #tuTable th, #tuTable td {
        box-sizing: border-box !important;
        vertical-align: middle !important;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    #tuTable th:nth-child(1), #tuTable td:nth-child(1) { width: 44px !important; min-width: 44px; text-align: center; }
    #tuTable th:nth-child(2), #tuTable td:nth-child(2) { width: 18% !important; min-width: 160px; }
    #tuTable th:nth-child(3), #tuTable td:nth-child(3) { width: 13% !important; min-width: 125px; text-align: center; }
    #tuTable th:nth-child(4), #tuTable td:nth-child(4) { width: 15% !important; min-width: 135px; }
    #tuTable th:nth-child(5), #tuTable td:nth-child(5) { width: 13% !important; min-width: 125px; text-align: center; }
    #tuTable th:nth-child(6), #tuTable td:nth-child(6) { width: 7% !important; min-width: 70px; text-align: center; }
    #tuTable th:nth-child(7), #tuTable td:nth-child(7) { width: 7% !important; min-width: 70px; text-align: center; }
    #tuTable th:nth-child(8), #tuTable td:nth-child(8) { width: 10% !important; min-width: 85px; text-align: center; }
    #tuTable th:nth-child(9), #tuTable td:nth-child(9) { width: 17% !important; min-width: 140px; text-align: center; }

    /* ═══════════════════════════════════════════════════════════
       UNIFIED HERO BANNER — Exact Copy of Billing & Invoices Template
       ═══════════════════════════════════════════════════════════ */
    .inv-page-card {
        background: transparent;
        border: none;
        border-radius: 0;
        box-shadow: none;
        overflow: visible;
        margin-bottom: 8px;
    }

    html[data-theme="dark"] .inv-page-card {
        background: transparent;
    }

    .inv-hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
        background: transparent;
        border: none;
        border-radius: 0;
        padding: 14px 4px 6px;
        margin-bottom: 0;
        overflow: hidden;
    }

    html[data-theme="dark"] .inv-hero {
        background: transparent;
    }

    .inv-hero::before {
        content: "";
        position: absolute;
        right: -60px;
        top: -60px;
        width: 280px;
        height: 280px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(124, 92, 252, 0.14) 0%, rgba(124, 92, 252, 0) 70%);
        pointer-events: none;
    }

    .inv-hero::after {
        display: none !important;
    }

    /* Scattered Background Pattern (8-12% opacity outline SVGs in Purple/Blue) */
    .inv-hero-bg-pattern {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
        z-index: 0;
    }

    .hero-bg-icon {
        position: absolute;
        stroke: #7c5cfc;
        stroke-width: 1.5;
        fill: none;
        opacity: 0.10;
        transition: opacity 0.3s ease;
    }

    html[data-theme="dark"] .hero-bg-icon {
        stroke: #a78bfa;
        opacity: 0.12;
    }

    .hero-bg-icon.icon-invoice-1 { top: 8%; left: 1%; width: 32px; height: 32px; transform: rotate(-12deg); }
    .hero-bg-icon.icon-rupee-1   { top: 14%; left: 36%; width: 26px; height: 26px; transform: rotate(10deg); }
    .hero-bg-icon.icon-card-1    { bottom: 10%; left: 18%; width: 30px; height: 30px; transform: rotate(-8deg); }
    .hero-bg-icon.icon-receipt-1 { top: 58%; left: 3%; width: 28px; height: 28px; transform: rotate(6deg); }
    .hero-bg-icon.icon-chart-1   { top: 10%; left: 22%; width: 28px; height: 28px; transform: rotate(-10deg); }
    .hero-bg-icon.icon-wallet-1  { top: 62%; left: 44%; width: 26px; height: 26px; transform: rotate(-14deg); }
    .hero-bg-icon.icon-coins-1   { top: 12%; right: 44%; width: 28px; height: 28px; transform: rotate(18deg); }
    .hero-bg-icon.icon-wave-1    { bottom: 8%; right: 36%; width: 32px; height: 32px; transform: rotate(-10deg); }
    .hero-bg-icon.icon-leaf-1    { top: 10%; right: 26%; width: 26px; height: 26px; transform: rotate(8deg); }

    .inv-hero-left {
        position: relative;
        display: flex;
        align-items: center;
        gap: 18px;
        z-index: 1;
        flex: 1 1 320px;
        min-width: 260px;
    }

    .inv-hero-icon {
        width: 54px;
        height: 54px;
        flex-shrink: 0;
        border-radius: 16px;
        background: linear-gradient(135deg, #8b6cfd, #6a3df5);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        box-shadow: 0 8px 20px rgba(124, 92, 252, 0.35);
    }

    .inv-hero-title {
        font-size: 1.85rem !important;
        font-weight: 800 !important;
        color: var(--text-main);
        letter-spacing: -0.02em;
        margin: 0 0 2px;
    }

    .inv-hero-subtitle {
        font-size: 0.86rem;
        color: var(--text-muted);
        margin: 0 0 6px;
    }

    .inv-hero-underline {
        width: 36px;
        height: 4px;
        border-radius: 4px;
        background: linear-gradient(90deg, #7c5cfc, #a78bfa);
    }

    /* Hero Vector Illustration (Middle/Center) matching Subscriptions page light line-art style */
    .inv-hero-illustration {
        position: relative;
        z-index: 1;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 260px;
        pointer-events: none;
    }

    /* Bottom Flowing Waves */
    .inv-hero-wave-container {
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 50px;
        pointer-events: none;
        overflow: hidden;
        z-index: 0;
    }

    .inv-hero-wave-svg {
        width: 100%;
        height: 100%;
    }

    /* ═══════════════════════════════════════════════════════════
       COMPACT KPI CARDS (Matching Billing & Invoices exact size & alignment)
       ═══════════════════════════════════════════════════════════ */
    .sub-kpi-container {
        position: relative;
        display: flex;
        gap: 14px;
        align-items: stretch;
        z-index: 1;
        flex-wrap: wrap;
    }

    .sub-kpi-card {
        cursor: pointer;
        user-select: none;
        width: 178px;
        flex-shrink: 0;
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 14px;
        padding: 10px 14px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(0,0,0,0.03), 0 6px 16px -8px rgba(15,23,42,0.08);
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

    .sub-kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(0,0,0,0.05), 0 10px 24px -8px rgba(15,23,42,0.14);
    }

    .sub-kpi-card.active {
        border-color: #06b6d4 !important;
        box-shadow: 0 0 0 2px rgba(6, 182, 212, 0.15), var(--shadow-sm) !important;
    }

    .sub-kpi-card .tabler-stat-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
    }

    .sub-kpi-card .tabler-stat-title {
        font-size: 0.66rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #64748b;
        line-height: 1.3;
    }

    html[data-theme="dark"] .sub-kpi-card .tabler-stat-title {
        color: #94a3b8;
    }

    .sub-kpi-card .tabler-stat-value {
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--text-main);
        line-height: 1;
    }

    .tabler-stat-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s ease;
    }

    .sub-kpi-card:hover .tabler-stat-icon {
        transform: scale(1.08);
    }

    .tabler-stat-icon.total-icon {
        background: rgba(124, 92, 252, 0.14);
        color: #7c5cfc !important;
    }

    .tabler-stat-icon.active-icon {
        background: rgba(16, 185, 129, 0.14);
        color: #10b981 !important;
    }

    .tabler-stat-icon.inactive-icon {
        background: rgba(245, 158, 11, 0.14);
        color: #f59e0b !important;
    }

    .kpi-mini-visual {
        position: absolute;
        right: 10px;
        bottom: 6px;
        opacity: 0.7;
        pointer-events: none;
    }

    /* Purple/Blue Primary Button (Toolbar - matching Tenants page) */
    .btn-cyan-primary {
        background: linear-gradient(135deg, #8b6cfd 0%, #6a3df5 100%) !important;
        border: none !important;
        color: #ffffff !important;
        font-weight: 700 !important;
        height: 38px !important;
        padding: 0 18px !important;
        border-radius: 10px !important;
        font-size: 0.84rem !important;
        box-shadow: 0 4px 14px rgba(124, 92, 252, 0.35) !important;
        transition: all 0.25s ease !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        cursor: pointer !important;
    }

    .btn-cyan-primary:hover {
        transform: translateY(-1px) !important;
        box-shadow: 0 6px 18px rgba(124, 92, 252, 0.45) !important;
        color: #ffffff !important;
    }

    /* Additional purple accent overrides for controls/buttons in Tenant Access Control */
    .mt-search-input:focus {
        border-color: #7c5cfc !important;
        box-shadow: 0 0 0 3px rgba(124, 92, 252, 0.15) !important;
    }
    .mt-select:focus {
        border-color: #7c5cfc !important;
    }

    /* Tenant Avatar & Cell */
    .tu-tenant-cell {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 180px;
    }

    .tu-tenant-avatar {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: rgba(124, 92, 252, 0.1);
        color: #7c5cfc;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-weight: 700;
        font-size: 0.88rem;
    }

    .tu-tenant-name {
        font-weight: 700;
        color: #0F172A;
        font-size: 0.84rem;
        white-space: nowrap;
    }

    html[data-theme="dark"] .tu-tenant-name {
        color: #F8FAFC;
    }

    .tu-tenant-code {
        font-size: 0.70rem;
        color: #64748B;
        font-family: 'SFMono-Regular', 'Consolas', monospace;
        margin-top: 1px;
    }

    /* Status Badges */
    .tu-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .tu-status-dot { width: 5px; height: 5px; border-radius: 50%; }
    .tu-status-active { color: #22C55E; background: rgba(34, 197, 94, 0.1); }
    .tu-status-active .tu-status-dot { background: #22C55E; }
    .tu-status-inactive { color: #64748B; background: rgba(100, 116, 139, 0.1); }
    .tu-status-inactive .tu-status-dot { background: #94A3B8; }

    /* DB Mode Badge */
    .tu-db-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 600;
        background: rgba(124, 92, 252, 0.08);
        color: #7c5cfc;
        border: 1px solid rgba(124, 92, 252, 0.2);
    }

    /* Filter Buttons in Toolbar */
    .tu-filter-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 14px;
        border: 1px solid #E5E7EB;
        border-radius: 10px;
        font-size: 0.78rem;
        font-weight: 600;
        color: #64748B;
        background: #ffffff;
        cursor: pointer;
        transition: all 0.2s ease;
        height: 38px;
    }

    html[data-theme="dark"] .tu-filter-btn {
        background: #11141f;
        border-color: #262d42;
        color: #94A3B8;
    }

    .tu-filter-btn:hover {
        border-color: #7c5cfc;
        color: #7c5cfc;
    }

    .tu-filter-btn.active {
        border-color: #7c5cfc;
        color: #7c5cfc;
        background: rgba(124, 92, 252, 0.08);
    }

    /* Action Manage Button & Three-Dots Dropdown */
    .tu-btn-manage {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 12px;
        border-radius: 8px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid #E5E7EB;
        background: #ffffff;
        color: #7c5cfc;
        transition: all 0.2s ease;
        text-decoration: none;
        white-space: nowrap;
    }

    html[data-theme="dark"] .tu-btn-manage {
        background: #11141f;
        border-color: #262d42;
    }

    .tu-btn-manage:hover {
        background: rgba(124, 92, 252, 0.1);
        border-color: #7c5cfc;
        color: #6a3df5;
        text-decoration: none;
    }

    .tu-btn-dots {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        border: 1px solid #E5E7EB;
        background: #ffffff;
        color: #64748B;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        padding: 0;
    }

    html[data-theme="dark"] .tu-btn-dots {
        background: #11141f;
        border-color: #262d42;
        color: #94A3B8;
    }

    .tu-btn-dots:hover, .tu-btn-dots[aria-expanded="true"] {
        border-color: #7c5cfc;
        color: #7c5cfc;
        background: rgba(124, 92, 252, 0.08);
    }

    /* Action Buttons (Plain Outline Icons - Matching Application Theme) */
    .action-btn {
        width: 30px !important;
        height: 30px !important;
        border-radius: 8px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        border: 1px solid #E5E7EB !important;
        background: #ffffff !important;
        cursor: pointer !important;
        transition: all 0.2s ease !important;
        padding: 0 !important;
        margin: 0 !important;
    }

    html[data-theme="dark"] .action-btn {
        background: #11141f !important;
        border-color: #262d42 !important;
    }

    .action-btn svg {
        width: 15px !important;
        height: 15px !important;
        flex-shrink: 0 !important;
        transition: transform 0.2s ease !important;
    }

    /* Edit Button (Amber subtle hover) */
    .action-btn-edit {
        color: #F59E0B !important;
    }
    .action-btn-edit:hover {
        background: rgba(245, 158, 11, 0.08) !important;
        border-color: #F59E0B !important;
        color: #D97706 !important;
        transform: scale(1.05) !important;
    }

    /* Delete Button (Red subtle hover) */
    .action-btn-delete {
        color: #EF4444 !important;
    }
    .action-btn-delete:hover {
        background: rgba(239, 68, 68, 0.08) !important;
        border-color: #EF4444 !important;
        color: #DC2626 !important;
        transform: scale(1.05) !important;
    }

    /* Dropdown Styling */
    .tu-dropdown-menu {
        border-radius: 12px !important;
        border: 1px solid #E5E7EB !important;
        box-shadow: 0 10px 25px rgba(15, 23, 42, 0.12) !important;
        padding: 6px !important;
        min-width: 140px !important;
    }

    html[data-theme="dark"] .tu-dropdown-menu {
        background: #181c2b !important;
        border-color: #262d42 !important;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4) !important;
    }

    .tu-dropdown-menu .dropdown-item {
        border-radius: 8px !important;
        font-size: 0.80rem !important;
        font-weight: 600 !important;
        color: #334155 !important;
        padding: 7px 12px !important;
        display: flex !important;
        align-items: center !important;
        gap: 8px !important;
        transition: all 0.15s ease !important;
    }

    html[data-theme="dark"] .tu-dropdown-menu .dropdown-item {
        color: #CBD5E1 !important;
    }

    .tu-dropdown-menu .dropdown-item:hover {
        background: rgba(124, 92, 252, 0.08) !important;
        color: #7c5cfc !important;
    }

    .tu-dropdown-menu .dropdown-item.text-danger:hover {
        background: rgba(239, 68, 68, 0.08) !important;
        color: #EF4444 !important;
    }

    @@media (max-width: 1024px) {
        .inv-hero { padding: 16px 12px; }
        .sub-kpi-container { width: 100%; }
        .sub-kpi-card { flex: 1 1 150px; }
    }

    @@media (max-width: 768px) {
        .sub-kpi-container { flex-direction: column; align-items: stretch; }
        .sub-kpi-card { width: 100% !important; }
        .inv-hero-left { flex-direction: column; text-align: center; align-items: center; }
        .inv-hero-subtitle { max-width: 100%; }
    }
</style>

<div class="breadcrumbs">
    <span>Auxinz SSO Server</span>
    <a href="#">Multi-Tenancy</a>
    <span class="current">Tenant Access Control</span>
</div>

<!-- ═══════════════════════════════════════════════════════════
   UNIFIED HERO HEADER (Exact Copy of Billing & Invoices Template)
   ═══════════════════════════════════════════════════════════ -->
<div class="inv-page-card">
    <div class="inv-hero">
        <!-- Layered Bottom Flowing Waves -->
        <div class="inv-hero-wave-container">
            <svg class="inv-hero-wave-svg" viewBox="0 0 1300 70" preserveAspectRatio="none" fill="none">
                <path d="M0,35 C200,65 420,0 700,40 C950,75 1100,15 1300,45 L1300,70 L0,70 Z" fill="#7c5cfc" opacity="0.06" />
                <path d="M0,45 C220,15 450,55 720,25 C980,-5 1120,50 1300,35 L1300,70 L0,70 Z" fill="#a78bfa" opacity="0.05" />
            </svg>
        </div>

        <!-- Scattered background outline icons in Purple/Blue #7C5CFC -->
        <div class="inv-hero-bg-pattern">
            <!-- User -->
            <svg class="hero-bg-icon icon-invoice-1" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <!-- Users Group -->
            <svg class="hero-bg-icon icon-rupee-1" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            <!-- Shield -->
            <svg class="hero-bg-icon icon-card-1" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <!-- Key -->
            <svg class="hero-bg-icon icon-receipt-1" viewBox="0 0 24 24"><circle cx="7.5" cy="15.5" r="5.5"></circle><path d="m21 2-9.6 9.6"></path><path d="m15.5 7.5 3 3"></path></svg>
            <!-- Lock -->
            <svg class="hero-bg-icon icon-chart-1" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            <!-- Badge -->
            <svg class="hero-bg-icon icon-wallet-1" viewBox="0 0 24 24"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.78 4.78 4 4 0 0 1-6.74 0 4 4 0 0 1-4.78-4.78 4 4 0 0 1 0-6.74z"></path></svg>
            <!-- Database -->
            <svg class="hero-bg-icon icon-coins-1" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
            <!-- Sparkles & Geometry -->
