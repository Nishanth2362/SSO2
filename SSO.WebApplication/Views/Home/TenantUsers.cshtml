<script type="text/javascript">
    $(function () {
        const canManageTenant = @canManageTenant.ToString().ToLower();
        const $search = $('#tuSearchInput');
        let currentStatusFilter = '';

        const dt = $('#tuTable').DataTable({
            processing : true,
            serverSide : true,
            ajax: {
                url  : '/Home/GetTenantUsersList_Tenants',
                type : 'POST',
                data : function (d) {
                    d.customSearchValue = d.search.value;
                    const $panel = $('#tuTable').closest('.panel, .tu-panel, .if-panel');
                    const activeFilters = $panel.data('active-filters') || {};

                    if (activeFilters.IsActive) {
                        d.filter_IsActive = activeFilters.IsActive;
                    } else if (currentStatusFilter !== '') {
                        d.filter_IsActive = currentStatusFilter;
                    } else {
                        const $statusFilter = $panel.find('.table-filters-repo [name="filter-IsActive"], .table-filters-repo .filter-IsActive');
                        if ($statusFilter.length) {
                            const val = $statusFilter.val();
                            if (val !== undefined && val !== null && val !== '') {
                                d.filter_IsActive = val;
                            }
                        }
                    }
                }
            },
            responsive : false,
            dom        : 't<"if-table-footer-wrap"<"footer-right"<"if-pill-pagination-mount">>>',
            columns    : [
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: 'text-center align-middle',
                    render: function (data, type, row) {
                        return '<input type="checkbox" class="row-select-cb" data-row-id="' + (row.id || '') + '">';
                    }
                },
                /* 0 - Tenant */
                {
                    data: 'name',
                    className: 'text-left align-middle',
                    render: function (data, type, row) {
                        const initial = (data || 'T').charAt(0).toUpperCase();
                        return '<div class="tu-tenant-cell">' +
                                    '<div class="tu-tenant-avatar">' + initial + '</div>' +
                                    '<div>' +
                                        '<div class="tu-tenant-name">' + (data || 'Unknown') + '</div>' +
                                        '<div class="tu-tenant-code">' + (row.code || '-') + '</div>' +
                                    '</div>' +
                                  '</div>';
                    }
                },
                /* 1 - DB Mode */
                {
                    data: 'databaseMode',
                    className: 'text-center align-middle',
                    render: function (data) {
                        const label      = data || 'Standard';
                        const isIsolated = /separate|isolated/i.test(label);
                        const icon       = isIsolated
                            ? '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>'
                            : '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>';
                        return '<span class="tu-db-badge ' + (isIsolated ? 'isolated' : '') + '">' + icon + ' ' + label + '</span>';
                    }
                },
                /* 2 - Subscription */
                {
                    data: 'subscriptionName',
                    orderable: false,
                    className: 'text-left align-middle',
                    render: function (data, type, row) {
                        const name   = data || 'No Active Plan';
                        const expiry = row.subscriptionExpiry
                            ? new Date(row.subscriptionExpiry).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
                            : 'N/A';
                        return '<div>' +
                                    '<div style="font-weight:700;font-size:0.82rem;color:#7c5cfc;">' + name + '</div>' +
                                    '<div style="font-size:0.72rem;color:#64748B;">Expires: ' + expiry + '</div>' +
                                '</div>';
                    }
                },
                /* 3 - Applications */
                {
                    data: 'applicationsCount',
                    orderable: false,
                    className: 'text-center align-middle',
                    render: function (data) {
                        return (data !== undefined && data !== null) ? data : 0;
                    }
                },
                /* 4 - Users */
                {
                    data: 'usersCount',
                    orderable: false,
                    className: 'text-center align-middle',
                    render: function (data) {
                        return (data !== undefined && data !== null) ? data : 0;
                    }
                },
                /* 5 - Roles */
                {
                    data: 'rolesCount',
                    orderable: false,
                    className: 'text-center align-middle',
                    render: function (data) {
                        return (data !== undefined && data !== null) ? data : 0;
                    }
                },
                /* 6 - Status */
                {
                    data: 'isActive',
                    className: 'text-center align-middle',
                    render: function (data) {
                        return data
                            ? '<span class="tu-status tu-status-active"><span class="tu-status-dot"></span>Active</span>'
                            : '<span class="tu-status tu-status-inactive"><span class="tu-status-dot"></span>Inactive</span>';
                    }
                },
                /* 4 - Actions (Manage Button + Edit Icon + Delete Icon) */
                {
                    data: null,
                    orderable: false,
                    className: 'text-center align-middle',
                    render: function (data, type, row) {
                        let html = '<div style="display:flex;justify-content:center;align-items:center;gap:6px;">';
                        if (canManageTenant) {
                            html += '<a href="/Home/ManageTenant?tenantId=' + row.id + '" class="tu-btn-manage">' +
                                        '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">' +
                                            '<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>' +
                                            '<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>' +
                                        '</svg>' +
                                        'Manage' +
                                    '</a>';
                            html += '<button type="button" class="action-btn action-btn-edit" title="Edit Tenant" onclick="if(window.editTenant) window.editTenant(\'' + row.id + '\')">' +
                                        '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
                                            '<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>' +
                                            '<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>' +
                                        '</svg>' +
                                    '</button>';
                            html += '<button type="button" class="action-btn action-btn-delete" title="Delete Tenant" onclick="if(window.deleteTenant) window.deleteTenant(\'' + row.id + '\', \'' + (row.name || '').replace(/'/g, "\\'") + '\')">' +
                                        '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
                                            '<polyline points="3 6 5 6 21 6"></polyline>' +
                                            '<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>' +
                                        '</svg>' +
                                    '</button>';
                        }
                        html += '</div>';
                        return html;
                    }
                }
            ],
            drawCallback: function () {
                const api        = this.api();
                const info       = api.page.info();
                const shown      = api.rows({ page: 'current' }).count();
                const total      = info.recordsTotal;
                const rows       = api.rows({ page: 'current' }).data().toArray();

                const activeCount   = rows.filter(r => r.isActive).length;
                const inactiveCount = rows.filter(r => !r.isActive).length;

                $('#tuStatTotal').text(total);
                $('#tuStatActive').text(Math.round(activeCount / shown * total) || 0);
                $('#tuStatInactive').text(Math.round(inactiveCount / shown * total) || 0);

                window.renderPillPagination(api, '.if-pill-pagination-mount', 'tenant users');
            }
        });

        /* Search debounce */
        let searchTimer;
        $search.on('keyup', function () {
            clearTimeout(searchTimer);
            const val = this.value;
            searchTimer = setTimeout(() => dt.search(val).draw(), 350);
        });

        /* KPI card clicks */
        $('.sub-kpi-card').on('click', function () {
            const filterVal = $(this).attr('data-filter') || '';
            window.setStatusFilter(filterVal);
        });

        /* Status filter buttons */
        window.setStatusFilter = function (val) {
            currentStatusFilter = val;
            $('#tuBtnAll, #tuBtnActive, #tuBtnInactive').removeClass('active');
            $('.sub-kpi-card').removeClass('active');

            if (val === '') {
                $('#tuBtnAll').addClass('active');
                $('#kpiTotalUsers').addClass('active');
            } else if (val === 'true') {
                $('#tuBtnActive').addClass('active');
                $('#kpiActiveUsers').addClass('active');
            } else {
                $('#tuBtnInactive').addClass('active');
                $('#kpiInactiveUsers').addClass('active');
            }

            const $panel = $('#tuTable').closest('.panel, .tu-panel, .if-panel');

            // Sync active-filters map on panel
            const activeFilters = $panel.data('active-filters') || {};
            if (val === '') {
                delete activeFilters['IsActive'];
            } else {
                activeFilters['IsActive'] = val;
            }
            $panel.data('active-filters', activeFilters);

            const $orig = $panel.find('.table-filters-repo .filter-IsActive');
            if ($orig.length) {
                $orig.val(val).trigger('change');
            } else {
                $('#tuStatusFilter').val(val);
            }

            dt.ajax.reload();
        };

        // Listen for drawer changes to sync back to status filter buttons & KPI cards
        $(document).on('change', '.table-filters-repo .filter-IsActive', function() {
            const val = $(this).val();
            currentStatusFilter = val;
            $('#tuBtnAll, #tuBtnActive, #tuBtnInactive').removeClass('active');
            $('.sub-kpi-card').removeClass('active');
            if (val === '' || val === null || val === undefined) {
                $('#tuBtnAll').addClass('active');
                $('#kpiTotalUsers').addClass('active');
            } else if (val === 'true') {
                $('#tuBtnActive').addClass('active');
                $('#kpiActiveUsers').addClass('active');
            } else {
                $('#tuBtnInactive').addClass('active');
                $('#kpiInactiveUsers').addClass('active');
            }
        });

        // Initialize row selection for smart export
        window.initRowSelection('tuTable', 'id');
    });

    window.openTenantModal = function (id = '') {
        const isEdit = id !== '';
        window.openModal({
            title   : isEdit ? 'Update Organization'   : 'Provision New Tenant',
            subtitle: isEdit ? 'Modify organizational boundaries and settings.'
                             : 'Scale your ecosystem by adding a new organization boundary.',
            icon    : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>',
            url     : '/Home/CreateTenant?Id=' + id + '&theme=purple',
            onSuccess: () => $('#tuTable').DataTable().ajax.reload()
        });
    };

    window.editTenant = function (id) {
        window.openTenantModal(id);
    };

    window.deleteTenant = function (id, name) {
        const subtitleText = name ? 'Confirm permanent deletion of tenant organization "' + name + '".' : 'Confirm permanent destruction of this organizational boundary.';
        window.openModal({
            title   : 'Decommission Tenant',
            subtitle: subtitleText,
            icon    : `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-error">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                      </svg>`,
            url     : '/Home/DeleteTenant?Id=' + id,
            onSuccess: () => $('#tuTable').DataTable().ajax.reload()
        });
    };
</script>