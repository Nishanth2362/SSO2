@using SSO.Application.Responses.Features

@{
    ViewData["Title"] = "Tenants";
}

<div class="breadcrumbs">
    <span>Auxinz Identity</span>
    <a href="#">Multi-Tenancy</a>
    <span class="current">Tenants & Licenses</span>
</div>

<div class="page-header">
    <div>
        <h1>Organization Tenants</h1>
        <p style="color: var(--text-muted); margin-top: 4px;">
            Manage child tenants, database
            connections, and licensing quotas.
        </p>
    </div>
    <div style="display: flex; gap: 12px;">
        <button class="btn btn-primary" id="openCreateTenantModal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Create Tenant
        </button>
        <a href="/Home/ExportTenants" class="btn btn-secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Export Excel
        </a>
    </div>
</div>

<div class="panel">
    <div class="table-toolbar">
        <div class="table-filters">
            <div style="position: relative;">
                <svg style="position: absolute; left: 10px; top: 10px; color: var(--text-muted);"
                     width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" class="form-input" placeholder="Filter by Name or Code..."
                       style="padding-left: 32px; width: 250px;">
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table id="tenantTable" class="data-table table-hoverable manual-init">
            <thead>
                <tr>
                    <th style="width: 48px;"><input type="checkbox" class="custom-checkbox"></th>
                    <th class="sorted">
                        Tenant Organization
                        <svg class="sort-icon" width="12" height="12" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2">
                            <path d="M12 5v14M5 12l7-7 7 7" />
                        </svg>
                    </th>
                    <th>Database Mode</th>
                    <th>License / Subscription</th>
                    <th>Grace (Days)</th>
                    <th>Max Conc. Users</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>


<script type="text/javascript">
    $(function () {
        const $panel = $('#tenantTable').closest('.panel');
        const $customSearch = $panel.find('.table-toolbar .form-input');
        const $customFilters = $panel.find('.table-toolbar .form-select');

        const dt = $('#tenantTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '/Home/GetTenants',
                type: 'POST',
                data: function (d) {
                    if ($customSearch.length > 0) {
                        d.customSearchValue = $customSearch.val();
                    }
                }
            },
            responsive: true,
            dom: '<"table-toolbar datatables-injected"<"table-filters"l>f>t<"pagination"ip>',
            columns: [
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function () { return '<input type="checkbox" class="custom-checkbox">'; }
                },
                {
                    data: 'name',
                    render: function (data, type, row) {
                        return `<div class="cell-flex">
                                    <div class="cell-avatar primary">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                        </svg>
                                    </div>
                                    <div class="cell-text">
                                        <h5>${data || 'Unknown Tenant'}</h5>
                                        <p>${row.code || 'No Code'}</p>
                                    </div>
                                </div>`;
                    }
                },
                {
                    data: 'databaseMode',
                    render: function (data) {
                        return `<span class="badge badge-neutral">${data || 'Standard'}</span>`;
                    }
                },
                {
                    data: 'subscriptionName',
                    orderable: false,
                    render: function (data, type, row) {
                        const expiry = row.subscriptionExpiry ? new Date(row.subscriptionExpiry).toLocaleDateString() : 'N/A';
                        return `<div class="cell-text"><h5 style="color: var(--brand-primary);">${data || 'No Active Plan'}</h5><p>Expires: ${expiry}</p></div>`;
                    }
                },
                {
                    data: 'gracePeriodDays',
                    render: function (data) {
                        return `<span style="font-weight: 600; font-family: monospace;">${data} d</span>`;
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    render: function (data) {
                        return `<div title="Usage">
                                    <div class="progress-track">
                                        <div class="progress-fill" style="width: 50%;"></div>
                                    </div>
                                    <span style="font-family: monospace; font-size: 0.75rem; color: var(--text-muted);">50%</span>
                                </div>`;
                    }
                },
                {
                    data: 'isActive',
                    render: function (data) {
                        return data ? '<span class="badge badge-success">Active</span>' : '<span class="badge badge-error">Disabled</span>';
                    }
                },
                {
                    data: null,
                    orderable: false,
                    render: function (data, type, row) {
                        return `<div style="text-align: right;">
                                    <button class="action-btn" title="Manage Subscriptions" onclick="manageSubscriptions('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg></button>
                                    <button class="action-btn" title="Edit Tenant" onclick="editTenant('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></button>
                                    <button class="action-btn text-error" title="Delete Tenant" onclick="deleteTenant('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>
                                </div>`;
                    }
                }
            ]
        });

        if ($customSearch.length > 0) {
            let searchTimeout;
            $customSearch.on('keyup', function () {
                clearTimeout(searchTimeout);
                const val = this.value;
                searchTimeout = setTimeout(() => {
                    dt.search(val).draw();
                }, 400);
            });
        }

        $('#openCreateTenantModal').on('click', function() {
            openTenantModal();
        });
    });

    function openTenantModal(id = '') {
        const isEdit = id !== '';
        openModal({
            title: isEdit ? 'Update Organization' : 'Provision New Tenant',
            subtitle: isEdit ? 'Modify organizational boundaries and settings.' : 'Scale your ecosystem by adding a new organization boundary.',
            icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>',
            url: '/Home/CreateTenant?Id=' + id,
            onSuccess: function() {
                $('#tenantTable').DataTable().ajax.reload();
            }
        });
    }

    function editTenant(id) {
        openTenantModal(id);
    }

    function manageSubscriptions(id) {
        window.openModal({
            title: 'Manage Subscriptions',
            subtitle: 'Configure service tiers and licensing dates.',
            icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>',
            url: '/Home/ManageTenantSubscriptions?TenantId=' + id,
            onSuccess: function() {
                $('#tenantTable').DataTable().ajax.reload();
            }
        });
    }

    function deleteTenant(id) {
        openModal({
            title: 'Decommission Tenant',
            subtitle: 'Confirm permanent destruction of this organizational boundary.',
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-error">
                    <polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  </svg>`,
            url: '/Home/DeleteTenant?Id=' + id,
            onSuccess: function() {
                $('#tenantTable').DataTable().ajax.reload();
            }
        });
    }
</script>
