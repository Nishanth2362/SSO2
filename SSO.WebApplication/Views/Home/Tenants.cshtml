<script type="text/javascript">
$(function () {
    const $panel = $('#tenantTable').closest('.if-panel');
    const $searchInput = $('#ifSearchInput');
    const canEditTenant = @canEditTenant.ToString().ToLower();
    const canDeleteTenant = @canDeleteTenant.ToString().ToLower();
    const canManageSubs = @canManageSubs.ToString().ToLower();

    const dt = $('#tenantTable').DataTable({
        processing: true,
        serverSide: true,
        ajax: {
            url: '/Home/GetTenants',
            type: 'POST',
            data: function (d) {
                d.customSearchValue = $searchInput.val();
            }
        },
        responsive: false,
dom: '<"table-toolbar datatables-injected"<"table-filters">f>t<"if-table-footer-wrap"<"footer-right"<"if-pill-pagination-mount">>>',

        columns: [
            {
                data: null,
                orderable: false,
                searchable: false,
                className: 'text-center align-middle',
                render: function (data, type, row) {
                    return '<input type="checkbox" class="row-select-cb" data-row-id="' + (row.id || row.Id || '') + '">';
                }
            },
            /* 0 - Tenant Name + Code */
            {
                data: 'name',
                className: 'text-left align-middle',
                render: function (data, type, row, meta) {
                    const tintPalette = [
                        { bg: 'rgba(124, 92, 252, 0.14)', fg: '#7c5cfc' },
                        { bg: 'rgba(245, 158, 11, 0.14)', fg: '#f59e0b' },
                        { bg: 'rgba(24, 167, 223, 0.14)', fg: '#18a7df' },
                        { bg: 'rgba(236, 72, 153, 0.14)', fg: '#ec4899' },
                        { bg: 'rgba(16, 185, 129, 0.14)', fg: '#10b981' },
                        { bg: 'rgba(99, 102, 241, 0.14)', fg: '#6366f1' }
                    ];
                    const tint = tintPalette[(meta && typeof meta.row === 'number' ? meta.row : 0) % tintPalette.length];
                    const iconContent = row.logoUrl 
                        ? `<img src="${row.logoUrl}" alt="${_tEsc(data)}" style="width: 100%; height: 100%; object-fit: cover;" />`
                        : `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                               <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                           </svg>`;
                    return `<div class="if-tenant-cell">
                                <div class="if-tenant-icon" style="overflow: hidden; display: flex; align-items: center; justify-content: center; padding: 0; background: ${tint.bg}; color: ${tint.fg};">
                                    ${iconContent}
                                </div>
                                <div>
                                    <div class="if-tenant-name">${data || 'Unknown Tenant'}</div>
                                    <div class="if-tenant-code">${row.code || '-'}</div>
                                </div>
                              </div>`;
                }
            },
            /* 1 - Database Mode */
            {
                data: 'databaseMode',
                className: 'text-center align-middle',
                render: function (data) {
                    const label = data || 'Standard';
                    const isIsolated = /separate|isolated/i.test(label);
                    return `<span class="if-db-badge ${isIsolated ? 'isolated' : ''}">
                                ${isIsolated
                                    ? '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>'
                                    : '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>'}
                                ${label}
                            </span>`;
                }
            },
            /* 2 - Subscription */
            {
                data: 'subscriptionName',
                orderable: false,
                className: 'text-left align-middle',
                render: function (data, type, row) {
                    const name   = data || 'No Active Plan';
                    const expiry = row.subscriptionExpiry
                        ? new Date(row.subscriptionExpiry).toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' })
                        : 'N/A';
                    return `<div class="if-plan-cell">
                                <h5>${name}</h5>
                                <p>Expires: ${expiry}</p>
                            </div>`;
                }
            },
            /* 3 - Grace Period */
            {
                data: 'gracePeriodDays',
                className: 'text-center align-middle',
                render: function (data) {
                    return `<span class="if-grace">${data != null ? data : '-'} d</span>`;
                }
            },
            /* 4 - Status */
            {
                data: 'isActive',
                className: 'text-center align-middle',
                render: function (data) {
                    return data
                        ? `<span class="if-status if-status-active"><span class="if-status-dot"></span>Active</span>`
                        : `<span class="if-status if-status-disabled"><span class="if-status-dot"></span>Disabled</span>`;
                }
            },
            { data: 'code', visible: false, className: 'text-left align-middle', render: function(d){ return d || '—'; } },
            { data: 'databaseProvider', visible: false, className: 'text-left align-middle', render: function(d){ return d || '—'; } },
            { data: 'databaseName', visible: false, className: 'text-left align-middle', render: function(d){ return d || '—'; } },
            { data: 'email', visible: false, className: 'text-left align-middle', render: function(d){ return d || '—'; } },
            { data: 'phone', visible: false, className: 'text-left align-middle', render: function(d){ return d || '—'; } },
            { data: 'website', visible: false, className: 'text-left align-middle', render: function(d){ return d || '—'; } },
            { data: 'billingAddress', visible: false, className: 'text-left align-middle', render: function(d){ return d || '—'; } },
            { data: 'currency', visible: false, className: 'text-center align-middle', render: function(d){ return d || '—'; } },
            /* 5 - Actions */
            {
                data: null,
                orderable: false,
                className: 'text-center align-middle',
                render: function (data, type, row) {
                    let html = `<div style="display: flex; align-items: center; justify-content: center; gap: 8px;">
                                <button class="action-btn action-btn-view" title="View Details" data-type="tenant" data-id="${row.id}">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="3"></circle>
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    </svg>
                                </button>`;
                    if (canManageSubs) {
                        html += `<button class="action-btn action-btn-manage" title="Manage Subscriptions" onclick="manageSubscriptions('${row.id}')">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M6 3h12M6 8h12M6 13l8.5 8M6 13h3a4.5 4.5 0 0 0 0-9H6"></path>
                                    </svg>
                                </button>`;
                    }
                    if (canEditTenant) {
                        html += `<button class="action-btn action-btn-edit" title="Edit Tenant" onclick="editTenant('${row.id}')">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                    </svg>
                                </button>`;
                    }
                    if (canDeleteTenant) {
                        html += `<button class="action-btn action-btn-delete" title="Delete Tenant" onclick="deleteTenant('${row.id}')">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    </svg>
                                </button>`;
                    }
                    html += `</div>`;
                    return html;
                }
            }
        ],
        drawCallback: function () {
            const api        = this.api();
            const info       = api.page.info();
            const shown      = api.rows({ page: 'current' }).count();
            const total      = info.recordsTotal;
            const current    = info.page;
            const totalPages = info.pages;

            // Calculate stats based on loaded page records and scale to total records
            const rowsData = api.rows({ page: 'current' }).data().toArray();
            const activeCount = rowsData.filter(t => t.isActive).length;
            const isolatedCount = rowsData.filter(t => /separate|isolated/i.test(t.databaseMode || '')).length;

            const activeRatio = shown > 0 ? (activeCount / shown) : 0;
            const isolatedRatio = shown > 0 ? (isolatedCount / shown) : 0;

            const totalActive = Math.round(activeRatio * total) || 0;
            const totalIsolated = Math.round(isolatedRatio * total) || 0;

            $('#statTotalTenants').text(total);
            $('#statActiveTenants').text(totalActive);
            $('#statIsolatedDb').text(totalIsolated);

            renderTenantArrowPagination(api, '.if-pill-pagination-mount', 'tenants');

            // Sync KPI highlights and counts
            const activeFilters = $panel.data('active-filters') || {};
            $('.sub-kpi-card').removeClass('active');
            if (activeFilters.IsActive === 'true') {
                $('#kpiActiveTenants').addClass('active');
            } else if (activeFilters.DatabaseMode === 'Isolated') {
                $('#kpiIsolatedTenants').addClass('active');
            } else {
                $('#kpiTotalTenants').addClass('active');
            }

            // Self-correcting count logic
            if (typeof activeFilters.IsActive === 'undefined' && typeof activeFilters.DatabaseMode === 'undefined') {
                $panel.data('total-tenants-kpi', total);
                $panel.data('active-tenants-kpi', totalActive);
                $panel.data('isolated-tenants-kpi', totalIsolated);
            } else if (activeFilters.IsActive === 'true') {
                const jsonResult = api.ajax.json();
                $panel.data('active-tenants-kpi', jsonResult ? jsonResult.recordsFiltered : totalActive);
            } else if (activeFilters.DatabaseMode === 'Isolated') {
                const jsonResult = api.ajax.json();
                $panel.data('isolated-tenants-kpi', jsonResult ? jsonResult.recordsFiltered : totalIsolated);
            }

            $('#totalTenantsCountKpi').text($panel.data('total-tenants-kpi') || total || 0);
            $('#activeTenantsCountKpi').text($panel.data('active-tenants-kpi') || 0);
            $('#isolatedTenantsCountKpi').text($panel.data('isolated-tenants-kpi') || 0);

            // Render grid view with current page data
            renderTenantGridView(rowsData);

            // Sync footer when grid is active
            var _sTView = localStorage.getItem('view-mode-tenantTable') || 'list';
            if (_sTView === 'grid') {
                var $tF = $panel.find('.if-table-footer-wrap');
                if ($tF.length) $panel.append($tF);
            }
        }
    });

    /* -- Search debounce -- */
    let searchTimer;
    $searchInput.on('keyup', function () {
        clearTimeout(searchTimer);
        const val = this.value;
        searchTimer = setTimeout(() => dt.search(val).draw(), 400);
    });

    /* -- Open Create Modal -- */
    $('#openCreateTenantModal').on('click', () => openTenantModal());

    // Initialize row selection for smart export
    window.initRowSelection('tenantTable', 'id');

    /* ── KPI Cards Click Routing ── */
    $('.sub-kpi-card').on('click', function () {
        const id = $(this).attr('id');
        const activeFilters = $panel.data('active-filters') || {};
        
        if (id === 'kpiTotalTenants') {
            delete activeFilters.IsActive;
            delete activeFilters.DatabaseMode;
        } else if (id === 'kpiActiveTenants') {
            if (activeFilters.IsActive === 'true') {
                delete activeFilters.IsActive;
            } else {
                activeFilters.IsActive = 'true';
                delete activeFilters.DatabaseMode;
            }
        } else if (id === 'kpiIsolatedTenants') {
            if (activeFilters.DatabaseMode === 'Isolated') {
                delete activeFilters.DatabaseMode;
            } else {
                activeFilters.DatabaseMode = 'Isolated';
                delete activeFilters.IsActive;
            }
        }
        
        $panel.data('active-filters', activeFilters);
        const hasFilters = Object.keys(activeFilters).length > 0;
        $panel.find('.filter-trigger-btn').toggleClass('active', hasFilters);
        
        // Sync values to select inputs in hidden repo
        const $isActiveFilter = $panel.find('.table-filters-repo [name="filter-IsActive"], .table-filters-repo .filter-IsActive');
        if ($isActiveFilter.length) {
            $isActiveFilter.val(activeFilters.IsActive ? [activeFilters.IsActive] : []).trigger('change');
        }
        const $dbModeFilter = $panel.find('.table-filters-repo [name="filter-DatabaseMode"], .table-filters-repo .filter-DatabaseMode');
        if ($dbModeFilter.length) {
            $dbModeFilter.val(activeFilters.DatabaseMode ? [activeFilters.DatabaseMode] : []).trigger('change');
        }
        
        dt.draw();
    });

    // Sync KPI highlights if filter changes from filter drawer select
    $(document).on('change', '.table-filters-repo [name="filter-IsActive"], .table-filters-repo .filter-IsActive, .table-filters-repo [name="filter-DatabaseMode"], .table-filters-repo .filter-DatabaseMode', function () {
        const activeFilters = $panel.data('active-filters') || {};
        $('.sub-kpi-card').removeClass('active');
        if (activeFilters.IsActive === 'true') {
            $('#kpiActiveTenants').addClass('active');
        } else if (activeFilters.DatabaseMode === 'Isolated') {
            $('#kpiIsolatedTenants').addClass('active');
        } else {
            $('#kpiTotalTenants').addClass('active');
        }
    });

    /* ═══════════════════════════════════════════════════════════
       TENANT GRID VIEW
       ═══════════════════════════════════════════════════════════ */
    var _tAvatarPalette = ['#7c5cfc','#18a7df','#8b5cf6','#f59e0b','#ef4444','#06b6d4','#ec4899','#6366f1'];

    function _tInitials(name) {
        if (!name) return '?';
        var p = name.trim().split(/\s+/);
        return p.length >= 2 ? (p[0][0] + p[1][0]).toUpperCase() : name.substring(0,2).toUpperCase();
    }

    function _tEsc(s) { return $('<div>').text(s || '').html(); }

    function renderTenantGridView(dataArray) {
        var $c = $('#tenantGridViewWrapper');
        $c.empty();
        if (!dataArray || dataArray.length === 0) {
            $c.html('<div style="grid-column:1/-1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:64px 20px;color:var(--text-muted);text-align:center;background:var(--bg-surface);border:1px dashed var(--border-strong);border-radius:var(--radius-lg);margin:16px;">' +
                '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom:12px;opacity:0.7;"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>' +
                '<h5 style="margin:0 0 4px;font-weight:600;color:var(--text-main);">No Tenants Found</h5>' +
                '<p style="margin:0;font-size:0.75rem;">Try adjusting your search terms or filters.</p></div>');
            return;
        }
        var sel       = (window.getSelectionSet ? window.getSelectionSet('tenantTable') : new Set());
        var colDb     = dt.column(2).visible();
        var colPlan   = dt.column(3).visible();
        var colGrace  = dt.column(4).visible();
        var colStatus = dt.column(5).visible();

        $.each(dataArray, function (idx, row) {
            var color    = _tAvatarPalette[idx % _tAvatarPalette.length];
            var initials = _tInitials(row.name);
            var isSel    = sel.has(String(row.id));
            var inactive = !row.isActive;
            var isIso    = /separate|isolated/i.test(row.databaseMode || '');
            var planName = row.subscriptionName || 'No Active Plan';
            var expiry   = row.subscriptionExpiry
                ? new Date(row.subscriptionExpiry).toLocaleDateString('en-GB', {day:'2-digit',month:'short',year:'numeric'})
                : 'N/A';

            var dbBadge = colDb
                ? '<div class="tenant-card-field"><span class="tcf-label">DB Mode</span>' +
                  '<span class="' + (isIso ? 'tcard-db-isolated' : 'tcard-db-shared') + '">' +
                  (isIso
                      ? '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>'
                      : '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>') +
                  _tEsc(row.databaseMode || 'Standard') + '</span></div>'
                : '';

            var planField = colPlan
                ? '<div class="tenant-card-field"><span class="tcf-label">Plan</span>' +
                  '<span class="tcard-plan-txt" title="' + _tEsc(planName) + ' · Exp: ' + expiry + '">' + _tEsc(planName) + '</span></div>'
                : '';

            var graceField = colGrace
                ? '<div class="tenant-card-field"><span class="tcf-label">Grace</span>' +
                  '<span class="tcf-value" style="font-family:monospace;">' + (row.gracePeriodDays != null ? row.gracePeriodDays + ' d' : '—') + '</span></div>'
                : '';

            var statusBadge = colStatus
                ? (row.isActive
                    ? '<span class="tcard-s-active"><span class="tcard-sdot" style="background:#10b981;"></span>Active</span>'
                    : '<span class="tcard-s-inactive"><span class="tcard-sdot" style="background:#94a3b8;"></span>Disabled</span>')
                : '';

            var fields    = dbBadge + planField + graceField;
            var fieldsHtml = fields ? '<div class="tcard-divider"></div><div class="tenant-card-fields">' + fields + '</div>' : '';

            var actions = '<button class="btn-tcard-view action-btn-view" data-type="tenant" data-id="' + row.id + '" title="View Details">' +
                '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path></svg>View</button>';
            if (canManageSubs) {
                actions += '<button class="btn-tcard-action" title="Manage Subscriptions" onclick="manageSubscriptions(\'' + row.id + '\')">' +
                    '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12M6 8h12M6 13l8.5 8M6 13h3a4.5 4.5 0 0 0 0-9H6"></path></svg></button>';
            }
            if (canEditTenant) {
                actions += '<button class="btn-tcard-action" title="Edit Tenant" onclick="editTenant(\'' + row.id + '\')">' +
                    '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></button>';
            }
            if (canDeleteTenant) {
                actions += '<button class="btn-tcard-action danger" title="Delete Tenant" onclick="deleteTenant(\'' + row.id + '\')">' +
                    '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>';
            }

            var card = '<div class="tenant-grid-card' + (inactive ? ' inactive' : '') + (isSel ? ' selected' : '') + '" data-id="' + row.id + '">' +
                '<div class="tenant-card-header">' +
                '<input type="checkbox" class="tenant-card-checkbox" data-id="' + row.id + '"' + (isSel ? ' checked' : '') + '>' +
                statusBadge +
                '</div>' +
                '<div class="tenant-card-org-section">' +
                '<div class="tenant-card-avatar" style="background:' + color + '; overflow: hidden; display: flex; align-items: center; justify-content: center; padding: 0;">' + 
                (row.logoUrl ? '<img src="' + row.logoUrl + '" alt="' + _tEsc(row.name) + '" style="width: 100%; height: 100%; object-fit: cover;" />' : _tEsc(initials)) + 
                '</div>' +
                '<div class="tenant-card-name-group">' +
                '<h4 class="tenant-card-name" title="' + _tEsc(row.name) + '">' + _tEsc(row.name || 'Unknown') + '</h4>' +
                '<div class="tenant-card-code">' + _tEsc(row.code || '—') + '</div>' +
                '</div></div>' +
                fieldsHtml +
                '<div class="tcard-divider"></div>' +
                '<div class="tenant-card-actions">' + actions + '</div>' +
                '</div>';
            $c.append(card);
        });
    }

    /* Card checkbox → table row sync */
    $('#tenantGridViewWrapper').on('change', '.tenant-card-checkbox', function () {
        var id = $(this).data('id'), chk = this.checked;
        if (window.toggleSelection) window.toggleSelection('tenantTable', id, chk);
        $(this).closest('.tenant-grid-card').toggleClass('selected', chk);
        var $rc = $('#tenantTable').find('input.row-select-cb[data-row-id="' + id + '"]');
        if ($rc.length) { $rc.prop('checked', chk); $rc.closest('tr').toggleClass('selected-row', chk); }
        var s = window.getSelectionSet ? window.getSelectionSet('tenantTable') : new Set();
        var vis = $('#tenantTable').find('input.row-select-cb').map(function () { return String($(this).data('row-id')); }).get();
        var $m = $('.master-select-cb[data-table="tenantTable"]');
        $m.prop('checked', vis.length > 0 && vis.every(function (i) { return s.has(i); }));
        var cc = vis.filter(function (i) { return s.has(i); }).length;
        $m.prop('indeterminate', cc > 0 && cc < vis.length);
    });

    /* Global selection → card sync */
    $(document).on('selection:changed', function (e, data) {
        if (data && data.tableId === 'tenantTable') {
            $('.tenant-card-checkbox').each(function () {
                var id = $(this).data('id'), chk = data.ids && data.ids.includes(String(id));
                $(this).prop('checked', chk);
                $(this).closest('.tenant-grid-card').toggleClass('selected', chk);
            });
        }
    });

    /* applyViewMode override for tenantTable */
    var _origTVM = window.applyViewMode;
    window.applyViewMode = function (targetTableId, mode) {
        if (targetTableId === 'tenantTable') {
            var $grid = $('#tenantGridViewWrapper');
            var $tbl  = $('#tenantTableViewWrapper');
            var $foot = $panel.find('.if-table-footer-wrap');
            var $btns = $panel.find('.view-toggle-btn[data-target="tenantTable"]');
            if (mode === 'grid') {
                $tbl.removeClass('active'); $grid.addClass('active');
                if ($foot.length) $panel.append($foot);
                $btns.removeClass('active');
                $panel.find('.view-toggle-btn[data-target="tenantTable"][data-view="grid"]').addClass('active');
                localStorage.setItem('view-mode-tenantTable', 'grid');
            } else {
                $grid.removeClass('active'); $tbl.addClass('active');
                var $dtw = $('#tenantTable_wrapper');
                if ($foot.length && $dtw.length) $dtw.append($foot);
                $btns.removeClass('active');
                $panel.find('.view-toggle-btn[data-target="tenantTable"][data-view="list"]').addClass('active');
                localStorage.setItem('view-mode-tenantTable', 'list');
            }
        } else if (typeof _origTVM === 'function') {
            _origTVM(targetTableId, mode);
        }
    };

    /* View toggle click → animate wrappers */
    $(document).on('click', '.view-toggle-btn[data-target="tenantTable"]', function () {
        var mode = $(this).data('view');
        window.applyViewMode('tenantTable', mode);
        if (mode === 'grid') {
            $('#tenantTableViewWrapper').removeClass('active');
            setTimeout(function () { $('#tenantGridViewWrapper').addClass('active'); }, 50);
        } else {
            $('#tenantGridViewWrapper').removeClass('active');
            setTimeout(function () { $('#tenantTableViewWrapper').addClass('active'); }, 50);
        }
    });

    /* Init from localStorage – no flicker */
    (function initTenantView() {
        var saved = localStorage.getItem('view-mode-tenantTable') || 'list';
        window.applyViewMode('tenantTable', saved);
        if (saved === 'grid') {
            $('#tenantTableViewWrapper').removeClass('active');
            $('#tenantGridViewWrapper').addClass('active');
        } else {
            $('#tenantGridViewWrapper').removeClass('active');
            $('#tenantTableViewWrapper').addClass('active');
        }
    })();

});

function renderTenantArrowPagination(dt, mountSelector, label) {
    const info = dt.page.info();
    const totalPages = Math.max(info.pages, 1);
    const current = info.page + 1;
    const total = info.recordsTotal;
    const perPage = info.length;
    const $mount = $(mountSelector);

    if (!$mount.length) return;

    if ($mount.find('.if-pill-pagination').length === 0) {
        $mount.html(`
            <div class="if-pill-pagination">
                <div class="if-pill-rows-group">
                    <span class="if-pill-range-info">Rows</span>
                    <select class="if-pill-rows-select">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="200">200</option>
                    </select>
                    <span class="if-pill-range-info if-pill-range-info-label"></span>
                </div>
                <div class="tenant-arrow-pagination">
                    <button type="button" class="tenant-page-arrow tenant-prev-page" title="Previous Page">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </button>
                    <span class="tenant-page-circle">1</span>
                    <button type="button" class="tenant-page-arrow tenant-next-page" title="Next Page">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                </div>
            </div>
        `);

        $mount.on('change', '.if-pill-rows-select', function () {
            dt.page.len(parseInt(this.value, 10)).draw();
        });

        $mount.on('click', '.tenant-prev-page', function () {
            if (dt.page.info().page > 0) {
                dt.page('previous').draw('page');
            }
        });

        $mount.on('click', '.tenant-next-page', function () {
            const inf = dt.page.info();
            if (inf.page < inf.pages - 1) {
                dt.page('next').draw('page');
            }
        });
    }

    $mount.find('.if-pill-rows-select').val(perPage);

    const start = total === 0 ? 0 : (current - 1) * perPage + 1;
    const end = Math.min(current * perPage, total);
    $mount.find('.if-pill-range-info-label').text(`${start}\u2013${end} of ${total} ${label}`);

    $mount.find('.tenant-page-circle').text(current);
    $mount.find('.tenant-prev-page').prop('disabled', current <= 1);
    $mount.find('.tenant-next-page').prop('disabled', current >= totalPages);
}

/* ----------------------------------------------------------- */
function openTenantModal(id = '') {
    const isEdit = id !== '';
    openModal({
        title   : isEdit ? 'Update Organization'   : 'Provision New Tenant',
        subtitle: isEdit ? 'Modify organizational boundaries and settings.'
                         : 'Scale your ecosystem by adding a new organization boundary.',
        icon    : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>',
        url     : '/Home/CreateTenant?Id=' + id,
        onSuccess: () => $('#tenantTable').DataTable().ajax.reload()
    });
}

function editTenant(id)            { openTenantModal(id); }

function manageSubscriptions(id) {
    window.openModal({
        title   : 'Manage Subscriptions',
        subtitle: 'Configure service tiers and licensing dates.',
        icon    : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>',
        url     : '/Home/ManageTenantSubscriptions?TenantId=' + id,
        onSuccess: () => $('#tenantTable').DataTable().ajax.reload()
    });
}

function deleteTenant(id) {
    openModal({
        title   : 'Decommission Tenant',
        subtitle: 'Confirm permanent destruction of this organizational boundary.',
        icon    : `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-error">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  </svg>`,
        url     : '/Home/DeleteTenant?Id=' + id,
        onSuccess: () => $('#tenantTable').DataTable().ajax.reload()
    });
}
</script>
