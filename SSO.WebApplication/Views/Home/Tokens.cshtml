@{
    ViewData["Title"] = "Token Management";
}

<div class="breadcrumbs">
    <span>Auxinz Identity</span>
    <a href="#">Security</a>
    <span class="current">Token Management</span>
</div>

<div class="page-header">
    <div>
        <h1>Tokens</h1>
        <p style="color: var(--text-muted); margin-top: 4px;">
            View and manage active authorization and refresh tokens.
        </p>
    </div>
</div>

<div class="panel">
    <div class="table-toolbar">
        <div class="table-filters">
            <div style="position: relative;">
                <svg style="position: absolute; left: 10px; top: 10px; color: var(--text-muted);"
                     width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" class="form-input" placeholder="Search by subject..."
                       style="padding-left: 32px; width: 250px;">
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table id="tokenTable" class="data-table table-hoverable manual-init">
            <thead>
                <tr>
                    <th class="sorted">Subject</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Creation Date</th>
                    <th>Expiration Date</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        const $panel = $('#tokenTable').closest('.panel');
        const $customSearch = $panel.find('.table-toolbar .form-input');

        const dt = $('#tokenTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '/Home/GetTokens',
                type: 'POST',
                data: function (d) {
                    if ($customSearch.length > 0) {
                        d.customSearchValue = $customSearch.val();
                    }
                }
            },
            responsive: true,
            dom: '<"table-toolbar datatables-injected"<"table-filters"l>f>t<"pagination"ip>',
            columns: [
                {
                    data: 'subject',
                    render: function (data, type, row) {
                        return `<div class="cell-flex">
                                    <div class="cell-avatar status-active">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                            <circle cx="12" cy="7" r="4"></circle>
                                        </svg>
                                    </div>
                                    <div class="cell-text">
                                        <h5>${data || 'N/A'}</h5>
                                        <p>Ref ID: ${row.referenceId || 'N/A'}</p>
                                    </div>
                                </div>`;
                    }
                },
                {
                    data: 'type',
                    render: function (data) {
                        return `<span class="badge badge-neutral">${data || 'Unknown'}</span>`;
                    }
                },
                {
                    data: 'status',
                    render: function (data) {
                        if (data === 'valid') return '<span class="badge badge-success">Valid</span>';
                        if (data === 'revoked') return '<span class="badge badge-error">Revoked</span>';
                        return `<span class="badge badge-neutral">${data}</span>`;
                    }
                },
                {
                    data: 'creationDate',
                    render: function (data) {
                        if (!data) return '-';
                        return new Date(data).toLocaleString();
                    }
                },
                {
                    data: 'expirationDate',
                    render: function (data) {
                        if (!data) return '-';
                        return new Date(data).toLocaleString();
                    }
                },
                {
                    data: null,
                    orderable: false,
                    render: function (data, type, row) {
                        if (row.status === 'revoked') {
                            return `<div style="text-align: right;"><span class="text-muted">Revoked</span></div>`;
                        }
                        return `<div style="text-align: right;">
                                    <button class="action-btn text-error" title="Revoke Token" onclick="revokeToken('${row.id}')">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <line x1="15" y1="9" x2="9" y2="15"></line>
                                            <line x1="9" y1="9" x2="15" y2="15"></line>
                                        </svg>
                                    </button>
                                </div>`;
                    }
                }
            ]
        });

        if ($customSearch.length > 0) {
            let searchTimeout;
            $customSearch.on('keyup', function () {
                clearTimeout(searchTimeout);
                const val = this.value;
                searchTimeout = setTimeout(() => {
                    dt.search(val).draw();
                }, 400);
            });
        }
    });

    function revokeToken(id) {
        if (!confirm('Are you sure you want to revoke this token immediately? This action cannot be undone.')) return;
        
        $.ajax({
            url: '/Home/RevokeToken',
            type: 'POST',
            data: { id: id },
            success: function (response) {
                if(response && response.succeeded) {
                    $('#tokenTable').DataTable().ajax.reload();
                    alert(response.message);
                } else {
                    alert('Failed to revoke the token.');
                }
            },
            error: function () {
                alert('An error occurred while revoking the token.');
            }
        });
    }
</script>
