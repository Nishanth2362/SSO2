@using SSO.Application.Responses.Features

@{
    ViewData["Title"] = "Users Management";
}

<div class="breadcrumbs">
    <span>Auxinz Identity</span>
    <a href="#">Identity & Access</a>
    <span class="current">Users</span>
</div>

<div class="page-header">
    <div>
        <h1>System Users</h1>
        <p style="color: var(--text-muted); margin-top: 4px;">
            Manage user accounts, authentication methods, and tenant assignments.
        </p>
    </div>
    <div style="display: flex; gap: 12px;">
        <button class="btn btn-primary" id="openCreateUserModal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Create User
        </button>
        <a href="/Home/ExportUsers" class="btn btn-secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Export Excel
        </a>
    </div>
</div>

<div class="panel">
    <div class="table-toolbar">
        <div class="table-filters">
            <div style="position: relative;">
                <svg style="position: absolute; left: 10px; top: 10px; color: var(--text-muted);"
                     width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" class="form-input" placeholder="Search by name, email..."
                       style="padding-left: 32px; width: 250px;">
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table id="userTable" class="data-table table-hoverable manual-init">
            <thead>
                <tr>
                    <th style="width: 48px;"><input type="checkbox" class="custom-checkbox"></th>
                    <th class="sorted">User</th>
                    <th>Email</th>
                    <th>Tenant</th>
                    <th>Created</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        const $panel = $('#userTable').closest('.panel');
        const $customSearch = $panel.find('.table-toolbar .form-input');
        const $customFilters = $panel.find('.table-toolbar .form-select');

        window.dt = $('#userTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '/Home/GetUsers',
                type: 'POST',
                data: function (d) {
                    if ($customSearch.length > 0) {
                        d.customSearchValue = $customSearch.val();
                    }
                    // Additional filters can be added here
                }
            },
            responsive: true,
            dom: '<"table-toolbar datatables-injected"<"table-filters"l>f>t<"pagination"ip>',
            columns: [
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function () { return '<input type="checkbox" class="custom-checkbox">'; }
                },
                {
                    data: 'userName',
                    render: function (data, type, row) {
                        const name = row.firstName || data;
                        return `<div class="cell-flex">
                                    <div class="cell-avatar primary">
                                        ${name.charAt(0).toUpperCase()}
                                    </div>
                                    <div class="cell-text">
                                        <h5>${name}</h5>
                                        <p>${data}</p>
                                    </div>
                                </div>`;
                    }
                },
                { data: 'email' },
                { 
                    data: 'tenantId',
                    render: function(data) {
                        return `<span class="badge badge-neutral">${data ? 'Assigned' : 'Global' }</span>`;
                    }
                },
                { 
                    data: 'createdAt',
                    render: function(data) {
                        return new Date(data).toLocaleDateString();
                    }
                },
                {
                    data: 'isActive',
                    render: function (data) {
                        return data ? '<span class="badge badge-success">Active</span>' : '<span class="badge badge-error">Inactive</span>';
                    }
                },
                {
                    data: null,
                    orderable: false,
                    render: function (data, type, row) {
                        return `<div style="text-align: right;">
                                    <button class="action-btn" title="Reset Password"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></button>
                                    <button class="action-btn" title="Edit" onclick="editUser('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></button>
                                    <button class="action-btn text-error" title="Delete" onclick="deleteUser('${row.id}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>
                                </div>`;
                    }
                }
            ]
        });

        if ($customSearch.length > 0) {
            let searchTimeout;
            $customSearch.on('keyup', function () {
                clearTimeout(searchTimeout);
                const val = this.value;
                searchTimeout = setTimeout(() => {
                    dt.search(val).draw();
                }, 400);
            });
        }

        $('#openCreateUserModal').on('click', function() {
            openUserModal();
        });
    });

    function openUserModal(id = '') {
        const isEdit = id !== '';
        window.openModal({
            title: isEdit ? 'Edit User Profile' : 'Create New User',
            subtitle: isEdit ? 'Modify identity and access details.' : 'Register a new identity on the platform.',
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>`,
            url: '/Home/CreateUser?Id=' + id,
            onSuccess: function(result) {
                // This will be called if the generic modal form handler is used
                // but our partial has its own handler for now.
                window.dt.ajax.reload();
            }
        });
    }

    function editUser(id) {
        openUserModal(id);
    }

    function deleteUser(id) {
        window.openModal({
            title: 'Delete User',
            subtitle: 'Confirm permanent account removal.',
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-error">
                    <path d="M3 6h18"></path>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  </svg>`,
            url: '/Home/DeleteUser?Id=' + id,
            onSuccess: function(result) {
                window.dt.ajax.reload();
            }
        });
    }
</script>
