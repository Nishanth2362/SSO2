@using SSO.WebApplication.Controllers
@model List<JobViewModel>

@{
    ViewData["Title"] = "Operations Center";
    var cspNonce = Context.Items["CSPNonce"]?.ToString();
    var canManageJobs = (await AuthorizationService.AuthorizeAsync(User, Permissions.Hangfire.Manage)).Succeeded;
}

<link rel="stylesheet" href="~/css/jobs-management.css?v=@(DateTime.Now.Ticks)" />

<style>
    /* Full-page background for seamless integration - Fuchsia / Magenta Theme */
    body {
        background: linear-gradient(150deg,
                        rgba(217, 70, 239, 0.09) 0%,
                        rgba(192, 38, 211, 0.04) 25%,
                        rgba(250, 232, 255, 0.35) 60%,
                        rgba(255, 255, 255, 0.98) 100%) !important;
        background-attachment: fixed !important;
        background-repeat: no-repeat !important;
        background-size: cover !important;
    }

    html[data-theme="dark"] body {
        background: linear-gradient(150deg,
                        rgba(217, 70, 239, 0.16) 0%,
                        rgba(192, 38, 211, 0.08) 25%,
                        rgba(74, 4, 78, 0.45) 60%,
                        rgba(9, 12, 20, 0.96) 100%) !important;
        background-attachment: fixed !important;
        background-repeat: no-repeat !important;
        background-size: cover !important;
    }

    .page-wrapper, .content-wrapper, .container-xl, main, #content, .page-body {
        background: transparent !important;
    }

    .th-page-card {
        background: transparent;
        border: none;
        border-radius: 0;
        box-shadow: none;
        overflow: visible;
        margin-bottom: 8px;
    }

    .jobs-hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
        background: transparent;
        border: none;
        border-radius: 0;
        padding: 12px 4px 6px;
        margin-bottom: 0;
        overflow: hidden;
    }

    /* Scattered Background Pattern (8-12% opacity outline SVGs) - Fuchsia Theme */
    .jobs-hero-bg-pattern {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
        z-index: 0;
    }

    .hero-bg-icon {
        position: absolute;
        stroke: #d946ef;
        stroke-width: 1.5;
        fill: none;
        opacity: 0.10;
        transition: opacity 0.3s ease;
    }

    html[data-theme="dark"] .hero-bg-icon {
        stroke: #f0abfc;
        opacity: 0.12;
    }

    .hero-bg-icon.icon-cpu-1       { top: 8%; left: 1%; width: 32px; height: 32px; transform: rotate(-12deg); }
    .hero-bg-icon.icon-activity-1  { top: 14%; left: 36%; width: 26px; height: 26px; transform: rotate(10deg); }
    .hero-bg-icon.icon-clock-1     { bottom: 10%; left: 18%; width: 30px; height: 30px; transform: rotate(-8deg); }
    .hero-bg-icon.icon-rotate-1    { top: 58%; left: 3%; width: 28px; height: 28px; transform: rotate(6deg); }
    .hero-bg-icon.icon-zap-1       { top: 10%; left: 22%; width: 28px; height: 28px; transform: rotate(-10deg); }
    .hero-bg-icon.icon-server-1    { top: 62%; left: 44%; width: 26px; height: 26px; transform: rotate(-14deg); }
    .hero-bg-icon.icon-play-1      { top: 12%; right: 44%; width: 28px; height: 28px; transform: rotate(18deg); }
    .hero-bg-icon.icon-check-1     { bottom: 8%; right: 36%; width: 32px; height: 32px; transform: rotate(-10deg); }
    .hero-bg-icon.icon-list-1      { top: 10%; right: 26%; width: 26px; height: 26px; transform: rotate(8deg); }

    .th-hero-left { 
        position: relative; 
        display: flex; 
        align-items: center; 
        gap: 18px; 
        min-width: 260px; 
        flex: 1 1 320px; 
        z-index: 1; 
    }
    .th-hero-icon {
        width: 52px; 
        height: 52px; 
        flex-shrink: 0; 
        border-radius: 14px;
        background: linear-gradient(135deg, #d946ef, #c026d3);
        display: flex; 
        align-items: center; 
        justify-content: center; 
        color: #fff;
        box-shadow: 0 6px 16px rgba(217, 70, 239, 0.25);
    }
    .th-hero-title {
        font-size: 1.7rem !important;
        font-weight: 800 !important;
        color: var(--text-main);
        letter-spacing: -0.02em;
        margin: 0 0 6px;
        line-height: 1.2;
    }
    .th-hero-subtitle {
        font-size: 0.9rem !important;
        color: var(--text-muted);
        margin: 0;
        line-height: 1.4;
    }
    .th-hero-right { 
        position: relative; 
        display: flex; 
        align-items: center; 
        gap: 12px; 
        flex-wrap: wrap; 
        z-index: 1; 
    }
</style>

<div class="breadcrumbs">
    <a asp-action="Index" asp-controller="Home">Infrastructure</a>
    <span>/</span>
    <span class="current">Background Jobs</span>
</div>

<div class="th-page-card">
    <div class="jobs-hero">
        <div class="jobs-hero-bg-pattern">
            <svg class="hero-bg-icon icon-cpu-1" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="15" x2="23" y2="15"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="15" x2="4" y2="15"/></svg>
            <svg class="hero-bg-icon icon-activity-1" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            <svg class="hero-bg-icon icon-clock-1" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <svg class="hero-bg-icon icon-rotate-1" viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
            <svg class="hero-bg-icon icon-zap-1" viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            <svg class="hero-bg-icon icon-server-1" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
            <svg class="hero-bg-icon icon-play-1" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
            <svg class="hero-bg-icon icon-check-1" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <svg class="hero-bg-icon icon-list-1" viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="13" x2="3.01" y2="13"/></svg>
        </div>

        <div class="th-hero-left">
            <div class="th-hero-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                </svg>
            </div>
            <div>
                <h1 class="th-hero-title">Background Operations Control</h1>
                <p class="th-hero-subtitle">Monitor system performance and configure automated service workers.</p>
            </div>
        </div>

        <div class="th-hero-right">
        </div>
    </div>
</div>

<div class="jobs-container">
    <!-- Navigation Tabs -->
    <div class="tabs">
        <div class="tab active" data-tab="control">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            Service Control
        </div>
        <div class="tab" data-tab="monitor">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
            Execution Monitor
        </div>
    </div>

    <!-- Job Controls View -->
    <div id="control" class="tab-content active">
        <div class="panel" style="border:none; border-radius:0;">
            <!-- Real-time Stats Cards -->
            <div style="padding: 24px 32px 0 32px; display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 16px;">
                <div class="stat-glass-card" style="border-left: 3px solid var(--brand-primary);">
                    <span class="stat-label">Enqueued</span>
                    <div style="display:flex; align-items:baseline; gap:8px;">
                        <span class="stat-value">@ViewBag.EnqueuedCount</span>
                        @if (ViewBag.EnqueuedCount > 0)
                        {
                            <span class="pulse-ring" style="background: var(--brand-primary); width: 8px; height: 8px; border-radius: 50%;"></span>
                        }
                    </div>
                </div>
                <div class="stat-glass-card" style="border-left: 3px solid #f59e0b;">
                    <span class="stat-label">Active</span>
                    <span class="stat-value" style="color: #f59e0b;">@ViewBag.ProcessingCount</span>
                </div>
                <div class="stat-glass-card" style="border-left: 3px solid #10b981;">
                    <span class="stat-label">Succeeded</span>
                    <span class="stat-value" style="color: #10b981;">@ViewBag.SucceededCount</span>
                </div>
                <div class="stat-glass-card" style="border-left: 3px solid #ef4444;">
                    <span class="stat-label">Failed</span>
                    <span class="stat-value" style="color: #ef4444;">@ViewBag.FailedCount</span>
                </div>
                <div class="stat-glass-card" style="border-left: 3px solid #3b82f6;">
                    <span class="stat-label">Delayed Tasks</span>
                    <span class="stat-value" style="color: #3b82f6;">@ViewBag.DelayedCount</span>
                </div>
                <div class="stat-glass-card" style="border-left: 3px solid #8b5cf6;">
                    <span class="stat-label">Recursion / Services</span>
                    <div style="display:flex; align-items:baseline; gap:8px;">
                        <span class="stat-value" style="color: #8b5cf6;">@ViewBag.RecurringCount</span>
                        <span style="font-size: 11px; color: var(--text-muted);">/ @ViewBag.TotalServices</span>
                    </div>
                </div>
            </div>

            <div style="padding: 24px 32px; border-bottom: 1px solid var(--border-subtle); display:flex; justify-content:space-between; align-items:center; background: rgba(59, 130, 246, 0.02); margin-top:24px;">
                <div>
                    <h4 style="margin:0; font-weight:700; color: var(--text-main); text-transform:none; letter-spacing:normal; font-size:16px;">Scheduled Task Management</h4>
                    <p style="margin:4px 0 0 0; color:var(--text-muted); font-size:13px;">Manage recurring infrastructure tasks and operational jobs.</p>
                </div>
                <div style="display:flex; gap:12px; align-items:center;">
                    <div class="smart-export-dropdown-wrapper">
                        <button type="button" class="btn btn-secondary smart-export-dropdown-btn smart-export-btn btn-toolbar" id="exportJobsBtn" title="More Options">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="1.5"></circle>
                                <circle cx="12" cy="5" r="1.5"></circle>
                                <circle cx="12" cy="19" r="1.5"></circle>
                            </svg>
                        </button>
                        <span class="smart-export-badge" id="jobsSelectionBadge"></span>
                        <div class="smart-export-menu glass-dropdown">
                            <button type="button" class="dropdown-item smart-import-option" onclick="window.openImportModal('Background Jobs')">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                Import
                            </button>
                            <button type="button" class="dropdown-item smart-export-option" onclick="window.smartExport('jobsTable','/Home/ExportTemplates')">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                Export
                            </button>
                        </div>
                    </div>
                    @if (canManageJobs)
                    {
                        <button class="btn btn-primary btn-toolbar" onclick="showCreateJobForm()" style="box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            New Service Task
                        </button>
                    }
                    <button class="btn btn-ghost btn-toolbar" onclick="$('.tab[data-tab=\'monitor\']').click(); document.getElementById('hangfireFrame').src='/backgroundJobs';" style="border: 1px solid var(--border-subtle);">
                         View Enqueued Queue
                    </button>
                </div>
            </div>

            <div class="table-responsive" style="padding: 10px;">
                <table class="data-table manual-init" id="jobsTable" style="width: 100% !important; margin-bottom: 0 !important;">
                    <thead>
                        <tr>
                            <th class="text-left">IDENTIFIER / SERVICE</th>
                            <th class="text-center">STATUS</th>
                            <th class="text-center">SCHEDULE (CRON)</th>
                            <th class="text-left">METRICS / TIMELINE</th>
                            <th class="text-center">OPERATIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model.OrderBy(x => x.Name))
                        {
                            <tr data-job-row-id="@job.Id">
                                <td>
                                    <div style="display:flex; flex-direction:column; gap:4px;">
                                        <span style="font-weight: 700; color: var(--text-main); font-size: 14.5px;">@job.Name</span>
                                        <span style="font-size: 11px; color: var(--text-muted); font-family: 'JetBrains Mono', monospace; background: rgba(255,255,255,0.05); padding: 1px 6px; border-radius: 4px; align-self: flex-start;">@job.Id</span>
                                        
                                        <!-- Live Progress Container -->
                                        <div class="job-progress-container" style="display:none; margin-top: 6px; width: 100%; max-width: 250px;">
                                            <div class="progress-track" style="height: 6px; background: var(--border-subtle); border-radius: 3px; overflow: hidden; position: relative;">
                                                <div class="progress-fill job-progress-fill" style="width: 0%; height: 100%; background: var(--brand-primary); transition: width 0.3s ease;"></div>
                                            </div>
                                            <span class="job-progress-message" style="font-size: 10px; color: var(--text-muted); margin-top: 2px; display: inline-block;">Idle</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (job.IsRunning)
                                    {
                                        <div style="display: flex; align-items: center; justify-content: center;">
                                            <span class="badge" style="background: rgba(16, 185, 129, 0.1); color: var(--status-success); border: 1px solid rgba(16, 185, 129, 0.2); padding: 6px 14px; font-weight: 600; border-radius: 10px;">
                                                <i class="pulse-dot" style="background:var(--status-success); width:6px; height:6px; border-radius:50%; display:inline-block; margin-right:10px; vertical-align:middle; box-shadow: 0 0 8px var(--status-success);"></i>
                                                ENABLED
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background: rgba(255,255,255,0.05); color: var(--text-muted); border: 1px solid var(--border-subtle); padding: 6px 14px; border-radius: 10px;">
                                            DORMANT
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <code style="background: var(--bg-surface-hover); padding: 5px 12px; border-radius: 6px; font-weight:700; color: var(--brand-primary); font-size: 13px; border: 1px solid var(--border-subtle);">
                                        @(job.CronExpression)
                                    </code>
                                </td>
                                <td>
                                    <div style="display: flex; flex-direction: column; gap: 6px; font-size: 12px; color: var(--text-muted);">
                                        <div style="display: flex; justify-content: space-between; gap: 15px;">
                                            <span>Previous:</span>
                                            <span style="color: var(--text-main); font-weight: 500;">@(job.LastExecution?.ToString("MMM dd HH:mm:ss") ?? "Never")</span>
                                        </div>
                                        <div style="display: flex; justify-content: space-between; gap: 15px;">
                                            <span>Scheduled:</span>
                                            <span style="color: var(--brand-accent); font-weight: 600;">@(job.NextExecution?.ToString("MMM dd HH:mm:ss") ?? "N/A")</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (canManageJobs)
                                    {
                                        <div style="display: flex; gap: 8px; justify-content: center;">
                                            <button class="btn-icon" onclick="triggerNow('@job.Id')" title="Execute Logic Immediately" style="color: var(--brand-primary); background: rgba(59, 130, 246, 0.08);">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                                            </button>
                                            
                                            <button class="btn-icon" onclick="toggleSchedule('@job.Id', true)" title="Modify Schedule Parameters" style="color: var(--text-main); background: rgba(255, 255, 255, 0.05);">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                            </button>

                                            @if (job.IsRunning)
                                            {
                                                <button class="btn-icon" onclick="toggleSchedule('@job.Id', false)" title="Unregister Service" style="color: var(--status-error); background: rgba(239, 68, 68, 0.08);">
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"></path></svg>
                                                </button>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Live Execution Monitoring -->
    <div id="monitor" class="tab-content">
        <iframe src="/backgroundJobs" class="hangfire-iframe" id="hangfireFrame" title="Hangfire Dashboard"></iframe>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js" nonce="@cspNonce"></script>
<script src="~/js/jobs-management.js?v=@(DateTime.Now.Ticks)" nonce="@cspNonce"></script>
