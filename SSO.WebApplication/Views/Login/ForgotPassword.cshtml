@using SSO.Domain.Entities
@model SSO.Application.Requests.Identity.ForgotPasswordRequest
@{
    var tenant = ViewBag.TenantBranding as Tenants;
    var rawLogo = tenant?.LogoUrl?.Replace("\\", "/");
    var logo = !string.IsNullOrEmpty(rawLogo) ? "/" + rawLogo : "/pwa-icon-512.png";
    var tenantName = tenant?.Name ?? "Identity System";
    ViewData["Title"] = "Forgot Password";
    ViewData["ChalkSubtitle"] = "Recover Access Details";
}

<div class="chalk-card-header">
    <h2 class="chalk-card-title">Forgot Details?</h2>
    <p class="chalk-card-desc">Enter your registered email address to recover your username and access link.</p>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="chalk-alert chalk-alert-error">
        <div asp-validation-summary="ModelOnly" class="chalk-validation-summary"></div>
    </div>
}

<form method="post" asp-action="ForgotPassword" asp-controller="Login">
    <input type="hidden" asp-for="ReturnUrl" />

    <!-- Email Input -->
    <div class="form-group">
        <div class="chalk-input-wrap">
            <svg class="chalk-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <input type="email" class="form-input" asp-for="Email" placeholder="Email Address" required>
            <button type="button" class="clear-input-btn" aria-label="Clear text" tabindex="-1" style="display: none;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="m15 9-6 6"></path>
                    <path d="m9 9 6 6"></path>
                </svg>
            </button>
        </div>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <!-- Submit Button -->
    <button type="submit" class="chalk-btn">
        Recover Details
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
        </svg>
    </button>
</form>

<!-- Back to Login -->
<div class="chalk-links">
    <a asp-action="Index" asp-controller="Login" asp-route-returnUrl="@(Model?.ReturnUrl ?? string.Empty)" class="chalk-back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <path d="m12 19-7-7 7-7"></path>
        </svg>
        Back to Login
    </a>
</div>
