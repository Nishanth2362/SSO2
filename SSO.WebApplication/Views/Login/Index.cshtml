@using SSO.Domain.Entities
@model SSO.Application.Requests.Identity.TokenRequest;
@{
    var tenant = ViewBag.TenantBranding as Tenants;
    var rawLogo = tenant?.LogoUrl?.Replace("\\", "/");
    var logo = !string.IsNullOrEmpty(rawLogo) ? "/" + rawLogo : "/pwa-icon-512.png";
    var tenantName = tenant?.Name ?? "Identity System";
    ViewData["Title"] = "Sign In";
    ViewData["ChalkSubtitle"] = "Your Gateway to the Perfect Education";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="chalk-alert chalk-alert-success">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="chalk-alert chalk-alert-error">
        @TempData["ErrorMessage"]
    </div>
}

<div class="chalk-card-header">
    <h2 class="chalk-card-title">Welcome Back</h2>
    <p class="chalk-card-desc">Sign in to manage identity, tenants, and access across your workspace.</p>
</div>

<form method="post" asp-action="Index" asp-controller="Login" asp-route-returnUrl="@Model?.ReturnUrl">
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="Step" />
    <div asp-validation-summary="All" class="chalk-validation-summary"></div>

    <div class="form-group" data-login-step="identifier">
        <div class="chalk-input-wrap">
            <svg class="chalk-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <input type="text" class="form-input" asp-for="UserName" placeholder="Email or username" autocomplete="username" maxlength="256" readonly="@(Model?.Step == 2 ? "readonly" : null)" required>
        </div>
        <span asp-validation-for="UserName" class="text-danger"></span>
    </div>

    <div class="form-group" data-login-step="password" style="display:@(Model?.Step == 2 ? "block" : "none");">
        <div class="chalk-input-wrap">
            <svg class="chalk-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <input type="password" class="form-input" asp-for="Password" placeholder="Password" autocomplete="current-password">
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    @if (Model != null && !string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="chalk-alert chalk-alert-error">
            @Model.ErrorMessage
        </div>
    }

    <div class="chalk-checkbox-row" data-login-step="password" style="display:@(Model?.Step == 2 ? "flex" : "none");">
        <input type="checkbox" id="remember" asp-for="RememberMe">
        <label for="remember">Keep me signed in for 30 days</label>
    </div>

    <div class="chalk-links" data-login-step="password" style="display:@(Model?.Step == 2 ? "flex" : "none"); margin-top:0; margin-bottom:1rem; justify-content:flex-start;">
        <button type="button" class="chalk-link chalk-link-strong" id="loginBackButton" style="background:none; border:none; padding:0;" aria-label="Change email or username">
            Use a different email or username
        </button>
    </div>

    <button type="submit" class="chalk-btn" id="loginContinueButton">
        <span id="loginContinueText">@(Model?.Step == 2 ? "Sign In" : "Continue")</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
        </svg>
    </button>
</form>

<!-- Links -->
<div class="chalk-links">
    <div>
        <a asp-action="ForgotPassword" asp-controller="Login" asp-route-returnUrl="@(Model?.ReturnUrl ?? string.Empty)" class="chalk-link chalk-link-strong">
            Forgot Access Details?
        </a>
    </div>
    <div class="chalk-links-divider">
        <span class="chalk-link">New user? </span>
        <a asp-action="Register" asp-controller="Login" asp-route-returnUrl="@(Model?.ReturnUrl ?? string.Empty)" class="chalk-link-bold">Sign Up</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/login.js" asp-append-version="true"></script>
}
