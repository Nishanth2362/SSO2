@using SSO.Domain.Entities
@model SSO.Application.Requests.Identity.RegisterRequest
@{
    var tenant = ViewBag.TenantBranding as Tenants;
    var rawLogo = tenant?.LogoUrl?.Replace("\\", "/");
    var logo = !string.IsNullOrEmpty(rawLogo) ? "/" + rawLogo : "/pwa-icon-512.png";
    var tenantName = tenant?.Name ?? "Identity System";
    ViewData["Title"] = "Register";
    ViewData["ChalkSubtitle"] = "Create Your Account";
}

<div class="chalk-card-header">
    <h2 class="chalk-card-title">Create Account</h2>
    <p class="chalk-card-desc">Join @tenantName and start your journey today.</p>
</div>

<form method="post" asp-action="Register" asp-controller="Login" asp-route-returnUrl="@Model.ReturnUrl">
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="ClientId" />
    <input type="hidden" asp-for="TenantId" />

    <!-- Full Name -->
    <div class="form-group">
        <div class="chalk-input-wrap">
            <svg class="chalk-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <input type="text" class="form-input" asp-for="Name" placeholder="Full Name" required>
        </div>
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <!-- Email -->
    <div class="form-group">
        <div class="chalk-input-wrap">
            <svg class="chalk-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <input type="email" class="form-input" asp-for="Email" placeholder="Email Address" required>
        </div>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <!-- Password -->
    <div class="form-group">
        <div class="chalk-input-wrap">
            <svg class="chalk-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <input type="password" class="form-input" asp-for="Password" placeholder="Password" required>
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <!-- Confirm Password -->
    <div class="form-group">
        <div class="chalk-input-wrap">
            <svg class="chalk-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <input type="password" class="form-input" asp-for="ConfirmPassword" placeholder="Confirm Password" required>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="chalk-alert chalk-alert-error">
            <div asp-validation-summary="All" class="chalk-validation-summary"></div>
        </div>
    }

    <!-- Submit Button -->
    <button type="submit" class="chalk-btn">
        Create Account
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
        </svg>
    </button>
</form>

<!-- Links -->
<div class="chalk-links">
    <span class="chalk-link">Already have an account? </span>
    <a asp-action="Index" asp-controller="Login" asp-route-returnUrl="@Model.ReturnUrl" class="chalk-link-bold">Sign In</a>
</div>
