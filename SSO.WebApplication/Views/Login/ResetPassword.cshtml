@using SSO.Domain.Entities
@model SSO.Application.Requests.Identity.ResetPasswordRequest
@{
    var tenant = ViewBag.TenantBranding as Tenants;
    var rawLogo = tenant?.LogoUrl?.Replace("\\", "/");
    var logo = !string.IsNullOrEmpty(rawLogo) ? "/" + rawLogo : "/pwa-icon-512.png";
    var tenantName = tenant?.Name ?? "Identity System";
    ViewData["Title"] = "Reset Password";
    ViewData["ChalkSubtitle"] = "Set New Password";
}

<div class="chalk-card-header">
    <h2 class="chalk-card-title">Set New Password</h2>
    <p class="chalk-card-desc">Choose a strong password to secure your account.</p>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="chalk-alert chalk-alert-error">
        <div asp-validation-summary="All" class="chalk-validation-summary"></div>
    </div>
}

<form method="post" asp-action="ResetPassword" asp-controller="Login">
    <input type="hidden" asp-for="Token" />
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="ReturnUrl" />

    <!-- New Password -->
    <div class="form-group">
        <div class="chalk-input-wrap">
            <svg class="chalk-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <input type="password" class="form-input" asp-for="Password" placeholder="New Password" required>
            <button type="button" class="password-toggle-btn" aria-label="Toggle password visibility">
                <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg class="eye-off-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                </svg>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <!-- Confirm New Password -->
    <div class="form-group">
        <div class="chalk-input-wrap">
            <svg class="chalk-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <input type="password" class="form-input" asp-for="ConfirmPassword" placeholder="Confirm New Password" required>
            <button type="button" class="password-toggle-btn" aria-label="Toggle password visibility">
                <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg class="eye-off-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                </svg>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <!-- Submit Button -->
    <button type="submit" class="chalk-btn">
        Reset Password
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
        </svg>
    </button>
</form>

<!-- Back to Login -->
<div class="chalk-links">
    <a asp-action="Index" asp-controller="Login" asp-route-returnUrl="@Model.ReturnUrl" class="chalk-back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <path d="m12 19-7-7 7-7"></path>
        </svg>
        Back to Login
    </a>
</div>
