<!-- Main Panel -->
<div class="panel">
    <div class="table-filters-data" style="display:none;">
        <div class="filter-group-item">
            <label style="cursor: pointer; display: inline-flex; align-items: center; gap: 6px; user-select: none;">
                <input type="checkbox" name="filter_searchInOldValues" id="searchInOldValues" class="filter-searchInOldValues" style="margin: 0; cursor: pointer;">
                Old Values
            </label>
        </div>
        <div class="filter-group-item">
            <label style="cursor: pointer; display: inline-flex; align-items: center; gap: 6px; user-select: none;">
                <input type="checkbox" name="filter_searchInNewValues" id="searchInNewValues" class="filter-searchInNewValues" style="margin: 0; cursor: pointer;">
                New Values
            </label>
        </div>
    </div>

    <!-- Table -->
    <div class="table-responsive">
        <table id="auditTable" class="data-table manual-init">
            <thead>
                <tr>
                    <th class="text-center" style="width: 40px;"><input type="checkbox" class="master-select-cb" data-table="auditTable"></th>
                    <th class="text-center">Date / Time</th>
                    <th class="text-left">User</th>
                    <th class="text-center">Type</th>
                    <th class="text-left">Table Name</th>
                    <th class="text-left">Primary Key</th>
                    <th class="text-left">Affected Columns</th>
                    <th class="text-left">Old Values</th>
                    <th class="text-left">New Values</th>
                    <th class="text-center" style="width: 60px;">Actions</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        window.dt = $('#auditTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '/Reporting/GetAuditLogs',
                type: 'POST'
            },
            responsive: false,
            autoWidth: false,
            dom: '<"table-toolbar datatables-injected"<"table-filters">f>t<"if-table-footer-wrap"<"footer-right"<"if-pill-pagination-mount">>>',
            drawCallback: function(settings) {
                const api = this.api();
                window.renderPillPagination && window.renderPillPagination(api, '.if-pill-pagination-mount', 'audit');
                const info = api.page.info();
                const rows = api.rows({ page: 'current' }).data().toArray();
                const total = info.recordsTotal;
                const opsCount = rows.filter(r => r.type === 'Update' || r.type === 'Create' || r.type === 'Insert').length;
                const secCount = rows.filter(r => r.type === 'Delete' || (r.tableName && r.tableName.toLowerCase().indexOf('security') !== -1)).length;
                const opsRatio = rows.length > 0 ? opsCount / rows.length : 0.6;
                const secRatio = rows.length > 0 ? secCount / rows.length : 0.4;
                $('#totalLogsKpi').text(total || '—');
                $('#opsLogsKpi').text(Math.round(opsRatio * total) || '—');
                $('#secLogsKpi').text(Math.round(secRatio * total) || '—');
            },
            order: [[1, 'desc']],
            columns: [
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: 'text-center align-middle',
                    render: function (data, type, row) {
                        return '<input type="checkbox" class="row-select-cb" data-row-id="' + (row.id || row.Id || '') + '">';
                    }
                },
                { 
                    data: 'dateTime',
                    className: 'text-center align-middle',
                    render: function(data) {
                        return new Date(data).toLocaleString();
                    }
                },
                { 
                    data: 'userId',
                    className: 'text-left align-middle'
                },
                { 
                    data: 'type',
                    className: 'text-center align-middle',
                    render: function(data) {
                        if (data === 'Create' || data === 'Insert') {
                            return `<span class="badge badge-success">${data}</span>`;
                        }
                        if (data === 'Update') {
                            return `<span class="badge badge-warning">${data}</span>`;
                        }
                        if (data === 'Delete') {
                            return `<span class="badge badge-error">${data}</span>`;
                        }
                        return `<span class="badge badge-neutral">${data}</span>`;
                    }
                },
                { 
                    data: 'tableName',
                    className: 'text-left align-middle'
                },
                { 
                    data: 'primaryKey',
                    className: 'text-left align-middle'
                },
                { 
                    data: 'affectedColumns',
                    className: 'text-left align-middle',
                    render: function(data) {
                        if (!data || data === '[]') return '-';
                        return `<div style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: 'SFMono-Regular', 'Consolas', monospace; font-size: 0.72rem; color: var(--text-muted);" title="${data}">${data}</div>`;
                    }
                },
                { 
                    data: 'oldValues',
                    className: 'text-left align-middle',
                    render: function(data) {
                        if (!data || data === '{}') return '-';
                        return `<div style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: 'SFMono-Regular', 'Consolas', monospace; font-size: 0.72rem; color: var(--text-muted);" title='${data}'>${data}</div>`;
                    }
                },
                { 
                    data: 'newValues',
                    className: 'text-left align-middle',
                    render: function(data) {
                        if (!data || data === '{}') return '-';
                        return `<div style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: 'SFMono-Regular', 'Consolas', monospace; font-size: 0.72rem; color: var(--text-muted);" title='${data}'>${data}</div>`;
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: 'text-center align-middle',
                    render: function (data, type, row) {
                        return `<div class="audit-actions-wrapper" style="display: flex; justify-content: center; align-items: center;">
                                    <button class="action-btn action-btn-view" title="View Details" data-type="auditLog" data-id="${row.id}">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="3"></circle>
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        </svg>
                                    </button>
                                </div>`;
                    }
                }
            ],
            drawCallback: function () {
                const api = this.api();
                window.renderPillPagination(api, '.if-pill-pagination-mount', 'audit logs');
                setTimeout(() => {
                    if (window.dt) {
                        window.dt.columns.adjust();
                    }
                }, 100);
            }
        });

        window.exportData = function(format) {
            document.getElementById('exportMenu').style.display = 'none';
            var searchStr = window.dt.search() || '';
            const activeFilters = $('.panel').data('active-filters') || {};
            var searchOld = activeFilters.searchInOldValues === 'true';
            var searchNew = activeFilters.searchInNewValues === 'true';
            
            if (format === 'pdf') {
                const selectedIds = Array.from(window.getSelectionSet('auditTable'));
                // Show export toast
                window.showExportToast('Generating PDF...');
                
                $.ajax({
                    url: '/Reporting/ExportAuditLogs',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() || ''
                    },
                    data: JSON.stringify({
                        Format: 'pdf_json',
                        SearchValue: searchStr,
                        SearchInOldValues: searchOld,
                        SearchInNewValues: searchNew,
                        SelectedIds: selectedIds.length > 0 ? selectedIds : []
                    }),
                    success: function(response) {
                        window.hideExportToast();
                        try {
                            const { jsPDF } = window.jspdf;
                            const doc = new jsPDF('landscape');
                            
                            doc.setFontSize(16);
                            doc.text('System Audit Logs', 14, 15);
                            
                            var bodyData = [];
                            for(var i=0; i<response.length; i++) {
                                var item = response[i];
                                var dt = new Date(item.dateTime).toLocaleString();
                                bodyData.push([
                                    dt, 
                                    item.userId || '-', 
                                    item.type || '-', 
                                    item.tableName || '-', 
                                    item.primaryKey || '-', 
                                    item.affectedColumns || '-',
                                    (item.oldValues && item.oldValues.length > 50) ? item.oldValues.substring(0,47)+'...' : (item.oldValues || '-'),
                                    (item.newValues && item.newValues.length > 50) ? item.newValues.substring(0,47)+'...' : (item.newValues || '-')
                                ]);
                            }
                            
                            doc.autoTable({
                                head: [['Date/Time', 'User', 'Type', 'Table', 'Key', 'Columns', 'Old Values', 'New Values']],
                                body: bodyData,
                                startY: 25,
                                styles: { fontSize: 8, cellPadding: 2, overflow: 'linebreak' },
                                columnStyles: {
                                    6: { cellWidth: 40 },
                                    7: { cellWidth: 40 }
                                }
                            });
                            
                            doc.save('AuditLogs.pdf');
                        } catch (e) {
                            console.error(e);
                            alert("Failed to build PDF logic.");
                        }
                    },
                    error: function() {
                        window.hideExportToast();
                        alert("Error retrieving data for PDF generation.");
                    }
                });
            } else {
                window.smartExport('auditTable', '/Reporting/ExportAuditLogs', {
                    Format: format,
                    SearchInOldValues: searchOld,
                    SearchInNewValues: searchNew
                });
            }
        };

        // Initialize row selection for smart export
        window.initRowSelection('auditTable', 'id');

        window.onclick = function(event) {
            if (!event.target.closest('.dropdown')) {
                var menu = document.getElementById('exportMenu');
                if (menu) menu.style.display = 'none';
            }
        };
    });
</script>
