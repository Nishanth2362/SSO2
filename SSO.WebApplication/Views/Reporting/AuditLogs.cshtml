@{
    ViewData["Title"] = "Audit Logs";
    var canExportAuditLogs = (await AuthorizationService.AuthorizeAsync(User, Permissions.AuditTrails.Export)).Succeeded || (await AuthorizationService.AuthorizeAsync(User, Permissions.AuditTrails.View)).Succeeded;
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>

<style>
    /* Table general scaling and layout */
    #auditTable {
        width: 100% !important;
        min-width: 1100px; /* Forces horizontal scroll on narrower screens rather than wrapping or collapsing */
        border-collapse: separate;
        border-spacing: 0;
        font-size: 0.78rem !important;
    }

    #auditTable thead th {
        padding: 8px 10px !important;
        font-size: 0.7rem !important;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        background-color: var(--bg-base);
        border-bottom: 1px solid var(--border-subtle) !important;
        white-space: nowrap;
        vertical-align: middle !important;
    }

    #auditTable tbody td {
        padding: 6px 10px !important; /* Compact spacing */
        font-size: 0.78rem !important;
        border-bottom: 1px solid var(--border-subtle) !important;
        white-space: nowrap !important; /* Keep all table content on a single line */
        word-break: normal !important;
        vertical-align: middle !important;
    }

    /* Hover and Transition consistency */
    #auditTable tbody tr {
        transition: background 0.12s;
    }
    #auditTable tbody tr:hover td {
        background: var(--bg-surface-hover) !important;
    }

    /* Column Width Controls */
    #auditTable th:nth-child(1), #auditTable td:nth-child(1) { width: 40px !important; min-width: 40px; text-align: center; } /* Checkbox */
    #auditTable th:nth-child(2), #auditTable td:nth-child(2) { width: 14% !important; min-width: 140px; } /* Date/Time */
    #auditTable th:nth-child(3), #auditTable td:nth-child(3) { width: 10% !important; min-width: 90px; }  /* User */
    #auditTable th:nth-child(4), #auditTable td:nth-child(4) { width: 8% !important; min-width: 80px; }   /* Type */
    #auditTable th:nth-child(5), #auditTable td:nth-child(5) { width: 12% !important; min-width: 110px; } /* Table Name */
    #auditTable th:nth-child(6), #auditTable td:nth-child(6) { width: 10% !important; min-width: 90px; }  /* Primary Key */
    #auditTable th:nth-child(7), #auditTable td:nth-child(7) { width: 16% !important; min-width: 150px; } /* Affected Columns */
    #auditTable th:nth-child(8), #auditTable td:nth-child(8) { width: 13% !important; min-width: 150px; } /* Old Values */
    #auditTable th:nth-child(9), #auditTable td:nth-child(9) { width: 13% !important; min-width: 150px; } /* New Values */
    #auditTable th:nth-child(10), #auditTable td:nth-child(10) { width: 4% !important; min-width: 50px; text-align: right; }   /* Actions */

    /* Horizontal scrolling wrapper styling */
    .table-responsive {
        width: 100% !important;
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch;
        border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    }

    /* Custom scrollbar for horizontal scrolling area */
    .table-responsive::-webkit-scrollbar {
        height: 6px;
    }
    .table-responsive::-webkit-scrollbar-track {
        background: transparent;
    }
    .table-responsive::-webkit-scrollbar-thumb {
        background: var(--border-strong);
        border-radius: 3px;
    }
    .table-responsive::-webkit-scrollbar-thumb:hover {
        background: var(--text-muted);
    }

    /* Actions vertical centering & size adjustments */
    .audit-actions-wrapper {
        display: flex;
        justify-content: flex-end;
        align-items: center;
    }
    .audit-actions-wrapper .action-btn {
        padding: 4px !important;
        border-radius: var(--radius-md) !important;
        width: 24px;
        height: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: transparent;
        color: var(--text-muted);
        cursor: pointer;
        transition: all 0.12s;
    }
    .audit-actions-wrapper .action-btn:hover {
        background: var(--bg-surface-hover);
        color: var(--text-main);
    }

    /* Full-page background for seamless integration - Indigo Theme */
    body {
        background: linear-gradient(150deg,
                        rgba(99, 102, 241, 0.08) 0%,
                        rgba(79, 70, 229, 0.03) 25%,
                        rgba(224, 231, 255, 0.3) 60%,
                        rgba(255, 255, 255, 0.95) 100%) !important;
        background-attachment: fixed !important;
        background-repeat: no-repeat !important;
        background-size: cover !important;
    }

    html[data-theme="dark"] body {
        background: linear-gradient(150deg,
                        rgba(99, 102, 241, 0.16) 0%,
                        rgba(79, 70, 229, 0.06) 25%,
                        rgba(30, 27, 75, 0.45) 60%,
                        rgba(9, 12, 20, 0.96) 100%) !important;
        background-attachment: fixed !important;
        background-repeat: no-repeat !important;
        background-size: cover !important;
    }

    .page-wrapper, .content-wrapper, .container-xl, main, #content, .page-body {
        background: transparent !important;
    }

    .th-page-card {
        background: transparent;
        border: none;
        border-radius: 0;
        box-shadow: none;
        overflow: visible;
        margin-bottom: 8px;
    }

    .audit-hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
        background: transparent;
        border: none;
        border-radius: 0;
        padding: 12px 4px 6px;
        margin-bottom: 0;
        overflow: hidden;
    }

    /* Scattered Background Pattern (8-12% opacity outline SVGs) - Indigo Theme */
    .audit-hero-bg-pattern {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
        z-index: 0;
    }

    .hero-bg-icon {
        position: absolute;
        stroke: #6366f1;
        stroke-width: 1.5;
        fill: none;
        opacity: 0.10;
        transition: opacity 0.3s ease;
    }

    html[data-theme="dark"] .hero-bg-icon {
        stroke: #818cf8;
        opacity: 0.12;
    }

    .hero-bg-icon.icon-doc-1       { top: 8%; left: 1%; width: 32px; height: 32px; transform: rotate(-12deg); }
    .hero-bg-icon.icon-search-1    { top: 14%; left: 36%; width: 26px; height: 26px; transform: rotate(10deg); }
    .hero-bg-icon.icon-activity-1  { bottom: 10%; left: 18%; width: 30px; height: 30px; transform: rotate(-8deg); }
    .hero-bg-icon.icon-eye-1       { top: 58%; left: 3%; width: 28px; height: 28px; transform: rotate(6deg); }
    .hero-bg-icon.icon-db-1        { top: 10%; left: 22%; width: 28px; height: 28px; transform: rotate(-10deg); }
    .hero-bg-icon.icon-history-1   { top: 62%; left: 44%; width: 26px; height: 26px; transform: rotate(-14deg); }
    .hero-bg-icon.icon-filetext-1  { top: 12%; right: 44%; width: 28px; height: 28px; transform: rotate(18deg); }
    .hero-bg-icon.icon-shield-1    { bottom: 8%; right: 36%; width: 32px; height: 32px; transform: rotate(-10deg); }
    .hero-bg-icon.icon-layers-1    { top: 10%; right: 26%; width: 26px; height: 26px; transform: rotate(8deg); }

    .th-hero-left { 
        position: relative; 
        display: flex; 
        align-items: center; 
        gap: 18px; 
        min-width: 260px; 
        flex: 1 1 320px; 
        z-index: 1; 
    }
    .th-hero-icon {
        width: 52px; 
        height: 52px; 
        flex-shrink: 0; 
        border-radius: 14px;
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        display: flex; 
        align-items: center; 
        justify-content: center; 
        color: #fff;
        box-shadow: 0 6px 16px rgba(99, 102, 241, 0.25);
    }
    .th-hero-title {
        font-size: 1.7rem !important;
        font-weight: 800 !important;
        color: var(--text-main);
        letter-spacing: -0.02em;
        margin: 0 0 6px;
        line-height: 1.2;
    }
    .th-hero-subtitle {
        font-size: 0.86rem;
        color: var(--text-muted);
        margin: 0;
        max-width: 480px;
        line-height: 1.5;
    }

    /* ═══════════════════════════════════════════════════════════
       COMPACT KPI CARDS (Indigo Theme)
       ═══════════════════════════════════════════════════════════ */
    .sub-kpi-container {
        position: relative;
        display: flex;
        gap: 14px;
        align-items: stretch;
        z-index: 1;
        flex-wrap: wrap;
        margin-left: 0;
        margin-right: 0;
    }
    .sub-kpi-card {
        cursor: pointer;
        user-select: none;
        width: 178px;
        flex-shrink: 0;
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 14px;
        padding: 10px 14px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(0,0,0,0.03), 0 6px 16px -8px rgba(15,23,42,0.08);
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }
    .sub-kpi-card:hover { 
        transform: translateY(-2px); 
        box-shadow: 0 4px 10px rgba(0,0,0,0.05), 0 10px 24px -8px rgba(15,23,42,0.14); 
    }
    .sub-kpi-card.active {
        border-color: #6366f1 !important;
        box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.18), var(--shadow-sm) !important;
    }

    .sub-kpi-card .tabler-stat-header { 
        display: flex; 
        align-items: center; 
        gap: 10px; 
        margin-bottom: 8px; 
    }
    .sub-kpi-card .tabler-stat-title { 
        font-size: 0.66rem; 
        font-weight: 700; 
        letter-spacing: 0.04em; 
        text-transform: uppercase; 
        color: #64748b; 
        line-height: 1.3; 
    }
    html[data-theme="dark"] .sub-kpi-card .tabler-stat-title { 
        color: #94a3b8; 
    }
    .sub-kpi-card .tabler-stat-value { 
        font-size: 1.6rem; 
        font-weight: 800; 
        color: var(--text-main); 
        line-height: 1; 
    }
    .tabler-stat-icon {
        width: 38px; 
        height: 38px; 
        border-radius: 10px; 
        flex-shrink: 0;
        display: flex; 
        align-items: center; 
        justify-content: center;
        transition: transform 0.2s ease;
    }
    .sub-kpi-card:hover .tabler-stat-icon { 
        transform: scale(1.08); 
    }
    .tabler-stat-icon.total-icon { 
        background: rgba(99, 102, 241, 0.14) !important; 
        color: #6366f1 !important; 
    }
    .tabler-stat-icon.system-icon { 
        background: rgba(59, 130, 246, 0.14) !important; 
        color: #3b82f6 !important; 
    }
    .tabler-stat-icon.security-icon { 
        background: rgba(16, 185, 129, 0.14) !important; 
        color: #10b981 !important; 
    }

    .kpi-mini-visual {
        position: absolute;
        right: 10px;
        bottom: 6px;
        opacity: 0.7;
        pointer-events: none;
    }

    #exportBtn, .btn-primary-audit {
        background: linear-gradient(135deg, #6366f1, #4f46e5) !important;
        border-color: #4f46e5 !important;
        color: #ffffff !important;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25) !important;
    }
    #exportBtn:hover, .btn-primary-audit:hover {
        background: linear-gradient(135deg, #4f46e5, #4338ca) !important;
        box-shadow: 0 6px 16px rgba(99, 102, 241, 0.35) !important;
    }

    /* Responsiveness overrides */
    @@media (max-width: 768px) {
        #auditTable th,
        #auditTable td {
            padding: 5px 8px !important;
            font-size: 0.74rem !important;
        }
    }

    @@media (max-width: 480px) {
        #auditTable th,
        #auditTable td {
            padding: 4px 6px !important;
            font-size: 0.7rem !important;
        }
    }
</style>

