<script nonce="@cspNonce">
    $(function () {
        const $table = $('#rpapTable');
        const $customSearch = $('#sessionSearchInput');

        const avatarColors = [
            { bg: 'rgba(99, 102, 241, 0.14)', fg: '#6366f1' },
            { bg: 'rgba(16, 185, 129, 0.14)', fg: '#10b981' },
            { bg: 'rgba(245, 158, 11, 0.14)', fg: '#f59e0b' },
            { bg: 'rgba(236, 72, 153, 0.14)', fg: '#ec4899' },
            { bg: 'rgba(59, 130, 246, 0.14)', fg: '#3b82f6' }
        ];

        const dt = $table.DataTable({
            processing: true,
            serverSide: true,
            responsive: false,
            autoWidth: false,
            pageLength: 10,
            dom: 't<"if-table-footer-wrap"<"footer-right"<"if-pill-pagination-mount">>>',
            ajax: {
                url: '/RestrictedAccess/GetTransactions',
                type: 'POST',
                data: function (d) {
                    if ($customSearch.length > 0) {
                        d.search = d.search || {};
                        d.search.value = $customSearch.val();
                    }
                    d.filter_ClientId = $('#filterClientId').val();
                    d.filter_TenantId = $('#filterTenantId').val();
                    d.filter_Scope = $('#filterScope').val();
                    d.filter_Status = $('#filterStatus').val();
                }
            },
            columns: [
                {
                    data: 'userName',
                    width: '25%',
                    render: function (data, type, row, meta) {
                        const name = data || row.userName || row.userEmail || 'Unknown User';
                        const email = row.userEmail || '';
                        const initial = (name.charAt(0) || 'U').toUpperCase();
                        const tint = avatarColors[(meta && typeof meta.row === 'number' ? meta.row : 0) % avatarColors.length];

                        return `
                            <div class="cell-flex">
                                <div class="cell-avatar" style="background: ${tint.bg}; color: ${tint.fg};">
                                    ${initial}
                                </div>
                                <div class="cell-text">
                                    <h5>${name}</h5>
                                    <p>${email}</p>
                                </div>
                            </div>
                        `;
                    }
                },
                {
                    data: 'clientDisplayName',
                    width: '20%',
                    render: function (data, type, row) {
                        const client = data || row.clientId || 'Client App';
                        const tenant = row.tenantName ? `<div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">Tenant: <strong>${row.tenantName}</strong></div>` : '';
                        return `
                            <div>
                                <div style="font-weight: 700; color: var(--text-main); font-size: 0.85rem;">${client}</div>
                                ${tenant}
                            </div>
                        `;
                    }
                },
                {
                    data: 'scope',
                    width: '15%',
                    render: function (data, type, row) {
                        const s = data || 'profile:manage';
                        let changesPill = '';
                        if (row.changes && row.changes.length > 0) {
                            const formatted = row.changes.map(c => c === 'phone_number' ? 'Phone' : c.charAt(0).toUpperCase() + c.slice(1)).join(', ');
                            changesPill = `
                                <div style="margin-top: 4px;">
                                    <span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 7px; border-radius: 6px; font-size: 0.68rem; font-weight: 700; background: rgba(16, 185, 129, 0.12); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.25);">
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                        ${formatted}
                                    </span>
                                </div>
                            `;
                        }
                        return `<div><span class="scope-pill"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>${s}</span>${changesPill}</div>`;
                    }
                },
                {
                    data: 'status',
                    width: '12%',
                    className: 'text-center',
                    render: function (data, type, row) {
                        const status = row.statusName || (data !== undefined && data !== null ? data.toString() : 'Pending');
                        let pillClass = 'status-pending';
                        if (status === 'Active' || status === '1') pillClass = 'status-active';
                        else if (status === 'Completed' || status === '2') pillClass = 'status-completed';
                        else if (status === 'Expired' || status === '3') pillClass = 'status-expired';
                        else if (status === 'Revoked' || status === '4') pillClass = 'status-revoked';

                        const displayStatus = row.statusName || status;
                        return `<span class="status-pill ${pillClass}"><span class="status-pulse"></span>${displayStatus}</span>`;
                    }
                },
                {
                    data: 'createdOn',
                    width: '12%',
                    className: 'text-center',
                    render: function (data) {
                        if (!data) return '-';
                        const d = new Date(data);
                        return `<span style="font-size: 0.825rem; font-weight: 600; color: var(--text-main);">${d.toLocaleDateString()} ${d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>`;
                    }
                },
                {
                    data: 'expiresOn',
                    width: '10%',
                    className: 'text-center',
                    render: function (data, type, row) {
                        if (!data) return '-';
                        const exp = new Date(data);
                        const isExp = exp < new Date();
                        const color = isExp ? 'color: var(--text-muted);' : 'color: #10b981; font-weight: 700;';
                        return `<span style="font-size: 0.825rem; ${color}">${exp.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>`;
                    }
                },
                {
                    data: 'id',
                    width: '6%',
                    orderable: false,
                    className: 'text-center',
                    render: function (data, type, row) {
                        const rowJson = encodeURIComponent(JSON.stringify(row));
                        let revokeBtn = '';
                        if (row.statusName === 'Active' || row.status === 1 || row.statusName === 'Pending' || row.status === 0) {
                            revokeBtn = `
                                <button type="button" class="btn btn-outline-danger btn-sm btn-revoke" data-id="${data}" title="Revoke Session" style="padding: 4px 10px; font-size: 0.75rem; border-radius: 8px; font-weight: 600;">
                                    Revoke
                                </button>
                            `;
                        }

                        return `
                            <div style="display: inline-flex; align-items: center; gap: 6px;">
                                <button type="button" class="btn btn-secondary btn-sm btn-inspect" data-row="${rowJson}" title="Inspect Details" style="padding: 4px 10px; font-size: 0.75rem; border-radius: 8px; font-weight: 600;">
                                    Inspect
                                </button>
                                ${revokeBtn}
                            </div>
                        `;
                    }
                }
            ],
            order: [[4, 'desc']],
            drawCallback: function (settings) {
                const api = this.api();
                if (typeof window.renderPillPagination === 'function') {
                    window.renderPillPagination(api, '.if-pill-pagination-mount', 'sessions');
                }
            }
        });

        // Search with debounce
        let searchTimer;
        $customSearch.on('input', function () {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(() => {
                dt.ajax.reload();
            }, 300);
        });

        // Dropdown filters
        $('#filterClientId, #filterTenantId, #filterScope, #filterStatus').on('change', function () {
            syncKpiActiveCard($('#filterStatus').val());
            dt.ajax.reload();
        });

        $('#btnResetFilters').on('click', function () {
            $customSearch.val('');
            $('#filterClientId').val('');
            $('#filterTenantId').val('');
            $('#filterScope').val('');
            $('#filterStatus').val('');
            syncKpiActiveCard('');
            dt.ajax.reload();
        });

        $('#btnRefreshTable').on('click', function () {
            dt.ajax.reload();
        });

        // Interactive KPI Cards
        $('.sub-kpi-card').on('click', function () {
            const status = $(this).data('status') || '';
            $('#filterStatus').val(status);
            syncKpiActiveCard(status);
            dt.ajax.reload();
        });

        function syncKpiActiveCard(status) {
            $('.sub-kpi-card').removeClass('active');
            if (status === 'Active') $('#kpiCardActive').addClass('active');
            else if (status === 'Completed') $('#kpiCardCompleted').addClass('active');
            else if (status === 'Revoked' || status === 'Expired') $('#kpiCardRevoked').addClass('active');
            else $('#kpiCardTotal').addClass('active');
        }

        // Slideover Inspector
        const overlay = document.getElementById('inspectorOverlay');
        const inspectorBody = document.getElementById('inspectorBody');
        const inspectorFooter = document.getElementById('inspectorFooter');
        const btnClose = document.getElementById('btnCloseInspector');

        $(document).on('click', '.btn-inspect', function () {
            const rowData = JSON.parse(decodeURIComponent($(this).data('row')));

            const status = rowData.statusName || 'Pending';
            let pillClass = 'status-pending';
            if (status === 'Active') pillClass = 'status-active';
            else if (status === 'Completed') pillClass = 'status-completed';
            else if (status === 'Expired') pillClass = 'status-expired';
            else if (status === 'Revoked') pillClass = 'status-revoked';

            const createdTime = rowData.createdOn ? new Date(rowData.createdOn).toLocaleString() : 'N/A';
            const expiresTime = rowData.expiresOn ? new Date(rowData.expiresOn).toLocaleString() : 'N/A';
            const consumedTime = rowData.consumedOn ? new Date(rowData.consumedOn).toLocaleString() : 'Not yet consumed';
            const resultCodeTime = rowData.resultCodeConsumedOn ? new Date(rowData.resultCodeConsumedOn).toLocaleString() : null;

            let exchangeBadge = '<span style="color: var(--text-muted); font-size: 0.8rem;">❌ Not Completed</span>';
            if (rowData.isResultCodeConsumed) {
                exchangeBadge = `<span style="color: #10b981; font-weight: 700; font-size: 0.8rem;">✅ Verified by Client Backend (${resultCodeTime || 'Completed'})</span>`;
            } else if (rowData.hasResultCode) {
                exchangeBadge = '<span style="color: #f59e0b; font-weight: 700; font-size: 0.8rem;">⏳ One-Time Code Issued, Awaiting Client Verification</span>';
            }

            inspectorBody.innerHTML = `
                <!-- 1. Lifecycle & Status Card -->
                <div class="so-card">
                    <div class="so-card-title">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        Session Status & Lifecycle
                    </div>
                    <div class="so-card-grid">
                        <div class="so-field">
                            <span class="so-label">Current Status</span>
                            <div><span class="status-pill ${pillClass}"><span class="status-pulse"></span>${status}</span></div>
                        </div>
                        <div class="so-field">
                            <span class="so-label">Assigned Permission Scope</span>
                            <div><span class="scope-pill">${rowData.scope}</span></div>
                        </div>
                        <div class="so-field">
                            <span class="so-label">Created At</span>
                            <span class="so-val">${createdTime}</span>
                        </div>
                        <div class="so-field">
                            <span class="so-label">Session Expires At</span>
                            <span class="so-val">${expiresTime}</span>
                        </div>
                        <div class="so-field" style="grid-column: 1 / -1;">
                            <span class="so-label">Result Code Verification</span>
                            <div>${exchangeBadge}</div>
                        </div>
                        <div class="so-field" style="grid-column: 1 / -1;">
                            <span class="so-label">Activity & Modified Fields</span>
                            <div>
                                ${rowData.changes && rowData.changes.length > 0 ? `
                                    <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px;">
                                        ${rowData.changes.map(c => `
                                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3);">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                                ${c === 'phone_number' ? 'Phone Number' : c.charAt(0).toUpperCase() + c.slice(1)}
                                            </span>
                                        `).join('')}
                                    </div>
                                ` : '<span style="color: var(--text-muted); font-size: 0.8rem; font-style: italic;">No modifications recorded during session</span>'}
                            </div>
                        </div>
                        ${rowData.revokedReason ? `
                            <div class="so-field" style="grid-column: 1 / -1; background: rgba(239, 68, 68, 0.08); padding: 8px 12px; border-radius: 8px; border: 1px solid rgba(239, 68, 68, 0.2);">
                                <span class="so-label" style="color: #ef4444;">Revocation Reason</span>
                                <span class="so-val" style="color: #dc2626;">${rowData.revokedReason} (Revoked by: ${rowData.revokedBy || 'Admin'})</span>
                            </div>
                        ` : ''}
                    </div>
                </div>

                <!-- 2. Transaction Identity -->
                <div class="so-card">
                    <div class="so-card-title">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        Transaction Identity
                    </div>
                    <div class="so-field">
                        <span class="so-label">Transaction ID (GUID)</span>
                        <div class="so-code-badge">
                            <span>${rowData.id}</span>
                            <button type="button" class="so-copy-btn" onclick="navigator.clipboard.writeText('${rowData.id}'); Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Transaction ID Copied!', showConfirmButton: false, timer: 1500 });" title="Copy GUID">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 3. User & Tenant Details -->
                <div class="so-card">
                    <div class="so-card-title">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        Target User & Tenant Account
                    </div>
                    <div class="so-card-grid">
                        <div class="so-field">
                            <span class="so-label">User Display Name</span>
                            <span class="so-val">${rowData.userName || 'N/A'}</span>
                        </div>
                        <div class="so-field">
                            <span class="so-label">User Email Address</span>
                            <span class="so-val">${rowData.userEmail || 'N/A'}</span>
                        </div>
                        <div class="so-field">
                            <span class="so-label">User ID (GUID)</span>
                            <span class="so-val" style="font-family: monospace; font-size: 0.78rem;">${rowData.userId}</span>
                        </div>
                        <div class="so-field">
                            <span class="so-label">Tenant Name & ID</span>
                            <span class="so-val">${rowData.tenantName || 'Standard Tenant'} <small style="color: var(--text-muted);">(${rowData.tenantId})</small></span>
                        </div>
                    </div>
                </div>

                <!-- 4. Protocol & URLs -->
                <div class="so-card">
                    <div class="so-card-title">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                        Navigation & Callback URLs
                    </div>
                    <div class="so-field">
                        <span class="so-label">Target Restricted Landing URL</span>
                        <div class="so-code-badge">
                            <span>${rowData.targetUrl}</span>
                        </div>
                    </div>
                    <div class="so-field">
                        <span class="so-label">Client Callback Return URL</span>
                        <div class="so-code-badge">
                            <span>${rowData.callbackUrl}</span>
                        </div>
                    </div>
                    ${rowData.state ? `
                        <div class="so-field">
                            <span class="so-label">State Parameter</span>
                            <span class="so-val" style="font-family: monospace; font-size: 0.8rem;">${rowData.state}</span>
                        </div>
                    ` : ''}
                </div>

                <!-- 5. Network & Security Audit -->
                <div class="so-card">
                    <div class="so-card-title">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
                        Device & Network Audit
                    </div>
                    <div class="so-card-grid">
                        <div class="so-field">
                            <span class="so-label">Client Application</span>
                            <span class="so-val"><strong>${rowData.clientDisplayName || rowData.clientId}</strong> (${rowData.clientId})</span>
                        </div>
                        <div class="so-field">
                            <span class="so-label">Consumed IP Address</span>
                            <span class="so-val" style="font-family: monospace;">${rowData.consumedIpAddress || 'Not yet launched'}</span>
                        </div>
                        <div class="so-field" style="grid-column: 1 / -1;">
                            <span class="so-label">Consumed User-Agent</span>
                            <span class="so-val" style="font-size: 0.78rem; color: var(--text-muted); word-break: break-all;">${rowData.consumedUserAgent || 'Not yet consumed in browser'}</span>
                        </div>
                    </div>
                </div>
            `;

            // Footer Buttons
            let revokeBtn = '';
            if (status === 'Active' || status === 'Pending') {
                revokeBtn = `
                    <button type="button" class="btn btn-outline-danger btn-sm btn-revoke-modal" data-id="${rowData.id}" style="padding: 8px 16px; font-weight: 700; border-radius: 10px;">
                        Revoke Session Now
                    </button>
                `;
            }

            inspectorFooter.innerHTML = `
                ${revokeBtn}
                <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('inspectorOverlay').classList.remove('active');" style="padding: 8px 16px; font-weight: 600; border-radius: 10px;">
                    Close
                </button>
            `;

            overlay.classList.add('active');
        });

        btnClose.addEventListener('click', function () {
            overlay.classList.remove('active');
        });

        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) {
                overlay.classList.remove('active');
            }
        });

        // ═══════════════════════════════════════════════════════════
        // RPAP PROTOCOL SETTINGS POPUP & AJAX LOGIC
        // ═══════════════════════════════════════════════════════════
        const settingsOverlay = document.getElementById('settingsModalOverlay');
        const btnOpenSettings = document.getElementById('btnOpenSettings');
        const btnCloseSettings = document.getElementById('btnCloseSettingsModal');
        const settingsForm = document.getElementById('rpapSettingsForm');

        function formatSecondsHelper(sec) {
            const num = parseInt(sec, 10);
            if (isNaN(num) || num <= 0) return '';
            if (num < 60) return `= ${num} seconds`;
            if (num % 60 === 0) return `= ${num / 60} minute(s)`;
            return `= ${Math.floor(num / 60)} min ${num % 60} sec`;
        }

        $('#settingProfileTtl').on('input', function () {
            $('#profileTtlHelper').text(formatSecondsHelper($(this).val()));
        });

        $('#settingManagementTtl').on('input', function () {
            $('#managementTtlHelper').text(formatSecondsHelper($(this).val()));
        });

        // Tab Navigation
        $(document).on('click', '.st-tab-btn', function () {
            const tabId = $(this).data('tab');
            $('.st-tab-btn').removeClass('active');
            $(this).addClass('active');
            $('.st-tab-pane').removeClass('active');
            $('#' + tabId).addClass('active');
        });

        // TTL Presets
        $(document).on('click', '.time-preset-pill', function () {
            const targetId = $(this).data('target');
            const val = $(this).data('val');
            $('#' + targetId).val(val).trigger('input');
        });

        // Interactive Action Chips State & Renderer
        let currentProfileActions = [];
        let currentUsersActions = [];

        function renderActionChips(containerId, inputId, actionsArray) {
            const $container = $('#' + containerId);
            const $input = $('#' + inputId);
            $container.find('.action-chip').remove();

            actionsArray.forEach((action, idx) => {
                const $chip = $(`
                    <span class="action-chip" data-action="${action}">
                        ${action}
                        <span class="chip-remove">✕</span>
                    </span>
                `);
                $chip.insertBefore($input);
            });
        }

        // Chip Input Event Handlers
        $('#profileActionInput').on('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ',') {
                e.preventDefault();
                const val = $(this).val().replace(',', '').trim();
                if (val && !currentProfileActions.includes(val)) {
                    currentProfileActions.push(val);
                    renderActionChips('profileActionsContainer', 'profileActionInput', currentProfileActions);
                    $(this).val('');
                }
            }
        });

        $('#usersActionInput').on('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ',') {
                e.preventDefault();
                const val = $(this).val().replace(',', '').trim();
                if (val && !currentUsersActions.includes(val)) {
                    currentUsersActions.push(val);
                    renderActionChips('usersActionsContainer', 'usersActionInput', currentUsersActions);
                    $(this).val('');
                }
            }
        });

        $(document).on('click', '#profileActionsContainer .chip-remove', function () {
            const action = $(this).closest('.action-chip').data('action');
            currentProfileActions = currentProfileActions.filter(a => a !== action);
            renderActionChips('profileActionsContainer', 'profileActionInput', currentProfileActions);
        });

        $(document).on('click', '#usersActionsContainer .chip-remove', function () {
            const action = $(this).closest('.action-chip').data('action');
            currentUsersActions = currentUsersActions.filter(a => a !== action);
            renderActionChips('usersActionsContainer', 'usersActionInput', currentUsersActions);
        });

        $('#btnLoadDefaultProfileActions').on('click', function () {
            currentProfileActions = ["Profile", "UpdateProfile", "ChangePassword", "SendEmailChangeVerification", "ConfirmEmailChange", "Enable2fa", "Verify2fa", "Disable2fa"];
            renderActionChips('profileActionsContainer', 'profileActionInput', currentProfileActions);
        });

        $('#btnLoadDefaultUsersActions').on('click', function () {
            currentUsersActions = ["Users", "GetUsers", "CreateUser", "DeleteUser", "ToggleUserStatus", "UnlockUser", "ResetPasswordAdmin", "ExportUsers", "Roles", "GetRoles", "CreateRole", "DeleteRole", "RolePermissions", "UpdateRolePermissions", "GetRolesByTenant", "GetClientsByTenant", "Profile", "UpdateProfile", "ChangePassword"];
            renderActionChips('usersActionsContainer', 'usersActionInput', currentUsersActions);
        });

        // Enforce Switch sync
        $('#settingEnforceScope').on('change', function () {
            const checked = $(this).is(':checked');
            if (checked) {
                $('#enforceStatusBadge').text('Active').css({ color: '#10b981', background: 'rgba(16, 185, 129, 0.12)' });
            } else {
                $('#enforceStatusBadge').text('Bypassed').css({ color: '#ef4444', background: 'rgba(239, 68, 68, 0.12)' });
            }
        });

        // Scope Checkbox UI card sync
        $(document).on('change', '.scope-checkbox', function () {
            const $card = $(this).closest('.scope-select-card');
            if ($(this).is(':checked')) {
                $card.addClass('checked');
            } else {
                $card.removeClass('checked');
            }
        });

        btnOpenSettings.addEventListener('click', function () {
            // Load current settings via AJAX
            $.ajax({
                url: '/RestrictedAccess/GetSettings',
                type: 'GET',
                success: function (res) {
                    if (res && res.data) {
                        const s = res.data;
                        $('#settingProfileTtl').val(s.defaultProfileTtlSeconds);
                        $('#profileTtlHelper').text(formatSecondsHelper(s.defaultProfileTtlSeconds));

                        $('#settingManagementTtl').val(s.defaultManagementTtlSeconds);
                        $('#managementTtlHelper').text(formatSecondsHelper(s.defaultManagementTtlSeconds));

                        $('#settingMinTtl').val(s.minTtlSeconds);
                        $('#settingMaxTtl').val(s.maxTtlSeconds);
                        $('#settingProfileUrl').val(s.profileLandingUrl);
                        $('#settingUsersUrl').val(s.usersLandingUrl);

                        // SsoContextFilter fields
                        const isEnforce = s.enforceScopeAccess !== false;
                        $('#settingEnforceScope').prop('checked', isEnforce).trigger('change');
                        $('#settingFallbackUrl').val(s.fallbackUnauthorizedRedirectUrl || '/Account/Profile');
                        $('#settingCookieExpiry').val(s.contextCookieExpiryDays || 7);
                        
                        $('#settingAutoRevoke').prop('checked', s.autoRevokeOnResultExchange !== false);
                        $('#settingStrictPort').prop('checked', s.requireStrictLocalhostPort === true);

                        currentProfileActions = s.profileScopeAllowedActions ? [...s.profileScopeAllowedActions] : [];
                        renderActionChips('profileActionsContainer', 'profileActionInput', currentProfileActions);

                        currentUsersActions = s.usersScopeAllowedActions ? [...s.usersScopeAllowedActions] : [];
                        renderActionChips('usersActionsContainer', 'usersActionInput', currentUsersActions);

                        const allowed = s.allowedScopes || [];
                        $('.scope-checkbox').each(function () {
                            const isChecked = allowed.includes($(this).val());
                            $(this).prop('checked', isChecked).trigger('change');
                        });

                        // Switch to first tab on open
                        $('.st-tab-btn[data-tab="tab-ttl"]').trigger('click');
                        settingsOverlay.classList.add('active');
                    } else {
                        Swal.fire('Error', 'Failed to load settings.', 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', 'An unexpected error occurred loading settings.', 'error');
                }
            });
        });

        btnCloseSettings.addEventListener('click', function () {
            settingsOverlay.classList.remove('active');
        });

        settingsOverlay.addEventListener('click', function (e) {
            if (e.target === settingsOverlay) {
                settingsOverlay.classList.remove('active');
            }
        });

        // Submit Settings Form
        settingsForm.addEventListener('submit', function (e) {
            e.preventDefault();
            const token = $('input[name="__RequestVerificationToken"]').val();

            const selectedScopes = [];
            $('.scope-checkbox:checked').each(function () {
                selectedScopes.push($(this).val());
            });

            if (selectedScopes.length === 0) {
                Swal.fire('Validation Error', 'Please enable at least one permission scope.', 'warning');
                return;
            }

            const payload = {
                defaultProfileTtlSeconds: parseInt($('#settingProfileTtl').val(), 10),
                defaultManagementTtlSeconds: parseInt($('#settingManagementTtl').val(), 10),
                minTtlSeconds: parseInt($('#settingMinTtl').val(), 10),
                maxTtlSeconds: parseInt($('#settingMaxTtl').val(), 10),
                profileLandingUrl: $('#settingProfileUrl').val(),
                usersLandingUrl: $('#settingUsersUrl').val(),
                fallbackUnauthorizedRedirectUrl: $('#settingFallbackUrl').val(),
                enforceScopeAccess: $('#settingEnforceScope').is(':checked'),
                autoRevokeOnResultExchange: $('#settingAutoRevoke').is(':checked'),
                requireStrictLocalhostPort: $('#settingStrictPort').is(':checked'),
                contextCookieExpiryDays: parseInt($('#settingCookieExpiry').val(), 10) || 7,
                profileScopeAllowedActions: currentProfileActions,
                usersScopeAllowedActions: currentUsersActions,
                allowedScopes: selectedScopes
            };

            const $btnSave = $('#btnSaveSettings');
            const originalHtml = $btnSave.html();
            $btnSave.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="margin-right: 6px;"></span> Saving...');

            $.ajax({
                url: '/RestrictedAccess/UpdateSettings',
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    'RequestVerificationToken': token
                },
                data: JSON.stringify(payload),
                success: function (res) {
                    $btnSave.prop('disabled', false).html(originalHtml);
                    if (res && res.succeeded) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Settings Saved!',
                            text: 'RPAP Protocol and SsoContextFilter settings have been saved to Database successfully.',
                            timer: 2000,
                            showConfirmButton: false
                        });
                        settingsOverlay.classList.remove('active');
                    } else {
                        Swal.fire('Error', res.messages ? res.messages[0] : 'Failed to save settings.', 'error');
                    }
                },
                error: function () {
                    $btnSave.prop('disabled', false).html(originalHtml);
                    Swal.fire('Error', 'An unexpected error occurred saving settings.', 'error');
                }
            });
        });

        // Reset Settings to Defaults
        $('#btnResetSettingsDefault').on('click', function () {
            const token = $('input[name="__RequestVerificationToken"]').val();

            Swal.fire({
                title: 'Reset to Factory Defaults?',
                text: 'This will restore all TTL thresholds, SsoContextFilter actions, landing URLs, and allowed scopes in the database to default system values.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                confirmButtonText: 'Yes, Reset',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/RestrictedAccess/ResetSettings',
                        type: 'POST',
                        contentType: 'application/json',
                        headers: {
                            'RequestVerificationToken': token
                        },
                        success: function (res) {
                            if (res && res.succeeded && res.data) {
                                const s = res.data;
                                $('#settingProfileTtl').val(s.defaultProfileTtlSeconds);
                                $('#profileTtlHelper').text(formatSecondsHelper(s.defaultProfileTtlSeconds));

                                $('#settingManagementTtl').val(s.defaultManagementTtlSeconds);
                                $('#managementTtlHelper').text(formatSecondsHelper(s.defaultManagementTtlSeconds));

                                $('#settingMinTtl').val(s.minTtlSeconds);
                                $('#settingMaxTtl').val(s.maxTtlSeconds);
                                $('#settingProfileUrl').val(s.profileLandingUrl);
                                $('#settingUsersUrl').val(s.usersLandingUrl);

                                $('#settingEnforceScope').prop('checked', s.enforceScopeAccess !== false).trigger('change');
                                $('#settingFallbackUrl').val(s.fallbackUnauthorizedRedirectUrl || '/Account/Profile');
                                $('#settingCookieExpiry').val(s.contextCookieExpiryDays || 7);
                                
                                $('#settingAutoRevoke').prop('checked', s.autoRevokeOnResultExchange !== false);
                                $('#settingStrictPort').prop('checked', s.requireStrictLocalhostPort === true);

                                currentProfileActions = s.profileScopeAllowedActions ? [...s.profileScopeAllowedActions] : [];
                                renderActionChips('profileActionsContainer', 'profileActionInput', currentProfileActions);

                                currentUsersActions = s.usersScopeAllowedActions ? [...s.usersScopeAllowedActions] : [];
                                renderActionChips('usersActionsContainer', 'usersActionInput', currentUsersActions);

                                const allowed = s.allowedScopes || [];
                                $('.scope-checkbox').each(function () {
                                    const isChecked = allowed.includes($(this).val());
                                    $(this).prop('checked', isChecked).trigger('change');
                                });

                                Swal.fire('Reset!', 'Settings restored to factory defaults.', 'success');
                            }
                        }
                    });
                }
            });
        });

        // Revoke Session Action with SweetAlert2
        $(document).on('click', '.btn-revoke, .btn-revoke-modal', function () {
            const txId = $(this).data('id');
            const token = $('input[name="__RequestVerificationToken"]').val();

            Swal.fire({
                title: 'Revoke Restricted Session?',
                text: 'This will immediately terminate the active user session and prevent any further operations.',
                icon: 'warning',
                input: 'text',
                inputPlaceholder: 'Enter reason (optional)',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: 'var(--bg-base)',
                confirmButtonText: 'Yes, Revoke Session',
                cancelButtonText: 'Cancel',
                customClass: { popup: 'glass-modal border-glass' }
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/RestrictedAccess/RevokeSession',
                        type: 'POST',
                        contentType: 'application/json',
                        headers: {
                            'RequestVerificationToken': token
                        },
                        data: JSON.stringify({
                            transactionId: txId,
                            reason: result.value || 'Terminated by administrator'
                        }),
                        success: function (res) {
                            if (res.succeeded) {
                                Swal.fire('Revoked!', 'The session has been terminated.', 'success');
                                overlay.classList.remove('active');
                                dt.ajax.reload();
                            } else {
                                Swal.fire('Error', res.messages ? res.messages[0] : 'Failed to revoke session.', 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'An unexpected error occurred.', 'error');
                        }
                    });
                }
            });
        });
    });
</script>
