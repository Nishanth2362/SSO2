                                                    <button type="button" class="global-search-category-item" data-value="Subscriptions" data-url="/Home/Subscriptions"><span class="cat-icon"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg></span>Subscriptions</button>
